<!DOCTYPE html>
<html lang="vi">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/nav') %>
  <main class="container">
    <h1>Giao dịch / Sao kê — <%= COMPANIES[activeCompany].label %></h1>
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (typeof success !== 'undefined' && success) { %><div class="alert alert-success"><%= success %></div><% } %>

    <% if (typeof duplicateSummary !== 'undefined' && duplicateSummary) { %>
    <div class="alert" style="border:1px solid #e33; background:#fff5f5;">
      <strong>⚠️ Phát hiện giao dịch trùng lặp cho ngân hàng đang lọc:</strong>
      <%= duplicateSummary.groupCount %> nhóm giao dịch bị nhập trùng, dư <strong><%= duplicateSummary.excessCount %></strong> dòng,
      tổng số tiền bị cộng thừa <strong><%= duplicateSummary.excessAmount.toLocaleString('vi-VN') %> đ</strong>.
      Thường xảy ra khi tải lại sao kê nhiều lần trong lúc dữ liệu cũ chưa được dọn đúng cách.
      <form method="POST" action="/transactions/dedupe/<%= filters.bank_id %>" style="margin-top:8px;"
            onsubmit="return confirm('Xoá ' + <%= duplicateSummary.excessCount %> + ' dòng trùng lặp (giữ lại 1 dòng đúng cho mỗi giao dịch thật)? Không thể hoàn tác.');">
        <button type="submit" class="btn btn-secondary">Dọn giao dịch trùng lặp ngay</button>
      </form>
    </div>
    <% } %>

    <section class="panel">
      <h2>Tải file sao kê tải trực tiếp từ ngân hàng (.xlsx/.xls)</h2>
      <p class="muted">
        Tải nguyên file sao kê bạn xuất/tải về từ ngân hàng (BIDV, ACB, MB...) lên đây — web tự nhận diện
        cột Ngày giao dịch và Số dư, tự tính Thu/Chi, và tự bỏ qua các dòng đã có sẵn (nếu file mới có ngày trùng
        với dữ liệu cũ) nên tải lại đè lên nhau vẫn an toàn.
      </p>
      <form method="POST" action="/transactions/upload-statement" enctype="multipart/form-data" class="form-inline">
        <select name="bank_id" required>
          <option value="">-- Chọn ngân hàng --</option>
          <% banks.forEach(function(b) { %>
          <option value="<%= b.id %>" <%= filters.bank_id == b.id ? 'selected' : '' %>><%= b.name %><%= b.khu_vuc ? ' - ' + b.khu_vuc : '' %></option>
          <% }) %>
        </select>
        <input type="file" name="file" accept=".xlsx,.xls" required />
        <button type="submit" class="btn btn-primary">Tải lên</button>
      </form>

      <% if (uploadResult) { %>
      <div class="alert alert-success">
        Đọc file (sheet "<%= uploadResult.sheetName %>"): <%= uploadResult.totalRows %> dòng giao dịch.
        Đã thêm mới <strong><%= uploadResult.added %></strong> dòng, bỏ qua <strong><%= uploadResult.skipped %></strong> dòng đã có sẵn (trùng).
        <% if (uploadResult.healedRemoved > 0) { %>
        Đã tự động dọn <strong><%= uploadResult.healedRemoved %></strong> dòng cũ bị gộp nhầm (do lỗi trùng lặp trước đây) trong đúng khoảng ngày của file này trước khi nạp lại đầy đủ.
        <% } %>
      </div>
      <% } %>
    </section>

    <section class="panel">
      <h2>Tải danh sách Mã công trình chuẩn — <%= COMPANIES[activeCompany].label %></h2>
      <p class="muted">
        Tải file "Danh sách công trình" (mỗi công ty 1 file riêng, vì KH Cũ/KH Mới là 2 pháp nhân khác nhau nên mã
        công trình khác nhau). Danh sách này dùng làm nguồn chuẩn để sau này đối chiếu/chuẩn hóa tên gian ở các
        trang khác: tên khớp chính xác thì lấy mã tương ứng, không khớp tuyệt đối thì tự tìm tên gần giống nhất
        trong danh sách và đổi về đúng mã công trình chuẩn đó.
      </p>
      <form method="POST" action="/transactions/upload-ma-cong-trinh" enctype="multipart/form-data" class="form-inline">
        <input type="file" name="file" accept=".xlsx,.xls" required />
        <button type="submit" class="btn btn-primary">Tải lên</button>
      </form>

      <% if (maCongTrinhResult) { %>
      <div class="alert alert-success">
        Đã nạp "<%= maCongTrinhResult.fileName %>" (sheet "<%= maCongTrinhResult.sheetName %>"): <strong><%= maCongTrinhResult.count %></strong> mã công trình cho <%= COMPANIES[activeCompany].label %>.
      </div>
      <% } %>

      <% if (maCongTrinhMaster) { %>
      <p class="muted" style="margin-top:10px;">
        Đang lưu: <strong><%= maCongTrinhMaster.rows.length %></strong> mã công trình (file "<%= maCongTrinhMaster.file_name %>",
        tải lúc <%= new Date(maCongTrinhMaster.uploaded_at).toLocaleString('vi-VN') %>).
      </p>
      <% } else { %>
      <p class="muted" style="margin-top:10px;">Chưa có danh sách mã công trình nào cho <%= COMPANIES[activeCompany].label %>.</p>
      <% } %>
    </section>

    <section class="panel">
      <h2>Dán sao kê ngân hàng (nhiều dòng)</h2>
      <p class="muted">
        Mỗi dòng: <strong>Ngày</strong>&nbsp;&nbsp;<strong>Diễn giải</strong>&nbsp;&nbsp;<strong>Số tiền</strong>&nbsp;&nbsp;<strong>Thu/Chi (tuỳ chọn)</strong> —
        copy trực tiếp từ Excel (phân tách bằng Tab) rồi dán vào đây. Nếu không ghi Thu/Chi, số dương sẽ tính là Thu, số âm là Chi.
      </p>
      <form method="POST" action="/transactions/paste">
        <label>Chọn ngân hàng</label>
        <select name="bank_id" required>
          <option value="">-- Chọn ngân hàng --</option>
          <% banks.forEach(function(b) { %>
          <option value="<%= b.id %>" <%= filters.bank_id == b.id ? 'selected' : '' %>><%= b.name %><%= b.khu_vuc ? ' - ' + b.khu_vuc : '' %></option>
          <% }) %>
        </select>
        <label>Nội dung sao kê</label>
        <textarea name="paste_text" rows="8" placeholder="20/07/2026&#9;Thu tien khach ABC&#9;1.500.000&#9;Thu"></textarea>
        <button type="submit" class="btn btn-primary">Nhập sao kê</button>
      </form>

      <% if (pasteResult) { %>
        <div class="alert alert-success">Đã nhập thành công <%= pasteResult.inserted %> dòng.</div>
        <% if (pasteResult.errors.length > 0) { %>
        <div class="alert alert-error">
          Có <%= pasteResult.errors.length %> dòng bị bỏ qua:
          <ul>
            <% pasteResult.errors.forEach(function(e) { %><li><%= e %></li><% }) %>
          </ul>
        </div>
        <% } %>
      <% } %>
    </section>

    <section class="panel">
      <h2>Nhập giao dịch đơn lẻ</h2>
      <form method="POST" action="/transactions" class="form-grid">
        <div>
          <label>Ngân hàng</label>
          <select name="bank_id" required>
            <option value="">-- Chọn --</option>
            <% banks.forEach(function(b) { %>
            <option value="<%= b.id %>"><%= b.name %><%= b.khu_vuc ? ' - ' + b.khu_vuc : '' %></option>
            <% }) %>
          </select>
        </div>
        <div>
          <label>Ngày</label>
          <input type="date" name="date" required />
        </div>
        <div>
          <label>Diễn giải</label>
          <input type="text" name="description" />
        </div>
        <div>
          <label>Số tiền</label>
          <input type="text" name="amount" placeholder="1.500.000" required />
        </div>
        <div>
          <label>Loại</label>
          <select name="type" required>
            <option value="thu">Thu</option>
            <option value="chi">Chi</option>
          </select>
        </div>
        <div class="form-actions">
          <button type="submit" class="btn btn-primary">Thêm giao dịch</button>
        </div>
      </form>
    </section>

    <section class="panel">
      <h2>Danh sách giao dịch</h2>
      <form method="GET" action="/transactions" class="form-inline filter-bar">
        <select name="bank_id">
          <option value="">Tất cả ngân hàng</option>
          <% banks.forEach(function(b) { %>
          <option value="<%= b.id %>" <%= filters.bank_id == b.id ? 'selected' : '' %>><%= b.name %><%= b.khu_vuc ? ' - ' + b.khu_vuc : '' %></option>
          <% }) %>
        </select>
        <input type="date" name="from" value="<%= filters.from %>" />
        <input type="date" name="to" value="<%= filters.to %>" />
        <select name="type">
          <option value="">Tất cả Thu/Chi</option>
          <option value="thu" <%= filters.type === 'thu' ? 'selected' : '' %>>Chỉ Thu</option>
          <option value="chi" <%= filters.type === 'chi' ? 'selected' : '' %>>Chỉ Chi</option>
        </select>
        <button type="submit" class="btn btn-secondary">Lọc</button>
        <a class="btn btn-secondary" href="/export.xlsx?bank_id=<%= filters.bank_id %>&from=<%= filters.from %>&to=<%= filters.to %>">Xuất Excel</a>
      </form>

      <div style="margin:10px 0; padding:8px 12px; background:#f5f7fa; border:1px solid #e1e6ec; border-radius:8px; font-size:13px;">
        Tổng đang hiển thị (theo bộ lọc) —
        Thu: <strong class="text-pos"><%= totalThu.toLocaleString('vi-VN') %> đ</strong>
        &nbsp;|&nbsp;
        Chi: <strong class="text-neg"><%= totalChi.toLocaleString('vi-VN') %> đ</strong>
      </div>

      <% if (typeof isAdmin !== 'undefined' && isAdmin && filters.bank_id) { %>
      <% var _cnt = typeof filteredCount !== 'undefined' ? filteredCount : rows.length; %>
      <form method="POST" action="/transactions/xoa-loc" style="margin:6px 0 14px;"
            onsubmit="return confirm('Xoá TOÀN BỘ ' + <%= _cnt %> + ' dòng giao dịch đang lọc (ngân hàng + khoảng ngày + loại đang chọn)? Không thể hoàn tác, chỉ dùng khi muốn xoá sạch để tải lại sao kê đúng từ đầu.');">
        <input type="hidden" name="bank_id" value="<%= filters.bank_id %>" />
        <input type="hidden" name="from" value="<%= filters.from %>" />
        <input type="hidden" name="to" value="<%= filters.to %>" />
        <input type="hidden" name="type" value="<%= filters.type %>" />
        <button type="submit" class="btn" style="background:#e33; color:#fff; border:none;">
          Xoá toàn bộ <%= _cnt %> dòng đang lọc
        </button>
      </form>
      <% } %>

      <p class="muted" style="margin:6px 0 10px;">
        Mẹo: giữ <strong>Ctrl</strong> (hoặc <strong>Cmd</strong> trên Mac) rồi bấm vào nhiều dòng để cộng tổng số tiền các dòng đã chọn.
      </p>
      <div id="txSelectionBar" style="display:none; margin-bottom:10px; padding:8px 12px; background:#eef6ff; border:1px solid #cfe3fb; border-radius:8px; font-size:13px;">
        Đã chọn <strong id="txSelCount">0</strong> dòng — Tổng: <strong id="txSelTotal">0 đ</strong>
        <button type="button" class="link-btn" onclick="txClearSelection()" style="margin-left:10px;">Bỏ chọn</button>
      </div>

      <table class="table">
        <thead>
          <!-- Chi Nhan, 2026-07-29: "thêm cho tôi trên cái ngân hàng có hiển
               thị cái tên đối ứng trên sao kê luôn nha" -- them cot Ten doi
               ung (ben kia giao dich, doc tu file sao ke neu co, xem
               utils/bankStatementParser.js), giup do ai/NCC nao thanh toan/
               nhan tien ma khong can doc het Dien giai dai. -->
          <tr><th>Ngày</th><th>Ngân hàng</th><th>Diễn giải</th><th>Tên đối ứng</th><th>Thu</th><th>Chi</th><th>Số dư</th><% if (isAdmin) { %><th></th><% } %></tr>
        </thead>
        <tbody>
          <% rows.forEach(function(t) { %>
          <tr class="tx-row" data-id="<%= t.id %>" data-amount="<%= t.amount %>" data-type="<%= t.type %>" onclick="txRowClick(event, this)" style="cursor:pointer;">
            <td><%= t.date %></td>
            <td><%= t.bank_label %></td>
            <td class="desc-cell" title="<%= t.description %>"><%= t.description %></td>
            <td class="desc-cell" title="<%= t.tenDoiUng || '' %>"><%= t.tenDoiUng || '—' %></td>
            <td class="text-pos"><%= t.type === 'thu' ? t.amount.toLocaleString('vi-VN') + ' đ' : '' %></td>
            <td class="text-neg"><%= t.type === 'chi' ? t.amount.toLocaleString('vi-VN') + ' đ' : '' %></td>
            <td><%= t.balance != null ? t.balance.toLocaleString('vi-VN') + ' đ' : '-' %></td>
            <% if (isAdmin) { %>
            <td><button type="button" class="link-btn" style="font-size:11px;" onclick="txToggleEdit(event, '<%= t.id %>')">Sửa</button></td>
            <% } %>
          </tr>
          <% if (isAdmin) { %>
          <!-- Chi Nhan (2026-07-23): "số tiền có 8tr mấy mà bạn lấy lên mất tỷ dữ
               vậy" -- truoc gio khong co cach sua 1 giao dich da nhap sai (chi
               them moi), them form sua an san ngay duoi dong, mo ra khi bam "Sửa". -->
          <tr class="tx-edit-row" id="txEdit-<%= t.id %>" style="display:none; background:#fffbe6;">
            <td colspan="8">
              <form method="POST" action="/transactions/<%= t.id %>/sua" class="form-inline tx-edit-form" data-id="<%= t.id %>" style="gap:6px; padding:6px 0;">
                <input type="date" name="date" value="<%= t.date %>" required style="font-size:12px;" />
                <input type="text" name="description" value="<%= t.description %>" style="width:260px; font-size:12px;" placeholder="Diễn giải" />
                <input type="text" name="tenDoiUng" value="<%= t.tenDoiUng || '' %>" style="width:180px; font-size:12px;" placeholder="Tên đối ứng" />
                <input type="text" name="amount" value="<%= t.amount %>" style="width:140px; font-size:12px;" placeholder="Số tiền" required />
                <select name="type" style="font-size:12px;">
                  <option value="thu" <%= t.type === 'thu' ? 'selected' : '' %>>Thu</option>
                  <option value="chi" <%= t.type === 'chi' ? 'selected' : '' %>>Chi</option>
                </select>
                <button type="submit" class="btn btn-secondary" style="font-size:12px; padding:3px 10px;">Lưu</button>
                <button type="button" class="link-btn" style="font-size:12px;" onclick="txToggleEdit(event, '<%= t.id %>')">Hủy</button>
              </form>
            </td>
          </tr>
          <% } %>
          <% }) %>
          <% if (rows.length === 0) { %>
          <tr><td colspan="8" class="muted">Không có giao dịch nào.</td></tr>
          <% } %>
        </tbody>
      </table>
    </section>
  </main>
  <style>
    .tx-row-selected { background: #fff6d8 !important; }
  </style>
  <script>
    (function () {
      var selected = new Set();
      window.txRowClick = function (e, tr) {
        var id = tr.getAttribute('data-id');
        if (!e.ctrlKey && !e.metaKey) {
          if (selected.size === 1 && selected.has(id)) selected.clear();
          else {
            selected.clear();
            selected.add(id);
          }
        } else if (selected.has(id)) {
          selected.delete(id);
        } else {
          selected.add(id);
        }
        render();
      };
      window.txClearSelection = function () {
        selected.clear();
        render();
      };
      function render() {
        document.querySelectorAll('.tx-row').forEach(function (tr) {
          tr.classList.toggle('tx-row-selected', selected.has(tr.getAttribute('data-id')));
        });
        var bar = document.getElementById('txSelectionBar');
        if (selected.size === 0) {
          bar.style.display = 'none';
          return;
        }
        bar.style.display = '';
        var total = 0;
        selected.forEach(function (id) {
          var tr = document.querySelector('.tx-row[data-id="' + id + '"]');
          if (!tr) return;
          var amt = Number(tr.getAttribute('data-amount')) || 0;
          total += tr.getAttribute('data-type') === 'chi' ? -amt : amt;
        });
        document.getElementById('txSelCount').textContent = selected.size;
        document.getElementById('txSelTotal').textContent = total.toLocaleString('vi-VN') + ' đ';
      }
    })();
  </script>
  <script>
    // Chi Nhan (2026-07-23): sua 1 giao dich da nhap sai (vd nhap nham so tien).
    // Bam "Sửa" mo form an ngay duoi dong; luu xong RELOAD lai trang (khong chi
    // vá DOM) vi so du (Số dư) la tinh don dua tren TOAN BO cac giao dich phia
    // sau trong cung ngan hang -- sua 1 dong co the lam doi so du hang loat dong
    // khac, phai tai lai tu server moi tinh dung lai duoc.
    window.txToggleEdit = function (e, id) {
      if (e) e.stopPropagation();
      var editRow = document.getElementById('txEdit-' + id);
      if (!editRow) return;
      var willShow = editRow.style.display === 'none';
      document.querySelectorAll('.tx-edit-row').forEach(function (tr) { tr.style.display = 'none'; });
      editRow.style.display = willShow ? '' : 'none';
      if (willShow) {
        var input = editRow.querySelector('input[name="amount"]');
        if (input) { input.focus(); input.select(); }
      }
    };
    document.querySelectorAll('form.tx-edit-form').forEach(function (form) {
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var body = new URLSearchParams(new FormData(form));
        var btn = form.querySelector('button[type="submit"]');
        if (btn) btn.disabled = true;
        fetch(form.action, {
          method: 'POST',
          headers: { 'X-Requested-With': 'XMLHttpRequest' },
          body: body,
        })
          .then(function (resp) { return resp.json().then(function (data) { return { ok: resp.ok, data: data }; }); })
          .then(function (result) {
            if (!result.ok) {
              alert((result.data && result.data.error) || 'Có lỗi khi lưu, thử lại giúp tôi.');
              if (btn) btn.disabled = false;
              return;
            }
            window.location.reload();
          })
          .catch(function () {
            alert('Không kết nối được, thử lại giúp tôi.');
            if (btn) btn.disabled = false;
          });
      });
    });
  </script>
</body>
</html>

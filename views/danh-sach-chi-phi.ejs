<!DOCTYPE html>
<html lang="vi">
<head>
  <%- include('partials/head') %>
  <style>
    .dsch-row { cursor:pointer; transition:background 0.15s; }
    .dsch-row:hover { background: rgba(21,101,192,0.07) !important; }
    .dsch-cell { max-width:0; overflow:hidden; }
    .dsch-cell-1 { display:-webkit-box; -webkit-line-clamp:1; -webkit-box-orient:vertical; overflow:hidden; }
    .dsch-cell-2 { display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
    /* Modal */
    #dschOverlay { display:none; position:fixed; inset:0; background:rgba(0,0,0,0.45); z-index:9000; align-items:center; justify-content:center; }
    #dschOverlay.open { display:flex; }
    #dschModal { background:#fff; border-radius:10px; padding:24px 28px; width:580px; max-width:95vw; max-height:88vh; overflow-y:auto; box-shadow:0 8px 32px rgba(0,0,0,0.22); }
    .dsch-field { display:flex; gap:10px; margin-bottom:8px; font-size:13px; }
    .dsch-field label { min-width:130px; color:var(--muted); font-weight:600; flex-shrink:0; }
    .dsch-field span { word-break:break-word; }
    .dsch-ht-row { display:flex; align-items:center; gap:10px; margin-top:14px; padding-top:14px; border-top:1px solid #eee; }
  </style>
</head>
<body>
  <%- include('partials/nav') %>
  <main class="container">
    <h1>Danh Sách Chi Phí <%= mienLabel %></h1>
    <p class="muted" style="margin-top:-10px;margin-bottom:12px;">
      Toàn bộ thông tin chi phí <%= mienLabel %> từ file Đi UNC. Bấm vào dòng để xem chi tiết.
      <a href="/chi-phi/mien-<%= mien === 'nam' ? 'nam' : 'bac' %>" style="margin-left:8px;font-size:13px;">← Quay lại Chi Phí <%= mienLabel %></a>
    </p>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>

    <!-- Bo loc -->
    <form method="GET" action="/chi-phi/mien-<%= mien === 'nam' ? 'nam' : 'bac' %>/danh-sach"
          style="display:flex;flex-wrap:wrap;align-items:center;gap:10px;margin-bottom:14px;">
      <label style="display:flex;align-items:center;gap:6px;font-size:13px;">
        Tháng
        <select name="thang" onchange="this.form.submit()" style="font-size:13px;">
          <option value="">Tất cả</option>
          <% availableMonths.forEach(function(m) { %>
          <option value="<%= m %>" <%= thangFilter === m ? 'selected' : '' %>>
            Tháng <%= Number(m.slice(5,7)) %>/<%= m.slice(0,4) %>
          </option>
          <% }) %>
        </select>
      </label>
      <input type="text" name="q" value="<%= q %>" placeholder="Tìm diễn giải, NCC, số HĐ, UNC..."
             style="width:250px;font-size:13px;" />
      <button type="submit" class="btn btn-secondary" style="padding:5px 12px;">Tìm</button>
      <% if (q || thangFilter) { %>
        <a href="/chi-phi/mien-<%= mien === 'nam' ? 'nam' : 'bac' %>/danh-sach" class="link-btn">✕ Bỏ lọc</a>
      <% } %>
      <span class="muted" style="font-size:13px;margin-left:auto;">
        <%= rows.length %> dòng &nbsp;|&nbsp; Tổng: <strong><%= tongTien.toLocaleString('vi-VN') %> đ</strong>
      </span>
    </form>

    <section class="panel" style="padding:0;">
      <% if (rows.length === 0) { %>
        <p class="muted" style="padding:14px;">Không có dữ liệu<% if (q || thangFilter) { %> khớp bộ lọc<% } %>.</p>
      <% } else { %>
      <div class="table-scroll">
        <table class="table" style="font-size:12px;table-layout:fixed;width:100%;">
          <colgroup>
            <col style="width:82px;">
            <col style="width:120px;">
            <col style="width:46px;">
            <col style="width:160px;">
            <col style="width:68px;">
            <col style="width:76px;">
            <col style="width:90px;">
            <col><!-- dien giai -->
            <col style="width:110px;">
            <col style="width:38px;">
          </colgroup>
          <thead>
            <tr>
              <th>Ngày</th><th>Gian</th><th>TK</th><th>NCC</th>
              <th>Số HĐ</th><th>Số UNC</th><th>CT LQ</th>
              <th>Diễn giải</th>
              <th style="text-align:right;">Số tiền</th>
              <th style="text-align:center;" title="Đã chi">Chi</th>
            </tr>
          </thead>
          <tbody>
            <% rows.forEach(function(r) { %>
            <tr class="dsch-row"
                id="dsch-tr-<%= r.id %>"
                onclick="openDschModal(<%= r.id %>)">
              <td style="white-space:nowrap;color:var(--muted);">
                <%= r.ngay ? new Date(r.ngay).toLocaleDateString('vi-VN') : '—' %>
              </td>
              <td class="dsch-cell"><div class="dsch-cell-1" title="<%= r.gian || '' %>"><%= r.gian || '—' %></div></td>
              <td style="color:var(--muted);white-space:nowrap;"><%= r.taiKhoan || '—' %></td>
              <td class="dsch-cell"><div class="dsch-cell-2" title="<%= r.ncc || '' %>"><%= r.ncc || '—' %></div></td>
              <td style="white-space:nowrap;"><%= r.soHoaDon || '—' %></td>
              <td style="color:var(--muted);white-space:nowrap;"><%= r.soUNC || '—' %></td>
              <td class="dsch-cell"><div class="dsch-cell-1" style="color:var(--muted);" title="<%= r.soChungTuLienQuan || '' %>"><%= r.soChungTuLienQuan || '—' %></div></td>
              <td class="dsch-cell"><div class="dsch-cell-2" title="<%= (r.dienGiai || '') %>">
                <%= r.dienGiai || '—' %>
                <% if (r.trangThaiHoaDon) { %><br/><span style="font-size:10px;color:#e65100;"><%= r.trangThaiHoaDon %></span><% } %>
              </div></td>
              <td style="text-align:right;font-weight:600;white-space:nowrap;">
                <%= (r.soTien || 0).toLocaleString('vi-VN') %> đ
              </td>
              <td style="text-align:center;font-size:15px;">
                <% if (r.daChi) { %><span style="color:#388e3c;">☑</span><% } else { %><span style="color:#ccc;">☐</span><% } %>
              </td>
            </tr>
            <% }) %>
          </tbody>
          <tfoot>
            <tr style="background:var(--bg-hover,#f5f5f5);font-weight:700;">
              <td colspan="8" style="text-align:right;padding-right:10px;">Tổng cộng:</td>
              <td style="text-align:right;white-space:nowrap;"><%= tongTien.toLocaleString('vi-VN') %> đ</td>
              <td></td>
            </tr>
          </tfoot>
        </table>
      </div>
      <% } %>
    </section>
  </main>

  <!-- Modal chi tiet -->
  <div id="dschOverlay" onclick="if(event.target===this)closeDschModal()">
    <div id="dschModal">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;">
        <h3 style="margin:0;font-size:16px;">Chi tiết khoản chi</h3>
        <button type="button" class="link-btn" onclick="closeDschModal()" style="font-size:20px;line-height:1;">×</button>
      </div>
      <!-- VIEW -->
      <div id="dschViewPane">
        <div id="dschContent"></div>
        <div style="margin-top:14px;padding-top:12px;border-top:1px solid #eee;display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
          <label style="display:flex;align-items:center;gap:8px;font-size:14px;font-weight:600;cursor:pointer;">
            <input type="checkbox" id="dschHtCheck" style="width:18px;height:18px;" onchange="toggleDschHachToan(this)" />
            Đã hạch toán
          </label>
          <span id="dschHtStatus" style="font-size:12px;color:#388e3c;"></span>
          <button type="button" class="btn btn-secondary" onclick="dschEnterEdit()" style="margin-left:auto;">✏️ Sửa</button>
        </div>
      </div>
      <!-- EDIT -->
      <div id="dschEditPane" style="display:none;">
        <div id="dschEditContent"></div>
        <div style="margin-top:14px;padding-top:12px;border-top:1px solid #eee;display:flex;gap:10px;flex-wrap:wrap;align-items:center;">
          <button type="button" class="btn btn-primary" onclick="dschSaveEdit()" id="dschSaveBtn">💾 Lưu</button>
          <button type="button" class="btn btn-secondary" onclick="dschExitEdit()">Hủy</button>
          <span id="dschSaveStatus" style="font-size:12px;color:#388e3c;"></span>
        </div>
      </div>
    </div>
  </div>

  <script>
  var _dschRows = <%- JSON.stringify(rows).replace(/<\//g, '<\\/') %>;
  var _dschMap = {};
  _dschRows.forEach(function(r){ _dschMap[r.id] = r; });
  var _dschCurrentId = null;

  function fmt(v) { return v || '—'; }
  function fmtMoney(v) { return v ? Number(v).toLocaleString('vi-VN') + ' đ' : '—'; }
  function fmtDate(v) { return v ? new Date(v).toLocaleDateString('vi-VN') : '—'; }
  function esc(s) { return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/"/g,'&quot;'); }

  function openDschModal(id) {
    var r = _dschMap[id];
    if (!r) return;
    _dschCurrentId = id;
    renderDschView(r);
    document.getElementById('dschViewPane').style.display = '';
    document.getElementById('dschEditPane').style.display = 'none';
    document.getElementById('dschOverlay').classList.add('open');
  }

  function renderDschView(r) {
    var fields = [
      ['Ngày', fmtDate(r.ngay)],
      ['Gian', fmt(r.gian)],
      ['Tài khoản', fmt(r.taiKhoan)],
      ['NCC', fmt(r.ncc)],
      ['Số hóa đơn', fmt(r.soHoaDon)],
      ['Số UNC', fmt(r.soUNC)],
      ['Chứng từ liên quan', fmt(r.soChungTuLienQuan)],
      ['Diễn giải', fmt(r.dienGiai)],
      ['Số tiền', fmtMoney(r.soTien)],
      ['Loại chi phí', r.loaiChiPhi || null],
      ['Nguồn', r.nguon || null],
      ['Ghi chú', r.ghiChu || null],
      ['Trạng thái HĐ', r.trangThaiHoaDon || null],
      ['Link hóa đơn', r.linkHoaDon ? '<a href="'+r.linkHoaDon+'" target="_blank" rel="noopener">Xem hóa đơn</a>' : null],
      ['Đã chi', r.daChi ? '✓ Đã chi' : 'Chưa chi'],
    ];
    var html = '';
    fields.forEach(function(f) {
      if (f[1] === null || f[1] === undefined) return;
      html += '<div class="dsch-field"><label>'+f[0]+'</label><span>'+f[1]+'</span></div>';
    });
    document.getElementById('dschContent').innerHTML = html;
    document.getElementById('dschHtCheck').checked = !!r.daHachToan;
    document.getElementById('dschHtStatus').textContent = r.daHachToan ? '✓ Đã hạch toán' : '';
  }

  function dschEnterEdit() {
    var r = _dschMap[_dschCurrentId];
    if (!r) return;
    var inp = function(name, val, ph) {
      return '<input type="text" name="'+name+'" value="'+esc(val||'')+'" placeholder="'+(ph||'')+'" style="width:100%;font-size:13px;padding:4px 6px;border:1px solid #ccc;border-radius:4px;" />';
    };
    var ta = function(name, val, ph) {
      return '<textarea name="'+name+'" placeholder="'+(ph||'')+'" rows="2" style="width:100%;font-size:13px;padding:4px 6px;border:1px solid #ccc;border-radius:4px;resize:vertical;">'+esc(val||'')+'</textarea>';
    };
    var ro = function(val) { return '<span style="color:#666;">'+fmt(val)+'</span>'; };
    var html = '';
    html += '<div class="dsch-field"><label>Ngày</label>'+ro(fmtDate(r.ngay))+'</div>';
    html += '<div class="dsch-field"><label>Gian</label>'+ro(r.gian)+'</div>';
    html += '<div class="dsch-field"><label>Số tiền</label>'+ro(fmtMoney(r.soTien))+'</div>';
    html += '<div class="dsch-field"><label>NCC</label>'+inp('ncc', r.ncc, 'Nhà cung cấp...')+'</div>';
    html += '<div class="dsch-field"><label>Số hóa đơn</label>'+inp('soHoaDon', r.soHoaDon, 'Số HĐ...')+'</div>';
    html += '<div class="dsch-field"><label>Số UNC</label>'+inp('soUNC', r.soUNC, 'UNC...')+'</div>';
    html += '<div class="dsch-field"><label>Chứng từ LQ</label>'+inp('soChungTuLienQuan', r.soChungTuLienQuan, 'Số chứng từ...')+'</div>';
    html += '<div class="dsch-field"><label>Diễn giải</label>'+ta('dienGiai', r.dienGiai, 'Diễn giải...')+'</div>';
    html += '<div class="dsch-field"><label>Loại chi phí</label>'+inp('loaiChiPhi', r.loaiChiPhi, 'VD: Tiền thuê, Hàng hóa...')+'</div>';
    html += '<div class="dsch-field"><label>Ghi chú</label>'+inp('ghiChu', r.ghiChu, 'Ghi chú...')+'</div>';
    html += '<div class="dsch-field"><label>Link hóa đơn</label>'+inp('linkHoaDon', r.linkHoaDon, 'https://...')+'</div>';
    document.getElementById('dschEditContent').innerHTML = html;
    document.getElementById('dschViewPane').style.display = 'none';
    document.getElementById('dschEditPane').style.display = '';
    document.getElementById('dschSaveStatus').textContent = '';
  }

  function dschExitEdit() {
    document.getElementById('dschEditPane').style.display = 'none';
    document.getElementById('dschViewPane').style.display = '';
  }

  function dschSaveEdit() {
    var id = _dschCurrentId;
    if (!id) return;
    var btn = document.getElementById('dschSaveBtn');
    var status = document.getElementById('dschSaveStatus');
    btn.disabled = true;
    status.textContent = 'Đang lưu...';
    var inputs = document.querySelectorAll('#dschEditContent [name]');
    var body = new URLSearchParams();
    inputs.forEach(function(el) { body.append(el.name, el.value); });
    fetch('/chi-phi/' + id + '/update', {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' },
      body: body.toString()
    })
    .then(function(r){ return r.json(); })
    .then(function(data) {
      btn.disabled = false;
      if (data.success) {
        Object.assign(_dschMap[id], data.record);
        // cập nhật lại row trong table
        var tr = document.getElementById('dsch-tr-' + id);
        if (tr && data.record) {
          var r = data.record;
          var cells = tr.querySelectorAll('td');
          // cells: 0=ngày,1=gian,2=tk,3=ncc,4=soHD,5=soUNC,6=CTLQ,7=dienGiai,8=soTien,9=chi
          if (cells[3]) cells[3].querySelector('div').textContent = r.ncc || '—';
          if (cells[4]) cells[4].textContent = r.soHoaDon || '—';
          if (cells[5]) cells[5].textContent = r.soUNC || '—';
          if (cells[7]) cells[7].querySelector('div').textContent = r.dienGiai || '—';
        }
        dschExitEdit();
        renderDschView(_dschMap[id]);
        status.textContent = '';
      } else {
        status.textContent = 'Lỗi: ' + (data.error || 'Thử lại.');
      }
    })
    .catch(function() { btn.disabled = false; status.textContent = 'Lỗi kết nối.'; });
  }

  function closeDschModal() {
    document.getElementById('dschOverlay').classList.remove('open');
    _dschCurrentId = null;
  }

  function toggleDschHachToan(cb) {
    var id = _dschCurrentId;
    if (!id) return;
    var status = document.getElementById('dschHtStatus');
    status.textContent = 'Đang lưu...';
    var body = new URLSearchParams();
    body.append('daHachToan', cb.checked ? '1' : '0');
    fetch('/chi-phi/' + id + '/hach-toan', {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' },
      body: body.toString()
    })
    .then(function(r){ return r.json(); })
    .then(function(data) {
      if (data.success) {
        _dschMap[id].daHachToan = data.daHachToan;
        status.textContent = data.daHachToan ? '✓ Đã hạch toán' : '';
        var tr = document.getElementById('dsch-tr-' + id);
        if (tr) tr.style.background = data.daHachToan ? 'rgba(56,142,60,0.10)' : '';
      } else {
        status.textContent = 'Lỗi, thử lại.';
        cb.checked = !cb.checked;
      }
    })
    .catch(function() { status.textContent = 'Lỗi kết nối.'; cb.checked = !cb.checked; });
  }

  document.addEventListener('keydown', function(e){ if(e.key==='Escape') closeDschModal(); });
  </script>
  <%- include('partials/scroll-restore') %>
</body>
</html>

<!DOCTYPE html>
<html lang="vi">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/nav') %>
  <main class="container">
    <h1>Công Nợ Khách Hàng — <%= COMPANIES[activeCompany].label %></h1>
    <p class="muted" style="margin-top:-10px;margin-bottom:20px;">
      Các dòng đối soát <strong>chưa có hóa đơn</strong> hoặc <strong>còn lệch</strong> trên mọi kênh của
      <%= COMPANIES[activeCompany].label %> (Momo, Zalo/VNPay/Payoo, Viet QR), xếp theo số ngày kể từ ngày giao dịch.
      Đổi nút "<%= activeCompany === 'kh_cu' ? 'Mới' : 'Cũ' %>" ở góc trên bên trái để xem công ty kia.
    </p>

    <% if (error) { %><div class="alert alert-error" id="autohide-error"><%= error %></div><% } %>
    <% if (success) { %><div class="alert alert-success" id="successBanner"><%= success %></div><% } %>
    <script>
      (function () {
        ["successBanner", "autohide-error"].forEach(function (id) {
          var el = document.getElementById(id);
          if (!el) return;
          setTimeout(function () {
            el.style.transition = "opacity 0.6s ease, max-height 0.6s ease, margin 0.6s ease, padding 0.6s ease";
            el.style.opacity = "0";
            el.style.maxHeight = "0";
            el.style.overflow = "hidden";
            el.style.marginTop = "0";
            el.style.marginBottom = "0";
            el.style.paddingTop = "0";
            el.style.paddingBottom = "0";
          }, 3000);
        });
      })();
    </script>

    <section class="cards">
      <% aging.buckets.forEach(function(b) { %>
      <a href="/cong-no/khach-hang?bucket=<%= encodeURIComponent(b.bucket) %><%= aging.selectedChannel ? '&channel=' + encodeURIComponent(aging.selectedChannel) : '' %><%= selectedMonth ? '&month=' + encodeURIComponent(selectedMonth) : '' %>"
         class="card card-bucket <%= aging.selectedBucket === b.bucket ? 'card-bucket-active' : '' %>">
        <div class="card-label">Quá <%= b.bucket %> ngày</div>
        <div class="card-value"><%= b.total.toLocaleString('vi-VN') %> đ</div>
        <div class="muted"><%= b.count %> dòng</div>
      </a>
      <% }) %>
    </section>

    <section class="panel">
      <div class="panel-head">
        <h2>Chi tiết theo tài khoản ngân hàng (<%= aging.rows.length %> dòng, tổng <%= aging.grandTotal.toLocaleString('vi-VN') %> đ)</h2>
        <form method="GET" class="form-inline-tight">
          <select name="month" onchange="this.form.submit()">
            <option value="">Tất cả tháng</option>
            <% months.forEach(function(m) { %>
            <option value="<%= m %>" <%= selectedMonth === m ? 'selected' : '' %>><%= m %></option>
            <% }) %>
          </select>
          <select name="channel" onchange="this.form.submit()">
            <option value="">Tất cả kênh</option>
            <% channelOptions.forEach(function(c) { %>
            <option value="<%= c.key %>" <%= aging.selectedChannel === c.key ? 'selected' : '' %>><%= c.label %></option>
            <% }) %>
          </select>
          <% if (aging.selectedBucket) { %>
          <input type="hidden" name="bucket" value="<%= aging.selectedBucket %>" />
          <span class="badge badge-warn">Lọc: quá <%= aging.selectedBucket %> ngày <a href="/cong-no/khach-hang?<%= selectedMonth ? 'month=' + encodeURIComponent(selectedMonth) + '&' : '' %><%= aging.selectedChannel ? 'channel=' + encodeURIComponent(aging.selectedChannel) : '' %>" style="color:inherit;margin-left:6px;">✕</a></span>
          <% } %>
        </form>
      </div>
      <p class="muted" style="margin-top:-8px;">
        Bấm vào 1 tài khoản để xem/ẩn ngay tại chỗ các dòng chưa khớp của tài khoản đó — không tải lại trang. Nút
        "Xuất Hóa Đơn Bán Ra" mở đúng trang xuất hóa đơn, nhớ đổi nút "Cũ/Mới" ở góc trên bên trái đúng công ty của
        tài khoản đó trước khi xuất.
        <a href="/cong-no/khach-hang/export.xlsx?<%= selectedMonth ? 'month=' + encodeURIComponent(selectedMonth) + '&' : '' %><%= aging.selectedChannel ? 'channel=' + encodeURIComponent(aging.selectedChannel) + '&' : '' %><%= aging.selectedBucket ? 'bucket=' + encodeURIComponent(aging.selectedBucket) : '' %>" class="btn btn-secondary" style="margin-left:8px;">⬇ Xuất Excel theo đối tượng (gian) từng ngày</a>
      </p>
      <div class="bank-group-list">
        <% aging.byBank.forEach(function (b, idx) { %>
        <div class="bank-group <%= b.company %>">
          <div class="bank-group-head" onclick="toggleBankDetail('bank-detail-<%= idx %>')">
            <span class="bank-group-caret" id="bank-caret-<%= idx %>">▶</span>
            <span class="bank-group-name"><%= b.bankLabel %></span>
            <span class="bank-group-count muted"><%= b.count %> dòng chưa khớp</span>
            <span class="bank-group-total"><%= b.total.toLocaleString('vi-VN') %> đ</span>
            <a href="/bao-cao/xuat-hoa-don-ban-ra" class="btn btn-secondary" onclick="event.stopPropagation()">Xuất Hóa Đơn Bán Ra →</a>
          </div>
          <div class="bank-group-detail" id="bank-detail-<%= idx %>" style="display:none;">
            <table class="table" style="margin:0;">
              <thead>
                <tr>
                  <th>Kênh</th>
                  <th>Gian</th>
                  <th>Ngày</th>
                  <th>Số ngày</th>
                  <th>Trạng thái</th>
                  <th>Số tiền</th>
                  <th>HĐ liên quan</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                <% b.rows.forEach(function (r) { %>
                <tr>
                  <td><%= r.channelLabel %></td>
                  <td><%= r.gian %></td>
                  <td><%= r.settlementDate %></td>
                  <td class="num"><%= r.daysAged %></td>
                  <td><span class="badge <%= r.status === 'Lệch' ? 'badge-neg' : 'badge-warn' %>"><%= r.status %></span></td>
                  <td class="num"><%= r.amount.toLocaleString('vi-VN') %> đ</td>
                  <td><%= r.invoiceNumbers.length > 0 ? r.invoiceNumbers.join(', ') : '-' %></td>
                  <td><a href="<%= r.drillUrl %>" class="link-btn">Xem →</a></td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
        <% }) %>
        <% if (aging.byBank.length === 0) { %>
        <p class="muted">Không có dòng nào chưa khớp — mọi thứ đã đối soát xong.</p>
        <% } %>
      </div>
      <style>
        .bank-group-list { display: flex; flex-direction: column; gap: 10px; }
        .bank-group { border: 1px solid var(--color-hairline); border-radius: 12px; overflow: hidden; background: #fff; }
        .bank-group.kh_moi { border-left: 4px solid #7c5cff; }
        .bank-group.kh_cu { border-left: 4px solid #1aa3a3; }
        .bank-group-head {
          display: flex;
          align-items: center;
          gap: 14px;
          padding: 14px 16px;
          cursor: pointer;
          transition: background 0.15s ease;
        }
        .bank-group-head:hover { background: var(--color-fog); }
        .bank-group-caret { font-size: 12px; color: var(--color-graphite); width: 12px; }
        .bank-group-name { font-weight: 700; font-size: 15px; min-width: 160px; }
        .bank-group-count { font-size: 13px; }
        .bank-group-total { font-weight: 700; font-size: 15px; margin-left: auto; font-variant-numeric: tabular-nums; }
        .badge-co-cu { background: rgba(26, 163, 163, 0.12); color: #128080; }
        .badge-co-moi { background: rgba(124, 92, 255, 0.12); color: #6540e6; }
        .bank-group-detail { border-top: 1px solid var(--color-hairline); }
        .bank-group-detail .table { font-size: 13px; }
      </style>
      <script>
        function toggleBankDetail(id) {
          var row = document.getElementById(id);
          var caret = document.getElementById(id.replace('bank-detail-', 'bank-caret-'));
          if (!row) return;
          var isHidden = row.style.display === 'none' || !row.style.display;
          row.style.display = isHidden ? 'block' : 'none';
          if (caret) caret.textContent = isHidden ? '▼' : '▶';
        }
      </script>
    </section>

    <section class="panel">
      <div class="panel-head">
        <h2>Công nợ đã đối soát trước đây (nhập tay) — <%= manualEntries.length %> dòng, tổng <%= manualTotal.toLocaleString('vi-VN') %> đ</h2>
      </div>
      <p class="muted" style="margin-top:-8px;">
        Dùng cho công nợ chị đã tự đối soát xong từ trước và đã có sẵn số hóa đơn theo từng gian — ghi lại đây để tra cứu,
        KHÔNG cộng vào bảng "chưa khớp" phía trên (vì đã xong rồi).
      </p>
      <form method="POST" action="/cong-no/thu-cong" class="form-grid" style="margin-bottom:16px;">
        <div>
          <label>Gian</label>
          <input type="text" name="gian" required placeholder="vd AM TP PHCM" />
        </div>
        <div>
          <label>Ngày</label>
          <input type="date" name="date" required />
        </div>
        <div>
          <label>Số tiền</label>
          <input type="text" name="amount" required placeholder="vd 1500000" />
        </div>
        <div>
          <label>Số hóa đơn</label>
          <input type="text" name="invoiceNumbers" placeholder="vd 8274, 8416" />
        </div>
        <div class="form-actions">
          <button type="submit" class="btn btn-primary">Thêm</button>
        </div>
      </form>
      <div class="table-scroll">
        <table class="table">
          <thead>
            <tr>
              <th>Gian</th>
              <th>Ngày</th>
              <th class="num">Số tiền</th>
              <th>Số hóa đơn</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% manualEntries.forEach(function(m) { %>
            <tr>
              <td><%= m.gian %></td>
              <td><%= m.date %></td>
              <td class="num"><%= m.amount.toLocaleString('vi-VN') %> đ</td>
              <td><%= m.invoiceNumbers || '-' %></td>
              <td>
                <form method="POST" action="/cong-no/thu-cong/<%= m.id %>/delete" style="display:inline" onsubmit="return confirm('Xóa dòng công nợ này?')">
                  <button type="submit" class="link-btn link-danger">Xóa</button>
                </form>
              </td>
            </tr>
            <% }) %>
            <% if (manualEntries.length === 0) { %>
            <tr><td colspan="5" class="muted">Chưa có công nợ nào nhập tay.</td></tr>
            <% } %>
          </tbody>
          <% if (manualEntries.length > 0) { %>
          <tfoot>
            <tr><td colspan="2">Tổng</td><td class="num"><%= manualTotal.toLocaleString('vi-VN') %> đ</td><td colspan="2"></td></tr>
          </tfoot>
          <% } %>
        </table>
      </div>
    </section>

    <section class="panel">
      <div class="panel-head">
        <h2>Đối soát MISA (công nợ 131) vs Ngân hàng</h2>
      </div>
      <p class="muted" style="margin-top:-8px;">
        Tải file MISA "Sổ chi tiết công nợ phải thu theo công trình" (TK 131). File có thể gồm rất nhiều công trình
        toàn công ty — chị chỉ cần chọn công trình MISA tương ứng cho từng <strong>gian</strong> app đang theo dõi
        (tên gọi 2 bên khác nhau nên cần chọn tay 1 lần, lần tải file MISA sau không cần chọn lại).
      </p>
      <form method="POST" action="/cong-no/upload-misa" enctype="multipart/form-data" class="form-inline" style="margin-bottom:16px;">
        <input type="file" name="file" accept=".xlsx,.xls" required />
        <button type="submit" class="btn btn-primary">Tải file MISA</button>
      </form>
      <% if (misaInfo) { %>
      <p class="muted" style="margin-top:-8px;">
        Đã tải: <strong><%= misaInfo.fileName %></strong> lúc <%= new Date(misaInfo.uploadedAt).toLocaleString('vi-VN') %>
        — <%= misaInfo.order.length %> công trình.
      </p>
      <% } else { %>
      <p class="muted" style="margin-top:-8px;">Chưa tải file MISA nào.</p>
      <% } %>

      <form method="POST" action="/cong-no/misa-mapping">
        <div class="table-scroll">
          <table class="table">
            <thead>
              <tr>
                <th>Gian (app)</th>
                <th class="num">Chưa thu (Ngân hàng)</th>
                <th>Công trình MISA tương ứng</th>
                <th class="num">Dư nợ MISA</th>
                <th class="num">Chênh lệch</th>
                <th>Trạng thái</th>
              </tr>
            </thead>
            <tbody>
              <% misaComparison.forEach(function(row) { %>
              <tr>
                <td>
                  <%= row.gian %>
                  <input type="hidden" name="gian" value="<%= row.gian %>" />
                </td>
                <td class="num"><%= row.chuaThu.toLocaleString('vi-VN') %> đ</td>
                <td>
                  <select name="congtrinh">
                    <option value="">-- chọn công trình --</option>
                    <% misaCongTrinhOptions.forEach(function(ct) { %>
                    <option value="<%= ct %>" <%= row.mappedCongTrinh === ct ? 'selected' : '' %>><%= ct %></option>
                    <% }) %>
                  </select>
                </td>
                <td class="num"><%= row.soDuMisa === null ? '-' : row.soDuMisa.toLocaleString('vi-VN') + ' đ' %></td>
                <td class="num"><%= row.chenhLech === null ? '-' : row.chenhLech.toLocaleString('vi-VN') + ' đ' %></td>
                <td>
                  <span class="badge <%= row.trangThai === 'Khớp' ? 'badge-thu' : (row.trangThai === 'Lệch' ? 'badge-neg' : 'badge-warn') %>">
                    <%= row.trangThai %>
                  </span>
                </td>
              </tr>
              <% }) %>
              <% if (misaComparison.length === 0) { %>
              <tr><td colspan="6" class="muted">Chưa có dữ liệu để đối soát.</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
        <button type="submit" class="btn btn-secondary" style="margin-top:10px;">Lưu ánh xạ Gian ↔ Công trình MISA</button>
      </form>
    </section>
  </main>
</body>
</html>

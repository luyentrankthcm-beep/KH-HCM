<!DOCTYPE html>
<html lang="vi">
<head>
  <%- include('partials/head') %>
  <title>Hồ Sơ Hóa Đơn NCC – K&H</title>
  <style>
    .hoso-wrap { overflow-x:auto; }
    .hoso-table { width:100%; border-collapse:collapse; font-size:.88em; }
    .hoso-table th {
      background:#1e3a5f; color:#fff; padding:.5rem .75rem;
      text-align:left; white-space:nowrap;
      position:sticky; top:56px; z-index:10;
    }
    .hoso-table td { padding:.45rem .75rem; border-bottom:1px solid #eee; vertical-align:top; }
    /* NCC group header row */
    .ncc-group-row td {
      background:#1d4ed8 !important;
      color:#fff;
      font-weight:700;
      cursor:pointer;
      user-select:none;
      border-top:3px solid #1e3a5f;
    }
    .ncc-group-row:hover td { background:#1e40af !important; }
    .ncc-full { font-weight:normal; font-size:.82em; opacity:.85; margin-left:.5rem; }
    .ncc-count { font-size:.8em; font-weight:600; opacity:.75; white-space:nowrap; }
    .ncc-arrow { font-size:.8em; margin-right:.4rem; transition:transform .2s; display:inline-block; }
    .ncc-group-row.open .ncc-arrow { transform:rotate(90deg); }
    /* Invoice rows */
    .inv-row { display:none; }
    .inv-row.visible { display:table-row; }
    .inv-row:nth-child(odd) td { background:#f5f8ff; }
    .inv-row:nth-child(even) td { background:#eef3ff; }
    .inv-row:hover td { background:#dceeff !important; }
    .tien { font-weight:600; color:#15803d; white-space:nowrap; }
    .link-hd { color:#2563eb; text-decoration:none; display:inline-flex; align-items:center; gap:.3rem; }
    .link-hd:hover { text-decoration:underline; }
    .btn-edit { background:none; border:1px solid #cbd5e1; border-radius:4px; padding:.15rem .45rem; cursor:pointer; font-size:.8em; color:#555; }
    .btn-edit:hover { background:#f1f5f9; }
    .tag-so { background:#e0f2fe; color:#0369a1; border-radius:4px; padding:.05rem .35rem; font-size:.82em; font-weight:600; }
    .edit-modal { display:none; position:fixed; inset:0; background:rgba(0,0,0,.45); z-index:999; align-items:center; justify-content:center; }
    .edit-modal.open { display:flex; }
    .edit-box { background:#fff; border-radius:10px; padding:1.5rem; width:min(520px,95vw); box-shadow:0 8px 32px rgba(0,0,0,.2); }
    .edit-box h3 { margin:0 0 1rem; font-size:1rem; color:#1e3a5f; }
    .edit-box label { display:block; font-size:.85em; font-weight:600; margin:.6rem 0 .2rem; color:#444; }
    .edit-box input, .edit-box textarea { width:100%; box-sizing:border-box; border:1px solid #cbd5e1; border-radius:5px; padding:.4rem .6rem; font-size:.9em; }
    .edit-box textarea { resize:vertical; min-height:60px; }
    .edit-actions { display:flex; gap:.5rem; justify-content:flex-end; margin-top:1rem; }
    .btn-save { background:#2563eb; color:#fff; border:none; border-radius:5px; padding:.4rem 1rem; cursor:pointer; font-weight:600; }
    .btn-cancel { background:#f1f5f9; border:1px solid #cbd5e1; border-radius:5px; padding:.4rem 1rem; cursor:pointer; }
  </style>
</head>
<body>
  <%- include('partials/nav') %>
  <main class="container">
    <h1 class="page-title">Hồ Sơ Hóa Đơn NCC</h1>

    <% if (typeof error !== 'undefined' && error) { %><div class="alert-error"><%= error %></div><% } %>
    <% if (typeof success !== 'undefined' && success) { %><div class="alert-success"><%= success %></div><% } %>

    <div style="display:flex;gap:.75rem;align-items:center;margin-bottom:1rem;flex-wrap:wrap;">
      <form method="GET" action="/ho-so/hoa-don-ncc" style="display:flex;gap:.5rem;align-items:center;">
        <label style="font-weight:600;white-space:nowrap;">Tháng:</label>
        <select name="thang" onchange="this.form.submit()" style="padding:.3rem .6rem;border-radius:4px;border:1px solid #ccc;min-width:120px;">
          <option value="">-- Tất cả --</option>
          <% (allThang||[]).forEach(function(t){ %>
          <option value="<%= t %>" <%= thangFilter===t?'selected':'' %>><%= t %></option>
          <% }); %>
        </select>
      </form>
      <span style="color:#666;font-size:.9em;"><strong><%= total %></strong> hóa đơn · <strong><%= groups.length %></strong> NCC</span>
      <button onclick="toggleAll(true)" style="font-size:.82em;padding:.25rem .6rem;border:1px solid #cbd5e1;border-radius:4px;cursor:pointer;background:#f8fafc;">Mở tất cả</button>
      <button onclick="toggleAll(false)" style="font-size:.82em;padding:.25rem .6rem;border:1px solid #cbd5e1;border-radius:4px;cursor:pointer;background:#f8fafc;">Thu tất cả</button>
    </div>

    <% if (groups.length === 0) { %>
    <p style="color:#888;">Chưa có dữ liệu hóa đơn.</p>
    <% } else { %>
    <div class="hoso-wrap">
      <table class="hoso-table">
        <thead>
          <tr>
            <th style="width:36px;">#</th>
            <th style="width:170px;">Số HĐ · Ngày</th>
            <th>Tổng tiền TT</th>
            <th>Nội dung tóm tắt</th>
            <th>Hồ sơ liên quan</th>
            <th>Link HĐ</th>
            <th style="width:36px;"></th>
          </tr>
        </thead>
        <tbody>
          <% var _invNum = 0; groups.forEach(function(g, gi) {
            var gid = 'g' + gi;
          %>
          <!-- NCC group header -->
          <tr class="ncc-group-row" onclick="toggleGroup('<%= gid %>', this)">
            <td colspan="2">
              <span class="ncc-arrow">▶</span>
              <strong><%= g.nccShort %></strong>
              <% if (g.tenDayDuNCC) { %><span class="ncc-full">— <%= g.tenDayDuNCC %></span><% } %>
            </td>
            <td class="ncc-count"><%= g.invoices.length %> hóa đơn</td>
            <td colspan="4"></td>
          </tr>
          <!-- Invoice rows (hidden by default) -->
          <% g.invoices.forEach(function(r) { _invNum++; %>
          <tr class="inv-row" data-group="<%= gid %>">
            <td style="color:#bbb;font-size:.78em;padding-left:1.5rem;"><%= _invNum %></td>
            <td>
              <span class="tag-so"><%= r.soHoaDon %></span>
              <span style="color:#888;font-size:.8em;margin-left:.3rem;white-space:nowrap;"><%= r.ngay ? r.ngay.split('-').reverse().join('/') : '' %></span>
            </td>
            <td class="<%= r.tongTien ? 'tien' : '' %>" style="<%= (!r.tongTien) ? 'color:#bbb;' : '' %>"><%= r.tongTien || '—' %></td>
            <td style="max-width:240px;"><%= r.noiDung || '<span style="color:#bbb;">—</span>' %></td>
            <td style="color:#bbb;font-style:italic;">—</td>
            <td>
              <% if (r.driveLink) { %>
              <a href="<%= r.driveLink %>" target="_blank" rel="noopener" class="link-hd">📄 Mở</a>
              <% } else { %><span style="color:#bbb;">—</span><% } %>
            </td>
            <td><button class="btn-edit" onclick="event.stopPropagation();openEdit('<%= r.driveId %>','<%= encodeURIComponent(r.nccShort) %>','<%= encodeURIComponent(r.tenDayDuNCC||'') %>','<%= encodeURIComponent(r.tongTien||'') %>','<%= encodeURIComponent(r.noiDung||'') %>','<%= encodeURIComponent(r.hoSoLienQuan||'') %>')">✏️</button></td>
          </tr>
          <% }); %>
          <% }); %>
        </tbody>
      </table>
    </div>
    <% } %>
  </main>

  <!-- Edit modal -->
  <div class="edit-modal" id="editModal">
    <div class="edit-box">
      <h3 id="editTitle">Chỉnh sửa hóa đơn</h3>
      <form method="POST" id="editForm">
        <input type="hidden" name="thang" value="<%= thangFilter %>" />
        <label>Tên đầy đủ NCC</label>
        <input type="text" name="tenDayDuNCC" id="eNcc" placeholder="VD: CÔNG TY TNHH AEON VIỆT NAM" />
        <label>Tổng tiền thanh toán</label>
        <input type="text" name="tongTien" id="eTien" placeholder="VD: 12.500.000" />
        <label>Nội dung tóm tắt</label>
        <textarea name="noiDung" id="eNoiDung" placeholder="VD: Tiền điện tháng 8/2026"></textarea>
        <label>Hồ sơ liên quan</label>
        <input type="text" name="hoSoLienQuan" id="eHoSo" placeholder="VD: HĐ số 123, phụ lục..." />
        <div class="edit-actions">
          <button type="button" class="btn-cancel" onclick="closeEdit()">Hủy</button>
          <button type="submit" class="btn-save">Lưu</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    function toggleGroup(gid, headerRow) {
      var rows = document.querySelectorAll('.inv-row[data-group="' + gid + '"]');
      var isOpen = headerRow.classList.toggle('open');
      rows.forEach(function(r) {
        r.classList.toggle('visible', isOpen);
      });
    }
    function toggleAll(open) {
      document.querySelectorAll('.ncc-group-row').forEach(function(hdr) {
        var gid = hdr.nextElementSibling && hdr.nextElementSibling.dataset.group;
        if (!gid) return;
        if (open) hdr.classList.add('open'); else hdr.classList.remove('open');
        document.querySelectorAll('.inv-row[data-group="' + gid + '"]').forEach(function(r) {
          r.classList.toggle('visible', open);
        });
      });
    }
    function openEdit(driveId, ncc, tenDayDu, tien, noiDung, hoSo) {
      document.getElementById('editTitle').textContent = 'Sửa: ' + decodeURIComponent(ncc);
      document.getElementById('editForm').action = '/ho-so/hoa-don-ncc/' + driveId + '/sua';
      document.getElementById('eNcc').value = decodeURIComponent(tenDayDu);
      document.getElementById('eTien').value = decodeURIComponent(tien);
      document.getElementById('eNoiDung').value = decodeURIComponent(noiDung);
      document.getElementById('eHoSo').value = decodeURIComponent(hoSo);
      document.getElementById('editModal').classList.add('open');
      document.body.style.overflow = 'hidden';
    }
    function closeEdit() {
      document.getElementById('editModal').classList.remove('open');
      document.body.style.overflow = '';
    }
    document.getElementById('editModal').addEventListener('click', function(e) {
      if (e.target === this) closeEdit();
    });
  </script>
</body>
</html>

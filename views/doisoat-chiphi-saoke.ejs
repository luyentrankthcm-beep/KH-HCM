<!DOCTYPE html>
<html lang="vi">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/nav') %>
  <main class="container">
    <h1>Đối chiếu Chi từ Sao kê — <%= COMPANIES[activeCompany].label %></h1>
    <p class="muted" style="margin-top:-10px;margin-bottom:20px;">
      Tất cả giao dịch <strong>Chi</strong> từ sao kê ngân hàng trực tiếp (<%= chiBankNames.join(', ') %>),
      đối chiếu với danh sách Chi phí đã nhập để lấy Số hóa đơn, Gian và NCC.
      Khớp <strong>chính xác</strong> nếu giao dịch có bankTxId; <strong>tương đối</strong> nếu khớp số tiền ±1.000đ và ngày ±7 ngày.
    </p>

    <% if (successMsg) { %>
    <div class="alert alert-success" id="successBanner"><%= successMsg %></div>
    <% } %>
    <% if (errorMsg) { %>
    <div class="alert alert-error" id="autohide-error"><%= errorMsg %></div>
    <% } %>

    <script>
      (function () {
        ["successBanner", "autohide-error"].forEach(function (id) {
          var el = document.getElementById(id);
          if (!el) return;
          setTimeout(function () {
            el.style.transition = "opacity 0.6s ease, max-height 0.6s ease, margin 0.6s ease, padding 0.6s ease";
            el.style.opacity = "0"; el.style.maxHeight = "0"; el.style.overflow = "hidden";
            el.style.marginTop = "0"; el.style.marginBottom = "0";
            el.style.paddingTop = "0"; el.style.paddingBottom = "0";
          }, 4000);
        });
      })();
    </script>

    <!-- Bộ lọc -->
    <section class="panel" style="margin-bottom:18px;">
      <form method="GET" action="/doi-soat/chi-phi-saoke" style="display:flex;flex-wrap:wrap;gap:12px;align-items:flex-end;">
        <label style="display:flex;flex-direction:column;gap:4px;font-size:13px;">
          Tháng
          <select name="thang" onchange="this.form.submit()" style="min-width:120px;">
            <option value="">Tất cả</option>
            <% months.forEach(function(m) { %>
            <option value="<%= m %>" <%= selectedMonth === m ? 'selected' : '' %>><%= m %></option>
            <% }) %>
          </select>
        </label>
        <label style="display:flex;flex-direction:column;gap:4px;font-size:13px;">
          Ngân hàng
          <select name="nganHang" onchange="this.form.submit()" style="min-width:150px;">
            <option value="">Tất cả (<%= chiBankNames.join(' + ') %>)</option>
            <% chiBankNames.forEach(function(b) { %>
            <option value="<%= b %>" <%= selectedBankName === b ? 'selected' : '' %>><%= b %></option>
            <% }) %>
          </select>
        </label>
        <label style="display:flex;flex-direction:column;gap:4px;font-size:13px;">
          Loại GD
          <select name="loai" onchange="this.form.submit()" style="min-width:120px;">
            <option value="chi" <%= selectedLoai === 'chi' ? 'selected' : '' %>>Chỉ Chi ↓</option>
            <option value="thu" <%= selectedLoai === 'thu' ? 'selected' : '' %>>Chỉ Thu ↑</option>
            <option value="tat-ca" <%= selectedLoai === 'tat-ca' ? 'selected' : '' %>>Tất cả (Thu + Chi)</option>
          </select>
        </label>
      </form>
    </section>

    <!-- Tổng kết -->
    <div style="display:flex;gap:16px;flex-wrap:wrap;margin-bottom:12px;">
      <% if (selectedLoai !== 'thu') { %>
      <div class="stat-card" style="flex:1;min-width:130px;">
        <div class="stat-label">Giao dịch Chi</div>
        <div class="stat-value"><%= rows.filter(function(r){return r.txType==='chi';}).length.toLocaleString('vi-VN') %></div>
      </div>
      <div class="stat-card" style="flex:1;min-width:130px;">
        <div class="stat-label">Tổng tiền Chi ↓</div>
        <div class="stat-value"><%= chiTotal.toLocaleString('vi-VN') %>đ</div>
      </div>
      <% } %>
      <% if (selectedLoai !== 'chi') { %>
      <div class="stat-card" style="flex:1;min-width:130px;border-color:var(--color-info,#1976d2);">
        <div class="stat-label">Giao dịch Thu</div>
        <div class="stat-value" style="color:var(--color-info,#1976d2);"><%= rows.filter(function(r){return r.txType==='thu';}).length.toLocaleString('vi-VN') %></div>
      </div>
      <div class="stat-card" style="flex:1;min-width:130px;border-color:var(--color-info,#1976d2);">
        <div class="stat-label">Tổng tiền Thu ↑</div>
        <div class="stat-value" style="color:var(--color-info,#1976d2);"><%= thuTotal.toLocaleString('vi-VN') %>đ</div>
      </div>
      <% } %>
      <% if (selectedLoai !== 'thu') { %>
      <div class="stat-card" style="flex:1;min-width:130px;border-color:var(--color-success, #2d9e5f);">
        <div class="stat-label">Đã khớp Chi phí</div>
        <div class="stat-value" style="color:var(--color-success,#2d9e5f);"><%= matchedCount %> / <%= totalRows %></div>
      </div>
      <% } %>
    </div>

    <!-- Widget số dư cuối kỳ -->
    <% if (selectedMonth) { %>
    <div style="display:flex;gap:12px;flex-wrap:wrap;align-items:stretch;margin-bottom:18px;">
      <div class="stat-card" style="flex:1;min-width:150px;">
        <div class="stat-label">Đầu kỳ (tính ngược)</div>
        <div class="stat-value" style="font-size:16px;">
          <% if (sodudauky !== null) { %>
            <span style="color:<%= sodudauky < 0 ? 'var(--color-error,#c0392b)' : 'inherit' %>;">
              <%= sodudauky.toLocaleString('vi-VN') %>đ
            </span>
          <% } else { %><span class="muted" style="font-size:13px;">— (chưa nhập cuối kỳ)</span><% } %>
        </div>
        <div class="stat-label" style="margin-top:4px;">= Cuối kỳ − Thu + Chi</div>
      </div>
      <div class="stat-card" style="flex:1;min-width:100px;opacity:0.7;">
        <div class="stat-label">+ Thu (tất cả GD)</div>
        <div class="stat-value" style="font-size:16px;color:var(--color-info,#1976d2);">+<%= allThuTotal.toLocaleString('vi-VN') %>đ</div>
      </div>
      <div class="stat-card" style="flex:1;min-width:100px;opacity:0.7;">
        <div class="stat-label">− Chi (tất cả GD)</div>
        <div class="stat-value" style="font-size:16px;">−<%= allChiTotal.toLocaleString('vi-VN') %>đ</div>
      </div>
      <div class="stat-card" style="flex:2;min-width:200px;border-color:var(--color-info,#1976d2);background:rgba(25,118,210,0.04);">
        <div class="stat-label">Số dư cuối kỳ (từ ngân hàng)</div>
        <% if (soducucoiky !== null) { %>
          <div class="stat-value" style="font-size:18px;color:var(--color-info,#1976d2);"><%= soducucoiky.toLocaleString('vi-VN') %>đ</div>
        <% } else { %>
          <div class="stat-value" style="font-size:13px;color:var(--color-muted,#888);margin-bottom:6px;">Chưa nhập — nhập để tính đầu kỳ</div>
        <% } %>
        <form method="POST" action="/doi-soat/chi-phi-saoke/set-sodu-cuoiky" style="display:flex;gap:6px;margin-top:6px;align-items:center;">
          <input type="hidden" name="soduKey" value="<%= soduKey %>">
          <input type="number" name="soducucoiky" value="<%= soducucoiky !== null ? soducucoiky : '' %>" placeholder="Nhập số dư cuối kỳ..."
            style="flex:1;padding:5px 8px;border:1px solid var(--color-hairline,#ddd);border-radius:4px;font-size:13px;">
          <button type="submit" style="background:var(--color-info,#1976d2);color:#fff;border:none;border-radius:4px;padding:5px 10px;font-size:12px;cursor:pointer;white-space:nowrap;">Lưu</button>
          <% if (soducucoiky !== null) { %>
          <button type="submit" name="soducucoiky" value="" style="background:none;border:1px solid var(--color-hairline,#ddd);border-radius:4px;padding:5px 8px;font-size:11px;cursor:pointer;color:var(--color-muted,#888);">Xóa</button>
          <% } %>
        </form>
      </div>
    </div>
    <% } %>

    <!-- Nút xuất Excel + MISA -->
    <div style="margin-bottom:12px;text-align:right;display:flex;gap:8px;justify-content:flex-end;flex-wrap:wrap;">
      <a href="/doi-soat/chi-phi-saoke/export.xlsx?thang=<%= encodeURIComponent(selectedMonth) %>&nganHang=<%= encodeURIComponent(selectedBankName) %>&loai=<%= encodeURIComponent(selectedLoai) %>"
         style="display:inline-flex;align-items:center;gap:6px;background:var(--color-success,#2d9e5f);color:#fff;text-decoration:none;border-radius:6px;padding:7px 14px;font-size:13px;font-weight:600;">
        ⬇ Xuất Excel (<%= rows.length %> dòng)
      </a>
      <% if (selectedLoai !== 'thu') { %>
      <button onclick="openMisaModal()" style="display:inline-flex;align-items:center;gap:6px;background:#1565c0;color:#fff;border:none;cursor:pointer;border-radius:6px;padding:7px 14px;font-size:13px;font-weight:600;">
        📄 Xuất MISA (Phiếu chi)
      </button>
      <% } %>
    </div>

    <!-- Modal MISA: backdrop riêng + card riêng, đều position:fixed -->
    <div id="misaBackdrop" style="display:none;position:fixed;inset:0;z-index:9998;background:rgba(0,0,0,0.5);" onclick="closeMisaModal()"></div>
    <div id="misaCard" style="position:fixed;top:66px;left:50%;transform:translateX(-50%);width:96%;max-width:1260px;z-index:9999;background:#fff;border-radius:10px;box-shadow:0 8px 40px rgba(0,0,0,0.3);display:none;flex-direction:column;max-height:calc(100vh - 76px);overflow:hidden;">
      <!-- Header cố định -->
      <div style="flex-shrink:0;padding:12px 18px;border-bottom:1px solid #e0e0e0;border-radius:10px 10px 0 0;background:#fff;">
        <div style="display:flex;align-items:center;justify-content:space-between;gap:8px;flex-wrap:wrap;">
          <div style="font-size:15px;font-weight:700;">📄 Xuất MISA — Phiếu Chi Tiền Gửi</div>
          <button onclick="closeMisaModal()" style="background:#eee;color:#333;border:none;cursor:pointer;border-radius:6px;padding:5px 12px;font-size:13px;">✕ Đóng</button>
        </div>
        <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-top:8px;">
          <label style="font-size:13px;display:flex;align-items:center;gap:5px;">
            Từ ngày: <input id="misaFrom" type="date" style="font-size:12px;padding:3px 6px;border:1px solid #ccc;border-radius:4px;" onchange="loadMisaPreview()">
          </label>
          <label style="font-size:13px;display:flex;align-items:center;gap:5px;">
            Đến ngày: <input id="misaTo" type="date" style="font-size:12px;padding:3px 6px;border:1px solid #ccc;border-radius:4px;" onchange="loadMisaPreview()">
          </label>
          <label style="font-size:13px;display:flex;align-items:center;gap:5px;">
            Tiền tố: <input id="misaPrefix" value="UNC" style="width:55px;font-size:12px;padding:3px 6px;border:1px solid #ccc;border-radius:4px;">
          </label>
          <label style="font-size:13px;display:flex;align-items:center;gap:5px;">
            Số bắt đầu: <input id="misaStartNo" type="number" value="1" min="1" style="width:70px;font-size:12px;padding:3px 6px;border:1px solid #ccc;border-radius:4px;">
          </label>
          <button id="misaExportBtn" onclick="exportMisa()" style="background:#1565c0;color:#fff;border:none;cursor:pointer;border-radius:6px;padding:6px 14px;font-size:13px;font-weight:600;">⬇ Tải MISA.xlsx</button>
          <span id="misaCount" style="font-size:12px;color:#888;"></span>
        </div>
      </div>
      <!-- Body cuộn -->
      <div style="flex:1;min-height:0;overflow:auto;padding:0 4px 12px;">
        <p id="misaLoading" style="text-align:center;color:#888;padding:20px;">Đang tải dữ liệu...</p>
        <table id="misaTable" style="display:none;width:100%;border-collapse:collapse;font-size:12px;">
          <thead>
            <tr style="background:#f0f4ff;position:sticky;top:0;z-index:2;">
              <th style="padding:6px 6px;text-align:center;border:1px solid #ddd;">#</th>
              <th style="padding:6px 6px;border:1px solid #ddd;white-space:nowrap;">Ngày CT</th>
              <th style="padding:6px 6px;border:1px solid #ddd;white-space:nowrap;">Số CT</th>
              <th style="padding:6px 6px;border:1px solid #ddd;min-width:180px;">Diễn giải</th>
              <th style="padding:6px 6px;border:1px solid #ddd;min-width:140px;">Tên đối ứng</th>
              <th style="padding:6px 6px;border:1px solid #ddd;min-width:140px;">NCC</th>
              <th style="padding:6px 6px;border:1px solid #ddd;min-width:100px;">Mã NCC ✏️</th>
              <th style="padding:6px 6px;border:1px solid #ddd;min-width:70px;">Gian</th>
              <th style="padding:6px 6px;border:1px solid #ddd;min-width:80px;">TK Nợ ✏️</th>
              <th style="padding:6px 6px;border:1px solid #ddd;text-align:right;min-width:100px;">Số tiền</th>
              <th style="padding:6px 6px;border:1px solid #ddd;min-width:110px;">TK Chi</th>
            </tr>
          </thead>
          <tbody id="misaTbody"></tbody>
        </table>
      </div>
      <!-- Footer: nút xuất ở dưới -->
      <div id="misaFooter" style="flex-shrink:0;padding:10px 18px;border-top:1px solid #e0e0e0;background:#f8f9fa;border-radius:0 0 10px 10px;display:flex;align-items:center;justify-content:flex-end;gap:12px;">
        <span id="misaFooterCount" style="font-size:12px;color:#555;"></span>
        <button onclick="exportMisa()" style="background:#1565c0;color:#fff;border:none;cursor:pointer;border-radius:6px;padding:8px 20px;font-size:14px;font-weight:700;">⬇ Tải MISA.xlsx</button>
        <button onclick="closeMisaModal()" style="background:#eee;color:#333;border:none;cursor:pointer;border-radius:6px;padding:8px 14px;font-size:13px;">Đóng</button>
      </div>
    </div>

    <script>
    var _misaRows = [];
    var _misaThang = '<%= selectedMonth %>';
    var _misaNganHang = '<%= selectedBankName %>';

    function openMisaModal() {
      // Đặt khoảng ngày mặc định theo tháng đang lọc
      if (_misaThang) {
        var y = _misaThang.slice(0,4), m = _misaThang.slice(5,7);
        var last = new Date(+y, +m, 0).getDate();
        document.getElementById('misaFrom').value = y + '-' + m + '-01';
        document.getElementById('misaTo').value = y + '-' + m + '-' + String(last).padStart(2,'0');
      }
      document.getElementById('misaBackdrop').style.display = 'block';
      document.getElementById('misaCard').style.display = 'flex';
      loadMisaPreview();
    }
    function closeMisaModal() {
      document.getElementById('misaBackdrop').style.display = 'none';
      document.getElementById('misaCard').style.display = 'none';
    }

    async function loadMisaPreview() {
      document.getElementById('misaLoading').style.display = 'block';
      document.getElementById('misaTable').style.display = 'none';
      document.getElementById('misaCount').textContent = '';
      var from = document.getElementById('misaFrom').value;
      var to = document.getElementById('misaTo').value;
      var url = '/doi-soat/chi-phi-saoke/preview-misa?thang=' + encodeURIComponent(_misaThang)
              + '&nganHang=' + encodeURIComponent(_misaNganHang)
              + '&from=' + encodeURIComponent(from)
              + '&to=' + encodeURIComponent(to);
      try {
        var r = await fetch(url);
        var j = await r.json();
        if (!j.ok) { document.getElementById('misaLoading').textContent = 'Lỗi: ' + (j.message||''); return; }
        _misaRows = j.rows;
        renderMisaTable();
      } catch(e) {
        document.getElementById('misaLoading').textContent = 'Lỗi kết nối: ' + e.message;
      }
    }

    function renderMisaTable() {
      document.getElementById('misaLoading').style.display = 'none';
      var tbody = document.getElementById('misaTbody');
      tbody.innerHTML = '';
      var start = parseInt(document.getElementById('misaStartNo').value) || 1;
      var prefix = document.getElementById('misaPrefix').value || 'UNC';
      _misaRows.forEach(function(r, i) {
        var soCt = prefix + String(start + i).padStart(4, '0');
        var amtFmt = r.amount ? r.amount.toLocaleString('vi-VN') + ' đ' : '';
        var tkOpts = ['331','1388','1121'].map(function(v) {
          return '<option value="' + v + '"' + (String(r.tk) === v ? ' selected' : '') + '>' + v + '</option>';
        }).join('');
        var matchBg = r.matchType === 'exact' ? '#f0fff4' : r.matchType === 'fuzzy' ? '#fffbf0' : '#fff';
        var tr = document.createElement('tr');
        tr.style.background = matchBg;
        tr.innerHTML =
          '<td style="padding:4px 6px;border:1px solid #ddd;text-align:center;">' + (i+1) + '</td>' +
          '<td style="padding:4px 6px;border:1px solid #ddd;white-space:nowrap;">' + r.date + '</td>' +
          '<td style="padding:4px 6px;border:1px solid #ddd;white-space:nowrap;">' + soCt + '</td>' +
          '<td style="padding:4px 6px;border:1px solid #ddd;max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="' + (r.description||'').replace(/"/g,'&quot;') + '">' + (r.description||'') + '</td>' +
          '<td style="padding:4px 6px;border:1px solid #ddd;font-size:11px;max-width:150px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">' + (r.tenDoiUng||'—') + '</td>' +
          '<td style="padding:4px 6px;border:1px solid #ddd;font-size:11px;max-width:150px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">' + (r.ncc||'—') + '</td>' +
          '<td style="padding:4px 6px;border:1px solid #ddd;"><input data-idx="' + i + '" data-field="maNCC" value="' + (r.maNCC||'') + '" placeholder="Mã NCC" style="width:95px;font-size:11px;border:1px solid #ccc;border-radius:3px;padding:2px 4px;" oninput="updateMisaRow(this)"></td>' +
          '<td style="padding:4px 6px;border:1px solid #ddd;font-size:11px;white-space:nowrap;">' + (r.gian||'—') + '</td>' +
          '<td style="padding:4px 6px;border:1px solid #ddd;"><select data-idx="' + i + '" data-field="tk" onchange="updateMisaRow(this)" style="font-size:11px;">' + tkOpts + '</select></td>' +
          '<td style="padding:4px 6px;border:1px solid #ddd;text-align:right;white-space:nowrap;">' + amtFmt + '</td>' +
          '<td style="padding:4px 6px;border:1px solid #ddd;font-size:11px;white-space:nowrap;">' + (r.bankAccount||'') + '</td>';
        tbody.appendChild(tr);
      });
      document.getElementById('misaTable').style.display = '';
      var countTxt = _misaRows.length + ' dòng';
      document.getElementById('misaCount').textContent = countTxt;
      document.getElementById('misaFooterCount').textContent = countTxt;
    }

    function updateMisaRow(el) {
      _misaRows[parseInt(el.dataset.idx)][el.dataset.field] = el.value;
    }

    document.getElementById('misaPrefix').addEventListener('input', renderMisaTable);
    document.getElementById('misaStartNo').addEventListener('input', renderMisaTable);

    async function exportMisa() {
      if (!_misaRows.length) { alert('Chưa có dữ liệu.'); return; }
      var btn = document.getElementById('misaExportBtn');
      btn.textContent = 'Đang xuất...'; btn.disabled = true;
      var fd = new FormData();
      fd.append('rows', JSON.stringify(_misaRows));
      fd.append('startNo', document.getElementById('misaStartNo').value || '1');
      fd.append('prefix', document.getElementById('misaPrefix').value || 'UNC');
      try {
        var r = await fetch('/doi-soat/chi-phi-saoke/export-misa', { method:'POST', body:fd });
        if (!r.ok) { alert('Lỗi xuất file.'); } else {
          var blob = await r.blob();
          var a = document.createElement('a');
          a.href = URL.createObjectURL(blob);
          var from = document.getElementById('misaFrom').value || '';
          var to = document.getElementById('misaTo').value || '';
          a.download = 'MISA-phieu-chi' + (from ? '-' + from : '') + (to && to !== from ? '_' + to : '') + '.xlsx';
          a.click();
        }
      } catch(e) { alert('Lỗi: ' + e.message); }
      btn.textContent = '⬇ Tải MISA.xlsx'; btn.disabled = false;
    }
    </script>

    <!-- Bảng chi tiết -->
    <section class="panel">
      <% if (rows.length === 0) { %>
      <p class="muted">Không có giao dịch Chi nào<% if (selectedMonth) { %> trong tháng <%= selectedMonth %><% } %>
        <% if (selectedBankName) { %> (ngân hàng <%= selectedBankName %>)<% } %>.
        <br>Kiểm tra lại: tài khoản ngân hàng đã được tạo với tên đúng (<%= chiBankNames.join(', ') %>)?
      </p>
      <% } else { %>
      <div style="overflow-x:auto;">
        <table class="data-table" style="font-size:13px;">
          <thead>
            <tr>
              <th style="min-width:94px;">Ngày</th>
              <th>NH / Loại</th>
              <th>Tên đối tác (sao kê)</th>
              <th>Diễn giải</th>
              <th style="text-align:right;color:var(--color-success,#2d9e5f);white-space:nowrap;">Thu ↑</th>
              <th style="text-align:right;white-space:nowrap;">Chi ↓</th>
              <th style="text-align:right;white-space:nowrap;color:var(--color-info,#1976d2);">Số dư</th>
              <th>Số HĐ</th>
              <th>Gian</th>
              <th>NCC</th>
              <th>TK</th>
              <th>Khớp</th>
            </tr>
          </thead>
          <tbody>
            <% rows.forEach(function(r) { %>
            <%
              var txKey = r.id != null ? String(r.id) : null;
              var rowBal = txKey && balanceByTxId[txKey] !== undefined ? balanceByTxId[txKey] : null;
            %>
            <tr class="<%= r.txType === 'thu' ? 'row-thu' : r.matchType === 'exact' ? 'row-matched-exact' : r.matchType === 'fuzzy' ? 'row-matched-fuzzy' : 'row-unmatched' %>">
              <td style="white-space:nowrap;">
                <span class="date-cell"><%= r.date %></span>
              </td>
              <td style="white-space:nowrap;">
                <span class="badge badge-neutral" style="font-size:11px;"><%= r.bankLabel || r.bankName %></span>
              </td>
              <td style="max-width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="<%= r.tenDoiUng %>"><%= r.tenDoiUng || '—' %></td>
              <td style="max-width:220px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="<%= r.description %>"><%= r.description || '—' %></td>
              <!-- Thu -->
              <td style="text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap;">
                <% if (r.txType === 'thu') { %>
                  <span style="color:var(--color-success,#2d9e5f);font-weight:600;">+<%= r.amount.toLocaleString('vi-VN') %>đ</span>
                <% } else { %>
                  <span class="muted">—</span>
                <% } %>
              </td>
              <!-- Chi -->
              <td style="text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap;">
                <% if (r.txType === 'chi') { %>
                  <span style="color:var(--color-error,#c0392b);">−<%= r.amount.toLocaleString('vi-VN') %>đ</span>
                <% } else { %>
                  <span class="muted">—</span>
                <% } %>
              </td>
              <!-- Số dư -->
              <td style="text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap;">
                <% if (rowBal !== null) { %>
                  <span style="color:var(--color-info,#1976d2);font-weight:600;"><%= rowBal.toLocaleString('vi-VN') %>đ</span>
                <% } else { %>
                  <span class="muted" style="font-size:11px;">—</span>
                <% } %>
              </td>
              <td><%= r.soHoaDon || '' %></td>
              <td style="max-width:160px;white-space:nowrap;" title="<%= r.gian || r.suggestedGian %>">
                <% if (r.gian) { %>
                  <span style="overflow:hidden;text-overflow:ellipsis;display:inline-block;max-width:120px;vertical-align:middle;" title="<%= r.gian %>"><%= r.gian %></span>
                  <% if (r.hasOvr) { %><span title="Gán tay trên saoke" style="font-size:10px;color:var(--color-muted,#aaa);margin-left:2px;">✏️</span><% } %>
                <% } else if (r.suggestedGian) { %>
                  <span style="color:var(--color-muted,#888);font-size:11px;font-style:italic;" title="Gợi ý từ NCC">≈ <%= r.suggestedGian %></span>
                  <form method="POST" action="/doi-soat/chi-phi-saoke/set-gian-banktx" style="display:inline-block;margin-left:3px;">
                    <input type="hidden" name="bankTxId" value="<%= r.id %>">
                    <input type="hidden" name="gian" value="<%= r.suggestedGian %>">
                    <input type="hidden" name="tk" value="<%= r.suggestedTk %>">
                    <button type="submit" title="Xác nhận gán gian này" style="background:var(--color-success,#2d9e5f);color:#fff;border:none;border-radius:3px;padding:1px 5px;font-size:11px;cursor:pointer;">✓</button>
                  </form>
                <% } else { %>
                  <span class="muted" style="font-size:11px;">—</span>
                <% } %>
              </td>
              <td style="max-width:130px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="<%= r.ncc %>"><%= r.ncc || '' %></td>
              <td style="text-align:center;white-space:nowrap;">
                <% if (r.tk === '1388') { %>
                  <span class="badge badge-success" style="font-size:11px;" title="Doanh thu chia sẻ — TK Có 1388">TK Có 1388</span>
                <% } else if (r.tk === '331') { %>
                  <span class="badge badge-neutral" style="font-size:11px;" title="Tiền thuê — TK Nợ 331">TK Nợ 331</span>
                <% } else { %>
                  <span class="muted" style="font-size:11px;">—</span>
                <% } %>
                <% if (r.chiPhiId) { %>
                  <form method="POST" action="/doi-soat/chi-phi-saoke/set-gian-tk" style="display:inline-block;margin-left:2px;" title="Đổi TK">
                    <input type="hidden" name="chiPhiId" value="<%= r.chiPhiId %>">
                    <input type="hidden" name="tk" value="<%= r.tk === '1388' ? '331' : '1388' %>">
                    <button type="submit" style="background:none;border:none;cursor:pointer;font-size:10px;color:var(--color-muted,#aaa);padding:0 2px;" title="<%= r.tk === '1388' ? 'Chuyển sang TK Nợ 331' : 'Chuyển sang TK Có 1388' %>">⇄</button>
                  </form>
                <% } %>
              </td>
              <td>
                <% if (r.matchType === 'exact') { %>
                  <span class="badge badge-success" style="font-size:11px;" title="Khớp chính xác qua mã GD ngân hàng">Chính xác</span>
                  <% if (r.chiPhiId) { %>
                  <form method="POST" action="/doi-soat/chi-phi-saoke/unlink-banktxid" style="display:inline-block;margin-left:4px;" onsubmit="return confirm('Hủy liên kết GD này khỏi chi phí?')">
                    <input type="hidden" name="chiPhiId" value="<%= r.chiPhiId %>">
                    <button type="submit" title="Hủy liên kết (ghép sai)" style="background:none;border:none;cursor:pointer;font-size:12px;color:var(--color-muted,#888);padding:0 2px;">✂️</button>
                  </form>
                  <% } %>
                <% } else if (r.matchType === 'fuzzy') { %>
                  <span class="badge badge-warn" style="font-size:11px;" title="Khớp tương đối: số tiền ±1.000đ + ngày ±7 ngày">Tương đối</span>
                <% } else { %>
                  <span class="badge badge-error" style="font-size:11px;">Chưa khớp</span>
                <% } %>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% } %>
    </section>

    <!-- Cấu hình TK theo tên gian (admin only) -->
    <% if (locals.user && locals.user.role === 'admin') { %>
    <section class="panel" style="margin-top:28px;">
      <h3 style="margin:0 0 12px;">⚙️ Cấu hình TK theo tên gian</h3>
      <p class="muted" style="margin-top:-8px;margin-bottom:14px;font-size:13px;">
        Gian nào có tên khớp sẽ dùng TK này thay vì tự tính từ "hình thức hợp tác".
        Ví dụ: SNOW AMBD → TK 1388.
      </p>

      <!-- Danh sách hiện tại -->
      <% const tkMap = locals.gianNameTkMap || {}; %>
      <% if (Object.keys(tkMap).length > 0) { %>
      <table style="width:100%;border-collapse:collapse;font-size:13px;margin-bottom:16px;">
        <thead>
          <tr style="border-bottom:2px solid var(--color-hairline);">
            <th style="text-align:left;padding:6px 10px;">Tên gian (đã chuẩn hoá)</th>
            <th style="text-align:center;padding:6px 10px;">TK Nợ</th>
            <th style="padding:6px 10px;"></th>
          </tr>
        </thead>
        <tbody>
          <% Object.entries(tkMap).forEach(function([k, v]) { %>
          <tr style="border-bottom:1px solid var(--color-hairline);">
            <td style="padding:6px 10px;"><code><%= k %></code></td>
            <td style="text-align:center;padding:6px 10px;"><strong><%= v %></strong></td>
            <td style="padding:6px 10px;">
              <form method="POST" action="/doi-soat/chi-phi-saoke/set-gian-name-tk" style="display:inline;">
                <input type="hidden" name="gian" value="<%= k %>">
                <input type="hidden" name="tk" value="">
                <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Xoá cấu hình cho \'<%= k %>\'?')">Xoá</button>
              </form>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
      <% } else { %>
      <p class="muted" style="font-size:13px;margin-bottom:14px;">Chưa có cấu hình nào.</p>
      <% } %>

      <!-- Form thêm mới -->
      <form method="POST" action="/doi-soat/chi-phi-saoke/set-gian-name-tk" style="display:flex;gap:10px;align-items:flex-end;flex-wrap:wrap;">
        <label style="display:flex;flex-direction:column;gap:4px;font-size:13px;">
          Tên gian (một phần hoặc đầy đủ)
          <input type="text" name="gian" placeholder="VD: SNOW AMBD" style="min-width:220px;padding:6px 10px;border:1px solid var(--color-hairline);border-radius:6px;">
        </label>
        <label style="display:flex;flex-direction:column;gap:4px;font-size:13px;">
          TK Nợ
          <select name="tk" style="padding:6px 10px;border:1px solid var(--color-hairline);border-radius:6px;">
            <option value="1388">1388 (Trả trước người bán)</option>
            <option value="331">331 (Phải trả người bán)</option>
          </select>
        </label>
        <button type="submit" class="btn btn-primary" style="padding:7px 18px;">Lưu</button>
      </form>
    </section>
    <% } %>

  </main>

  <style>
    .row-matched-exact { background: rgba(45,158,95,0.05); }
    .row-matched-fuzzy { background: rgba(198,123,0,0.07); }
    .row-unmatched {}
    .row-thu { background: rgba(25,118,210,0.05); }
    .stat-card {
      background: var(--color-surface, #fff);
      border: 1.5px solid var(--color-hairline, #e0e0e0);
      border-radius: 10px;
      padding: 14px 18px;
    }
    .stat-label { font-size: 12px; color: var(--color-muted, #888); margin-bottom: 4px; }
    .stat-value { font-size: 22px; font-weight: 700; }
    .badge-neutral { background: #eee; color: #555; border-radius: 4px; padding: 2px 6px; font-size: 11px; }
    .badge-warn { background: #fff3cd; color: #856404; border-radius: 4px; padding: 2px 6px; }
    .date-cell {
      font-size: 13px;
      font-weight: 600;
      letter-spacing: 0.3px;
      color: var(--color-text, #222);
    }
  </style>
  <%- include('partials/scroll-restore') %>
  <%- include('partials/details-restore') %>
</body>
</html>

<!DOCTYPE html>
<html lang="vi">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/nav') %>
  <main class="container">
    <h1>Tài khoản Chi — <%= COMPANIES[activeCompany].label %></h1>
    <p class="muted" style="margin-top:-10px;margin-bottom:20px;">
      Tiền chi ra cho nhà cung cấp / mặt bằng / lương... từ tài khoản chi phí (<%= channels.map(function(c){ return c.label; }).join(', ') %>).
      Trang này phân loại theo NCC + gian (nếu xác định được), đối chiếu thêm danh sách hóa đơn HDDV và bảng lệnh chi UNC (mục 1b/1c) để tự điền Số hóa đơn + Diễn giải, rồi xuất file Misa.
    </p>

    <% if (error) { %><div class="alert alert-error" id="autohide-error"><%= error %></div><% } %>
    <% if (success) { %><div class="alert alert-success" id="successBanner"><%= success %></div><% } %>

    <% channels.forEach(function(ch) { %>
    <% if (errorsByChannel[ch.key]) { %>
    <div class="alert alert-error"><%= ch.label %>: <%= errorsByChannel[ch.key] %></div>
    <% } %>
    <% }) %>

    <script>
      // Tu an banner thanh cong / loi sau 3 giay, khong can bam tay.
      (function () {
        ["successBanner", "autohide-error"].forEach(function (id) {
          var el = document.getElementById(id);
          if (!el) return;
          setTimeout(function () {
            el.style.transition = "opacity 0.6s ease, max-height 0.6s ease, margin 0.6s ease, padding 0.6s ease";
            el.style.opacity = "0";
            el.style.maxHeight = "0";
            el.style.overflow = "hidden";
            el.style.marginTop = "0";
            el.style.marginBottom = "0";
            el.style.paddingTop = "0";
            el.style.paddingBottom = "0";
          }, 3000);
        });
      })();
    </script>

    <section class="panel">
      <details>
        <summary style="font-weight:700;color:#111;cursor:pointer;">1. Tải sao kê tài khoản chi phí</summary>
        <div style="margin-top:12px;">
      <form method="POST" action="/doi-soat/chi-phi/upload" enctype="multipart/form-data" class="form-inline">
        <input type="file" name="file" accept=".xls,.xlsx" required />
        <button type="submit" class="btn btn-primary">Tải lên (1 file, tự nhận diện cả 2 tài khoản theo tên sheet)</button>
      </form>
      <div class="table-scroll" style="margin-top:14px;">
        <table class="table">
          <thead><tr><th>Kênh</th><th></th></tr></thead>
          <tbody>
            <% channels.forEach(function(ch) { %>
            <tr>
              <td><strong><%= ch.label %></strong></td>
              <td>
                <a href="/doi-soat/chi-phi/export.xlsx?channel=<%= ch.key %>&start=1" class="btn btn-secondary">Xuất Misa <%= ch.label %></a>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% channels.forEach(function(ch) { %>
      <% var ups = uploadsByChannel[ch.key] || []; %>
      <% if (ups.length > 0) { %>
      <% var totalRows = ups.reduce(function(s, u){ return s + u.rows.length; }, 0); %>
      <details style="margin-top:10px;">
        <summary class="muted" style="cursor:pointer;">
          <%= ch.label %> — đã tải <%= ups.length %> lần, tổng <%= totalRows %> dòng (bấm để xem chi tiết)
        </summary>
        <div style="margin-top:6px;">
          <% ups.forEach(function(u) { %>
          <span class="badge badge-thu" style="margin-right:6px;margin-bottom:6px;display:inline-block;" title="<%= u.uploaded_at %>"><%= u.file_name %> (<%= u.rows.length %> dòng)</span>
          <% }) %>
        </div>
      </details>
      <% } %>
      <% }) %>
        </div>
      </details>
    </section>

    <section class="panel">
      <details>
        <summary style="font-weight:700;color:#111;cursor:pointer;">1b. Tải danh sách hóa đơn NCC (sheet "HDDV KH CŨ")</summary>
        <div style="margin-top:12px;">
      <p class="muted">
        Đối chiếu Tên/MST người bán + Tổng tiền thanh toán với từng dòng chi phí để tự điền Số hóa đơn/Ngày hóa đơn khi xuất Misa.
        Đã nạp <strong><%= invoiceCount %></strong> hóa đơn<% if (invoiceMeta) { %> — sheet "<%= invoiceMeta.sheetName %>", tải lúc <%= new Date(invoiceMeta.uploaded_at).toLocaleString('vi-VN') %>, file "<%= invoiceMeta.file_name %>"<% } %>.
        Tải lại sẽ thay thế toàn bộ danh sách cũ.
      </p>
      <form method="POST" action="/doi-soat/chi-phi/upload-invoice" enctype="multipart/form-data" class="form-inline">
        <input type="file" name="file" accept=".xls,.xlsx" required />
        <button type="submit" class="btn btn-secondary">Cập nhật danh sách hóa đơn</button>
      </form>
        </div>
      </details>
    </section>

    <section class="panel">
      <details>
        <summary style="font-weight:700;color:#111;cursor:pointer;">1c. Tải bảng lệnh chi UNC</summary>
        <div style="margin-top:12px;">
      <p class="muted">
        Đối chiếu Tên công ty + Số tiền để lấy Diễn giải sạch từ "Nội dung UNC" thay cho nội dung sao kê ngân hàng.
        Đã nạp <strong><%= uncCount %></strong> dòng<% if (uncMeta) { %> — sheet "<%= uncMeta.sheetName %>", tải lúc <%= new Date(uncMeta.uploaded_at).toLocaleString('vi-VN') %>, file "<%= uncMeta.file_name %>"<% } %>.
        Tải lại sẽ thay thế toàn bộ danh sách cũ.
      </p>
      <form method="POST" action="/doi-soat/chi-phi/upload-unc" enctype="multipart/form-data" class="form-inline">
        <input type="file" name="file" accept=".xls,.xlsx" required />
        <button type="submit" class="btn btn-secondary">Cập nhật bảng lệnh chi UNC</button>
      </form>
        </div>
      </details>
    </section>

    <section class="panel">
      <details>
        <summary style="font-weight:700;color:#111;cursor:pointer;">2. Danh sách NCC (nhà cung cấp)</summary>
        <div style="margin-top:12px;">
      <p class="muted">
        Đang dùng <%= nccIsCustom ? 'danh sách chị đã tải lên' : 'danh sách gốc đi kèm app' %>: <%= nccCount %> NCC<% if (nccMeta) { %> — tải lúc <%= new Date(nccMeta.uploaded_at).toLocaleString('vi-VN') %>, file "<%= nccMeta.file_name %>"<% } %>.
        Tải lại nếu chị có bản NCC mới hơn (thêm NCC, sửa tên, đổi mã...) — cần cột "Mã nhà cung cấp" và "Tên nhà cung cấp".
      </p>
      <form method="POST" action="/doi-soat/chi-phi/upload-ncc" enctype="multipart/form-data" class="form-inline">
        <select name="company" style="font-size:13px;padding:4px 8px;border:1px solid #ccc;border-radius:4px;">
          <option value="kh_cu">KH Cũ</option>
          <option value="kh_moi">KH Mới</option>
        </select>
        <input type="file" name="file" accept=".xls,.xlsx" required />
        <button type="submit" class="btn btn-secondary">Cập nhật danh sách NCC</button>
      </form>
        </div>
      </details>
    </section>

    <section class="panel">
      <p class="muted" style="margin-bottom:6px;">
        🔒 Khóa sổ: các dòng có Ngày từ đầu đến ngày khóa (bao gồm ngày đó) sẽ không còn hiện các badge cảnh báo
        ("Cần xác định", "Trùng tên", "chưa khớp hóa đơn"...) nữa — dữ liệu gốc vẫn giữ nguyên, chỉ ẩn cảnh báo
        cho các dòng đã chốt xong.
        <% if (lockDate) { %><strong>Đang khóa đến hết ngày <%= lockDate %>.</strong><% } else { %><em>Chưa khóa.</em><% } %>
      </p>
      <form method="POST" action="/doi-soat/chi-phi/khoa-so" class="form-inline">
        <input type="date" name="lockDate" value="<%= lockDate %>" required />
        <button type="submit" class="btn btn-secondary">Khóa đến ngày này</button>
      </form>
      <% if (lockDate) { %>
      <form method="POST" action="/doi-soat/chi-phi/khoa-so" class="form-inline" style="margin-top:6px;">
        <input type="hidden" name="lockDate" value="" />
        <button type="submit" class="btn btn-secondary" onclick="return confirm('Mở khóa sổ?');">Mở khóa</button>
      </form>
      <% } %>
    </section>

    <section class="panel">
      <div class="panel-head">
        <h2>3. Danh sách chi tiết<% if (selectedMonth) { %> — tháng <%= selectedMonth %><% } %> (<%= lines.length %> dòng, tổng <%= totalAmount.toLocaleString('vi-VN') %> đ)</h2>
        <form method="GET" class="form-inline-tight">
          <select name="channel" onchange="this.form.submit()">
            <option value="">Tất cả kênh</option>
            <% channels.forEach(function(ch) { %>
            <option value="<%= ch.key %>" <%= selectedChannel === ch.key ? 'selected' : '' %>><%= ch.label %></option>
            <% }) %>
          </select>
          <select name="month" onchange="this.form.submit()">
            <% months.forEach(function(m) { %>
            <option value="<%= m %>" <%= m === selectedMonth ? 'selected' : '' %>><%= m %></option>
            <% }) %>
            <option value="" <%= selectedMonth === '' ? 'selected' : '' %>>Tất cả</option>
          </select>
          <select name="invoiceStatus" onchange="this.form.submit()" title="Lọc theo hóa đơn NCC của chính dòng chi phí">
            <option value="" <%= selectedInvoiceStatus === '' ? 'selected' : '' %>>Hóa đơn: Tất cả</option>
            <option value="co" <%= selectedInvoiceStatus === 'co' ? 'selected' : '' %>>Có hóa đơn</option>
            <option value="khong" <%= selectedInvoiceStatus === 'khong' ? 'selected' : '' %>>Chưa có hóa đơn</option>
          </select>
          <select name="revenueStatus" onchange="this.form.submit()" title="Lọc theo trạng thái doanh thu của gian (Momo/ZVP/Viet QR) trong cùng tháng">
            <option value="" <%= selectedRevenueStatus === '' ? 'selected' : '' %>>DT gian: Tất cả</option>
            <option value="Đã hạch toán doanh thu" <%= selectedRevenueStatus === 'Đã hạch toán doanh thu' ? 'selected' : '' %>>Đã hạch toán doanh thu</option>
            <option value="Chưa hạch toán doanh thu" <%= selectedRevenueStatus === 'Chưa hạch toán doanh thu' ? 'selected' : '' %>>Chưa hạch toán doanh thu</option>
            <option value="Không có doanh thu ghi nhận" <%= selectedRevenueStatus === 'Không có doanh thu ghi nhận' ? 'selected' : '' %>>Không có doanh thu ghi nhận</option>
            <option value="Không xác định gian" <%= selectedRevenueStatus === 'Không xác định gian' ? 'selected' : '' %>>Không xác định gian</option>
          </select>
        </form>
      </div>
      <p class="muted" style="margin-top:6px;">
        <strong>Có hóa đơn</strong>: dòng chi phí này đã khớp hóa đơn NCC (mục 1b) hoặc rút được số HĐ từ diễn giải.
        <strong>DT gian</strong>: doanh thu của GIAN gắn với dòng này, trong CÙNG THÁNG, đã khớp hóa đơn doanh thu (Momo/ZVP/Viet QR) hay chưa — lấy đúng dữ liệu bên trang Công nợ/Tổng quan, không tính riêng.
      </p>
      <div class="table-scroll">
        <table class="table">
          <thead>
            <tr>
              <th>Ngày</th><th>Kênh</th><th>NCC</th><th>Mã NCC</th><th>Diễn giải (sao kê)</th><th>Nội dung UNC</th><th>Số HĐ</th><th>Số tiền</th><th>TK Nợ</th><th>Gian</th><th>Có hóa đơn</th><th>DT gian</th>
            </tr>
          </thead>
          <tbody>
            <% lines.forEach(function(l) { %>
            <% if (l.locked) { %>
            <tr style="opacity:0.6;">
              <td><%= l.date %> 🔒</td>
              <td><% var chLbl2 = channels.find(function(c){ return c.key === l.channelKey; }); %><%= chLbl2 ? chLbl2.label : l.channelKey %></td>
              <td><%= l.vendorKnown ? l.vendor : '-' %></td>
              <td><%= l.maNCC || '-' %></td>
              <td class="desc-cell" title="<%= l.description %>"><%= l.description %></td>
              <td class="desc-cell" title="<%= l.uncDienGiai %>"><%= l.uncDienGiai || '-' %></td>
              <td><%= (l.invoiceMatch && l.invoiceMatch.soHoaDon) || l.hdNumberFallback || '-' %></td>
              <td class="num"><%= l.debit.toLocaleString('vi-VN') %> đ</td>
              <td><%= l.tkNo || '-' %></td>
              <td><%= l.finalGian || l.siteFrag || '-' %></td>
              <td><span class="badge" title="Đã khóa sổ, không còn cảnh báo">🔒 Đã khóa sổ</span></td>
              <td class="muted"><%= l.revenueStatus %></td>
            </tr>
            <% } else { %>
            <tr>
              <td><%= l.date %></td>
              <td><% var chLbl = channels.find(function(c){ return c.key === l.channelKey; }); %><%= chLbl ? chLbl.label : l.channelKey %></td>
              <td>
                <% if (l.vendorKnown) { %>
                <%= l.vendor %>
                <% } else { %>
                <span class="badge badge-warn">Cần xác định</span>
                <% } %>
              </td>
              <td>
                <% if (l.maNCC) { %>
                <%= l.maNCC %>
                <% } else if (l.nccAmbiguous) { %>
                <span class="badge badge-warn" title="Trùng tên với nhiều NCC">Trùng tên — cần chọn tay</span>
                <% } else if (l.vendorKnown) { %>
                <span class="badge badge-warn">Không có trong DS NCC</span>
                <% } %>
                <% if (l.vendorKnown) { %>
                <form method="POST" action="/doi-soat/chi-phi/vendor-ncc" class="form-inline" style="margin-top:4px;">
                  <input type="hidden" name="vendor" value="<%= l.vendor %>" />
                  <input type="text" name="maNCC" placeholder="Mã NCC" value="<%= l.nccOverridden ? l.maNCC : '' %>" style="width:140px;" />
                  <button type="submit" class="link-btn">Lưu</button>
                </form>
                <% } %>
              </td>
              <td class="desc-cell" title="<%= l.description %>"><%= l.description %></td>
              <td class="desc-cell" title="<%= l.uncDienGiai %>">
                <% if (l.uncDienGiai) { %>
                <%= l.uncDienGiai %> <span class="badge badge-thu" title="Khớp bảng lệnh chi UNC theo Tên NCC + Số tiền">UNC</span>
                <% } else { %>
                <span class="muted">-</span>
                <% } %>
              </td>
              <td>
                <% if (l.invoiceMatch) { %>
                <%= l.invoiceMatch.soHoaDon %> <span class="badge badge-thu" title="Khớp danh sách hóa đơn HDDV theo Tên/MST NCC + Số tiền">HĐ</span>
                <% } else if (l.hdNumberFallback) { %>
                <%= l.hdNumberFallback %> <span class="badge badge-warn" title="Trích từ diễn giải, chưa khớp danh sách hóa đơn">theo diễn giải</span>
                <% } else { %>
                <span class="muted">-</span>
                <% } %>
              </td>
              <td class="num"><%= l.debit.toLocaleString('vi-VN') %> đ</td>
              <td><%= l.tkNo || '-' %></td>
              <td>
                <% if (l.finalGian) { %>
                <%= l.finalGian %>
                <% } else if (l.siteFrag) { %>
                <span class="badge badge-warn" title="Ứng viên: <%= l.gianCandidates.join(', ') || '(không khớp)' %>">"<%= l.siteFrag %>" — cần gán tay</span>
                <% } %>
                <form method="POST" action="/doi-soat/chi-phi/gian-override" class="form-inline" style="margin-top:4px;">
                  <input type="hidden" name="key" value="<%= l.key %>" />
                  <input type="text" name="maCongTrinh" placeholder="Mã công trình" value="<%= l.gianOverridden ? l.finalGian : '' %>" style="width:140px;" />
                  <button type="submit" class="link-btn">Lưu</button>
                </form>
              </td>
              <td>
                <span class="badge <%= l.coHoaDon.startsWith('Có') ? 'badge-thu' : 'badge-warn' %>"><%= l.coHoaDon %></span>
              </td>
              <td>
                <% if (l.revenueStatus === 'Đã hạch toán doanh thu') { %>
                <span class="badge badge-thu"><%= l.revenueStatus %></span>
                <% } else if (l.revenueStatus === 'Chưa hạch toán doanh thu') { %>
                <span class="badge badge-neg"><%= l.revenueStatus %></span>
                <% } else { %>
                <span class="badge badge-warn"><%= l.revenueStatus %></span>
                <% } %>
              </td>
            </tr>
            <% } %>
            <% }) %>
            <% if (lines.length === 0) { %>
            <tr><td colspan="12" class="muted">Chưa có dữ liệu — tải sao kê ở mục 1.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </section>

    <section class="panel">
      <h2>4. TK Nợ theo từng NCC</h2>
      <p class="muted">Gán mã tài khoản Nợ (vd 331, 641, 642, 334...) cho từng NCC — dùng khi xuất file Misa. Bỏ trống nếu chưa rõ.</p>
      <form method="POST" action="/doi-soat/chi-phi/vendor-tk">
        <div class="table-scroll">
          <table class="table">
            <thead><tr><th>NCC</th><th>TK Nợ</th></tr></thead>
            <tbody>
              <% vendors.forEach(function(v) { %>
              <tr>
                <td><%= v.vendor %></td>
                <td><input type="text" name="tkno_<%= encodeURIComponent(v.vendor) %>" value="<%= v.tkNo || '' %>" style="width:100px;" /></td>
              </tr>
              <% }) %>
              <% if (vendors.length === 0) { %>
              <tr><td colspan="2" class="muted">Chưa có NCC nào — tải sao kê ở mục 1.</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
        <button type="submit" class="btn btn-primary">Lưu TK Nợ</button>
      </form>
    </section>

    <section class="panel">
      <div class="panel-head">
        <h2>5. Công nợ NCC theo tên</h2>
        <a href="/doi-soat/chi-phi/cong-no-ncc/export.xlsx" class="btn btn-secondary">Xuất Excel</a>
      </div>
      <p class="muted" style="margin-top:6px;">
        Mỗi NCC: <strong>Tổng hóa đơn</strong> (cộng dồn từng hóa đơn — nhiều dòng hàng hóa cùng 1 Số hóa đơn đã được
        gộp lại, cộng tổng tiền — bên "Hóa Đơn Đầu Vào" của NCC này), <strong>Đã chi</strong> (cộng các hóa đơn đã
        đánh dấu Đã chi tiền), <strong>Còn nợ</strong> = Tổng hóa đơn − Đã chi.
        Bấm vào tên NCC để xem từng hóa đơn — hóa đơn nào Đã chi sẽ cố gắng dò thêm ngày/tài khoản đã thanh toán
        (khớp Tên NCC/MST + Tổng số tiền hóa đơn với dòng Chi phí hoặc giao dịch ngân hàng, chỉ để tham khảo).
        <strong>Lưu ý</strong>: nếu chị trả gộp nhiều hóa đơn cùng lúc (trả theo đợt/cấn trừ công nợ cuối tháng),
        số tiền giao dịch sẽ không khớp đúng 1 hóa đơn riêng lẻ nên cột "Ngày/Nơi thanh toán" có thể không dò ra được
        dù hóa đơn đó đã được đánh dấu Đã chi — chị tự đối chiếu thêm cho những trường hợp này.
      </p>
      <div style="margin:10px 0;">
        <input type="text" id="nccDebtSearch" placeholder="Tìm theo tên NCC..." style="width:280px;max-width:100%;" onkeyup="filterNccDebtRows()" />
      </div>
      <div class="cards" style="margin-bottom:14px;">
        <div class="card">
          <div class="card-label">Tổng hóa đơn (tất cả NCC)</div>
          <div class="card-value"><%= nccDebtGrandTotal.tongHoaDon.toLocaleString('vi-VN') %> đ</div>
        </div>
        <div class="card card-thu">
          <div class="card-label">Đã chi</div>
          <div class="card-value"><%= nccDebtGrandTotal.daChi.toLocaleString('vi-VN') %> đ</div>
        </div>
        <div class="card <%= nccDebtGrandTotal.conNo > 0 ? 'card-chi' : 'card-thu' %>">
          <div class="card-label">Còn nợ</div>
          <div class="card-value"><%= nccDebtGrandTotal.conNo.toLocaleString('vi-VN') %> đ</div>
        </div>
      </div>
      <div class="table-scroll">
        <table class="table" id="nccDebtTable">
          <thead>
            <tr>
              <th>NCC</th><th>Số hóa đơn</th><th>Tổng hóa đơn</th><th>Đã chi</th><th>Còn nợ</th><th></th>
            </tr>
          </thead>
          <tbody>
            <% nccDebtRows.forEach(function(g, gi) { %>
            <tr class="ncc-debt-row" data-name="<%= g.tenNCC.toLowerCase() %>">
              <td><strong><%= g.tenNCC %></strong><% if (g.mstNCC) { %><div class="muted" style="font-size:12px;">MST: <%= g.mstNCC %></div><% } %></td>
              <td class="num"><%= g.soHoaDonCount %></td>
              <td class="num"><%= g.tongHoaDon.toLocaleString('vi-VN') %> đ</td>
              <td class="num" style="color:#1a7f37;"><%= g.daChi.toLocaleString('vi-VN') %> đ</td>
              <td class="num" style="font-weight:700;color:<%= g.conNo > 0 ? '#c0392b' : '#1a7f37' %>;">
                <%= g.conNo.toLocaleString('vi-VN') %> đ
                <% if (g.conNo <= 0 && g.daChi > 0) { %><span class="badge badge-thu" title="Đã chi đủ hoặc vượt tổng hóa đơn">Hết nợ</span><% } %>
              </td>
              <td><button type="button" class="link-btn" onclick="toggleNccDebtDetail(<%= gi %>)">Xem chi tiết ▾</button></td>
            </tr>
            <tr class="ncc-debt-detail-row" id="nccDebtDetail<%= gi %>" style="display:none;">
              <td colspan="6" style="background:#fafafa;">
                <table class="table" style="margin:6px 0;">
                  <thead>
                    <tr><th>Ngày HĐ</th><th>Số HĐ</th><th>Diễn giải</th><th>Số tiền</th><th>Đã chi?</th><th>Ngày/Nơi thanh toán (dò được)</th></tr>
                  </thead>
                  <tbody>
                    <% g.invoices.forEach(function(inv) { %>
                    <tr>
                      <td><%= inv.ngayHD || '-' %></td>
                      <td><%= inv.soHoaDon || '-' %></td>
                      <td class="desc-cell" title="<%= inv.dienGiai %>"><%= inv.dienGiai || '-' %></td>
                      <td class="num"><%= (inv.soTien || 0).toLocaleString('vi-VN') %> đ</td>
                      <td>
                        <% if (inv.daChiTien) { %>
                        <span class="badge badge-thu">Đã chi</span>
                        <% } else { %>
                        <span class="badge badge-warn">Chưa chi</span>
                        <% } %>
                      </td>
                      <td class="muted">
                        <% if (inv.paymentDate) { %>
                        <%= inv.paymentDate %> — <%= inv.paymentSource %>
                        <% } else if (inv.daChiTien) { %>
                        (chưa dò được nguồn chi)
                        <% } else { %>
                        -
                        <% } %>
                      </td>
                    </tr>
                    <% }) %>
                  </tbody>
                </table>
              </td>
            </tr>
            <% }) %>
            <% if (nccDebtRows.length === 0) { %>
            <tr><td colspan="6" class="muted">Chưa có dữ liệu — cần có hóa đơn ở trang "Hóa Đơn Đầu Vào" cho công ty này.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </section>
    <script>
      function toggleNccDebtDetail(i) {
        var row = document.getElementById('nccDebtDetail' + i);
        if (!row) return;
        row.style.display = row.style.display === 'none' ? '' : 'none';
      }
      function filterNccDebtRows() {
        var q = document.getElementById('nccDebtSearch').value.trim().toLowerCase();
        document.querySelectorAll('#nccDebtTable tr.ncc-debt-row').forEach(function (tr) {
          var match = !q || (tr.getAttribute('data-name') || '').indexOf(q) !== -1;
          tr.style.display = match ? '' : 'none';
          var detailRow = tr.nextElementSibling;
          if (!match && detailRow && detailRow.classList.contains('ncc-debt-detail-row')) {
            detailRow.style.display = 'none';
          }
        });
      }
    </script>
  </main>
</body>
</html>

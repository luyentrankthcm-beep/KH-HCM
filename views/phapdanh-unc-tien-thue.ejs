<!DOCTYPE html>
<html lang="vi">
<head>
  <%- include('partials/head') %>
  <style>
    .unc-section { margin-bottom: 2.5rem; }
    .unc-section-title {
      font-size: 1.1rem; font-weight: 700; padding: .5rem 1rem;
      border-radius: 8px 8px 0 0; margin-bottom: 0;
    }
    .section-kh-cu  .unc-section-title { background: #1e3a5f; color: #fff; }
    .section-kh-moi .unc-section-title { background: #065f46; color: #fff; }
    .ncc-card {
      border: 1px solid #e2e8f0; border-radius: 0 0 8px 8px;
      margin-bottom: 1rem; overflow: hidden;
    }
    .section-kh-cu  .ncc-card { border-top: 3px solid #1e3a5f; border-radius: 8px; }
    .section-kh-moi .ncc-card { border-top: 3px solid #065f46; border-radius: 8px; }
    .ncc-header {
      display: flex; align-items: center; gap: 1rem;
      padding: .75rem 1rem; background: #f8fafc; cursor: pointer;
      user-select: none; flex-wrap: wrap;
    }
    .ncc-header:hover { background: #f1f5f9; }
    .ncc-name { font-weight: 700; color: #1e3a5f; font-size: .97rem; flex: 1; min-width: 200px; }
    .section-kh-moi .ncc-name { color: #065f46; }
    .ncc-meta { font-size: .82rem; color: #64748b; display: flex; gap: 1rem; flex-wrap: wrap; }
    .ncc-meta span { display: flex; gap: .3rem; align-items: center; }
    .ncc-tong { margin-left: auto; font-weight: 700; color: #1e3a5f; font-size: .95rem; white-space: nowrap; }
    .section-kh-moi .ncc-tong { color: #065f46; }
    .ncc-toggle { font-size: 1rem; transition: transform .2s; }
    .ncc-body { display: none; }
    .ncc-body.open { display: block; }
    .ncc-table { width: 100%; border-collapse: collapse; font-size: .85rem; }
    .ncc-table th { background: #f1f5f9; color: #475569; font-weight: 600;
      padding: .5rem .75rem; text-align: left; border-bottom: 1px solid #e2e8f0; }
    .ncc-table td { padding: .45rem .75rem; border-bottom: 1px solid #f1f5f9; vertical-align: top; }
    .ncc-table tr:last-child td { border-bottom: none; }
    .ncc-table tr:hover td { background: #fafafa; }
    .text-right { text-align: right; }
    .badge-thang { background: #e0f2fe; color: #0369a1; border-radius: 4px; padding: 1px 6px; font-size: .78rem; }
    .empty-note { color: #94a3b8; font-style: italic; padding: 1.5rem; text-align: center; }
    .summary-bar {
      display: flex; gap: 1.5rem; flex-wrap: wrap; align-items: center;
      background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px;
      padding: .6rem 1rem; margin-bottom: 1rem; font-size: .88rem;
    }
    .summary-bar strong { color: #1e3a5f; }
    .section-kh-moi .summary-bar strong { color: #065f46; }
  </style>
</head>
<body>
<%- include('partials/nav') %>
<div style="max-width:1300px;margin:2rem auto;padding:0 1rem">
  <h2 style="font-size:1.3rem;font-weight:700;color:#1e3a5f;margin-bottom:1.5rem">UNC Tiền Thuê</h2>

  <% if (typeof success !== 'undefined' && success) { %>
    <div style="background:#d1fae5;border:1px solid #6ee7b7;border-radius:8px;padding:.75rem 1rem;margin-bottom:1rem;color:#065f46">✅ <%= success %></div>
  <% } %>
  <% if (typeof error !== 'undefined' && error) { %>
    <div style="background:#fee2e2;border:1px solid #fca5a5;border-radius:8px;padding:.75rem 1rem;margin-bottom:1rem;color:#991b1b">❌ <%= error %></div>
  <% } %>

  <%
    function fmtVnd(n) {
      if (!n && n !== 0) return '';
      return Number(n).toLocaleString('vi-VN') + ' đ';
    }
  %>

  <!-- ========== KH CŨ ========== -->
  <div class="unc-section section-kh-cu">
    <div class="unc-section-title">🏢 KH Cũ — <%= groupsKhCu.length %> NCC</div>
    <% if (groupsKhCu.length === 0) { %>
      <div class="empty-note">Chưa có dữ liệu tiền thuê KH Cũ.</div>
    <% } else {
      const tongKhCu = groupsKhCu.reduce((s, g) => s + g.tongTien, 0);
    %>
    <div class="summary-bar">
      <span>Tổng NCC: <strong><%= groupsKhCu.length %></strong></span>
      <span>Tổng hóa đơn: <strong><%= groupsKhCu.reduce((s,g)=>s+g.rows.length,0) %></strong></span>
      <span>Tổng tiền: <strong><%= fmtVnd(tongKhCu) %></strong></span>
    </div>
    <% groupsKhCu.forEach(function(g, gi) { %>
    <div class="ncc-card" style="margin-bottom:.75rem">
      <div class="ncc-header" onclick="toggleNcc(this)">
        <span class="ncc-toggle">▶</span>
        <span class="ncc-name"><%= g.tenNCC %></span>
        <div class="ncc-meta">
          <% if (g.maSoThueNCC) { %><span>MST: <b><%= g.maSoThueNCC %></b></span><% } %>
          <% if (g.maDanhMuc && g.maDanhMuc !== g.maSoThueNCC) { %><span>Mã NCC: <b><%= g.maDanhMuc %></b></span><% } %>
          <span><%= g.rows.length %> hóa đơn</span>
        </div>
        <span class="ncc-tong"><%= fmtVnd(g.tongTien) %></span>
      </div>
      <div class="ncc-body">
        <table class="ncc-table">
          <thead>
            <tr>
              <th>Tháng</th>
              <th>Gian</th>
              <th>Số HĐ</th>
              <th>Ngày HĐ</th>
              <th>Diễn giải</th>
              <th class="text-right">Tiền trước thuế</th>
              <th class="text-right">Thuế GTGT</th>
              <th class="text-right">Tổng cộng</th>
            </tr>
          </thead>
          <tbody>
            <% g.rows.forEach(function(r) { %>
            <tr>
              <td><span class="badge-thang"><%= r.thang || '—' %></span></td>
              <td><%= r.tenCongTrinh || r.maCongTrinh || r.gian || '—' %></td>
              <td style="font-family:monospace"><%= r.soHoaDon || '—' %></td>
              <td><%= r.ngayHoaDon || '—' %></td>
              <td style="color:#475569"><%= r.dienGiai || '—' %></td>
              <td class="text-right"><%= r.soTien || (r.soTienRaw ? Number(r.soTienRaw).toLocaleString('vi-VN') : '—') %></td>
              <td class="text-right"><%= r.thueGtgt || '—' %></td>
              <td class="text-right" style="font-weight:600"><%= r.soTienTong || (r.soTienTongRaw ? Number(r.soTienTongRaw).toLocaleString('vi-VN') : '—') %></td>
            </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
    <% }); %>
    <% } %>
  </div>

  <!-- ========== KH MỚI ========== -->
  <div class="unc-section section-kh-moi">
    <div class="unc-section-title">🌿 KH Mới — <%= groupsKhMoi.length %> NCC</div>
    <% if (groupsKhMoi.length === 0) { %>
      <div class="empty-note">Chưa có dữ liệu tiền thuê KH Mới.</div>
    <% } else {
      const tongKhMoi = groupsKhMoi.reduce((s, g) => s + g.tongTien, 0);
    %>
    <div class="summary-bar">
      <span>Tổng NCC: <strong><%= groupsKhMoi.length %></strong></span>
      <span>Tổng hóa đơn: <strong><%= groupsKhMoi.reduce((s,g)=>s+g.rows.length,0) %></strong></span>
      <span>Tổng tiền: <strong><%= fmtVnd(tongKhMoi) %></strong></span>
    </div>
    <% groupsKhMoi.forEach(function(g, gi) { %>
    <div class="ncc-card" style="margin-bottom:.75rem">
      <div class="ncc-header" onclick="toggleNcc(this)">
        <span class="ncc-toggle">▶</span>
        <span class="ncc-name"><%= g.tenNCC %></span>
        <div class="ncc-meta">
          <% if (g.maSoThueNCC) { %><span>MST: <b><%= g.maSoThueNCC %></b></span><% } %>
          <% if (g.maDanhMuc && g.maDanhMuc !== g.maSoThueNCC) { %><span>Mã NCC: <b><%= g.maDanhMuc %></b></span><% } %>
          <span><%= g.rows.length %> hóa đơn</span>
        </div>
        <span class="ncc-tong"><%= fmtVnd(g.tongTien) %></span>
      </div>
      <div class="ncc-body">
        <table class="ncc-table">
          <thead>
            <tr>
              <th>Tháng</th>
              <th>Gian</th>
              <th>Số HĐ</th>
              <th>Ngày HĐ</th>
              <th>Diễn giải</th>
              <th class="text-right">Tiền trước thuế</th>
              <th class="text-right">Thuế GTGT</th>
              <th class="text-right">Tổng cộng</th>
            </tr>
          </thead>
          <tbody>
            <% g.rows.forEach(function(r) { %>
            <tr>
              <td><span class="badge-thang"><%= r.thang || '—' %></span></td>
              <td><%= r.tenCongTrinh || r.maCongTrinh || r.gian || '—' %></td>
              <td style="font-family:monospace"><%= r.soHoaDon || '—' %></td>
              <td><%= r.ngayHoaDon || '—' %></td>
              <td style="color:#475569"><%= r.dienGiai || '—' %></td>
              <td class="text-right"><%= r.soTien || (r.soTienRaw ? Number(r.soTienRaw).toLocaleString('vi-VN') : '—') %></td>
              <td class="text-right"><%= r.thueGtgt || '—' %></td>
              <td class="text-right" style="font-weight:600"><%= r.soTienTong || (r.soTienTongRaw ? Number(r.soTienTongRaw).toLocaleString('vi-VN') : '—') %></td>
            </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
    <% }); %>
    <% } %>
  </div>

</div>
<%- include('partials/footer') %>
<script>
function toggleNcc(header) {
  const body = header.nextElementSibling;
  const toggle = header.querySelector('.ncc-toggle');
  const isOpen = body.classList.contains('open');
  body.classList.toggle('open', !isOpen);
  toggle.style.transform = isOpen ? '' : 'rotate(90deg)';
}
</script>
</body>
</html>

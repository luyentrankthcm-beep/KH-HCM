<!DOCTYPE html>
<html lang="vi">
<head>
  <%- include('partials/head') %>
</head>
<body>
<%- include('partials/nav') %>
<div style="max-width:1200px;margin:2rem auto;padding:0 1rem">
  <h2 style="font-size:1.3rem;font-weight:700;color:#1e3a5f;margin-bottom:1rem">UNC Tiền Thuê</h2>
  <% if (typeof success !== 'undefined' && success) { %>
    <div style="background:#d1fae5;border:1px solid #6ee7b7;border-radius:8px;padding:.75rem 1rem;margin-bottom:1rem;color:#065f46">✅ <%= success %></div>
  <% } %>
  <% if (typeof error !== 'undefined' && error) { %>
    <div style="background:#fee2e2;border:1px solid #fca5a5;border-radius:8px;padding:.75rem 1rem;margin-bottom:1rem;color:#991b1b">❌ <%= error %></div>
  <% } %>
  <div style="background:#fef9c3;border:1px solid #fde047;border-radius:10px;padding:2rem;text-align:center;color:#713f12;font-size:1rem">
    🚧 Trang này đang được xây dựng.<br>
    <span style="font-size:.9rem;color:#92400e">Vui lòng hướng dẫn nội dung cần hiển thị.</span>
  </div>
</div>
<%- include('partials/footer') %>
</body>
</html>

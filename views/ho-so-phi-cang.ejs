<!DOCTYPE html>
<html lang="vi">
<head>
  <%- include('partials/head') %>
  <title>Phí Cảng Phú Quốc – K&H</title>
  <style>
    .tab-bar { display:flex; gap:0; border-bottom:2px solid #1e3a5f; margin-bottom:1.25rem; }
    .tab-btn { padding:.5rem 1.25rem; font-weight:600; font-size:.88em; cursor:pointer; border:none; background:#e8f0fe; color:#1e3a5f; border-radius:6px 6px 0 0; margin-right:3px; text-decoration:none; display:inline-block; }
    .tab-btn.active { background:#1e3a5f; color:#fff; }
    .tab-btn:hover:not(.active) { background:#c7d7f8; }
    .doc-table { width:100%; border-collapse:collapse; font-size:.88em; }
    .doc-table th { background:#1e3a5f; color:#fff; padding:.5rem .75rem; text-align:left; white-space:nowrap; position:sticky; top:0; z-index:5; }
    .doc-table td { padding:.45rem .75rem; border-bottom:1px solid #eee; vertical-align:middle; }
    .doc-table tbody tr:nth-child(odd) td { background:#f5f8ff; }
    .doc-table tbody tr:hover td { background:#dceeff !important; }
    .tien { font-weight:600; color:#15803d; }
    .link-doc { color:#2563eb; text-decoration:none; }
    .link-doc:hover { text-decoration:underline; }
    .add-form { background:#f8fafc; border:1px solid #e2e8f0; border-radius:8px; padding:1rem 1.25rem; margin-bottom:1.25rem; }
    .add-form h3 { margin:0 0 .75rem; font-size:.92rem; color:#1e3a5f; }
    .form-row { display:flex; gap:.6rem; flex-wrap:wrap; align-items:flex-end; }
    .form-row label { font-size:.8em; font-weight:600; color:#475569; display:block; margin-bottom:.2rem; }
    .form-row input, .form-row select { padding:.35rem .55rem; border:1px solid #cbd5e1; border-radius:4px; font-size:.85em; }
    .btn-add { background:#2563eb; color:#fff; border:none; border-radius:5px; padding:.38rem .9rem; cursor:pointer; font-weight:600; font-size:.85em; white-space:nowrap; }
    .btn-del { background:none; border:none; color:#ef4444; cursor:pointer; font-size:.85em; padding:.1rem .3rem; }
    .btn-del:hover { color:#b91c1c; }
  </style>
</head>
<body>
  <%- include('partials/nav') %>
  <main class="container">
    <h1 class="page-title">Hồ Sơ</h1>

    <div class="tab-bar">
      <a href="/ho-so/hoa-don-ncc" class="tab-btn">📄 Hóa Đơn NCC</a>
      <a href="/ho-so/phi-cang-phu-quoc" class="tab-btn active">🚢 Phí Cảng Phú Quốc</a>
      <a href="/ho-so/doanh-thu-chia-se" class="tab-btn">📊 Doanh Thu Chia Sẻ</a>
    </div>

    <% if (typeof error !== 'undefined' && error) { %><div class="alert-error"><%= error %></div><% } %>
    <% if (typeof success !== 'undefined' && success) { %><div class="alert-success"><%= success %></div><% } %>
    <% if (typeof warn !== 'undefined' && warn) { %><div style="background:#fff8e1;border:1px solid #f59e0b;border-radius:6px;padding:.6rem 1rem;margin-bottom:.75rem;font-size:.88em;color:#92400e;"><%= warn %></div><% } %>

    <!-- Add form -->
    <div style="display:flex;justify-content:flex-end;margin-bottom:.75rem;">
      <form method="POST" action="/ho-so/phi-cang-phu-quoc/sync-drive">
        <button type="submit" style="background:#0f766e;color:#fff;border:none;border-radius:5px;padding:.35rem .85rem;font-size:.85em;font-weight:600;cursor:pointer;white-space:nowrap;" title="Sync PDF từ folder Drive 'Phí Cảng HK'">🔄 Sync Drive</button>
      </form>
    </div>

    <!-- Upload biên lai → PDF → Drive (nhận PDF + ảnh, PDF tự đọc nội dung) -->
    <div class="add-form" style="border-color:#2563eb22;background:#eff6ff;">
      <h3>📎 Tải biên lai → Drive <span id="docStatus" style="font-size:.78em;color:#2563eb;margin-left:.5rem;"></span></h3>
      <form method="POST" action="/ho-so/phi-cang-phu-quoc/upload-anh" enctype="multipart/form-data" id="uploadPhiCangForm">
        <div class="form-row" style="margin-bottom:.55rem;">
          <div>
            <label>File biên lai <span style="color:#ef4444">*</span></label>
            <input type="file" name="anh" id="pcFileInput" accept=".jpg,.jpeg,.png,.pdf" multiple required style="font-size:.83em;padding:.25rem;" onchange="docPhiCangFile(this)" />
          </div>
          <div>
            <label>Ngày <span style="color:#ef4444">*</span></label>
            <input type="date" name="ngay" id="pcNgay" required />
          </div>
          <div>
            <label>Số hóa đơn</label>
            <input type="text" name="soHoaDon" id="pcSoHD" placeholder="VD: 0000192" style="min-width:110px;" />
          </div>
          <div style="min-width:200px;flex:1;">
            <label>Loại phí</label>
            <input type="text" name="loaiPhi" id="pcLoaiPhi" placeholder="VD: Phí kiểm tra an ninh hàng hóa..." style="width:100%;" />
          </div>
          <div>
            <label>Số tiền (đ)</label>
            <input type="text" name="soTien" id="pcSoTien" placeholder="VD: 42.100" style="min-width:110px;" />
          </div>
          <div style="flex:1;min-width:150px;">
            <label>Ghi chú</label>
            <input type="text" name="ghiChu" placeholder="Ghi chú thêm..." style="width:100%;" />
          </div>
          <div>
            <label>&nbsp;</label>
            <button type="submit" class="btn-add" style="background:#2563eb;">⬆️ Upload</button>
          </div>
        </div>
        <p style="margin:.2rem 0 0;font-size:.78em;color:#64748b;">PDF: tự đọc nội dung &amp; điền form. Ảnh JPG/PNG: tự chuyển sang PDF. Tên file: <em>PhiCang_SoHD_DD-MM-YYYY.pdf</em>.</p>
      </form>
    </div>
    <script>
    function pcEditLink(id, current) {
      const box = document.getElementById('pclink-' + id);
      const inp = document.getElementById('pclink-input-' + id);
      box.style.display = box.style.display === 'none' ? 'block' : 'none';
      if (inp) inp.value = current;
    }
    async function docPhiCangFile(input) {
      const files = input.files;
      if (!files || files.length === 0) return;
      // Chi doc tu dong khi co 1 file PDF
      const pdfFiles = Array.from(files).filter(f => f.name.toLowerCase().endsWith('.pdf'));
      if (pdfFiles.length !== 1) return;
      const status = document.getElementById('docStatus');
      status.textContent = '⏳ Đang đọc PDF...';
      try {
        const fd = new FormData();
        fd.append('file', pdfFiles[0]);
        const resp = await fetch('/ho-so/phi-cang-phu-quoc/doc-file', { method: 'POST', body: fd });
        const data = await resp.json();
        if (!data.success) { status.textContent = '⚠️ ' + (data.error || 'Không đọc được'); return; }
        if (data.ngay) document.getElementById('pcNgay').value = data.ngay;
        if (data.soHoaDon) document.getElementById('pcSoHD').value = data.soHoaDon;
        if (data.loaiPhi) document.getElementById('pcLoaiPhi').value = data.loaiPhi;
        if (data.soTien) document.getElementById('pcSoTien').value = data.soTien;
        status.textContent = '✅ Đã điền từ PDF — kiểm tra lại trước khi Upload';
        status.style.color = '#15803d';
      } catch(e) {
        status.textContent = '⚠️ Lỗi: ' + e.message;
      }
    }
    </script>

    <div class="add-form">
      <h3>➕ Thêm chứng từ phí cảng (nhập tay)</h3>
      <form method="POST" action="/ho-so/phi-cang-phu-quoc/them">
        <div class="form-row">
          <div>
            <label>Ngày</label>
            <input type="date" name="ngay" required />
          </div>
          <div>
            <label>Số hóa đơn</label>
            <input type="text" name="soHoaDon" placeholder="VD: 0000192" style="min-width:110px;" />
          </div>
          <div>
            <label>Loại phí</label>
            <input type="text" name="loaiPhi" placeholder="VD: Phí cầu bến, Phí neo đậu..." style="min-width:180px;" />
          </div>
          <div>
            <label>Số tiền</label>
            <input type="text" name="soTien" placeholder="VD: 5.000.000đ" style="min-width:120px;" />
          </div>
          <div style="flex:1;min-width:200px;">
            <label>Link tài liệu (Drive)</label>
            <input type="text" name="linkFile" placeholder="https://drive.google.com/..." style="width:100%;" />
          </div>
          <div style="flex:1;min-width:160px;">
            <label>Ghi chú</label>
            <input type="text" name="ghiChu" placeholder="Ghi chú thêm..." style="width:100%;" />
          </div>
          <div>
            <label>&nbsp;</label>
            <button type="submit" class="btn-add">Thêm</button>
          </div>
        </div>
      </form>
    </div>

    <% if (rows.length === 0) { %>
    <p style="color:#888;">Chưa có dữ liệu. Thêm chứng từ ở trên.</p>
    <% } else { %>
    <div style="overflow-x:auto;">
      <table class="doc-table">
        <thead>
          <tr>
            <th style="width:36px;">#</th>
            <th style="width:100px;">Ngày</th>
            <th style="width:110px;">Số HĐ</th>
            <th>Loại phí</th>
            <th style="width:120px;">Số tiền</th>
            <th style="width:90px;">Tài liệu</th>
            <th>Ghi chú</th>
            <th style="width:36px;"></th>
          </tr>
        </thead>
        <tbody>
          <% rows.forEach(function(r, i) { %>
          <tr>
            <td style="color:#bbb;font-size:.78em;"><%= i+1 %></td>
            <td><%= r.ngay ? r.ngay.split('-').reverse().join('/') : '—' %></td>
            <td style="font-family:monospace;font-size:.85em;"><%= r.soHoaDon || '—' %></td>
            <td><%= r.loaiPhi || '—' %></td>
            <td class="<%= r.soTien ? 'tien' : '' %>"><%
              if (r.soTien) {
                const n = parseInt(String(r.soTien).replace(/[.,\s]/g,''));
                %><%= isNaN(n) ? r.soTien : n.toLocaleString('de-DE') %> đ<%
              } else { %>—<% } %>
            </td>
            <td>
              <% if (r.linkFile) { %>
              <a href="<%= r.linkFile %>" target="_blank" class="link-doc">📄 Xem</a>
              <button onclick="pcEditLink('<%= r.id %>','<%= (r.linkFile||'').replace(/'/g,\"\\\\'\\\"') %>')" style="background:none;border:none;color:#94a3b8;cursor:pointer;font-size:.75em;padding:0 2px;" title="Sửa link">✏️</button>
              <% } else { %>
              <button onclick="pcEditLink('<%= r.id %>','')" style="background:none;border:none;color:#2563eb;cursor:pointer;font-size:.78em;padding:0;" title="Dán link Drive">🔗 Dán link</button>
              <% } %>
              <div id="pclink-<%= r.id %>" style="display:none;margin-top:3px;">
                <form method="POST" action="/ho-so/phi-cang-phu-quoc/<%= r.id %>/sua" style="display:flex;gap:4px;">
                  <input type="hidden" name="ngay" value="<%= r.ngay||'' %>" />
                  <input type="hidden" name="loaiPhi" value="<%= r.loaiPhi||'' %>" />
                  <input type="hidden" name="soTien" value="<%= r.soTien||'' %>" />
                  <input type="hidden" name="ghiChu" value="<%= r.ghiChu||'' %>" />
                  <input type="hidden" name="soHoaDon" value="<%= r.soHoaDon||'' %>" />
                  <input type="text" name="linkFile" id="pclink-input-<%= r.id %>" placeholder="https://drive.google.com/..." style="font-size:.78em;padding:2px 5px;border:1px solid #93c5fd;border-radius:3px;width:200px;" />
                  <button type="submit" style="background:#2563eb;color:#fff;border:none;border-radius:3px;padding:2px 7px;font-size:.78em;cursor:pointer;">Lưu</button>
                  <button type="button" onclick="document.getElementById('pclink-<%= r.id %>').style.display='none'" style="background:none;border:none;color:#94a3b8;cursor:pointer;font-size:.85em;">✕</button>
                </form>
              </div>
            </td>
            <td style="color:#555;font-size:.85em;"><%= r.ghiChu || '' %></td>
            <td>
              <form method="POST" action="/ho-so/phi-cang-phu-quoc/<%= r.id %>/xoa" onsubmit="return confirm('Xóa dòng này?')">
                <button type="submit" class="btn-del" title="Xóa">🗑️</button>
              </form>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <p style="color:#888;font-size:.82em;margin-top:.5rem;"><strong><%= rows.length %></strong> chứng từ</p>
    <% } %>
  </main>
</body>
</html>

<!DOCTYPE html>
<html lang="vi">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/nav') %>
  <main class="container">
    <h1>Thu/chi theo gian (tất cả ngân hàng)</h1>
    <p class="muted">
      Gộp chung mỗi khoản thu về ngân hàng (Momo + Zalo/VNPay/Payoo), tách theo từng gian, thành 1 dòng —
      không cần vào từng trang đối soát riêng để xem.
    </p>
    <section class="panel">
      <h2>Sao kê chi tiết theo ngân hàng (từng giao dịch)</h2>
      <form method="GET" action="/bao-cao/thu-chi-theo-gian" class="form-inline-tight" style="margin-bottom:10px;">
        <label style="margin:0;">Ngân hàng:</label>
        <select name="bank" onchange="this.form.submit()">
          <option value="">-- Tất cả --</option>
          <% banks.forEach(function(b) { %>
          <option value="<%= b %>" <%= bankFilter === b ? 'selected' : '' %>><%= b %></option>
          <% }) %>
        </select>
        <% if (stmtMonths.length > 0) { %>
        <label style="margin:0;">Tháng:</label>
        <select name="stmtMonth" onchange="this.form.submit()">
          <option value="" <%= stmtMonth === '' ? 'selected' : '' %>>-- Tất cả --</option>
          <% stmtMonths.forEach(function(m) { %>
          <option value="<%= m %>" <%= stmtMonth === m ? 'selected' : '' %>><%= m %></option>
          <% }) %>
        </select>
        <% } %>
      </form>
      <p class="muted">
        Toàn bộ giao dịch lấy trực tiếp từ sao kê ngân hàng (không qua đối soát), sắp xếp theo ngày tăng dần, mỗi
        ngân hàng 1 tab. Dòng tô <span style="background:var(--color-highlight-strong); padding:1px 6px; border-radius:4px;">xanh</span>
        là giao dịch đã được đưa vào 1 trong các trang đối soát (Momo / Zalo-VNPay-Payoo / VietQR / VNPay KH Mới);
        dòng trắng là giao dịch khác (chi phí, chuyển nội bộ, chưa đối soát...).
      </p>

      <section class="cards">
        <div class="card">
          <div class="card-label">Tổng <%= COMPANIES.kh_cu.label %></div>
          <div class="card-value" style="color:var(--color-success)">Thu <%= stmtCompanyTotals.kh_cu.thu.toLocaleString('vi-VN') %> đ</div>
          <div class="muted" style="font-size:12px;">Chi <%= stmtCompanyTotals.kh_cu.chi.toLocaleString('vi-VN') %> đ</div>
        </div>
        <div class="card">
          <div class="card-label">Tổng <%= COMPANIES.kh_moi.label %></div>
          <div class="card-value" style="color:var(--color-success)">Thu <%= stmtCompanyTotals.kh_moi.thu.toLocaleString('vi-VN') %> đ</div>
          <div class="muted" style="font-size:12px;">Chi <%= stmtCompanyTotals.kh_moi.chi.toLocaleString('vi-VN') %> đ</div>
        </div>
      </section>

      <% if (stmtTabs.length === 0) { %>
      <p class="muted" style="margin-top:14px;">Chưa có giao dịch nào cho bộ lọc này.</p>
      <% } else { %>
      <div id="stmtTabButtons" class="form-inline" style="flex-wrap:wrap; gap:6px; margin:14px 0;">
        <% stmtTabs.forEach(function(tab, i) { %>
        <button type="button" class="btn btn-secondary<%= i === 0 ? ' is-active' : '' %>"
          data-stmt-tab="stmtTab<%= tab.bankId %>" onclick="switchStmtTab('stmtTab<%= tab.bankId %>', this)">
          <%= tab.bankName %> (<%= COMPANIES[tab.company].shortLabel %>)
        </button>
        <% }) %>
      </div>

      <div class="form-inline" style="gap:8px; flex-wrap:wrap; margin-bottom:12px;">
        <input type="text" id="stmtSearchInput" placeholder="Lọc theo diễn giải / tên đối ứng..."
          style="flex:1; min-width:240px; max-width:420px; padding:7px 10px; border:1px solid var(--color-hairline); border-radius:6px;"
          onkeyup="filterStmtRows()">
        <!-- Luyen, 2026-08-03: "cho cái bộ lọc chỗ này là không màu hay màu
             xanh đi ... cứ cộng lại theo bộ lọc á ... như bộ lọc trong excel
             ấy" -- them loc theo trang thai da/chua doi soat (mau xanh =
             tx-matched), ket hop voi o tim kiem ben tren; tong thu/chi ngay
             duoi (xem filterStmtRows) tu tinh lai theo dung cac dong dang
             hien, giong autofilter + subtotal cua Excel. -->
        <select id="stmtStatusFilter" onchange="filterStmtRows()"
          style="padding:7px 10px; border:1px solid var(--color-hairline); border-radius:6px;">
          <option value="">-- Tất cả trạng thái --</option>
          <option value="matched">Đã đối soát (xanh)</option>
          <option value="unmatched">Chưa đối soát (không màu)</option>
        </select>
      </div>

      <% stmtTabs.forEach(function(tab, i) { %>
      <div class="stmt-tab-panel<%= i === 0 ? '' : ' is-hidden' %>" id="stmtTab<%= tab.bankId %>">
        <p class="muted" style="margin-bottom:8px;">
          Số dư đầu kỳ: <strong><%= tab.openingBalance.toLocaleString('vi-VN') %> đ</strong> —
          Tổng thu: <strong class="stmt-total-thu" style="color:var(--color-success)"><%= tab.totalThu.toLocaleString('vi-VN') %> đ</strong> —
          Tổng chi: <strong class="stmt-total-chi" style="color:var(--color-danger)"><%= tab.totalChi.toLocaleString('vi-VN') %> đ</strong>
          <span class="stmt-filter-note muted" style="font-size:12px; display:none;">(đang lọc)</span>
        </p>
        <div class="table-scroll">
          <table class="table">
            <thead>
              <tr><th>Ngày</th><th class="num">Thu</th><th class="num">Chi</th><th class="num">Số dư</th><th>Diễn giải</th><th>Tên đối ứng</th></tr>
            </thead>
            <tbody>
              <% tab.rows.forEach(function(r) { %>
              <tr class="<%= r.matched ? 'tx-matched' : '' %>" data-type="<%= r.type %>" data-amount="<%= r.amount %>" data-date="<%= r.date %>">
                <td>
                  <button type="button" class="stmt-merge-btn" title="Gộp vào dòng phía trên (chỉ nhóm hiển thị, không đổi dữ liệu thật)" onclick="mergeStmtRowUp(this)">⇪</button>
                  <%= r.date %>
                </td>
                <td class="num"><%= r.type === 'thu' ? r.amount.toLocaleString('vi-VN') + ' đ' : '' %></td>
                <td class="num" style="<%= r.type === 'chi' ? 'color:var(--color-danger);' : '' %>"><%= r.type === 'chi' ? r.amount.toLocaleString('vi-VN') + ' đ' : '' %></td>
                <td class="num"><%= r.balance.toLocaleString('vi-VN') %> đ</td>
                <td style="font-size:12px; max-width:360px; word-break:break-all;"><%= r.description %></td>
                <td class="ncc-cell" data-id="<%= r.id %>" data-val="<%= r.tenDoiUng || '' %>" onclick="nccCellClick(this)" style="cursor:pointer; min-width:120px;">
                  <% if (r.tenDoiUng) { %><%= r.tenDoiUng %><% } else { %><span style="color:#bbb;">—</span><% } %>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
      <% }) %>
      <% } %>
    </section>
  </main>
  <script>
    function switchStmtTab(tabId, btn) {
      document.querySelectorAll('.stmt-tab-panel').forEach(function (p) { p.classList.add('is-hidden'); });
      var target = document.getElementById(tabId);
      if (target) target.classList.remove('is-hidden');
      document.querySelectorAll('#stmtTabButtons .btn').forEach(function (b) { b.classList.remove('is-active'); });
      if (btn) btn.classList.add('is-active');
      filterStmtRows();
    }
    // Luyen, 2026-08-03: "cứ cộng lại theo bộ lọc á ... cứ cộng nhanh cho tôi
    // như bộ lọc trong excel ấy" -- loc ket hop CA 2 dieu kien (tim kiem chu +
    // trang thai da/chua doi soat), sau do TU TINH LAI Tổng thu/Tổng chi cua
    // tab dang xem chi tren cac dong dang HIEN (giong autofilter + subtotal
    // Excel), thay vi giu nguyen so tinh san tu server cho ca thang.
    function filterStmtRows() {
      var searchInput = document.getElementById('stmtSearchInput');
      var statusSelect = document.getElementById('stmtStatusFilter');
      var q = (searchInput ? searchInput.value : '').toLowerCase().trim();
      var status = statusSelect ? statusSelect.value : '';
      var activePanel = document.querySelector('.stmt-tab-panel:not(.is-hidden)');
      if (!activePanel) return;
      var rows = activePanel.querySelectorAll('tbody tr');
      var sumThu = 0, sumChi = 0;
      rows.forEach(function (tr) {
        if (tr.dataset.stmtMerged === '1') { tr.style.display = 'none'; return; }
        var text = (tr.cells[4].textContent + ' ' + tr.cells[5].textContent).toLowerCase();
        var matchesText = !q || text.indexOf(q) !== -1;
        var isMatched = tr.classList.contains('tx-matched');
        var matchesStatus = !status || (status === 'matched' && isMatched) || (status === 'unmatched' && !isMatched);
        var visible = matchesText && matchesStatus;
        tr.style.display = visible ? '' : 'none';
        if (visible) {
          var amt = parseFloat(tr.dataset.amount) || 0;
          if (tr.dataset.type === 'thu') sumThu += amt; else sumChi += amt;
        }
      });
      var thuEl = activePanel.querySelector('.stmt-total-thu');
      var chiEl = activePanel.querySelector('.stmt-total-chi');
      var noteEl = activePanel.querySelector('.stmt-filter-note');
      if (thuEl) thuEl.textContent = sumThu.toLocaleString('vi-VN') + ' đ';
      if (chiEl) chiEl.textContent = sumChi.toLocaleString('vi-VN') + ' đ';
      if (noteEl) noteEl.style.display = (q || status) ? '' : 'none';
    }

    // Luyen, 2026-07-31: "có thể nhấn nút giữ để cộng 2 giao dịch lại với
    // nhau" -- CHI gop HIEN THI (khong dung ho tro server/store.json gi ca),
    // giup xem nhanh 2 dong cung ngay (vd 2 dong VNPay "DV QR OFFLINE"/"DV
    // CTT" cung 1 ngay) cong lai bao nhieu ma khong can bam may tinh tay.
    // Bam nut o dong duoi se gop vao dong PHIA TREN GAN NHAT dang hien (bo
    // qua dong da an do gop truoc do), chi cho gop 2 dong CUNG loai (cung
    // Thu hoac cung Chi). Dong da gop se AN di, dong con lai hien so da cong
    // + 1 dong ghi chu nho co nut "Bo gop" de hoan tac -- KHONG luu lai qua
    // lan tai trang (chi la cong cu xem nhanh tam thoi, dung y dinh).
    function mergeStmtRowUp(btn) {
      var row = btn.closest('tr');
      var prev = row.previousElementSibling;
      while (prev && prev.style.display === 'none') prev = prev.previousElementSibling;
      if (!prev || prev.dataset.type === undefined) {
        alert('Không có dòng phía trên (trong cùng ngân hàng) để gộp.');
        return;
      }
      if (row.dataset.type !== prev.dataset.type) {
        alert('Chỉ gộp được 2 dòng CÙNG LOẠI (cùng Thu hoặc cùng Chi) với nhau.');
        return;
      }
      var amountCellIdx = row.dataset.type === 'thu' ? 1 : 2;
      var rowAmount = parseFloat(row.dataset.amount);
      var newAmount = parseFloat(prev.dataset.amount) + rowAmount;
      prev.dataset.amount = String(newAmount);
      prev.cells[amountCellIdx].textContent = newAmount.toLocaleString('vi-VN') + ' đ';

      var dienGiaiCell = prev.cells[4];
      var note = document.createElement('div');
      note.className = 'muted stmt-merge-note';
      note.style.cssText = 'font-size:11px; margin-top:4px; padding-top:4px; border-top:1px dashed var(--color-hairline);';
      var descSnippet = row.cells[4] ? row.cells[4].textContent.trim().slice(0, 70) : '';
      note.textContent = '+ Đã gộp ' + (row.dataset.date || '') + ': ' + descSnippet + ' (' + rowAmount.toLocaleString('vi-VN') + ' đ) ';
      var undoBtn = document.createElement('button');
      undoBtn.type = 'button';
      undoBtn.textContent = '↩ Bỏ gộp';
      undoBtn.className = 'stmt-merge-undo';
      undoBtn.onclick = function () {
        var restored = parseFloat(prev.dataset.amount) - rowAmount;
        prev.dataset.amount = String(restored);
        prev.cells[amountCellIdx].textContent = restored.toLocaleString('vi-VN') + ' đ';
        note.remove();
        row.style.display = '';
        row.dataset.stmtMerged = '';
      };
      note.appendChild(undoBtn);
      dienGiaiCell.appendChild(note);

      row.dataset.stmtMerged = '1';
      row.style.display = 'none';
    }

    // Luyen, 2026-08-18: click vào ô NCC ("—") để điền tên thụ hưởng thẳng
    function nccCellClick(td) {
      if (td.querySelector('input')) return; // already editing
      var txId = td.dataset.id;
      var curVal = td.dataset.val || '';
      var orig = td.innerHTML;
      td.innerHTML = '';
      var inp = document.createElement('input');
      inp.type = 'text';
      inp.value = curVal;
      inp.placeholder = 'Tên đối ứng...';
      inp.style.cssText = 'width:180px; font-size:12px; padding:2px 5px;';
      var saveBtn = document.createElement('button');
      saveBtn.textContent = '✓';
      saveBtn.title = 'Lưu';
      saveBtn.style.cssText = 'margin-left:4px; font-size:13px; color:#2a7; cursor:pointer; border:none; background:none;';
      var cancelBtn = document.createElement('button');
      cancelBtn.textContent = '✕';
      cancelBtn.title = 'Huỷ';
      cancelBtn.style.cssText = 'margin-left:2px; font-size:13px; color:#e33; cursor:pointer; border:none; background:none;';
      td.appendChild(inp); td.appendChild(saveBtn); td.appendChild(cancelBtn);
      inp.focus();

      async function doSave() {
        var newVal = inp.value.trim();
        var fd = new FormData();
        fd.append('tenDoiUng', newVal);
        try { await fetch('/transactions/' + txId + '/update-ncc', { method: 'POST', body: fd }); } catch(e) {}
        td.dataset.val = newVal;
        td.innerHTML = newVal ? newVal : '<span style="color:#bbb;">—</span>';
      }

      saveBtn.addEventListener('click', doSave);
      inp.addEventListener('keydown', function(e) { if (e.key === 'Enter') doSave(); if (e.key === 'Escape') { td.innerHTML = orig; } });
      cancelBtn.addEventListener('click', function() { td.innerHTML = orig; });
    }
  </script>
  <style>
    .stmt-merge-btn {
      border: 1px solid var(--color-hairline);
      background: #fff;
      border-radius: 4px;
      font-size: 11px;
      line-height: 1;
      padding: 2px 5px;
      margin-right: 6px;
      cursor: pointer;
      color: var(--color-primary);
    }
    .stmt-merge-btn:hover { background: var(--color-primary-soft); }
    .stmt-merge-undo {
      border: none;
      background: none;
      color: var(--color-primary);
      text-decoration: underline;
      cursor: pointer;
      font-size: 11px;
      padding: 0;
      margin-left: 4px;
    }
  </style>
</body>
</html>

<script>
  // Global (dung tu inline onclick tren nut dropdown) -- toggle 1 dropdown,
  // dong het cac dropdown khac dang mo truoc do.
  function toggleNavDropdown(id) {
    var target = document.getElementById(id);
    if (!target) return;
    var wasOpen = target.classList.contains("is-open");
    document.querySelectorAll(".nav-dropdown.is-open").forEach(function (dd) {
      dd.classList.remove("is-open");
    });
    if (!wasOpen) target.classList.add("is-open");
  }
</script>
<script>
  (function () {
    // Cau hoi tham / vui nhon doi moi 10 giay -- nhieu cau khac nhau, lap
    // vong tron. Fade out/in nhe cho muot mat thay vi doi chu dot ngot.
    var aquaMessages = [
      "Chào chị Nhẫn! 🐠",
      "Hôm nay chị ăn gì chưa nè? 🍜",
      "Bơi bơi~ chị nhớ uống nước nha!",
      "Số liệu đối soát xong chưa chị ơi?",
      "Chị cười lên nào, hôm nay đẹp trời ghê!",
      "Ăn no rồi làm việc mới có sức chị ơi!",
      "Em cá chúc chị một ngày làm việc suôn sẻ!",
      "Đói bụng chưa chị? Em cũng đói nè 🐟",
      "Nghỉ tay uống miếng nước đi chị!",
      "Sổ sách khớp hết là em cá mừng lắm đó!",
      "Chị làm việc chăm ghê, giỏi quá!",
      "Trưa nay ăn gì chị nhỉ? Em cá tò mò ghê!",
      "Chúc chị một ngày nhiều may mắn như sóng vỗ về nha!",
      "Đối soát mệt hong chị? Ráng lên nè!",
      "Em cá ở đây hỗ trợ chị 24/7 nha!",
      "Chị nhớ giữ sức khỏe, đừng thức khuya quá nha!",
      "Bơi bơi, hôm nay chị vui không? 🌊",
      "Ăn thêm chút trái cây cho khỏe chị ơi!",
      "Xong việc rồi tự thưởng ly trà sữa nha chị!",
      "Chị giỏi lắm, mọi lệnh đều đâu vào đó hết!"
    ];
    var aquaIdx = 0;
    var aquaBubble = document.getElementById("aquaBubble");
    if (aquaBubble) {
      setInterval(function () {
        aquaBubble.classList.add("is-fading");
        setTimeout(function () {
          aquaIdx = (aquaIdx + 1) % aquaMessages.length;
          aquaBubble.textContent = aquaMessages[aquaIdx];
          aquaBubble.classList.remove("is-fading");
        }, 350);
      }, 10000);
    }
  })();
</script>
<script>
  (function () {
    var navLinks = Array.prototype.slice.call(document.querySelectorAll(".nav-links > a, .nav-dropdown-menu a"));
    var path = window.location.pathname;
    var best = null;
    navLinks.forEach(function (a) {
      var href = a.getAttribute("href");
      if (href === "/" ? path === "/" : path.indexOf(href) === 0) {
        if (!best || href.length > best.getAttribute("href").length) best = a;
      }
    });
    if (best) {
      best.style.opacity = "1";
      best.style.borderBottomColor = "#ffffff";
      best.style.background = "rgba(255,255,255,0.08)";
      // Neu link dang active nam trong 1 dropdown, highlight luon nut bam
      // mo dropdown do (vd dang o "/doi-soat/momo" thi to sang chu "Ngan
      // hang", khong chi dong menu con ben trong).
      var parentDropdown = best.closest(".nav-dropdown");
      if (parentDropdown) {
        var toggleBtn = parentDropdown.querySelector(".nav-dropdown-toggle");
        if (toggleBtn) { toggleBtn.style.opacity = "1"; toggleBtn.style.background = "rgba(255,255,255,0.08)"; }
      }
    }
    // Cac trang doi soat (Momo/ZVP/VietQR) trong dropdown "Ngan hang" la nut
    // form (POST /chon-cong-ty), khong co href de so khop nhu tren -- kiem
    // tra rieng theo path de to sang nut "Ngan hang" khi dang o may trang do.
    var bankPaths = ["/doi-soat/momo", "/doi-soat/zvp", "/doi-soat/vietqr", "/doi-soat/vnpay-khmoi", "/doi-soat/chi-phi"];
    if (bankPaths.some(function (p) { return path.indexOf(p) === 0; })) {
      var bankToggle = document.querySelector("#navDropdownBank .nav-dropdown-toggle");
      if (bankToggle) { bankToggle.style.opacity = "1"; bankToggle.style.background = "rgba(255,255,255,0.08)"; }
    }

    var toTopBtn = document.getElementById("btnToTop");
    var goBackBtn = document.getElementById("btnGoBack");
    var goBackTopBtn = document.getElementById("btnGoBackTop");
    if (window.history.length <= 1) {
      if (goBackBtn) goBackBtn.classList.add("is-hidden");
      if (goBackTopBtn) goBackTopBtn.style.display = "none";
    }
    window.addEventListener("scroll", function () {
      if (!toTopBtn) return;
      if (window.scrollY > 300) toTopBtn.classList.remove("is-hidden");
      else toTopBtn.classList.add("is-hidden");
    });

    // Dropdown "Ngan hang" / "Phap danh": bam de mo/dong (khong dung hover
    // -- de xai duoc tot tren cam ung), tu dong dong lai khi bam ra ngoai
    // hoac dong dropdown kia dang mo.
    document.addEventListener("click", function (e) {
      var openDropdowns = document.querySelectorAll(".nav-dropdown.is-open");
      openDropdowns.forEach(function (dd) {
        if (!dd.contains(e.target)) dd.classList.remove("is-open");
      });
    });

    var topbar = document.querySelector(".topbar");
    function updateTopbarHeight() {
      if (!topbar) return;
      document.documentElement.style.setProperty("--topbar-h", topbar.offsetHeight + "px");
    }
    updateTopbarHeight();
    window.addEventListener("resize", updateTopbarHeight);
    if (window.ResizeObserver && topbar) {
      new ResizeObserver(updateTopbarHeight).observe(topbar);
    }
  })();
</script>
<script>
  // Chi Nhan (2026-07-21): "thông báo hiện ba giây thôi rồi tắt đi, các
  // trang trong web đều có" -- banner .alert-success/.alert-error (thong bao
  // ket qua sau khi bam nut/luu form) tu dong mo dan roi an sau 1 khoang thoi
  // gian, o TAT CA trang (dat trong nav.ejs vi partial nay duoc include o moi
  // trang). Chi Nhan doi lai thanh 5 giay ngay sau do ("cái thông báo hiển
  // thị năm giây thôi rồi tắt đi").
  // Van giu nguyen noi dung HTML (khong xoa khoi DOM) -- chi ho bien mat khoi
  // man hinh bang opacity/height, phong khi Luyen can doc lai (bam F5 la lai
  // hien vi query ?success=... con nguyen tren URL).
  //
  // Nhan, 2026-07-22: script nay dat trong nav.ejs, ma nav.ejs duoc include
  // NGAY DAU <body> (truoc <main>) o tat ca trang -- neu chay ngay (khong
  // cho DOM tai xong) thi luc script chay, .alert-success/.alert-error (nam
  // trong <main>, o SAU nav trong HTML) CHUA TON TAI trong DOM, nen
  // querySelectorAll luon tra ve rong va script tu thoat ma khong lam gi ca.
  // Bug nay khien tinh nang tu an banner KHONG THUC SU CHAY tu truoc den gio
  // (dau la request "hiển thị năm giây rồi tắt" da lam nhung chua bao gio
  // thuc su hoat dong). Sua bang cach cho DOMContentLoaded truoc khi chay.
  document.addEventListener("DOMContentLoaded", function () {
    var alerts = document.querySelectorAll(".alert-success, .alert-error");
    if (!alerts.length) return;
    alerts.forEach(function (el) {
      el.style.transition = "opacity .4s ease, max-height .4s ease, margin .4s ease, padding .4s ease";
      el.style.overflow = "hidden";
      setTimeout(function () {
        el.style.opacity = "0";
        el.style.maxHeight = "0";
        el.style.marginBottom = "0";
        el.style.paddingTop = "0";
        el.style.paddingBottom = "0";
      }, 5000);
    });
  });
</script>
<%- include('panel-toggle') %>
<%- include('scroll-restore') %>
<% if (typeof userRole !== "undefined" && userRole === "viewer") { %>
<script>
  // Chi Nhan (2026-07-21): tai khoan "chi xem" -- an bot moi form/nut thao
  // tac ghi/sua/xoa/tai len (chi de UI do nhin, khong phai lop bao ve chinh:
  // middleware/auth.js requireAdmin da chan that su o backend, chan du
  // form co bi lo ra do JS chua kip chay hay bi tat JS thi thao tac van bi
  // tu choi). Giu lai (khong an) 2 form dung chung cho ca 2 quyen: chuyen
  // cong ty (/chon-cong-ty, chi loc/xem) va doi mat khau cua chinh minh
  // (/account/password). Tat ca form POST khac deu la thao tac ghi -- an
  // luon (khong chi disable) de trang do gon, khong roi mat voi nut khong
  // dung duoc.
  (function () {
    var ALLOWED_ACTIONS = ["/chon-cong-ty", "/account/password", "/logout"];
    document.querySelectorAll('form[method="POST" i]').forEach(function (form) {
      var action = form.getAttribute("action") || "";
      if (ALLOWED_ACTIONS.some(function (a) { return action.indexOf(a) === 0; })) return;
      form.style.display = "none";
    });
  })();
</script>
<% } else if (typeof userRole !== "undefined" && userRole === "nhap_lieu") { %>
<script>
  // Luyen (2026-07-24): tai khoan "Nhap lieu" -- duoc them/sua/tai len du
  // lieu nghiep vu binh thuong (KHONG an cac form do), chi an cac form
  // XOA/CLEAR va cac form CAU HINH he thong (khoa so, mapping TK Co/TK No,
  // an gian, sua CSE...) ma backend cung tu choi (xem middleware/auth.js
  // requireAdmin/requireDataEntry) -- day CUNG chi la UI cho do nhin, lop
  // bao ve chinh van o backend, phong khi 1 form nao do lot khoi danh sach
  // nhan dien duoi day.
  (function () {
    var HIDE_IF_ACTION_CONTAINS = [
      "/delete", "/xoa", "/clear",
      "/khoa-so", "/mapping", "/gian-hidden", "/online-gian-fix", "/vendor-tk",
    ];
    document.querySelectorAll('form[method="POST" i]').forEach(function (form) {
      var action = form.getAttribute("action") || "";
      if (HIDE_IF_ACTION_CONTAINS.some(function (a) { return action.indexOf(a) !== -1; })) {
        form.style.display = "none";
      }
    });
  })();
</script>
<% } %>

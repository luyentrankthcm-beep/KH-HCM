<header class="topbar">
  <span class="pig-runner" aria-hidden="true">🐷</span>
  <div class="brand">
    <span class="brand-name">K&amp;H Bank Tracker</span>
    <span class="brand-sub"><%= COMPANIES[activeCompany].fullName %></span>
  </div>
  <!-- Nut chuyen cong ty: Doi soat Momo/Viet QR/Chi phi loc du lieu theo
       cong ty dang chon o day (luu trong session, rieng cho tung nguoi
       dung). Cac trang Tong quan/Bao cao/Cong no/Giao dich chua tach theo
       cong ty -- van hien theo KH Cu nhu truoc gio. -->
  <form method="POST" action="/chon-cong-ty" class="company-switch" title="Chuyển công ty đang xem cho Đối soát Momo / Viet QR / Chi phí">
    <input type="hidden" name="redirectTo" value="<%= currentPath %>" />
    <% Object.values(COMPANIES).forEach(function (c) { %>
    <button type="submit" name="company" value="<%= c.key %>" class="company-btn <%= activeCompany === c.key ? 'is-active' : '' %>"><%= c.shortLabel %></button>
    <% }) %>
  </form>
  <nav class="nav-links">
    <a href="/">Tổng quan</a>
    <a href="/transactions">Giao dịch / Sao kê</a>
    <a href="/banks">Ngân hàng</a>
    <a href="/doi-soat/momo">Đối soát Momo</a>
    <% if (activeCompany === "kh_cu") { %>
    <a href="/doi-soat/zvp">Đối soát Zalo/VNPay/Payoo</a>
    <% } %>
    <a href="/doi-soat/vietqr">Đối soát Viet QR</a>
    <a href="/doi-soat/chi-phi">Đối soát Chi phí</a>
    <a href="/bao-cao">Báo cáo</a>
    <a href="/cong-no">Công nợ</a>
    <a href="/he-thong/sao-luu">Sao lưu</a>
  </nav>
  <div class="nav-user">
    <span><%= userName %></span>
    <form method="POST" action="/logout" style="display:inline">
      <button type="submit" class="link-btn">Đăng xuất</button>
    </form>
  </div>
</header>

<!-- Nút nổi hỗ trợ di chuyển trên trang dài: "Quay lại" (trang trước đó,
     ẩn nếu đây là trang đầu tiên mở) và "Lên đầu trang" (hiện khi đã cuộn
     xuống, để không che nội dung lúc mới vào trang). -->
<div class="float-nav">
  <button type="button" class="float-nav-btn" id="btnGoBack" title="Quay lại" onclick="history.back()">←</button>
  <button type="button" class="float-nav-btn is-hidden" id="btnToTop" title="Lên đầu trang" onclick="window.scrollTo({top:0,behavior:'smooth'})">↑</button>
</div>

<!-- Heo mascot goc duoi trai -- bong thoai doi cau moi 10s (Luyen yeu cau
     2026-07-17). Ve SVG tay ngay trong trang, khong can file anh rieng. -->
<div class="pig-mascot" aria-hidden="true">
  <div class="pig-bubble" id="pigBubble">Chào chị Nhẫn! 🐷</div>
  <svg class="pig-mascot-face" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
    <ellipse cx="50" cy="56" rx="42" ry="38" fill="#ffb3c9"/>
    <ellipse cx="18" cy="22" rx="14" ry="16" fill="#ffb3c9" transform="rotate(-20 18 22)"/>
    <ellipse cx="82" cy="22" rx="14" ry="16" fill="#ffb3c9" transform="rotate(20 82 22)"/>
    <ellipse cx="18" cy="24" rx="7" ry="9" fill="#ff8fab" transform="rotate(-20 18 24)"/>
    <ellipse cx="82" cy="24" rx="7" ry="9" fill="#ff8fab" transform="rotate(20 82 24)"/>
    <circle cx="22" cy="60" r="8" fill="#ff9ebd" opacity="0.6"/>
    <circle cx="78" cy="60" r="8" fill="#ff9ebd" opacity="0.6"/>
    <circle cx="36" cy="48" r="5" fill="#4a2b1f"/>
    <circle cx="64" cy="48" r="5" fill="#4a2b1f"/>
    <circle cx="38" cy="46" r="1.6" fill="#fff"/>
    <circle cx="66" cy="46" r="1.6" fill="#fff"/>
    <ellipse cx="50" cy="66" rx="18" ry="13" fill="#ff8fab"/>
    <ellipse cx="43" cy="66" rx="3" ry="4" fill="#c9436a"/>
    <ellipse cx="57" cy="66" rx="3" ry="4" fill="#c9436a"/>
    <path d="M 40 79 Q 50 85 60 79" stroke="#c9436a" stroke-width="2" fill="none" stroke-linecap="round"/>
  </svg>
</div>
<script>
  (function () {
    // Cau hoi tham / vui nhon doi moi 10 giay -- nhieu cau khac nhau, lap
    // vong tron. Fade out/in nhe cho muot mat thay vi doi chu dot ngot.
    var pigMessages = [
      "Chào chị Nhẫn! 🐷",
      "Hôm nay chị ăn gì chưa nè? 🍜",
      "Ụt ụt~ chị nhớ uống nước nha!",
      "Số liệu đối soát xong chưa chị ơi?",
      "Chị cười lên nào, hôm nay đẹp trời ghê!",
      "Ăn no rồi làm việc mới có sức chị ơi!",
      "Em heo chúc chị một ngày làm việc suôn sẻ!",
      "Đói bụng chưa chị? Em cũng đói nè 🐽",
      "Nghỉ tay uống miếng nước đi chị!",
      "Sổ sách khớp hết là em heo mừng lắm đó!",
      "Chị làm việc chăm ghê, giỏi quá!",
      "Trưa nay ăn gì chị nhỉ? Em heo tò mò ghê!",
      "Chúc chị một ngày nhiều may mắn nha!",
      "Đối soát mệt hong chị? Ráng lên nè!",
      "Em heo ở đây hỗ trợ chị 24/7 nha!",
      "Chị nhớ giữ sức khỏe, đừng thức khuya quá nha!",
      "Ụt ịt, hôm nay chị vui không?",
      "Ăn thêm chút trái cây cho khỏe chị ơi!",
      "Xong việc rồi tự thưởng ly trà sữa nha chị!",
      "Chị giỏi lắm, mọi lệnh đều đâu vào đó hết!"
    ];
    var pigIdx = 0;
    var pigBubble = document.getElementById("pigBubble");
    if (pigBubble) {
      setInterval(function () {
        pigBubble.classList.add("is-fading");
        setTimeout(function () {
          pigIdx = (pigIdx + 1) % pigMessages.length;
          pigBubble.textContent = pigMessages[pigIdx];
          pigBubble.classList.remove("is-fading");
        }, 350);
      }, 10000);
    }
  })();
</script>
<script>
  (function () {
    var navLinks = Array.prototype.slice.call(document.querySelectorAll(".nav-links a"));
    var path = window.location.pathname;
    var best = null;
    navLinks.forEach(function (a) {
      var href = a.getAttribute("href");
      if (href === "/" ? path === "/" : path.indexOf(href) === 0) {
        if (!best || href.length > best.getAttribute("href").length) best = a;
      }
    });
    if (best) {
      best.style.opacity = "1";
      best.style.borderBottomColor = "#ffffff";
      best.style.background = "rgba(255,255,255,0.08)";
    }

    var toTopBtn = document.getElementById("btnToTop");
    var goBackBtn = document.getElementById("btnGoBack");
    if (goBackBtn && window.history.length <= 1) {
      goBackBtn.classList.add("is-hidden");
    }
    window.addEventListener("scroll", function () {
      if (!toTopBtn) return;
      if (window.scrollY > 300) toTopBtn.classList.remove("is-hidden");
      else toTopBtn.classList.add("is-hidden");
    });

    var topbar = document.querySelector(".topbar");
    function updateTopbarHeight() {
      if (!topbar) return;
      document.documentElement.style.setProperty("--topbar-h", topbar.offsetHeight + "px");
    }
    updateTopbarHeight();
    window.addEventListener("resize", updateTopbarHeight);
    if (window.ResizeObserver && topbar) {
      new ResizeObserver(updateTopbarHeight).observe(topbar);
    }
  })();
</script>

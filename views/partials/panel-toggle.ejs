<!--
  Luyen, 2026-07-17: "mỗi cái khung này nè thêm cho tôi cái gốc phải phía
  trên có chữ hiện và ẩn đi chứ để trang rối quá" -- moi <section class="panel">
  qua nhieu (đối soát Momo/VietQR/Zalo-VNPay-Payoo deu co hang chuc khung),
  nen them nut "Ẩn"/"Hiện" o goc phai tieu de h2 cua TUNG khung de tu thu gon
  bot, khong can sua tung file/tung section rieng -- dung chung 1 script nay,
  include o cuoi moi trang doi soat. Nho trang thai an/hien qua localStorage
  (theo dung URL + noi dung tieu de) nen lan sau vao lai khong bi mo lai het.

  Luyen, 2026-07-20: "hiện khung ẩn hay hiện cho tôi và tất cả các cái nào có
  ẩn hiện khi mở đều trong trạng thái ẩn nhá" -- 2 thay doi:
  1) Mac dinh LAN DAU vao trang (chua co localStorage luu) la AN (collapsed),
     truoc day mac dinh la HIEN -- lam trang rat dai/roi khi vao lan dau.
  2) Them icon mui ten (▾ dang mo / ▸ dang an) canh chu "Ẩn"/"Hiện" de nhin
     ro trang thai hon la chi doc chu.

  Nhan, 2026-07-22: "tất cả các khung đều có nút ẩn cho tôi nhá" -- truoc day
  chi 3 trang doi soat (Momo/VietQR/Zalo-VNPay-Payoo) tu include partial nay,
  cac trang khac (Chi Phi, Phap danh...) khong co. Gio include 1 lan DUY NHAT
  trong nav.ejs (o moi trang) de TAT CA <section class="panel"> o TAT CA
  trang deu tu dong co nut Ẩn/Hiện, khong can sua tung file. Vi nav.ejs nam
  o DAU <body> (truoc <main>, noi chua cac section.panel), script phai cho
  DOMContentLoaded roi moi chay (giong bug vua sua o script an banner trong
  nav.ejs) -- neu khong se khong tim thay panel nao ca.
-->
<style>
  section.panel > h2:first-child {
    position: relative;
    padding-right: 64px;
  }
  .panel-toggle-btn {
    position: absolute;
    top: -2px;
    right: 0;
    background: none;
    border: 1px solid var(--color-primary, #d46a9f);
    border-radius: 999px;
    color: var(--color-primary, #d46a9f);
    cursor: pointer;
    font-size: 12px;
    padding: 3px 12px;
    line-height: 1.4;
    white-space: nowrap;
  }
  .panel-toggle-btn:hover { opacity: 0.75; }
  .panel-toggle-btn .panel-toggle-icon { display: inline-block; margin-right: 4px; }
  /* Details/summary "Xem N mã", "Chi tiết"... deu la <details> native, da mac
     dinh dong; them style cho marker de nhin ro hon dang dong (▸) / dang mo (▾). */
  details > summary { cursor: pointer; }
  details > summary::marker { color: var(--color-primary, #d46a9f); }
</style>
<script>
  document.addEventListener("DOMContentLoaded", function () {
    // Neu 1 trang nao do vo tinh con include partial nay lan 2 (vd file cu
    // chua don), tranh chay lai/tao nut lap doi tren cung 1 panel.
    if (window.__khbtPanelToggleInit) return;
    window.__khbtPanelToggleInit = true;

    var STORAGE_PREFIX = "khbt_panel_collapsed:" + location.pathname + ":";
    // Nhan, 2026-07-29: "cái này lúc nào cx ở trang thái hiện cho tôi" -- khung
    // "Danh sách giao dịch" (trang Ngân hàng) LUON mo san moi lan vao trang,
    // KHONG phu thuoc localStorage lan truoc (khac cac khung khac -- van mac
    // dinh AN lan dau roi nho trang thai lan sau nhu Nhan/Luyen tung yeu cau
    // truoc do). Nut Ẩn/Hiện van hoat dong binh thuong de xem tam trong luc
    // dang o trang, chi la lan TAI TRANG SAU khong bi ket o trang thai an nua.
    var ALWAYS_EXPANDED_TITLES = ["Danh sách giao dịch"];
    var panels = document.querySelectorAll("section.panel");
    panels.forEach(function (panel, idx) {
      var h2 = panel.querySelector("h2");
      if (!h2 || h2.parentElement !== panel) return;
      var key = STORAGE_PREFIX + (h2.textContent.trim() || String(idx));

      // Gom toan bo cac phan tu SAU h2 (truc tiep trong section nay) vao 1
      // wrapper de an/hien cung luc bang 1 nut duy nhat.
      var wrapper = document.createElement("div");
      wrapper.className = "panel-collapsible-body";
      var node = h2.nextSibling;
      while (node) {
        var next = node.nextSibling;
        wrapper.appendChild(node);
        node = next;
      }
      panel.appendChild(wrapper);

      var btn = document.createElement("button");
      btn.type = "button";
      btn.className = "panel-toggle-btn";
      h2.appendChild(btn);

      function setState(collapsed) {
        wrapper.style.display = collapsed ? "none" : "";
        var icon = collapsed ? "▸" : "▾";
        var label = collapsed ? "Hiện" : "Ẩn";
        btn.innerHTML = '<span class="panel-toggle-icon">' + icon + "</span>" + label;
        try {
          localStorage.setItem(key, collapsed ? "1" : "0");
        } catch (e) {}
      }

      var saved = null;
      try {
        saved = localStorage.getItem(key);
      } catch (e) {}
      var alwaysExpanded = ALWAYS_EXPANDED_TITLES.indexOf(h2.textContent.trim()) !== -1;
      // Chua co gia tri luu (lan dau vao trang) -> mac dinh AN (collapsed).
      // Rieng cac khung trong ALWAYS_EXPANDED_TITLES -- bo qua gia tri da luu,
      // MOI LAN vao trang deu mo san.
      setState(alwaysExpanded ? false : saved === null ? true : saved === "1");

      btn.addEventListener("click", function () {
        setState(wrapper.style.display !== "none");
      });
    });
  });
</script>

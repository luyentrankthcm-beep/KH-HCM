<!DOCTYPE html>
<html lang="vi">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/nav') %>
  <main class="container">
    <h1>Đối soát Viet QR — <%= COMPANIES[activeCompany].label %> (<%= channels.map(function(c){ return c.label; }).join(' / ') %>)</h1>
    <p class="muted">
      Viet QR về ngân hàng từng giao dịch một (không gộp theo đợt như Momo/Zalo/VNPay), nên web đối soát theo TỪNG
      NGÀY: cộng hết tiền QR về ngày đó, tách theo gian dựa vào file "Dữ liệu"/"Cửa hàng" bạn tải lên, rồi dò khớp
      với danh sách hóa đơn dùng chung (gắn thẻ theo từng ngân hàng). Diễn giải khi xuất MISA luôn dùng đúng mẫu
      "Thu tiền dịch vụ vui chơi giải trí theo HĐ ...".
    </p>

    <% if (error) { %><div class="alert alert-error" id="autohide-error"><%= error %></div><% } %>
    <% if (success) { %><div class="alert alert-success" id="autohide-success"><%= success %></div><% } %>

    <% if (typeof allCrossMatchSuggestions !== 'undefined' && allCrossMatchSuggestions.length > 0) { %>
    <% if (allCrossMatchSuggestions.length > 1) { %>
    <form method="POST" action="/doi-soat/vietqr/cross-match-all" style="margin-bottom:10px;"
          onsubmit="return confirm('Đồng ý đối trừ hàng loạt cả <%= allCrossMatchSuggestions.length %> cặp gợi ý bên dưới?');">
      <input type="hidden" name="items" value='<%- JSON.stringify(allCrossMatchSuggestions.map(function(s){
        return { channel: s.channel, settlementDate: s.settlementDate, fromCode: s.fromCode, toCode: s.toCode };
      })).replace(/'/g, "&#39;") %>' />
      <button type="submit" class="btn btn-primary">Đồng ý tất cả, đối trừ hàng loạt (<%= allCrossMatchSuggestions.length %> cặp)</button>
    </form>
    <% } %>
    <% allCrossMatchSuggestions.forEach(function(s) { %>
    <div class="alert" style="border:1px solid #f0b; background:#fff6fb;">
      <strong>Nghi ngờ hóa đơn map sai ngày <%= s.settlementDate %> (<%= s.channelLabel %>):</strong>
      "<%= s.fromLabel %>" đang dư hóa đơn <%= s.amount.toLocaleString('vi-VN') %>đ, đúng bằng phần
      "<%= s.toLabel %>" đang thiếu. Có thể 1 hóa đơn bị gán nhầm/gộp nhầm giữa 2 gian này — bạn có muốn đối trừ
      tạm (chuyển phần dư qua) để khớp cả 2 không? Nhớ xem lại số hóa đơn thật để xác nhận sau.
      <form method="POST" action="/doi-soat/vietqr/cross-match/<%= s.channel %>" class="form-inline" style="margin-top:8px;">
        <input type="hidden" name="settlementDate" value="<%= s.settlementDate %>" />
        <input type="hidden" name="fromCode" value="<%= s.fromCode %>" />
        <input type="hidden" name="toCode" value="<%= s.toCode %>" />
        <button type="submit" class="btn btn-primary">Đồng ý, đối trừ</button>
      </form>
    </div>
    <% }) %>
    <% } %>

    <script>
      // Tu an bot banner thanh cong / loi sau vai giay de trong cho,
      // khong can bam tay - giong trang Doi soat Zalo/VNPay/Payoo.
      (function () {
        var ids = ["autohide-success", "autohide-error"];
        ids.forEach(function (id) {
          var el = document.getElementById(id);
          if (!el) return;
          setTimeout(function () {
            el.style.transition = "opacity 0.6s ease, max-height 0.6s ease, margin 0.6s ease, padding 0.6s ease";
            el.style.opacity = "0";
            el.style.maxHeight = "0";
            el.style.overflow = "hidden";
            el.style.marginTop = "0";
            el.style.marginBottom = "0";
            el.style.paddingTop = "0";
            el.style.paddingBottom = "0";
          }, 3000);
        });
      })();
    </script>

    <% channels.forEach(function(chInfo) { var ch = chInfo.key; %>
    <section class="panel">
      <details>
        <summary style="font-weight:700;color:#111;cursor:pointer;">Tải file dữ liệu Viet QR — <%= chInfo.label %></summary>
        <div style="margin-top:12px;">
      <p class="muted">File chứa sheet "Dữ liệu"/"Hệ thống" (giao dịch QR) + sheet "Cửa hàng" (tên điểm bán) trong cùng 1 file.</p>
      <form method="POST" action="/doi-soat/vietqr/upload-raw/<%= ch %>" enctype="multipart/form-data" class="form-inline">
        <input type="file" name="file" accept=".xlsx,.xls" required />
        <button type="submit" class="btn btn-primary">Tải lên</button>
      </form>
      <% var qrUps = rawUploads[ch] || []; %>
      <% var qrTotalRows = qrUps.reduce(function(s, u){ return s + (u.rows||[]).length; }, 0); %>
      <details style="margin-top:12px;">
        <summary class="muted" style="cursor:pointer;">
          Đã tải <%= qrUps.length %> lần, tổng <%= qrTotalRows %> giao dịch (bấm để xem chi tiết)
        </summary>
        <table class="table" style="margin-top:10px;">
          <thead><tr><th>File</th><th>Sheet</th><th>Số giao dịch</th><th>Lúc tải</th><th></th></tr></thead>
          <tbody>
            <% qrUps.forEach(function(u) { %>
            <tr>
              <td><%= u.file_name %></td>
              <td><%= u.sheetName %></td>
              <td><%= (u.rows || []).length %></td>
              <td><%= new Date(u.uploaded_at).toLocaleString('vi-VN') %></td>
              <td>
                <form method="POST" action="/doi-soat/vietqr/upload-raw/<%= ch %>/<%= u.id %>/delete" onsubmit="return confirm('Xoá bảng dữ liệu QR này?');">
                  <button type="submit" class="link-btn link-danger">Xoá</button>
                </form>
              </td>
            </tr>
            <% }) %>
            <% if (qrUps.length === 0) { %>
            <tr><td colspan="5" class="muted">Chưa tải file nào cho kênh này.</td></tr>
            <% } %>
          </tbody>
        </table>
      </details>

      <div style="margin-top:16px; padding-top:12px; border-top:1px dashed #ddd;">
        <p class="muted" style="margin-bottom:6px;">
          Danh sách điểm bán riêng ("store_export") — nạp trước tên điểm bán mới nhất, không cần chờ có giao dịch QR.
          Cộng dồn vào danh sách cũ; nếu có mã cửa hàng mới hoặc đổi tên điểm bán sẽ cảnh báo ngay.
        </p>
        <form method="POST" action="/doi-soat/vietqr/upload-store/<%= ch %>" enctype="multipart/form-data" class="form-inline">
          <input type="file" name="file" accept=".xlsx,.xls" required />
          <button type="submit" class="btn btn-secondary">Tải danh sách điểm bán</button>
        </form>
        <% var storeUps = storeUploads[ch] || []; %>
        <details style="margin-top:10px;">
          <summary class="muted" style="cursor:pointer;">
            Đã tải <%= storeUps.length %> lần (bấm để xem chi tiết, có thể xoá nếu lỡ tải nhầm)
          </summary>
          <table class="table" style="margin-top:10px;">
            <thead><tr><th>File</th><th>Sheet</th><th>Số điểm bán</th><th>Lúc tải</th><th></th></tr></thead>
            <tbody>
              <% storeUps.forEach(function(u) { %>
              <tr>
                <td><%= u.file_name %></td>
                <td><%= u.sheetName %></td>
                <td><%= Object.keys(u.map || {}).length %></td>
                <td><%= new Date(u.uploaded_at).toLocaleString('vi-VN') %></td>
                <td>
                  <form method="POST" action="/doi-soat/vietqr/upload-store/<%= ch %>/<%= u.id %>/delete" onsubmit="return confirm('Xoá lần tải danh sách điểm bán này? (sẽ tính lại danh sách từ các lần tải còn lại)');">
                    <button type="submit" class="link-btn link-danger">Xoá</button>
                  </form>
                </td>
              </tr>
              <% }) %>
              <% if (storeUps.length === 0) { %>
              <tr><td colspan="5" class="muted">Chưa tải file nào cho kênh này.</td></tr>
              <% } %>
            </tbody>
          </table>
        </details>
      </div>

      <div style="margin-top:16px; padding-top:12px; border-top:1px dashed #ddd;">
        <% var lockDate = (built[ch] && built[ch].lockDate) || ""; %>
        <p class="muted" style="margin-bottom:6px;">
          🔒 Khóa sổ: các ngày từ đầu đến ngày khóa (bao gồm ngày đó) sẽ không còn hiện cảnh báo "Chưa có HĐ"/"Lệch"
          nữa (số liệu gốc vẫn giữ nguyên để tra cứu). Dùng khi các ngày cũ đã chốt xong, không cần xử lý tiếp nữa.
          <% if (lockDate) { %><strong>Đang khóa đến hết ngày <%= lockDate %>.</strong><% } else { %><em>Chưa khóa.</em><% } %>
        </p>
        <form method="POST" action="/doi-soat/vietqr/khoa-so/<%= ch %>" class="form-inline">
          <input type="date" name="lockDate" value="<%= lockDate %>" required />
          <button type="submit" class="btn btn-secondary">Khóa đến ngày này</button>
        </form>
        <% if (lockDate) { %>
        <form method="POST" action="/doi-soat/vietqr/khoa-so/<%= ch %>" class="form-inline" style="margin-top:6px;">
          <input type="hidden" name="lockDate" value="" />
          <button type="submit" class="btn btn-secondary" onclick="return confirm('Mở khóa sổ kênh này?');">Mở khóa</button>
        </form>
        <% } %>
      </div>
        </div>
      </details>
    </section>
    <% }) %>

    <section class="panel">
      <details>
        <summary style="font-weight:700;color:#111;cursor:pointer;">Tải danh sách hóa đơn đã xuất (file MTT, dùng chung cho cả 3 ngân hàng Viet QR)</summary>
        <div style="margin-top:12px;">
      <form method="POST" action="/doi-soat/vietqr/upload-hoadon" enctype="multipart/form-data" class="form-inline">
        <input type="file" name="file" accept=".xlsx,.xls" required />
        <button type="submit" class="btn btn-primary">Tải lên</button>
      </form>
      <p class="muted" style="margin-top:8px;">
        Đã nạp:
        <% channels.forEach(function(chInfo, i) { %><strong><%= chInfo.label %>: <%= invoiceCounts[chInfo.key] %> HĐ</strong><%= i < channels.length - 1 ? ', ' : '' %><% }) %>.
        Tải file mới sẽ tự thêm dòng chưa có, không trùng lặp.
      </p>
      <% var totalInv = channels.reduce(function(s, c) { return s + invoiceCounts[c.key]; }, 0); %>
      <% if (totalInv > 0) { %>
      <form method="POST" action="/doi-soat/vietqr/invoices/clear" onsubmit="return confirm('Xoá toàn bộ hóa đơn Viet QR đã nạp (cả 3 kênh)?');">
        <button type="submit" class="btn btn-secondary">Xoá hết hóa đơn đã nạp</button>
      </form>
      <% } %>
        </div>
      </details>
    </section>

    <% if (allCodes.length > 0) { %>
    <datalist id="dl-ma-cong-trinh">
      <% allCodes.forEach(function(c) { %>
      <option value="<%= c %>"><%= c.endsWith('__FF') ? c.replace('__FF', '') + ' (CSE - chia sẻ)' : c %></option>
      <% }) %>
    </datalist>
    <% } %>

    <% if (typeof allUnmappedStores !== 'undefined' && allUnmappedStores.length > 0) { %>
    <section class="panel">
      <h2>Mã cửa hàng (tên điểm nội bộ) chưa map được Mã công trình</h2>
      <p class="muted">
        Những mã cửa hàng dưới đây có giao dịch QR về nhưng chưa dò khớp được với gian nào — doanh thu của chúng đang
        bị loại khỏi tổng "Tính từ dữ liệu tải lên", nên "Ngân hàng" và tổng dữ liệu bị lệch. Gán đúng Mã công trình
        rồi lưu để áp dụng ngay, không cần tải lại file.
      </p>
      <table class="table">
        <thead><tr><th>Mã cửa hàng</th><th>Ngân hàng</th><th>Tên hiện có</th><th>Số GD</th><th>Tổng tiền</th><th>Gán Mã công trình</th><th></th></tr></thead>
        <tbody>
          <% allUnmappedStores.forEach(function(u) { %>
          <tr>
            <td><%= u.isBlankCode ? '(không có mã)' : u.maCuaHang %></td>
            <td><%= u.channelLabel %></td>
            <td><%= u.matchText || '(chưa có tên)' %></td>
            <td><%= u.count %></td>
            <td><%= u.total.toLocaleString('vi-VN') %> đ</td>
            <td colspan="2">
              <% if (u.isBlankCode) { %>
              <span class="muted">Giao dịch không có mã cửa hàng — có thể thuộc nhiều gian khác nhau, không gán 1 mã chung được. Xem từng giao dịch ở bảng "Giao dịch không có mã cửa hàng" bên dưới để gán riêng.</span>
              <% } else { %>
              <form method="POST" action="/doi-soat/vietqr/store-map/<%= u.channel %>" class="form-inline">
                <input type="hidden" name="maCuaHang" value="<%= u.maCuaHang %>" />
                <input type="text" name="targetCode" list="dl-ma-cong-trinh" autocomplete="off"
                  placeholder="Gõ để lọc, chọn mã có sẵn hoặc nhập mã công trình mới..." style="min-width:280px;" required />
                <button type="submit" class="btn btn-secondary">Lưu</button>
              </form>
              <% } %>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </section>
    <% } %>

    <% if (typeof allUnmappedBlankRows !== 'undefined' && allUnmappedBlankRows.length > 0) { %>
    <section class="panel">
      <h2>Giao dịch không có mã cửa hàng (<%= allUnmappedBlankRows.length %> giao dịch)</h2>
      <p class="muted">
        Các giao dịch QR này về ngân hàng nhưng file tải lên không có mã cửa hàng đi kèm, nên hệ thống không tự biết
        thuộc gian nào — đang bị loại khỏi doanh thu, gây lệch "Ngân hàng" vs "Tính từ dữ liệu tải lên" ở đúng những
        ngày này. Gán Mã công trình cho từng giao dịch (nếu biết) để cộng vào đúng gian, áp dụng ngay không cần tải lại file.
      </p>
      <table class="table">
        <thead><tr><th>Ngày</th><th>Ngân hàng</th><th>Mã GD</th><th>Số tiền</th><th>Gán Mã công trình</th></tr></thead>
        <tbody>
          <% allUnmappedBlankRows.forEach(function(r) { %>
          <tr>
            <td><%= r.date %></td>
            <td><%= r.channelLabel %></td>
            <td style="font-size:11px;"><%= r.vqrCode || r.raw %></td>
            <td><%= r.amount.toLocaleString('vi-VN') %> đ</td>
            <td>
              <form method="POST" action="/doi-soat/vietqr/nocode-assign/<%= r.channel %>" class="form-inline">
                <input type="hidden" name="vqrCode" value="<%= r.vqrCode %>" />
                <input type="text" name="targetCode" list="dl-ma-cong-trinh" autocomplete="off"
                  placeholder="Gõ để lọc, chọn mã công trình..." style="min-width:240px;" required />
                <button type="submit" class="btn btn-secondary">Lưu</button>
              </form>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </section>
    <% } %>

    <% if (typeof allRefUnmatchedBankTx !== 'undefined' && allRefUnmatchedBankTx.length > 0) { %>
    <section class="panel" style="border:1px solid #e33; background:#fff5f5;">
      <h2>⚠️ Giao dịch ngân hàng KHÔNG khớp được Mã tham chiếu nào (<%= allRefUnmatchedBankTx.length %>)</h2>
      <p class="muted">
        Từ 22/07 trở đi, web khớp gian theo đúng "Mã tham chiếu" giữa sao kê ngân hàng và dữ liệu QR bạn tải lên
        (lấy ngân hàng làm chuẩn). Các giao dịch dưới đây có tiền về ngân hàng nhưng không tìm thấy mã tham chiếu
        khớp trong bất kỳ ngày nào của dữ liệu QR đã tải — kiểm tra lại đã tải đủ file "dữ liệu tải lên" chưa,
        hoặc mã tham chiếu 2 bên có đúng không.
      </p>
      <table class="table">
        <thead><tr><th>Ngày</th><th>Ngân hàng</th><th>Số tiền</th><th>Số tham chiếu</th><th>Diễn giải</th></tr></thead>
        <tbody>
          <% allRefUnmatchedBankTx.forEach(function(r) { %>
          <tr>
            <td><%= r.date %></td>
            <td><%= r.channelLabel %></td>
            <td><%= r.amount.toLocaleString('vi-VN') %> đ</td>
            <td style="font-size:11px;"><%= r.reference || '(không có)' %></td>
            <td style="font-size:11px;"><%= r.description %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </section>
    <% } %>

    <% if (typeof allRefLateMatches !== 'undefined' && allRefLateMatches.length > 0) { %>
    <section class="panel" style="border:1px solid #3b82f6; background:#eff6ff;">
      <h2>ℹ️ Khớp Mã tham chiếu nhưng thuộc dữ liệu QR của NGÀY KHÁC (<%= allRefLateMatches.length %>)</h2>
      <p class="muted">
        Các giao dịch dưới đây ngân hàng báo tiền về vào 1 ngày, nhưng mã tham chiếu lại khớp với đơn QR của ngày
        khác (thường là đơn ra trước, tiền về ngân hàng sau) — doanh thu vẫn được cộng đúng vào ngày NGÂN HÀNG báo
        (lấy ngân hàng làm chuẩn), dòng này chỉ để bạn biết vì sao có chênh lệch ngày.
      </p>
      <table class="table">
        <thead><tr><th>Ngày ngân hàng</th><th>Ngân hàng</th><th>Ngày dữ liệu QR</th><th>Số tham chiếu</th><th>Số tiền</th><th>Mã cửa hàng</th></tr></thead>
        <tbody>
          <% allRefLateMatches.forEach(function(r) { %>
          <tr>
            <td><%= r.bankDate %></td>
            <td><%= r.channelLabel %></td>
            <td><%= r.rawDate %></td>
            <td style="font-size:11px;"><%= r.reference %></td>
            <td><%= r.amount.toLocaleString('vi-VN') %> đ</td>
            <td><%= r.maCuaHang %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </section>
    <% } %>

    <% if (typeof allRefUnmappedStoreCodes !== 'undefined' && allRefUnmappedStoreCodes.length > 0) { %>
    <section class="panel" style="border:1px solid #e33; background:#fff5f5;">
      <h2>⚠️ Mã cửa hàng MỚI, chưa có trong danh sách điểm bán (<%= allRefUnmappedStoreCodes.length %>)</h2>
      <p class="muted">
        Các mã cửa hàng dưới đây xuất hiện trong giao dịch khớp mã tham chiếu, nhưng chưa có trong file "Danh sách
        điểm bán" đã tải — chưa xác định được tên điểm/mã công trình nên doanh thu đang bị loại. Tải bổ sung file
        điểm bán mới nhất rồi thử lại.
      </p>
      <table class="table">
        <thead><tr><th>Mã cửa hàng</th><th>Diễn giải mẫu</th><th>Số GD</th><th>Tổng tiền</th><th>Gán mã công trình</th></tr></thead>
        <tbody>
          <% allRefUnmappedStoreCodes.forEach(function(r) { %>
          <tr>
            <td><%= r.maCuaHang %></td>
            <td style="font-size:11px; max-width:260px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;" title="<%= r.sampleRaw || '' %>"><%= r.sampleRaw || '-' %></td>
            <td><%= r.count %></td>
            <td><%= r.total.toLocaleString('vi-VN') %> đ</td>
            <td>
              <form method="POST" action="/doi-soat/vietqr/gan-ma-cua-hang/<%= r.channel %>" class="form-inline" style="gap:4px;">
                <input type="hidden" name="maCuaHang" value="<%= r.maCuaHang %>" />
                <select name="maCongTrinh" required style="max-width:220px;">
                  <option value="">-- Chọn mã công trình --</option>
                  <% (typeof maCongTrinhOptions !== 'undefined' ? maCongTrinhOptions : []).forEach(function(m) { %>
                  <option value="<%= m.maCongTrinh %>"><%= m.maCongTrinh %><%= m.tenCongTrinh ? ' - ' + m.tenCongTrinh : '' %></option>
                  <% }) %>
                </select>
                <button type="submit" class="btn btn-secondary" style="font-size:12px; padding:4px 8px;">Gán</button>
              </form>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </section>
    <% } %>

    <% if (typeof allRefUnmappedTenDiem !== 'undefined' && allRefUnmappedTenDiem.length > 0) { %>
    <section class="panel" style="border:1px solid #e33; background:#fff5f5;">
      <h2>⚠️ Tên điểm bán chưa có Mã công trình tương ứng (<%= allRefUnmappedTenDiem.length %>)</h2>
      <p class="muted">
        Đã tra được tên điểm bán qua Mã cửa hàng, nhưng tên điểm này chưa có trong sheet "Tên điểm- Mã công trình" —
        bổ sung dòng tương ứng vào file rồi tải lại (qua nút tải "Dữ liệu Viet QR" như bình thường).

    <% if (typeof allTanPhuAutoApplied !== 'undefined' && allTanPhuAutoApplied.length > 0) { %>
    <section class="panel" style="border:2px solid #d97706; background:#fffbeb;">
      <h2>🟠 Đã tự động gộp phần dư Ngân hàng-Dữ liệu vào gian mặc định (<%= allTanPhuAutoApplied.length %>)</h2>

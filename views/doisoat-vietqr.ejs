        <thead><tr><th>Ngày</th><th>Kênh</th><th>Số tiền đã gộp</th><th>Gộp vào gian</th><th></th></tr></thead>
        <tbody>
          <% allTanPhuAutoApplied.forEach(function(r) { %>
          <tr>
            <td><%= r.date %></td>
            <td><%= r.channelLabel %></td>
            <td><%= r.amount.toLocaleString('vi-VN') %> đ</td>
            <td><%= r.targetCode %></td>
            <td>
              <form method="POST" action="/doi-soat/vietqr/tanphu-ack/<%= r.channel %>" class="form-inline">
                <input type="hidden" name="date" value="<%= r.date %>" />
                <input type="hidden" name="amount" value="<%= r.amount %>" />

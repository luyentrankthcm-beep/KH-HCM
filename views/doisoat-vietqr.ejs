          <table class="pivot-table">
            <thead>
              <tr>
                <th class="pivot-label-head">Mã công trình</th>
                <th>Tổng DT</th>
                <th>Tổng lệch</th>
                <% pivot.dates.forEach(function(d) { %><th><%= d.slice(5) %></th><% }) %>
              </tr>
            </thead>
            <tbody>
              <% pivot.rows.forEach(function(row, ri) { %>
              <tr>
                <td class="pivot-label"><%= row.maCongTrinh %><%= row.isCse ? ' (CSE)' : '' %></td>
                <td><%= row.sumGross.toLocaleString('vi-VN') %></td>
                <td class="<%= Math.abs(row.sumDiff) < 1000 ? 'text-pos' : 'text-neg' %>"><%= row.sumDiff.toLocaleString('vi-VN') %></td>
                <% row.cells.forEach(function(cell, ci) { %>
                <td
                  class="pivot-cell <%= cell ? 'pivot-' + cell.status : 'pivot-empty' %>"
                  <% if (cell) { %>onclick="vqrShowDetail('<%= ch %>', <%= ri %>, <%= ci %>)"<% } %>
                  title="<%= cell ? row.maCongTrinh + ' - ' + pivot.dates[ci] : '' %>"
                ><%= cell ? Math.round(cell.gross / 1000) + 'k' : '' %></td>
                <% }) %>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <p class="muted" style="margin-top:6px;">Bấm vào 1 ô trong bảng để xem chi tiết ngày đó (hiện ra ở khung giữa màn hình).</p>
      <% } %>

      <div style="margin-top:16px;">
        <div style="display:flex; align-items:center; gap:8px; margin-bottom:8px;">
          <strong>Xem chi tiết theo từng ngày</strong>
          <input
            type="text"
            placeholder="Tìm ngày (vd 2026-07-05)"
            oninput="vqrFilterDays('<%= ch %>', this.value)"
            style="flex:0 0 220px; padding:4px 8px; font-size:12px; border:1px solid #ddd; border-radius:6px;"
          />
        </div>
      <% var list = reconciled[ch] || []; %>
      <% if (list.length === 0) { %>
        <p class="muted">Chưa có dữ liệu để đối soát kênh này (trong tháng đang chọn).</p>
      <% } else { %>
      <% var dayList = list.filter(function(r){ return r.lines.length > 0; }); %>
        <table class="table" id="vqr-summary-<%= ch %>" style="font-size:12px;">
          <thead>
            <tr>
              <th>Ngày</th><th>Ngân hàng</th><th>Tính từ dữ liệu tải lên</th>
              <th>Lệch: Ngân hàng ↔ Dữ liệu</th><th>Lệch: Dữ liệu ↔ Hóa đơn</th>
            </tr>
          </thead>
          <tbody>
            <% dayList.forEach(function(r) {
              // Luyen, 2026-07-19: "hiện ngày cho tôi 2 phần lệch đi, 1 là ngân
              // hàng với dữ liệu, 1 là dữ liệu với hóa đơn" -- tach ro 2 loai
              // lech khac nhau o dong tong theo ngay, thay vi phai mo tung
              // dong gian ben duoi moi biet ngay do co gian nao lech hoa don
              // hay khong. "Lech du lieu vs hoa don" la TONG (co dau) cua tung
              // dong l.diff (invoiceTotal - gross), bo qua dong SKIP.
              var invDiffSum = r.lines.reduce(function(s, l) { return s + (l.tkCo !== 'SKIP' ? l.diff : 0); }, 0);
            %>
            <tr data-day="<%= r.settlementDate %>" onclick="vqrJumpToDay('<%= ch %>','<%= r.settlementDate %>')" style="cursor:pointer;<%= r.locked ? ' opacity:0.6;' : '' %>">
              <td><%= r.settlementDate %><%= r.locked ? ' 🔒' : '' %></td>
              <% if (r.pendingBank) { %>
              <td colspan="3"><span class="badge badge-warn" title="Đã có doanh thu/gian, chưa có giao dịch ngân hàng khớp ngày này">⏳ Chưa có ngân hàng</span></td>
              <% } else { %>
              <td><%= r.bankAmount.toLocaleString('vi-VN') %> đ</td>
              <td><%= r.totalNetComputed.toLocaleString('vi-VN') %> đ</td>
              <td class="<%= Math.abs(r.diffVsBank) < 1000 ? 'text-pos' : 'text-neg' %>"><%= r.diffVsBank.toLocaleString('vi-VN') %> đ</td>
              <% } %>
              <td class="<%= Math.abs(invDiffSum) < 1000 ? 'text-pos' : 'text-neg' %>"><%= invDiffSum.toLocaleString('vi-VN') %> đ</td>
            </tr>
            <% }) %>
          </tbody>
        </table>

        <% dayList.forEach(function(r) {
          var invDiffSum = r.lines.reduce(function(s, l) { return s + (l.tkCo !== 'SKIP' ? l.diff : 0); }, 0);
        %>
        <details id="vqr-day-<%= ch %>-<%= r.settlementDate %>" style="background:#fafbfc; border:1px solid #eee; border-radius:8px; margin-top:8px; padding:8px 12px;">
          <summary style="cursor:pointer; font-size:13px; display:flex; justify-content:space-between; flex-wrap:wrap; gap:6px;">
            <span style="font-weight:600;">Ngày <%= r.settlementDate %><%= r.locked ? ' 🔒 (đã khóa sổ)' : '' %><% if (r.pendingBank) { %> <span class="badge badge-warn">⏳ Chưa có ngân hàng</span><% } %></span>
            <span>
              <% if (r.pendingBank) { %>
              Tính từ dữ liệu tải lên: <strong><%= r.totalNetComputed.toLocaleString('vi-VN') %> đ</strong>
              <% } else { %>
              Ngân hàng: <strong><%= r.bankAmount.toLocaleString('vi-VN') %> đ</strong>
              <% if (r.bankAmountExcluded) { %>
              <span class="muted" title="Đã trừ các giao dịch không có Mã tham chiếu VietQR khớp (lãi ngân hàng, chuyển khoản khác...) khỏi tổng Ngân hàng của ngày này.">(đã trừ <%= r.bankAmountExcluded.toLocaleString('vi-VN') %> đ không phải VietQR)</span>
              <% } %>
              &nbsp;|&nbsp; Tính từ dữ liệu tải lên: <strong><%= r.totalNetComputed.toLocaleString('vi-VN') %> đ</strong>
              &nbsp;|&nbsp;
              <span class="<%= Math.abs(r.diffVsBank) < 1000 ? 'text-pos' : 'text-neg' %>">
                Lệch Ngân hàng↔Dữ liệu: <%= r.diffVsBank.toLocaleString('vi-VN') %> đ
              </span>
              <% } %>
              &nbsp;|&nbsp;
              <span class="<%= Math.abs(invDiffSum) < 1000 ? 'text-pos' : 'text-neg' %>">
                Lệch Dữ liệu↔Hóa đơn: <%= invDiffSum.toLocaleString('vi-VN') %> đ
              </span>
            </span>
          </summary>
          <% if (r.tanPhuSuggestion) { %>
          <p class="badge badge-warn" style="display:block; margin-top:8px; font-size:12px; padding:6px 10px;">
            ⚠️ Sau khi trừ giao dịch không phải VietQR, Ngân hàng ngày này vẫn còn dư <strong><%= r.tanPhuSuggestion.amount.toLocaleString('vi-VN') %> đ</strong> so với dữ liệu đối soát — có nên gộp khoản này vào gian <strong><%= r.tanPhuSuggestion.targetCode %></strong> (Tân Phú) không?
          </p>
          <% } %>
          <table class="table" style="margin-top:8px;">
            <thead>
              <tr><th>Mã công trình (gian)</th><th>TK Có</th><th>Doanh thu</th><th>Số HĐ khớp</th><th>Tổng tiền HĐ</th><th>Trạng thái</th></tr>
            </thead>
            <tbody>
              <% r.lines.forEach(function(l) { %>
              <tr<%= l.tkCo === 'SKIP' ? ' style="opacity:0.6;"' : '' %>>
                <td><%= l.maCongTrinh %><%= l.code.endsWith('__FF') ? ' (CSE)' : '' %></td>
                <td><%= l.tkCo === 'SKIP' ? '—' : l.tkCo %></td>
                <td><%= l.gross.toLocaleString('vi-VN') %> đ</td>
                <td><%= l.invoiceNumbers.join(', ') || '-' %></td>
                <td><%= l.invoiceTotal.toLocaleString('vi-VN') %> đ</td>
                <td>
                  <% if (l.locked) { %>
                    <span class="badge">🔒 Đã khóa sổ</span>
                  <% } else if (l.tkCo === 'SKIP') { %>
                    <span class="badge badge-chi">KH mới - chưa xuất MISA</span>
                  <% } else if (l.manualOverride) { %>
                    <% if (l.matched) { %>
                      <span class="badge badge-thu">Khớp (bù thủ công)</span>
                    <% } else { %>
                      <span class="badge badge-chi">Lệch (đã bù 1 phần) còn <%= l.diff.toLocaleString('vi-VN') %> đ</span>
                    <% } %>
                    <form method="POST" action="/doi-soat/vietqr/manual-match/delete" style="display:inline;" onsubmit="return confirm('Xoá đánh dấu thủ công này?');">
                      <input type="hidden" name="channel" value="<%= ch %>" />
                      <input type="hidden" name="settlementDate" value="<%= r.settlementDate %>" />
                      <input type="hidden" name="code" value="<%= l.code %>" />
                      <button type="submit" class="link-btn link-danger" style="font-size:11px;">Xoá</button>
                    </form>
                    <% if (l.manualNote) { %><div class="muted" style="font-size:11px;"><%= l.manualNote %></div><% } %>
                  <% } else if (l.invoiceNumbers.length === 0) { %>
                    <span class="badge badge-chi">Chưa có HĐ</span>
                    <form method="POST" action="/doi-soat/vietqr/manual-match" style="margin-top:6px;">
                      <input type="hidden" name="channel" value="<%= ch %>" />
                      <input type="hidden" name="settlementDate" value="<%= r.settlementDate %>" />
                      <input type="hidden" name="code" value="<%= l.code %>" />
                      <input type="text" name="invoiceNumbers" placeholder="Số HĐ bù" style="width:80px; font-size:11px;" />
                      <input type="text" name="amount" placeholder="Số tiền" style="width:80px; font-size:11px;" />
                      <input type="text" name="grossAdjustment" placeholder="+/- Sửa DT" title="Sửa doanh thu (Doanh thu) của dòng này: nhập số dương để cộng thêm, số âm để trừ bớt — dùng khi dữ liệu QR thiếu/dư (vd 1 GD không có mã cửa hàng thuộc gian này, hoặc trùng/thiếu giao dịch)" style="width:80px; font-size:11px;" />
                      <button type="submit" class="link-btn" style="font-size:11px;" title="Đánh dấu đã có hóa đơn bù (vd xuất ngày hôm sau)">Đã có HĐ bù</button>
                    </form>
                  <% } else if (l.matched) { %>
                    <span class="badge badge-thu">Khớp</span>
                  <% } else { %>
                    <span class="badge badge-chi">Lệch <%= l.diff.toLocaleString('vi-VN') %> đ</span>
                    <form method="POST" action="/doi-soat/vietqr/manual-match" style="margin-top:6px;">
                      <input type="hidden" name="channel" value="<%= ch %>" />
                      <input type="hidden" name="settlementDate" value="<%= r.settlementDate %>" />
                      <input type="hidden" name="code" value="<%= l.code %>" />
                      <input type="text" name="invoiceNumbers" value="<%= l.invoiceNumbers.join(', ') %>" placeholder="Số HĐ" style="width:100px; font-size:11px;" />
                      <input type="text" name="amount" value="<%= l.invoiceTotal %>" placeholder="Số tiền" style="width:80px; font-size:11px;" />
                      <input type="text" name="grossAdjustment" placeholder="+/- Sửa DT" title="Sửa doanh thu (Doanh thu) của dòng này: nhập số dương để cộng thêm, số âm để trừ bớt — dùng khi dữ liệu QR thiếu/dư (vd 1 GD không có mã cửa hàng thuộc gian này, hoặc trùng/thiếu giao dịch)" style="width:80px; font-size:11px;" />
                      <button type="submit" class="link-btn" style="font-size:11px;" title="Sửa/thêm số hóa đơn cho dòng lệch này">Sửa HĐ</button>
                    </form>
                  <% } %>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </details>
        <% }) %>
      <% } %>
      </div>
    </section>
    <% }) %>
  </main>

  <div class="vqr-modal-overlay" id="vqr-modal-overlay" onclick="if (event.target === this) vqrCloseModal();">
    <div class="vqr-modal-box">
      <button type="button" class="vqr-modal-close" onclick="vqrCloseModal()">&times;</button>
      <div id="vqr-modal-body"></div>
    </div>
  </div>
</body>
</html>

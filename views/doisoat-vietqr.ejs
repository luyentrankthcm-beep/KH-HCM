      <table class="table">
        <thead><tr><th>Ngày ngân hàng</th><th>Ngân hàng</th><th>Ngày dữ liệu QR</th><th>Số tham chiếu</th><th>Số tiền</th><th>Mã cửa hàng</th></tr></thead>
        <tbody>
          <% allRefLateMatches.forEach(function(r) { %>
          <tr>
            <td><%= r.bankDate %></td>
            <td><%= r.channelLabel %></td>
            <td><%= r.rawDate %></td>
            <td style="font-size:11px;"><%= r.reference %></td>
            <td><%= r.amount.toLocaleString('vi-VN') %> đ</td>
            <td><%= r.maCuaHang %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </section>
    <% } %>

    <% if (typeof allRefUnmappedStoreCodes !== 'undefined' && allRefUnmappedStoreCodes.length > 0) { %>
    <section class="panel" style="border:1px solid #e33; background:#fff5f5;">
      <h2>⚠️ Mã cửa hàng MỚI, chưa có trong danh sách điểm bán (<%= allRefUnmappedStoreCodes.length %>)</h2>
      <p class="muted">
        Các mã cửa hàng dưới đây xuất hiện trong giao dịch khớp mã tham chiếu, nhưng chưa có trong file "Danh sách
        điểm bán" đã tải — chưa xác định được tên điểm/mã công trình nên doanh thu đang bị loại. Tải bổ sung file
        điểm bán mới nhất rồi thử lại.
      </p>
      <table class="table">
        <thead><tr><th>Mã cửa hàng</th><th>Diễn giải mẫu</th><th>Số GD</th><th>Tổng tiền</th><th>Gán mã công trình</th></tr></thead>
        <tbody>
          <% allRefUnmappedStoreCodes.forEach(function(r) { %>
          <tr>
            <td><%= r.maCuaHang %></td>
            <td style="font-size:11px; max-width:260px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;" title="<%= r.sampleRaw || '' %>"><%= r.sampleRaw || '-' %></td>
            <td><%= r.count %></td>
            <td><%= r.total.toLocaleString('vi-VN') %> đ</td>
            <td>
              <form method="POST" action="/doi-soat/vietqr/gan-ma-cua-hang/<%= r.channel %>" class="form-inline" style="gap:4px;">
                <input type="hidden" name="maCuaHang" value="<%= r.maCuaHang %>" />
                <input type="text" name="maCongTrinh" list="dl-ma-cong-trinh-full" autocomplete="off"
                  placeholder="Gõ để lọc, chọn mã có sẵn hoặc nhập mã mới..." style="min-width:260px;" required />
                <button type="submit" class="btn btn-secondary" style="font-size:12px; padding:4px 8px;">Gán</button>
              </form>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </section>
    <% } %>

    <% if (typeof allRefUnmappedTenDiem !== 'undefined' && allRefUnmappedTenDiem.length > 0) { %>
    <section class="panel" style="border:1px solid #e33; background:#fff5f5;">
      <h2>⚠️ Tên điểm bán chưa có Mã công trình tương ứng (<%= allRefUnmappedTenDiem.length %>)</h2>
      <p class="muted">
        Đã tra được tên điểm bán qua Mã cửa hàng, nhưng tên điểm này chưa có trong sheet "Tên điểm- Mã công trình" —
        gán mã công trình trực tiếp bên dưới, hoặc bổ sung dòng tương ứng vào file rồi tải lại (qua nút tải "Dữ liệu
        Viet QR" như bình thường).
      </p>
      <table class="table">
        <thead><tr><th>Tên điểm bán</th><th>Mã cửa hàng</th><th>Số GD</th><th>Tổng tiền</th><th>Gán mã công trình</th></tr></thead>
        <tbody>
          <% allRefUnmappedTenDiem.forEach(function(r) { %>
          <tr>
            <td><%= r.tenDiemBan || '(không có tên)' %></td>
            <td><%= r.maCuaHang %></td>
            <td><%= r.count %></td>
            <td><%= r.total.toLocaleString('vi-VN') %> đ</td>
            <td>
              <% if (r.tenDiemBan) { %>
              <form method="POST" action="/doi-soat/vietqr/gan-ten-diem/<%= r.channel %>" class="form-inline" style="gap:4px;">
                <input type="hidden" name="tenDiemBan" value="<%= r.tenDiemBan %>" />
                <input type="text" name="maCongTrinh" list="dl-ma-cong-trinh-full" autocomplete="off"
                  placeholder="Gõ để lọc, chọn mã có sẵn hoặc nhập mã mới..." style="min-width:260px;" required />
                <button type="submit" class="btn btn-secondary" style="font-size:12px; padding:4px 8px;">Gán</button>
              </form>
              <% } else { %>
              <span class="muted" style="font-size:12px;">Không có tên điểm, không gán được -- xem cột Mã cửa hàng</span>
              <% } %>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </section>
    <% } %>

    <% if (typeof allNocodeAssignments !== 'undefined' && allNocodeAssignments.length > 0) { %>
    <section class="panel">
      <h2>Các giao dịch không mã đã gán (<%= allNocodeAssignments.length %>)</h2>
      <p class="muted">
        Danh sách các giao dịch "không có mã cửa hàng" đã được gán Mã công trình ở bảng trên. Nếu gán nhầm, bấm
        Xoá để trả giao dịch về diện "chưa gán" rồi gán lại mã khác.
      </p>
      <table class="table">
        <thead><tr><th>Ngân hàng</th><th>Mã GD</th><th>Đã gán vào</th><th>Lúc gán</th><th></th></tr></thead>
        <tbody>
          <% allNocodeAssignments.forEach(function(a) { %>
          <tr>
            <td><%= a.channelLabel %></td>
            <td style="font-size:11px;"><%= a.vqrCode %></td>
            <td><%= a.targetCode %></td>
            <td><%= a.assignedAt ? new Date(a.assignedAt).toLocaleString('vi-VN') : '-' %></td>
            <td>
              <form method="POST" action="/doi-soat/vietqr/nocode-assign/<%= a.channel %>/<%= encodeURIComponent(a.vqrCode) %>/delete"
                    onsubmit="return confirm('Xoá gán này? Giao dịch sẽ trở lại diện chưa gán.');">
                <button type="submit" class="link-btn link-danger">Xoá</button>
              </form>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </section>
    <% } %>

    <!--
      Luyen, 2026-07-20: "bỏ cái bảng này đi 7704 á hay các viẹt qr kh cũ" --
      an muc nay khi dang xem KH Cu (gom ca 3 kenh BIDV7704/BIDV77020/
      MB11521268 nen ra toi 4356 gian, qua roi/khong con can nhin nua). Van
      giu nguyen cho KH Moi (chi 1 kenh BIDV7702/VietQR MN).
    -->
    <% if (activeCompany !== 'kh_cu' && typeof allStoreGroups !== 'undefined' && allStoreGroups.length > 0) { %>
    <section class="panel">
      <details>
        <summary style="font-weight:700;color:#111;cursor:pointer;">Danh sách mã cửa hàng theo gian (<%= allStoreGroups.length %> gian)</summary>
        <div style="margin-top:12px;">
      <div class="panel-head">
        <input type="text" id="storeGroupSearchBox" placeholder="🔎 Tìm theo tên gian..." style="min-width:240px; padding:8px 12px; border:1px solid var(--color-hairline); border-radius:var(--radius-md);" oninput="filterStoreGroupRows(this.value)" />
      </div>
      <p class="muted">
        Mỗi gian (điểm bán) có thể có nhiều mã QR/mã cửa hàng con — gom lại còn 1 dòng mỗi gian cho dễ nhìn, bấm
        "Xem N mã" để mở chi tiết từng mã cửa hàng bên trong.
      </p>
      <table class="table" id="storeGroupTable">
        <thead><tr><th>Gian</th><th>Ngân hàng</th><th>Mã điểm bán</th><th>Số mã cửa hàng</th><th>Chi tiết</th></tr></thead>
        <tbody>
          <% allStoreGroups.forEach(function(g) { %>
          <tr data-search="<%= g.label.toLowerCase() %>">
            <td><strong><%= g.label %></strong></td>
            <td><%= g.channelLabel %></td>
            <td><%= g.maDiemBan || '-' %></td>
            <td><%= g.count %></td>
            <td>
              <details>
                <summary style="cursor:pointer;">Xem <%= g.count %> mã ▾</summary>
                <div style="margin-top:6px; font-size:12px; max-width:360px;">
                  <% g.codes.forEach(function(c) { %>
                  <div><%= c.maCuaHang %><% if (c.tenCuaHang) { %> — <%= c.tenCuaHang %><% } %></div>
                  <% }) %>
                </div>
              </details>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
        </div>
      </details>
    </section>
    <script>
      function filterStoreGroupRows(q) {
        var needle = (q || "").trim().toLowerCase();
        document.querySelectorAll("#storeGroupTable tbody tr[data-search]").forEach(function (tr) {
          tr.style.display = !needle || tr.getAttribute("data-search").indexOf(needle) !== -1 ? "" : "none";
        });
      }
    </script>
    <% } %>

    <% var allUnmatched = []; var seenUnmatched = {};
       channels.forEach(function(chInfo) {
         ((built[chInfo.key] || {}).unmatchedInvoiceCodes || []).forEach(function(c) {
           if (!seenUnmatched[c]) { seenUnmatched[c] = true; allUnmatched.push(c); }
         });
       });
       var invoiceDiemAlias = (built[channels[0].key] || {}).invoiceDiemAlias || {};
    %>
    <% if (allUnmatched.length > 0 || Object.keys(invoiceDiemAlias).length > 0) { %>
    <section class="panel">
      <h2>Ánh xạ tên/mã điểm khác trên hóa đơn về đúng Mã công trình (dùng chung với Momo/ZVP)</h2>
      <p class="muted">
        Một số hóa đơn ghi "Mã điểm" khác với Mã công trình bên doanh thu — ánh xạ tên này về đúng Mã công trình
        bên dưới, áp dụng ngay không cần tải lại hóa đơn.
      </p>
      <% if (allUnmatched.length > 0) { %>
      <table class="table">
        <thead><tr><th>Tên/Mã điểm trên hóa đơn (chưa khớp)</th><th>Ánh xạ về Mã công trình</th><th></th></tr></thead>
        <tbody>
          <% allUnmatched.forEach(function(code) { %>
          <tr>
            <td><%= code %></td>
            <td colspan="2">
              <form method="POST" action="/doi-soat/vietqr/diem-alias" class="form-inline">
                <input type="hidden" name="sourceCode" value="<%= code %>" />
                <input type="text" name="targetCode" list="dl-ma-cong-trinh" autocomplete="off"
                  placeholder="Gõ để lọc, chọn mã có sẵn hoặc nhập mã công trình mới..." style="min-width:280px;" required />
                <button type="submit" class="btn btn-secondary">Lưu ánh xạ</button>
              </form>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
      <p class="muted" style="margin-top:-4px;">
        Gõ vài chữ để lọc danh sách gian có sẵn (cả KH Cũ và KH Mới). Nếu gian này thật sự chưa có trong hệ thống,
        gõ hẳn tên Mã công trình mới rồi lưu — hệ thống sẽ tự tạo mã đó (mặc định TK Có 131).
      </p>
      <% } %>
      <% if (Object.keys(invoiceDiemAlias).length > 0) { %>
      <table class="table" style="margin-top:12px;">
        <thead><tr><th>Đã ánh xạ</th><th></th><th></th></tr></thead>
        <tbody>
          <% Object.keys(invoiceDiemAlias).forEach(function(src) { %>
          <tr>
            <td><%= src %> → <%= invoiceDiemAlias[src] %></td>
            <td>
              <form method="POST" action="/doi-soat/vietqr/diem-alias/delete" onsubmit="return confirm('Xoá ánh xạ này?');">
                <input type="hidden" name="sourceCode" value="<%= src %>" />
                <button type="submit" class="link-btn link-danger">Xoá</button>
              </form>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
      <% } %>
    </section>
    <% } %>

    <section class="panel">
      <h2>Xuất file MISA</h2>
      <p class="muted" style="margin-bottom:14px;">
        Xuất riêng từng ngân hàng. Các dòng "KH mới - chưa xuất MISA" sẽ tự động bị loại khỏi file xuất. Để trống 1
        trong 2 ô ngày để xuất không giới hạn đầu/cuối.
      </p>
      <div class="form-inline" style="margin-bottom:14px; flex-wrap:wrap; gap:10px;">
        <label style="margin:0;">Số chứng từ bắt đầu (NTTK...):</label>
        <input type="number" id="startNo" value="1" min="1" style="width:100px;" />
        <label style="margin:0;">Từ ngày:</label>
        <input type="date" id="exportTu" value="<%= exportTuDefault %>" style="width:150px;" />
        <label style="margin:0;">Đến ngày:</label>
        <input type="date" id="exportDen" value="<%= exportDenDefault %>" style="width:150px;" />
        <% channels.forEach(function(chInfo) { %>
        <a class="btn btn-secondary export-btn" data-channel="<%= chInfo.key %>" href="#">Xuất <%= chInfo.label %></a>
        <% }) %>
      </div>
      <script>
        function updateVietQrExportLinks() {
          var v = document.getElementById('startNo').value || 1;
          var tu = document.getElementById('exportTu').value || '';
          var den = document.getElementById('exportDen').value || '';
          document.querySelectorAll('.export-btn').forEach(function(a) {
            a.href = '/doi-soat/vietqr/export.xlsx?channel=' + a.dataset.channel + '&start=' + v +
              '&tu=' + encodeURIComponent(tu) + '&den=' + encodeURIComponent(den);
          });
        }
        document.getElementById('startNo').addEventListener('input', updateVietQrExportLinks);
        document.getElementById('exportTu').addEventListener('change', updateVietQrExportLinks);
        document.getElementById('exportDen').addEventListener('change', updateVietQrExportLinks);
        updateVietQrExportLinks();
      </script>
    </section>

    <% var hoaDonDauRaChannel = channels.find(function(c){ return c.key === 'bidv7702'; }); %>
    <% if (hoaDonDauRaChannel) { %>
    <section class="panel">
      <h2>Xuất Hóa đơn đầu ra (mẫu VietInvoice)</h2>
      <p class="muted" style="margin-bottom:14px;">
        Chọn khoảng Từ ngày - Đến ngày cần xuất (BIDV 7702): mỗi gian có doanh thu mỗi ngày trong khoảng đó thành 1
        dòng hóa đơn riêng, cột Thành tiền = doanh thu VietQR ngày đó của gian (đã tách 8% thuế GTGT). Các cột khác
        giữ nguyên như file mẫu. Số thứ tự hóa đơn cộng dần liên tục qua các ngày, từ số bắt đầu chị chọn.
      </p>
      <div class="form-inline" style="margin-bottom:14px;">
        <label style="margin:0;">Từ ngày:</label>
        <input type="date" id="hddrFrom" style="width:150px;" />
        <label style="margin:0;">Đến ngày:</label>
        <input type="date" id="hddrTo" style="width:150px;" />
        <label style="margin:0;">Số hóa đơn bắt đầu:</label>
        <input type="number" id="hddrStart" value="1" min="1" style="width:100px;" />
        <a class="btn btn-secondary" id="hddrExportBtn" href="#">Xuất Hóa đơn đầu ra BIDV 7702</a>
      </div>
      <script>
        (function() {
          var fromInput = document.getElementById('hddrFrom');
          var toInput = document.getElementById('hddrTo');
          var startInput = document.getElementById('hddrStart');
          var btn = document.getElementById('hddrExportBtn');
          function updateHref() {
            if (!fromInput.value || !toInput.value) { btn.setAttribute('href', '#'); return; }
            btn.setAttribute(
              'href',
              '/doi-soat/vietqr/xuat-hoa-don-dau-ra?channel=bidv7702&from=' + fromInput.value + '&to=' + toInput.value + '&start=' + (startInput.value || 1)
            );
          }
          fromInput.addEventListener('input', updateHref);
          toInput.addEventListener('input', updateHref);
          startInput.addEventListener('input', updateHref);
          btn.addEventListener('click', function(e) {
            if (!fromInput.value || !toInput.value) {
              e.preventDefault();
              alert('Chọn đủ Từ ngày và Đến ngày trước.');
            }
          });
          updateHref();
        })();
      </script>
    </section>
    <% } %>

    <section class="panel">
      <h2>Kết quả đối soát</h2>
      <form method="GET" action="/doi-soat/vietqr" class="form-inline">
        <label style="margin:0;">Chọn ngân hàng:</label>
        <select name="channel" onchange="this.form.submit()">
          <option value="" <%= selectedChannel === '' ? 'selected' : '' %>>-- Tất cả --</option>
          <% channels.forEach(function(chInfo) { %>
          <option value="<%= chInfo.key %>" <%= selectedChannel === chInfo.key ? 'selected' : '' %>><%= chInfo.label %></option>
          <% }) %>
        </select>
        <% if (months.length > 0) { %>
        <label style="margin:0 0 0 12px;">Chọn tháng:</label>
        <select name="month" onchange="this.form.submit()">
          <option value="" <%= selectedMonth === '' ? 'selected' : '' %>>-- Tất cả --</option>
          <% months.forEach(function(m) { %>
          <option value="<%= m %>" <%= selectedMonth === m ? 'selected' : '' %>><%= m %></option>
          <% }) %>
        </select>
        <% } %>
      </form>
    </section>

    <style>
      .pivot-wrap { overflow-x: auto; }
      .pivot-table { border-collapse: collapse; font-size: 12px; white-space: nowrap; }
      .pivot-table th, .pivot-table td { border: 1px solid #e5e5e5; padding: 4px 6px; text-align: right; }
      .pivot-table th { background: #fafbfc; text-align: center; }
      .pivot-table td.pivot-label { text-align: left; position: sticky; left: 0; background: #fff; z-index: 1; }
      .pivot-table th.pivot-label-head { position: sticky; left: 0; background: #fafbfc; z-index: 2; text-align: left; }
      .pivot-cell { cursor: pointer; }
      .pivot-ok { background: #e6f4ea; }
      .pivot-diff { background: #fdecea; }
      .pivot-missing { background: #fff8e1; }
      .pivot-skip { background: #f0f0f0; color: #999; }
      .pivot-locked { background: #eef1f5; color: #888; }
      .pivot-empty { color: #ddd; cursor: default; }
      .vqr-modal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.35);
        z-index: 1000;
        align-items: center;
        justify-content: center;
      }
      .vqr-modal-overlay.open { display: flex; }
      .vqr-modal-box {
        background: #fff;
        border-radius: 10px;
        padding: 18px 20px;
        font-size: 13px;
        max-width: 420px;
        width: 90%;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.25);
        position: relative;
      }
      .vqr-modal-close {
        position: absolute;
        top: 8px;
        right: 12px;
        cursor: pointer;
        color: #999;
        font-size: 18px;
        line-height: 1;
        background: none;
        border: none;
      }
    </style>
    <script>
      function vqrShowDetail(ch, rowIdx, colIdx) {
        var pivot = window.__vqrPivot[ch];
        var row = pivot.rows[rowIdx];
        var cell = row.cells[colIdx];
        var date = pivot.dates[colIdx];
        var body = document.getElementById('vqr-modal-body');
        if (!cell) {
          body.innerHTML = '<p class="muted">Không có dữ liệu ngày ' + date + ' cho gian "' + row.maCongTrinh + '".</p>';
          vqrOpenModal();
          return;
        }
        var statusHtml;
        if (cell.locked) statusHtml = '<span class="badge">🔒 Đã khóa sổ</span>';
        else if (cell.tkCo === 'SKIP') statusHtml = '<span class="badge badge-chi">KH mới - chưa xuất MISA</span>';
        else if (cell.manualOverride && cell.matched) statusHtml = '<span class="badge badge-thu">Khớp (bù thủ công)</span>';
        else if (cell.manualOverride) statusHtml = '<span class="badge badge-chi">Lệch (đã bù 1 phần) còn ' + cell.diff.toLocaleString('vi-VN') + ' đ</span>';
        else if (!cell.invoiceNumbers || cell.invoiceNumbers.length === 0) statusHtml = '<span class="badge badge-chi">Chưa có HĐ</span>';
        else if (cell.matched) statusHtml = '<span class="badge badge-thu">Khớp</span>';
        else statusHtml = '<span class="badge badge-chi">Lệch ' + cell.diff.toLocaleString('vi-VN') + ' đ</span>';

        var deleteBtn = '';
        if (cell.manualOverride) {
          var safeCode = (row.code || '').replace(/'/g, "\\'");
          deleteBtn =
            '<form method="POST" action="/doi-soat/vietqr/manual-match/delete" style="display:inline; margin-left:8px;"' +
            ' onsubmit="vqrCloseModal(); return xoaBuTruConfirm(this, \'' + safeCode + '\', \'' + date + '\')">' +
            '<input type="hidden" name="channel" value="' + ch + '" />' +
            '<input type="hidden" name="settlementDate" value="' + date + '" />' +
            '<input type="hidden" name="code" value="' + (row.code || '') + '" />' +
            '<button type="submit" class="link-btn link-danger" style="font-size:11px; margin-left:4px;">Xoá bù trừ</button>' +
            '</form>';
        }

        body.innerHTML =
          '<p style="margin:0 0 8px;"><strong>' + row.maCongTrinh + (row.isCse ? ' (CSE)' : '') + '</strong> — Ngày ' + date + '</p>' +
          '<p style="margin:0;">TK Có: ' + (cell.tkCo === 'SKIP' ? '—' : cell.tkCo) +
          ' &nbsp;|&nbsp; Doanh thu: ' + cell.gross.toLocaleString('vi-VN') + ' đ</p>' +
          '<p style="margin:4px 0 0;">Tổng tiền HĐ: ' + cell.invoiceTotal.toLocaleString('vi-VN') + ' đ' +
          ' &nbsp;|&nbsp; ' + statusHtml + deleteBtn + '</p>' +
          '<p style="margin:8px 0 0;">Số HĐ khớp: ' + ((cell.invoiceNumbers && cell.invoiceNumbers.join(', ')) || '-') + '</p>';
        vqrOpenModal();
      }

      function vqrOpenModal() {
        document.getElementById('vqr-modal-overlay').classList.add('open');
      }

      function vqrCloseModal() {
        document.getElementById('vqr-modal-overlay').classList.remove('open');
      }

      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') vqrCloseModal();
      });

      function vqrJumpToDay(ch, date) {
        var id = 'vqr-day-' + ch + '-' + date;
        var el = document.getElementById(id);
        if (!el) return;
        el.open = true;
        el.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }

      function vqrFilterDays(ch, q) {
        q = (q || '').trim();
        var rows = document.querySelectorAll('#vqr-summary-' + ch + ' tbody tr');
        rows.forEach(function (tr) {
          var day = tr.getAttribute('data-day') || '';
          tr.style.display = !q || day.indexOf(q) !== -1 ? '' : 'none';
        });
      }
    </script>

    <% var displayChannels = selectedChannel ? channels.filter(function(c) { return c.key === selectedChannel; }) : channels; %>
    <% displayChannels.forEach(function(chInfo) { var ch = chInfo.key; var pivot = pivotByChannel[ch] || { dates: [], rows: [] }; %>
    <section class="panel" id="vqr-channel-<%= ch %>">
      <h2>Kết quả đối soát — <%= chInfo.label %></h2>

      <script>
        window.__vqrPivot = window.__vqrPivot || {};
        window.__vqrPivot["<%= ch %>"] = <%- JSON.stringify(pivot).replace(/</g, '\\u003c') %>;
      </script>

      <% if (pivot.rows.length === 0) { %>
        <p class="muted">Chưa có dữ liệu để đối soát kênh này (trong tháng đang chọn).</p>
      <% } else { %>
        <p class="muted" style="margin-bottom:8px;">Mỗi dòng 1 gian, mỗi cột 1 ngày — bấm vào 1 ô để xem chi tiết bên dưới bảng.</p>
        <div class="pivot-wrap">
          <table class="pivot-table">
            <thead>
              <tr>
                <th class="pivot-label-head">Mã công trình</th>
                <th>Tổng DT</th>
                <th>Tổng lệch</th>
                <% pivot.dates.forEach(function(d) { %><th><%= d.slice(5) %></th><% }) %>
              </tr>
            </thead>
            <tbody>
              <% pivot.rows.forEach(function(row, ri) { %>
              <tr>
                <td class="pivot-label"><%= row.maCongTrinh %><%= row.isCse ? ' (CSE)' : '' %></td>
                <td><%= row.sumGross.toLocaleString('vi-VN') %></td>
                <td class="<%= Math.abs(row.sumDiff) < 1000 ? 'text-pos' : 'text-neg' %>"><%= row.sumDiff.toLocaleString('vi-VN') %></td>
                <% row.cells.forEach(function(cell, ci) { %>
                <td
                  class="pivot-cell <%= cell ? 'pivot-' + cell.status : 'pivot-empty' %>"
                  <% if (cell) { %>onclick="vqrShowDetail('<%= ch %>', <%= ri %>, <%= ci %>)"<% } %>
                  title="<%= cell ? row.maCongTrinh + ' - ' + pivot.dates[ci] : '' %>"
                ><%= cell ? Math.round(cell.gross / 1000) + 'k' : '' %></td>
                <% }) %>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <p class="muted" style="margin-top:6px;">Bấm vào 1 ô trong bảng để xem chi tiết ngày đó (hiện ra ở khung giữa màn hình).</p>
      <% } %>

      <%
        // Tong hop tat ca dong bi lech (khong locked, khong SKIP, khong manualOverride)
        // manualOverride = da bu tru roi -> an di khoi bang nay
        var lechRows = [];
        (reconciled[ch] || []).forEach(function(r) {
          (r.lines || []).forEach(function(l) {
            if (l.locked || l.tkCo === 'SKIP') return;
            if (l.manualOverride) return;
            if (Math.abs(l.diff) < 1) return;
            lechRows.push({ date: r.settlementDate, l: l, ch: ch });
          });
        });
      %>
      <% if (lechRows.length > 0) { %>
      <div style="margin-top:12px; margin-bottom:4px; border:1px solid #dee2e6; border-radius:6px; overflow:hidden;">
        <div style="background:#fff3cd; padding:8px 12px; display:flex; align-items:center; gap:8px; cursor:pointer; user-select:none;"
          onclick="var b=document.getElementById('lech-body-<%=ch%>'); b.style.display=b.style.display==='none'?'block':'none';">
          <span style="font-weight:600;">⚠️ Tổng hợp lệch — <%= lechRows.length %> dòng chưa khớp</span>
          <span class="muted" style="font-size:11px;">▼ click để ẩn/hiện</span>
        </div>
        <div id="lech-body-<%= ch %>" style="padding:10px 12px;">
          <div style="display:flex; gap:10px; align-items:center; margin-bottom:8px;">
            <button onclick="submitBulkLech('<%= ch %>')" type="button"
              style="font-size:12px; padding:5px 12px; background:#0d6efd; color:#fff; border:none; border-radius:4px; cursor:pointer; font-weight:600;">
              💾 Lưu tất cả đã chọn
            </button>
            <label style="font-size:12px; cursor:pointer; display:flex; align-items:center; gap:4px;">
              <input type="checkbox" id="selAll-<%= ch %>"
                onchange="toggleAllLech('<%= ch %>', this.checked)" checked>
              Chọn tất cả
            </label>
            <span class="muted" style="font-size:11px;">Điền số HĐ / tiền HĐ / sửa DT rồi bấm Lưu. Hàng đã lưu tự biến mất.</span>
          </div>
          <div style="overflow-x:auto;">
          <style>.lech-tbl thead th { position: static !important; top: auto !important; box-shadow: none !important; }</style>
          <table class="table lech-tbl" style="font-size:12px; min-width:820px; margin-bottom:0;">
            <thead>
              <tr>
                <th style="width:28px;"></th>
                <th style="white-space:nowrap;">Ngày</th>
                <th>Mã công trình</th>
                <th style="text-align:right;">DT (NH)</th>
                <th style="text-align:right;">Tổng HĐ</th>
                <th style="text-align:right;">Lệch</th>
                <th>Số HĐ</th>
                <th>Tiền HĐ</th>
                <th>Sửa DT (+/-)</th>
              </tr>
            </thead>
            <tbody>
            <% lechRows.forEach(function(item, idx) { var l = item.l; var fid = ch + '_' + idx; %>
            <tr class="lrow-<%= ch %>"
              data-fid="<%= fid %>"
              data-channel="<%= ch %>"
              data-date="<%= item.date %>"
              data-code="<%= encodeURIComponent(l.code) %>"
              data-amt="<%= l.invoiceTotal %>">
              <td>
                <input type="checkbox" class="lsel-<%= ch %>" checked
                  onchange="toggleAllLech('<%= ch %>', null)">
              </td>
              <td style="white-space:nowrap;"><%= item.date %></td>
              <td><%= l.maCongTrinh || l.code %></td>
              <td style="text-align:right;"><%= l.gross.toLocaleString('vi-VN') %></td>
              <td style="text-align:right;"><%= l.invoiceTotal.toLocaleString('vi-VN') %></td>
              <td style="text-align:right;" class="<%= l.diff > 0 ? 'text-pos' : 'text-neg' %>">
                <%= l.diff.toLocaleString('vi-VN') %>
              </td>
              <td><input type="text" class="linv-<%= fid %>"
                value="<%= (l.invoiceNumbers||[]).join(', ') %>"
                placeholder="Số HĐ" style="width:80px; font-size:11px;"></td>
              <td><input type="number" class="lamt-<%= fid %>"
                value="<%= l.invoiceTotal %>"
                placeholder="Tiền HĐ" style="width:80px; font-size:11px;"></td>
              <td><input type="text" class="lgadj-<%= fid %>"
                value="" placeholder="+/-" style="width:65px; font-size:11px;"></td>
            </tr>
            <% }) %>
            </tbody>
          </table>
          </div>
        </div>
      </div>
      <script>
      if (!window._lechReady) {
        window._lechReady = true;
        window.toggleAllLech = function(ch, val) {
          var cbs = document.querySelectorAll('.lsel-' + ch);
          if (val !== null) { cbs.forEach(function(c) { c.checked = val; }); }
          var selAll = document.getElementById('selAll-' + ch);
          if (selAll) {
            var all = Array.from(cbs);
            selAll.checked = all.length > 0 && all.every(function(c) { return c.checked; });
            selAll.indeterminate = !selAll.checked && all.some(function(c) { return c.checked; });
          }
        };
        window.submitBulkLech = function(ch) {
          var rows = Array.from(document.querySelectorAll('.lrow-' + ch));
          var selected = rows.filter(function(tr) {
            var cb = tr.querySelector('.lsel-' + ch);
            return cb && cb.checked;
          });
          if (!selected.length) { alert('Chưa chọn dòng nào.'); return; }
          var form = document.createElement('form');
          form.method = 'POST'; form.action = '/doi-soat/vietqr/manual-match/bulk';
          form.style.display = 'none';
          function hi(name, val) {
            var inp = document.createElement('input');
            inp.type = 'hidden'; inp.name = name; inp.value = val || '';
            form.appendChild(inp);
          }
          hi('returnChannel', ch);
          selected.forEach(function(tr) {
            var fid = tr.dataset.fid;
            hi('channel', tr.dataset.channel);
            hi('settlementDate', tr.dataset.date);
            hi('code', decodeURIComponent(tr.dataset.code));
            var invEl = document.querySelector('.linv-' + fid);
            var amtEl = document.querySelector('.lamt-' + fid);
            var gadjEl = document.querySelector('.lgadj-' + fid);
            hi('invoiceNumbers', invEl ? invEl.value : '');
            hi('amount', amtEl ? amtEl.value : tr.dataset.amt);
            hi('grossAdjustment', gadjEl ? gadjEl.value : '');
          });
          document.body.appendChild(form);
          form.submit();
        };
      }
      </script>
      <% } %>

      <div style="margin-top:16px;">
        <div style="display:flex; align-items:center; gap:8px; margin-bottom:8px;">
          <strong>Xem chi tiết theo từng ngày</strong>
          <input
            type="text"
            placeholder="Tìm ngày (vd 2026-07-05)"
            oninput="vqrFilterDays('<%= ch %>', this.value)"
            style="flex:0 0 220px; padding:4px 8px; font-size:12px; border:1px solid #ddd; border-radius:6px;"
          />
        </div>
      <% var list = reconciled[ch] || []; %>
      <% if (list.length === 0) { %>
        <p class="muted">Chưa có dữ liệu để đối soát kênh này (trong tháng đang chọn).</p>
      <% } else { %>
      <% var dayList = list.filter(function(r){ return r.lines.length > 0; }); %>
        <table class="table" id="vqr-summary-<%= ch %>" style="font-size:12px;">
          <thead>
            <tr>
              <th>Ngày</th><th>Ngân hàng</th><th>Tính từ dữ liệu tải lên</th>
              <th>Lệch: Ngân hàng ↔ Dữ liệu</th><th>Lệch: Dữ liệu ↔ Hóa đơn</th>
            </tr>
          </thead>
          <tbody>
            <% dayList.forEach(function(r) {
              // Luyen, 2026-07-19: "hiện ngày cho tôi 2 phần lệch đi, 1 là ngân
              // hàng với dữ liệu, 1 là dữ liệu với hóa đơn" -- tach ro 2 loai
              // lech khac nhau o dong tong theo ngay, thay vi phai mo tung
              // dong gian ben duoi moi biet ngay do co gian nao lech hoa don
              // hay khong. "Lech du lieu vs hoa don" la TONG (co dau) cua tung
              // dong l.diff (invoiceTotal - gross), bo qua dong SKIP.
              var invDiffSum = r.lines.reduce(function(s, l) { return s + (l.tkCo !== 'SKIP' ? l.diff : 0); }, 0);
            %>
            <tr data-day="<%= r.settlementDate %>" onclick="vqrJumpToDay('<%= ch %>','<%= r.settlementDate %>')" style="cursor:pointer;<%= r.locked ? ' opacity:0.6;' : '' %>">
              <td><%= r.settlementDate %><%= r.locked ? ' 🔒' : '' %></td>
              <% if (r.pendingBank) { %>
              <td colspan="3"><span class="badge badge-warn" title="Đã có doanh thu/gian, chưa có giao dịch ngân hàng khớp ngày này">⏳ Chưa có ngân hàng</span></td>
              <% } else { %>
              <td><%= r.bankAmount.toLocaleString('vi-VN') %> đ</td>
              <td><%= r.totalNetComputed.toLocaleString('vi-VN') %> đ</td>
              <td class="<%= Math.abs(r.diffVsBank) < 1000 ? 'text-pos' : 'text-neg' %>"><%= r.diffVsBank.toLocaleString('vi-VN') %> đ</td>
              <% } %>
              <td class="<%= Math.abs(invDiffSum) < 1000 ? 'text-pos' : 'text-neg' %>"><%= invDiffSum.toLocaleString('vi-VN') %> đ</td>
            </tr>
            <% }) %>
          </tbody>
        </table>

        <% dayList.forEach(function(r) {
          var invDiffSum = r.lines.reduce(function(s, l) { return s + (l.tkCo !== 'SKIP' ? l.diff : 0); }, 0);
        %>
        <details id="vqr-day-<%= ch %>-<%= r.settlementDate %>" style="background:#fafbfc; border:1px solid #eee; border-radius:8px; margin-top:8px; padding:8px 12px;">
          <summary style="cursor:pointer; font-size:13px; display:flex; justify-content:space-between; flex-wrap:wrap; gap:6px;">
            <span style="font-weight:600;">Ngày <%= r.settlementDate %><%= r.locked ? ' 🔒 (đã khóa sổ)' : '' %><% if (r.pendingBank) { %> <span class="badge badge-warn">⏳ Chưa có ngân hàng</span><% } %></span>
            <span>
              <% if (r.pendingBank) { %>
              Tính từ dữ liệu tải lên: <strong><%= r.totalNetComputed.toLocaleString('vi-VN') %> đ</strong>
              <% } else { %>
              Ngân hàng: <strong><%= r.bankAmount.toLocaleString('vi-VN') %> đ</strong>
              <% if (r.bankAmountExcluded) { %>
              <span class="muted">(đã trừ <%= r.bankAmountExcluded.toLocaleString('vi-VN') %> đ không phải VietQR:
                <% (r.excludedTxs || []).forEach(function(tx) { %>
                  <span style="display:inline-flex; align-items:center; gap:3px; margin-left:4px;">
                    <span title="<%= tx.description %>"><%= tx.amount.toLocaleString('vi-VN') %>đ</span>
                    <form method="POST" action="/doi-soat/vietqr/xoa-gd-ngoai" style="display:inline;"
                          onsubmit="return confirm('Cộng GD <%= tx.amount.toLocaleString('vi-VN') %>đ ngày <%= tx.date %> vào tổng ngân hàng (bỏ khỏi danh sách trừ)?');">
                      <input type="hidden" name="txId" value="<%= tx.id %>" />
                      <input type="hidden" name="channel" value="<%= ch %>" />
                      <input type="hidden" name="returnUrl" value="/doi-soat/vietqr?channel=<%= ch %>" />
                      <button type="submit" class="link-btn link-danger" style="font-size:11px; padding:0 2px;" title="Loại khỏi đối soát">✕</button>
                    </form>
                  </span>
                <% }) %>
              )</span>
              <% } %>
              &nbsp;|&nbsp; Tính từ dữ liệu tải lên: <strong><%= r.totalNetComputed.toLocaleString('vi-VN') %> đ</strong>
              &nbsp;|&nbsp;
              <span class="<%= Math.abs(r.diffVsBank) < 1000 ? 'text-pos' : 'text-neg' %>">
                Lệch Ngân hàng↔Dữ liệu: <%= r.diffVsBank.toLocaleString('vi-VN') %> đ
              </span>
              <% } %>
              &nbsp;|&nbsp;
              <span class="<%= Math.abs(invDiffSum) < 1000 ? 'text-pos' : 'text-neg' %>">
                Lệch Dữ liệu↔Hóa đơn: <%= invDiffSum.toLocaleString('vi-VN') %> đ
              </span>
            </span>
          </summary>
          <%
            const dayBankTxs = ((built[ch] && built[ch].bankTxsByDate) || {})[r.settlementDate] || [];
          %>
          <% if (isAdmin && dayBankTxs.length > 0) { %>
          <details style="margin:6px 0; font-size:12px;">
            <summary style="cursor:pointer; color:#555;">🏦 Giao dịch ngân hàng (<%= dayBankTxs.length %> giao dịch — click để xem/xóa)</summary>
            <table style="margin-top:6px; width:100%; font-size:12px; border-collapse:collapse;">
              <% dayBankTxs.forEach(function(tx) { %>
              <tr style="border-bottom:1px solid #eee;">
                <td style="padding:3px 6px; white-space:nowrap;"><%= tx.amount.toLocaleString('vi-VN') %>đ</td>
                <td style="padding:3px 6px; color:#555; max-width:400px; overflow:hidden; text-overflow:ellipsis;" title="<%= tx.description %>"><%= tx.description %></td>
                <td style="padding:3px 6px;">
                  <form method="POST" action="/transactions/<%= tx.id %>/xoa" style="display:inline;"
                    onsubmit="return confirm('Xoá giao dịch ngày <%= tx.date %> số tiền <%= tx.amount.toLocaleString('vi-VN') %>đ?')">
                    <button type="submit" class="link-btn" style="font-size:11px; color:#c0392b;">Xoá</button>
                  </form>
                </td>
              </tr>
              <% }) %>
            </table>
          </details>
          <% } %>
          <% if (r.tanPhuSuggestion) { %>
          <p class="badge badge-warn" style="display:block; margin-top:8px; font-size:12px; padding:6px 10px;">
            ✅ Sau khi trừ giao dịch không phải VietQR, Ngân hàng ngày này còn dư <strong><%= r.tanPhuSuggestion.amount.toLocaleString('vi-VN') %> đ</strong> so với dữ liệu đối soát — đã tự động gộp vào gian <strong><%= r.tanPhuSuggestion.targetCode %></strong>.
          </p>
          <% } %>
          <table class="table" style="margin-top:8px;">
            <thead>
              <tr><th>Mã công trình (gian)</th><th>TK Có</th><th>Doanh thu</th><th>Số HĐ khớp</th><th>Tổng tiền HĐ</th><th>Trạng thái</th></tr>
            </thead>
            <tbody>
              <% r.lines.forEach(function(l) { %>
              <% if (l.skipLine) return; /* an dong da bi Xoa khoi doi soat */ %>
              <tr<%= l.tkCo === 'SKIP' ? ' style="opacity:0.6;"' : '' %>>
                <td>
                  <%= l.maCongTrinh %><%= l.code.endsWith('__FF') ? ' (CSE)' : '' %>
                  <% if (l.code === '__VANG_LAI__') { %>
                  <% var dateGianForCh = (vangLaiDateGian && vangLaiDateGian[ch]) || {}; %>
                  <% var currentDateVal = dateGianForCh[r.settlementDate] || (vangLaiGian && vangLaiGian[ch]) || ''; %>
                  <form method="POST" action="/doi-soat/vietqr/set-vang-lai-date/<%= ch %>" style="display:inline-flex;align-items:center;gap:4px;margin-left:6px;">
                    <input type="hidden" name="settlementDate" value="<%= r.settlementDate %>" />
                    <input type="hidden" name="returnMonth" value="<%= selectedMonth %>" />
                    <input type="text" name="vangLaiCode" value="<%= currentDateVal %>"
                           list="dl-ma-cong-trinh-full" autocomplete="off"
                           placeholder="Map → Mã CT" style="width:110px;font-size:11px;padding:1px 4px;" />
                    <button type="submit" class="link-btn" style="font-size:11px;">Lưu</button>
                  </form>
                  <% } %>
                </td>
                <td><%= l.tkCo === 'SKIP' ? '—' : l.tkCo %></td>
                <td><%= l.gross.toLocaleString('vi-VN') %> đ</td>
                <td><%= l.invoiceNumbers.join(', ') || '-' %></td>
                <td><%= l.invoiceTotal.toLocaleString('vi-VN') %> đ</td>
                <td>
                  <% if (l.locked) { %>
                    <span class="badge">🔒 Đã khóa sổ</span>
                  <% } else if (l.tkCo === 'SKIP') { %>
                    <span class="badge badge-chi">KH mới - chưa xuất MISA</span>
                  <% } else if (l.manualOverride) { %>
                    <% if (l.matched) { %>
                      <span class="badge badge-thu">Khớp (bù thủ công)</span>
                    <% } else { %>
                      <span class="badge badge-chi">Lệch (đã bù 1 phần) còn <%= l.diff.toLocaleString('vi-VN') %> đ</span>
                    <% } %>
                    <form method="POST" action="/doi-soat/vietqr/manual-match/delete" style="display:inline;"
                          onsubmit="return xoaBuTruConfirm(this, '<%= l.code.replace(/'/g,"\\'") %>', '<%= r.settlementDate %>');">
                      <input type="hidden" name="channel" value="<%= ch %>" />
                      <input type="hidden" name="settlementDate" value="<%= r.settlementDate %>" />
                      <input type="hidden" name="code" value="<%= l.code %>" />
                      <button type="submit" class="link-btn link-danger" style="font-size:11px;">Xoá bù trừ</button>
                    </form>
                    <% if (l.gross === 0 && l.invoiceTotal === 0) { %>
                    <form method="POST" action="/doi-soat/vietqr/skip-line" style="display:inline; margin-left:4px;"
                          onsubmit="return confirm('Ẩn hẳn dòng này khỏi đối soát?');">
                      <input type="hidden" name="channel" value="<%= ch %>">
                      <input type="hidden" name="settlementDate" value="<%= r.settlementDate %>">
                      <input type="hidden" name="code" value="<%= l.code %>">
                      <input type="hidden" name="returnUrl" value="/doi-soat/vietqr?channel=<%= ch %>">
                      <button type="submit" class="link-btn link-danger" style="font-size:11px;">Xóa hẳn</button>
                    </form>
                    <% } %>
                    <% if (l.manualNote) { %><div class="muted" style="font-size:11px;"><%= l.manualNote %></div><% } %>
                  <% } else if (l.gross === 0 && l.invoiceTotal === 0) { %>
                    <span class="badge badge-chi" style="opacity:0.6;">0đ</span>
                    <form method="POST" action="/doi-soat/vietqr/skip-line" style="display:inline; margin-left:6px;"
                          onsubmit="return confirm('Ẩn dòng <%= l.maCongTrinh %> ngày <%= r.settlementDate %> khỏi đối soát?');">
                      <input type="hidden" name="channel" value="<%= ch %>">
                      <input type="hidden" name="settlementDate" value="<%= r.settlementDate %>">
                      <input type="hidden" name="code" value="<%= l.code %>">
                      <input type="hidden" name="returnUrl" value="/doi-soat/vietqr?channel=<%= ch %>">
                      <button type="submit" class="link-btn link-danger" style="font-size:11px;">Xóa</button>
                    </form>
                  <% } else if (l.invoiceNumbers.length === 0) { %>
                    <span class="badge badge-chi">Chưa có HĐ</span>
                    <form method="POST" action="/doi-soat/vietqr/manual-match" style="margin-top:6px;">
                      <input type="hidden" name="channel" value="<%= ch %>" />
                      <input type="hidden" name="settlementDate" value="<%= r.settlementDate %>" />
                      <input type="hidden" name="code" value="<%= l.code %>" />
                      <input type="text" name="invoiceNumbers" placeholder="Số HĐ bù" style="width:80px; font-size:11px;" />
                      <input type="text" name="amount" placeholder="Số tiền" style="width:80px; font-size:11px;" />
                      <input type="text" name="grossAdjustment" placeholder="+/- Sửa DT" title="Sửa doanh thu (Doanh thu) của dòng này: nhập số dương để cộng thêm, số âm để trừ bớt — dùng khi dữ liệu QR thiếu/dư (vd 1 GD không có mã cửa hàng thuộc gian này, hoặc trùng/thiếu giao dịch)" style="width:80px; font-size:11px;" />
                      <button type="submit" class="link-btn" style="font-size:11px;" title="Đánh dấu đã có hóa đơn bù (vd xuất ngày hôm sau)">Đã có HĐ bù</button>
                    </form>
                  <% } else if (l.matched) { %>
                    <span class="badge badge-thu">Khớp</span>
                  <% } else { %>
                    <span class="badge badge-chi">Lệch <%= l.diff.toLocaleString('vi-VN') %> đ</span>
                    <form method="POST" action="/doi-soat/vietqr/manual-match" style="margin-top:6px;">
                      <input type="hidden" name="channel" value="<%= ch %>" />
                      <input type="hidden" name="settlementDate" value="<%= r.settlementDate %>" />
                      <input type="hidden" name="code" value="<%= l.code %>" />
                      <input type="text" name="invoiceNumbers" value="<%= l.invoiceNumbers.join(', ') %>" placeholder="Số HĐ" style="width:100px; font-size:11px;" />
                      <input type="text" name="amount" value="<%= l.invoiceTotal %>" placeholder="Số tiền" style="width:80px; font-size:11px;" />
                      <input type="text" name="grossAdjustment" placeholder="+/- Sửa DT" title="Sửa doanh thu (Doanh thu) của dòng này: nhập số dương để cộng thêm, số âm để trừ bớt — dùng khi dữ liệu QR thiếu/dư (vd 1 GD không có mã cửa hàng thuộc gian này, hoặc trùng/thiếu giao dịch)" style="width:80px; font-size:11px;" />
                      <button type="submit" class="link-btn" style="font-size:11px;" title="Sửa/thêm số hóa đơn cho dòng lệch này">Sửa HĐ</button>
                    </form>
                  <% } %>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </details>
        <% }) %>
      <% } %>
      </div>
    </section>
    <% }) %>
  </main>

  <div class="vqr-modal-overlay" id="vqr-modal-overlay" onclick="if (event.target === this) vqrCloseModal();">
    <div class="vqr-modal-box">
      <button type="button" class="vqr-modal-close" onclick="vqrCloseModal()">&times;</button>
      <div id="vqr-modal-body"></div>
    </div>
  </div>

  <!-- Custom confirm modal cho Xoá bù trừ thủ công -->
  <div id="xoa-bu-tru-overlay" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,.45); z-index:9999; align-items:center; justify-content:center;">
    <div style="background:#fff; border-radius:10px; padding:28px 32px; max-width:400px; width:90%; box-shadow:0 8px 32px rgba(0,0,0,.25); text-align:center;">
      <div style="font-size:2rem; margin-bottom:8px;">⚠️</div>
      <h3 style="margin:0 0 10px; color:#c0392b; font-size:1.1rem;">Xoá bù trừ thủ công</h3>
      <p style="margin:0 0 6px; font-size:.95rem;" id="xoa-bu-tru-msg"></p>
      <p style="margin:0 0 20px; font-size:.85rem; color:#888;">Sau khi xoá, gian sẽ trở về trạng thái lệch. Bạn có chắc không?</p>
      <div style="display:flex; gap:12px; justify-content:center;">
        <button onclick="xoaBuTruHuy()" style="padding:8px 24px; border:1px solid #ccc; border-radius:6px; background:#f5f5f5; cursor:pointer; font-size:.9rem;">Hủy</button>
        <button onclick="xoaBuTruXacNhan()" style="padding:8px 24px; border:none; border-radius:6px; background:#c0392b; color:#fff; cursor:pointer; font-size:.9rem; font-weight:600;">Xoá</button>
      </div>
    </div>
  </div>

  <script>
    var _xoaBuTruForm = null;
    function xoaBuTruConfirm(form, code, date) {
      _xoaBuTruForm = form;
      var msg = document.getElementById('xoa-bu-tru-msg');
      msg.innerHTML = '<strong>' + code + '</strong> — Ngày ' + date;
      var overlay = document.getElementById('xoa-bu-tru-overlay');
      overlay.style.display = 'flex';
      return false; // chặn submit ngay
    }
    function xoaBuTruHuy() {
      _xoaBuTruForm = null;
      document.getElementById('xoa-bu-tru-overlay').style.display = 'none';
    }
    function xoaBuTruXacNhan() {
      document.getElementById('xoa-bu-tru-overlay').style.display = 'none';
      if (_xoaBuTruForm) {
        var f = _xoaBuTruForm;
        _xoaBuTruForm = null;
        f.removeAttribute('onsubmit');
        f.submit();
      }
    }
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && document.getElementById('xoa-bu-tru-overlay').style.display !== 'none') xoaBuTruHuy();
    });
  </script>
</body>
</html>

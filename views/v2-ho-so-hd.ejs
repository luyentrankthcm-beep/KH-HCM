<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Hồ Sơ Hóa Đơn – K&amp;H</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; background: #f4f6f9; color: #1a2035; min-height: 100vh; }

    /* ── Topbar ── */
    .topbar {
      background: #1e3a5f;
      color: #fff;
      display: flex;
      align-items: center;
      gap: 1rem;
      padding: .65rem 1.25rem;
      position: sticky; top: 0; z-index: 100;
      box-shadow: 0 2px 8px rgba(0,0,0,.25);
    }
    .topbar-back { background: none; border: none; color: #fff; font-size: 1.2rem; cursor: pointer; padding: .25rem .4rem; border-radius: 5px; }
    .topbar-back:hover { background: rgba(255,255,255,.15); }
    .brand { display: flex; align-items: baseline; gap: .5rem; }
    .brand-name { font-size: 1.1rem; font-weight: 800; letter-spacing: .03em; }
    .brand-sub { font-size: .72rem; opacity: .75; }
    .topbar-spacer { flex: 1; }
    .company-pills { display: flex; gap: .3rem; }
    .company-pill {
      padding: .3rem .85rem; border-radius: 20px; border: none; cursor: pointer;
      font-size: .8rem; font-weight: 700; transition: all .15s;
      background: rgba(255,255,255,.12); color: rgba(255,255,255,.8);
    }
    .company-pill.active { background: #fff; color: #1e3a5f; }
    .company-pill:hover:not(.active) { background: rgba(255,255,255,.22); }
    .nav-links { display: flex; gap: .15rem; }
    .nav-link { color: rgba(255,255,255,.8); text-decoration: none; padding: .3rem .75rem; border-radius: 5px; font-size: .82rem; }
    .nav-link:hover { background: rgba(255,255,255,.12); color: #fff; }
    .user-area { display: flex; align-items: center; gap: .75rem; font-size: .82rem; }
    .btn-logout { background: none; border: 1px solid rgba(255,255,255,.3); color: #fff; border-radius: 5px; padding: .25rem .65rem; cursor: pointer; font-size: .78rem; }
    .btn-logout:hover { background: rgba(255,255,255,.12); }

    /* ── Page layout ── */
    .page { max-width: 1200px; margin: 0 auto; padding: 1.5rem 1.25rem; }
    .page-header { display: flex; align-items: center; gap: 1rem; margin-bottom: 1.25rem; flex-wrap: wrap; }
    .page-title { font-size: 1.4rem; font-weight: 800; color: #1e3a5f; }
    .company-badge {
      display: inline-flex; align-items: center; gap: .4rem;
      padding: .3rem .85rem; border-radius: 20px; font-size: .8rem; font-weight: 700;
    }
    .badge-cu { background: #dbeafe; color: #1d4ed8; }
    .badge-moi { background: #dcfce7; color: #166534; }

    /* ── Toolbar ── */
    .toolbar { display: flex; gap: .75rem; margin-bottom: 1rem; flex-wrap: wrap; align-items: center; }
    .search-box {
      flex: 1; min-width: 200px; max-width: 360px;
      padding: .5rem .85rem; border: 1px solid #d1d5db; border-radius: 8px;
      font-size: .88rem; background: #fff; outline: none;
    }
    .search-box:focus { border-color: #3b82f6; box-shadow: 0 0 0 2px rgba(59,130,246,.15); }
    .filter-select {
      padding: .48rem .75rem; border: 1px solid #d1d5db; border-radius: 8px;
      font-size: .85rem; background: #fff; cursor: pointer; color: #374151; outline: none;
    }
    .filter-select:focus { border-color: #3b82f6; }
    .stat-chip {
      display: inline-flex; align-items: center; gap: .3rem;
      background: #fff; border: 1px solid #e5e7eb; border-radius: 8px;
      padding: .4rem .85rem; font-size: .82rem; color: #4b5563; white-space: nowrap;
    }
    .stat-chip strong { color: #1e3a5f; }

    /* ── Cards / Table ── */
    .ncc-card {
      background: #fff; border-radius: 10px; box-shadow: 0 1px 4px rgba(0,0,0,.07);
      margin-bottom: 1rem; overflow: hidden;
      border: 1px solid #e5e7eb;
    }
    .ncc-card-header {
      display: flex; align-items: center; gap: .75rem;
      padding: .75rem 1rem; cursor: pointer; user-select: none;
      background: #f8fafc; border-bottom: 1px solid #e5e7eb;
      transition: background .12s;
    }
    .ncc-card-header:hover { background: #eff6ff; }
    .ncc-avatar {
      width: 36px; height: 36px; border-radius: 8px;
      background: #1e3a5f; color: #fff;
      display: flex; align-items: center; justify-content: center;
      font-weight: 800; font-size: .85rem; flex-shrink: 0;
    }
    .ncc-info { flex: 1; min-width: 0; }
    .ncc-short { font-weight: 700; font-size: .95rem; color: #1e3a5f; }
    .ncc-full { font-size: .78rem; color: #6b7280; margin-top: .1rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .ncc-meta { display: flex; gap: .5rem; align-items: center; flex-shrink: 0; flex-wrap: wrap; }
    .count-badge { background: #dbeafe; color: #1e40af; border-radius: 12px; padding: .15rem .6rem; font-size: .75rem; font-weight: 700; }
    .tong-tien { font-weight: 700; color: #15803d; font-size: .88rem; white-space: nowrap; }
    .chevron { font-size: .8rem; color: #9ca3af; transition: transform .2s; }
    .ncc-card.open .chevron { transform: rotate(90deg); }

    .ncc-card-body { display: none; padding: 0; }
    .ncc-card.open .ncc-card-body { display: block; }

    /* Invoice table inside card */
    .inv-table { width: 100%; border-collapse: collapse; font-size: .84rem; }
    .inv-table th { background: #f1f5f9; color: #374151; padding: .45rem .85rem; text-align: left; font-size: .75rem; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; border-bottom: 2px solid #e2e8f0; white-space: nowrap; }
    .inv-table td { padding: .5rem .85rem; border-bottom: 1px solid #f1f5f9; vertical-align: middle; }
    .inv-table tbody tr:last-child td { border-bottom: none; }
    .inv-table tbody tr:hover td { background: #f8fafc; }
    .tag { display: inline-block; background: #e0f2fe; color: #0369a1; border-radius: 4px; padding: .06rem .4rem; font-size: .75rem; font-weight: 600; }
    .link-pdf { color: #2563eb; text-decoration: none; display: inline-flex; align-items: center; gap: .3rem; font-size: .82rem; }
    .link-pdf:hover { text-decoration: underline; }
    .tien-cell { font-weight: 600; color: #15803d; white-space: nowrap; }
    .date-cell { white-space: nowrap; color: #374151; }

    /* Empty state */
    .empty { text-align: center; padding: 3rem; color: #9ca3af; }
    .empty-icon { font-size: 2.5rem; margin-bottom: .75rem; }
    .empty-text { font-size: .95rem; }

    /* Responsive */
    @media (max-width: 640px) {
      .inv-table th:nth-child(3), .inv-table td:nth-child(3),
      .inv-table th:nth-child(4), .inv-table td:nth-child(4) { display: none; }
      .brand-sub { display: none; }
    }
  </style>
</head>
<body>

<!-- Topbar -->
<div class="topbar">
  <button class="topbar-back" onclick="history.back()" title="Quay lại">←</button>
  <div class="brand">
    <span class="brand-name">K&amp;H</span>
    <span class="brand-sub"><%= COMPANIES[activeCompany].fullName %></span>
  </div>

  <!-- Company switcher -->
  <form method="POST" action="/chon-cong-ty" id="frmCompany" style="display:none">
    <input type="hidden" name="redirectTo" value="/v2/ho-so/hoa-don-ncc" />
    <input type="hidden" name="company" id="frmCompanyVal" value="" />
  </form>
  <div class="company-pills">
    <% Object.values(COMPANIES).forEach(function(c) { %>
    <button type="button"
      class="company-pill <%= activeCompany === c.key ? 'active' : '' %>"
      onclick="document.getElementById('frmCompanyVal').value='<%= c.key %>'; document.getElementById('frmCompany').submit();">
      <%= c.shortLabel %>
    </button>
    <% }) %>
  </div>

  <div class="topbar-spacer"></div>

  <nav class="nav-links">
    <a class="nav-link" href="/">Tổng quan</a>
    <a class="nav-link" href="/ho-so/hoa-don-ncc">Phiên bản cũ</a>
  </nav>

  <div class="user-area">
    <span><%= userName %></span>
    <form method="POST" action="/logout" style="display:inline">
      <button type="submit" class="btn-logout">Đăng xuất</button>
    </form>
  </div>
</div>

<!-- Page -->
<div class="page">
  <div class="page-header">
    <h1 class="page-title">📄 Hồ Sơ Hóa Đơn NCC</h1>
    <span class="company-badge <%= activeCompany === 'kh_cu' ? 'badge-cu' : 'badge-moi' %>">
      🏢 <%= COMPANIES[activeCompany].label %>
    </span>
  </div>

  <% if (error) { %><div style="background:#fee2e2;color:#991b1b;padding:.75rem 1rem;border-radius:8px;margin-bottom:1rem;"><%= error %></div><% } %>
  <% if (success) { %><div style="background:#dcfce7;color:#166534;padding:.75rem 1rem;border-radius:8px;margin-bottom:1rem;"><%= success %></div><% } %>

  <!-- Toolbar -->
  <div class="toolbar">
    <input type="text" class="search-box" id="searchBox" placeholder="🔍  Tìm NCC, số hóa đơn..." oninput="filterCards()" />
    <select class="filter-select" id="thangFilter" onchange="applyThangFilter(this.value)">
      <option value="">Tất cả tháng</option>
      <% allThang.forEach(function(t) { %>
      <option value="<%= t %>" <%= thangFilter === t ? 'selected' : '' %>>
        <%= t.slice(5,7) %>/<%= t.slice(0,4) %>
      </option>
      <% }) %>
    </select>
    <span class="stat-chip">Tổng: <strong><%= total %></strong> hóa đơn / <strong><%= groups.length %></strong> NCC</span>
  </div>

  <!-- NCC Cards -->
  <div id="cardList">
    <% if (groups.length === 0) { %>
    <div class="empty">
      <div class="empty-icon">📭</div>
      <div class="empty-text">Chưa có hóa đơn nào cho <%= COMPANIES[activeCompany].label %></div>
    </div>
    <% } %>

    <% groups.forEach(function(g) {
      const tongTien = g.invoices.reduce(function(s,r){ return s + (r.tongTien||0); }, 0);
      const avatarLetter = g.nccShort.charAt(0).toUpperCase();
    %>
    <div class="ncc-card" data-ncc="<%= g.nccShort.toLowerCase() %>">
      <div class="ncc-card-header" onclick="toggleCard(this.parentElement)">
        <div class="ncc-avatar"><%= avatarLetter %></div>
        <div class="ncc-info">
          <div class="ncc-short"><%= g.nccShort %></div>
          <% if (g.tenDayDuNCC) { %><div class="ncc-full" title="<%= g.tenDayDuNCC %>"><%= g.tenDayDuNCC %></div><% } %>
        </div>
        <div class="ncc-meta">
          <span class="count-badge"><%= g.invoices.length %> HĐ</span>
          <% if (tongTien > 0) { %><span class="tong-tien"><%= tongTien.toLocaleString('vi-VN') %> ₫</span><% } %>
          <span class="chevron">▶</span>
        </div>
      </div>
      <div class="ncc-card-body">
        <table class="inv-table">
          <thead>
            <tr>
              <th>Số HĐ</th>
              <th>Ngày</th>
              <th>Nội dung</th>
              <th>Số tiền</th>
              <th>File PDF</th>
            </tr>
          </thead>
          <tbody>
            <% g.invoices.forEach(function(inv) { %>
            <tr data-search="<%= (inv.nccShort + ' ' + inv.soHoaDon + ' ' + (inv.tenDayDuNCC||'')).toLowerCase() %>">
              <td><span class="tag"><%= inv.soHoaDon || '—' %></span></td>
              <td class="date-cell">
                <% if (inv.ngay) { %>
                  <%= inv.ngay.slice(8,10) %>/<%= inv.ngay.slice(5,7) %>/<%= inv.ngay.slice(0,4) %>
                <% } else { %>—<% } %>
              </td>
              <td style="color:#4b5563; font-size:.82em; max-width:260px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                <%= inv.dienGiai || inv.ghiChu || '' %>
              </td>
              <td class="tien-cell">
                <% if (inv.tongTien > 0) { %><%= inv.tongTien.toLocaleString('vi-VN') %> ₫<% } else { %>—<% } %>
              </td>
              <td>
                <a class="link-pdf" href="https://drive.google.com/file/d/<%= inv.driveId %>/view" target="_blank" rel="noopener">
                  📄 Xem PDF
                </a>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
    <% }) %>
  </div>
</div>

<script>
function toggleCard(card) {
  card.classList.toggle('open');
}

function applyThangFilter(val) {
  const url = new URL(window.location.href);
  if (val) url.searchParams.set('thang', val);
  else url.searchParams.delete('thang');
  window.location.href = url.toString();
}

function filterCards() {
  const q = document.getElementById('searchBox').value.toLowerCase().trim();
  document.querySelectorAll('.ncc-card').forEach(function(card) {
    const ncc = (card.dataset.ncc || '');
    const rows = card.querySelectorAll('tbody tr');
    let cardMatch = !q || ncc.includes(q);
    rows.forEach(function(row) {
      const match = !q || (row.dataset.search || '').includes(q) || ncc.includes(q);
      row.style.display = match ? '' : 'none';
    });
    // Show card if header matches OR any row matches
    const anyRow = Array.from(rows).some(r => r.style.display !== 'none');
    card.style.display = (cardMatch || anyRow) ? '' : 'none';
    // Auto-expand if searching
    if (q && (cardMatch || anyRow)) card.classList.add('open');
    else if (!q) card.classList.remove('open');
  });
}
</script>
</body>
</html>

<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Hồ Sơ – K&amp;H</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; background: #f4f6f9; color: #1a2035; min-height: 100vh; }

    /* ── Topbar ── */
    .topbar {
      background: #1e3a5f; color: #fff;
      display: flex; align-items: center; gap: .85rem;
      padding: .6rem 1.25rem;
      position: sticky; top: 0; z-index: 100;
      box-shadow: 0 2px 8px rgba(0,0,0,.3);
    }
    .topbar-back { background: none; border: none; color: #fff; font-size: 1.1rem; cursor: pointer; padding: .2rem .4rem; border-radius: 5px; }
    .topbar-back:hover { background: rgba(255,255,255,.15); }
    .brand-name { font-size: 1.05rem; font-weight: 800; }
    .brand-sub { font-size: .7rem; opacity: .7; margin-left: .35rem; }
    .spacer { flex: 1; }
    .company-pills { display: flex; gap: .3rem; }
    .cpill {
      padding: .28rem .8rem; border-radius: 20px; border: none; cursor: pointer;
      font-size: .78rem; font-weight: 700; transition: all .15s;
      background: rgba(255,255,255,.12); color: rgba(255,255,255,.82);
    }
    .cpill.active { background: #fff; color: #1e3a5f; }
    .cpill:hover:not(.active) { background: rgba(255,255,255,.22); }
    .user-info { font-size: .8rem; opacity: .8; }
    .btn-logout { background: none; border: 1px solid rgba(255,255,255,.28); color: #fff; border-radius: 5px; padding: .22rem .6rem; cursor: pointer; font-size: .75rem; }
    .btn-logout:hover { background: rgba(255,255,255,.12); }

    /* ── Tabs ── */
    .tab-nav {
      background: #fff; border-bottom: 2px solid #e5e7eb;
      display: flex; gap: 0; padding: 0 1.25rem; overflow-x: auto;
      position: sticky; top: 45px; z-index: 90;
      box-shadow: 0 1px 4px rgba(0,0,0,.06);
    }
    .tab-link {
      display: inline-block; padding: .7rem 1.1rem;
      font-size: .84rem; font-weight: 600; color: #6b7280;
      text-decoration: none; border-bottom: 3px solid transparent;
      white-space: nowrap; transition: all .15s; margin-bottom: -2px;
    }
    .tab-link:hover { color: #1e3a5f; }
    .tab-link.active { color: #1e3a5f; border-bottom-color: #1e3a5f; }

    /* ── Page ── */
    .page { max-width: 1180px; margin: 0 auto; padding: 1.25rem 1.1rem; }
    .page-header { display: flex; align-items: center; gap: .85rem; margin-bottom: 1rem; flex-wrap: wrap; }
    .page-title { font-size: 1.3rem; font-weight: 800; color: #1e3a5f; }
    .co-badge { display: inline-flex; align-items: center; gap: .3rem; padding: .25rem .75rem; border-radius: 20px; font-size: .77rem; font-weight: 700; }
    .co-cu { background: #dbeafe; color: #1d4ed8; }
    .co-moi { background: #dcfce7; color: #166534; }

    /* ── Toolbar ── */
    .toolbar { display: flex; gap: .6rem; margin-bottom: .9rem; flex-wrap: wrap; align-items: center; }
    .search-box { flex: 1; min-width: 180px; max-width: 340px; padding: .48rem .8rem; border: 1px solid #d1d5db; border-radius: 8px; font-size: .86rem; background: #fff; outline: none; }
    .search-box:focus { border-color: #3b82f6; box-shadow: 0 0 0 2px rgba(59,130,246,.14); }
    .filter-sel { padding: .46rem .7rem; border: 1px solid #d1d5db; border-radius: 8px; font-size: .83rem; background: #fff; cursor: pointer; outline: none; }
    .stat-chip { background: #fff; border: 1px solid #e5e7eb; border-radius: 8px; padding: .38rem .8rem; font-size: .8rem; color: #4b5563; white-space: nowrap; }
    .stat-chip strong { color: #1e3a5f; }

    /* ── NCC Cards ── */
    .ncc-card { background: #fff; border-radius: 10px; box-shadow: 0 1px 4px rgba(0,0,0,.06); margin-bottom: .85rem; border: 1px solid #e5e7eb; overflow: hidden; }
    .ncc-head {
      display: flex; align-items: center; gap: .7rem;
      padding: .7rem 1rem; cursor: pointer; user-select: none;
      background: #f8fafc; border-bottom: 1px solid transparent;
      transition: background .12s;
    }
    .ncc-head:hover { background: #eff6ff; }
    .ncc-card.open .ncc-head { border-bottom-color: #e5e7eb; }
    .ncc-avatar { width: 34px; height: 34px; border-radius: 8px; background: #1e3a5f; color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: .82rem; flex-shrink: 0; }
    .ncc-info { flex: 1; min-width: 0; }
    .ncc-short { font-weight: 700; font-size: .92rem; color: #1e3a5f; }
    .ncc-full { font-size: .76rem; color: #6b7280; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-top: .08rem; }
    .ncc-meta { display: flex; gap: .45rem; align-items: center; flex-shrink: 0; }
    .cnt-badge { background: #dbeafe; color: #1e40af; border-radius: 12px; padding: .12rem .55rem; font-size: .73rem; font-weight: 700; }
    .tong-tien { font-weight: 700; color: #15803d; font-size: .84rem; white-space: nowrap; }
    .chev { font-size: .75rem; color: #9ca3af; transition: transform .2s; }
    .ncc-card.open .chev { transform: rotate(90deg); }

    .ncc-body { display: none; }
    .ncc-card.open .ncc-body { display: block; }

    /* ── Invoice Table ── */
    .inv-tbl { width: 100%; border-collapse: collapse; font-size: .83rem; }
    .inv-tbl th { background: #f1f5f9; color: #374151; padding: .42rem .85rem; text-align: left; font-size: .73rem; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; border-bottom: 2px solid #e2e8f0; white-space: nowrap; }
    .inv-tbl td { padding: .48rem .85rem; border-bottom: 1px solid #f1f5f9; vertical-align: middle; }
    .inv-tbl tbody tr:last-child td { border-bottom: none; }
    .inv-tbl tbody tr:hover td { background: #f8fafc; }
    .tag-so { background: #e0f2fe; color: #0369a1; border-radius: 4px; padding: .04rem .38rem; font-size: .73rem; font-weight: 700; }
    .link-pdf { color: #2563eb; text-decoration: none; font-size: .8rem; }
    .link-pdf:hover { text-decoration: underline; }
    .tien-v { font-weight: 600; color: #15803d; white-space: nowrap; }
    .date-v { white-space: nowrap; color: #374151; }
    .nd-v { color: #4b5563; font-size: .8em; max-width: 240px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .dash { color: #cbd5e1; }

    /* ── Placeholder tabs ── */
    .coming-soon { text-align: center; padding: 3.5rem 1rem; color: #9ca3af; }
    .coming-icon { font-size: 2.5rem; margin-bottom: .75rem; }
    .coming-text { font-size: .95rem; }

    /* ── Empty state ── */
    .empty { text-align: center; padding: 3rem; color: #9ca3af; }

    @media (max-width: 600px) {
      .inv-tbl th:nth-child(3), .inv-tbl td:nth-child(3) { display: none; }
      .brand-sub { display: none; }
    }
  </style>
</head>
<body>

<%
  // Helper: hien thi tien (co the la so hoac string "1,234d")
  function fmtTien(v) {
    if (!v && v !== 0) return '';
    if (typeof v === 'number') return v > 0 ? v.toLocaleString('vi-VN') + ' ₫' : '';
    if (typeof v === 'string' && v.trim()) return v;
    return '';
  }
  // Helper: YYYY-MM-DD -> DD/MM/YYYY
  function fmtNgay(s) {
    if (!s) return '';
    const p = s.split('-');
    if (p.length === 3) return p[2] + '/' + p[1] + '/' + p[0];
    return s;
  }
%>

<!-- Topbar -->
<div class="topbar">
  <button class="topbar-back" onclick="history.back()">←</button>
  <span class="brand-name">K&amp;H</span>
  <span class="brand-sub"><%= COMPANIES[activeCompany].fullName %></span>

  <form method="POST" action="/chon-cong-ty" id="fComp" style="display:none">
    <input type="hidden" name="redirectTo" id="fCompRedir" value="<%= currentPath %>" />
    <input type="hidden" name="company" id="fCompVal" value="" />
  </form>
  <div class="company-pills">
    <% Object.values(COMPANIES).forEach(function(c) { %>
    <button type="button" class="cpill <%= activeCompany === c.key ? 'active' : '' %>"
      onclick="document.getElementById('fCompVal').value='<%= c.key %>'; document.getElementById('fComp').submit();">
      <%= c.shortLabel %>
    </button>
    <% }) %>
  </div>

  <div class="spacer"></div>
  <span class="user-info"><%= userName %></span>
  <form method="POST" action="/logout" style="display:inline">
    <button type="submit" class="btn-logout">Đăng xuất</button>
  </form>
</div>

<!-- Tab nav -->
<nav class="tab-nav">
  <a class="tab-link active" href="/v2/ho-so/hoa-don-ncc">📄 Hóa Đơn NCC</a>
  <a class="tab-link" href="/v2/ho-so/phi-cang">🚢 Phí Cảng Phú Quốc</a>
  <a class="tab-link" href="/v2/ho-so/doanh-thu-chia-se">📊 Doanh Thu Chia Sẻ</a>
  <a class="tab-link" href="/v2/ho-so/tien-thue">🏠 Tiền Thuê</a>
  <a class="tab-link" href="/v2/ho-so/chung-tu">📋 Chứng Từ</a>
</nav>

<!-- Page content -->
<div class="page">
  <div class="page-header">
    <h1 class="page-title">📄 Hóa Đơn NCC</h1>
    <span class="co-badge <%= activeCompany === 'kh_cu' ? 'co-cu' : 'co-moi' %>">
      🏢 <%= COMPANIES[activeCompany].label %>
    </span>
  </div>

  <% if (error) { %><div style="background:#fee2e2;color:#991b1b;padding:.7rem 1rem;border-radius:8px;margin-bottom:.9rem;"><%= error %></div><% } %>
  <% if (success) { %><div style="background:#dcfce7;color:#166534;padding:.7rem 1rem;border-radius:8px;margin-bottom:.9rem;"><%= success %></div><% } %>

  <div class="toolbar">
    <input class="search-box" id="qBox" type="text" placeholder="🔍  Tìm NCC, số hóa đơn..." oninput="doFilter()" />
    <select class="filter-sel" id="thangSel" onchange="goThang(this.value)">
      <option value="">Tất cả tháng</option>
      <% allThang.forEach(function(t) { %>
      <option value="<%= t %>" <%= thangFilter === t ? 'selected' : '' %>>
        Tháng <%= t.slice(5,7) %>/<%= t.slice(0,4) %>
      </option>
      <% }) %>
    </select>
    <span class="stat-chip">Tổng: <strong><%= total %></strong> HĐ / <strong><%= groups.length %></strong> NCC</span>
  </div>

  <div id="cardList">
    <% if (groups.length === 0) { %>
    <div class="empty">
      <div style="font-size:2.5rem;margin-bottom:.75rem;">📭</div>
      <div>Chưa có hóa đơn nào cho <%= COMPANIES[activeCompany].label %></div>
    </div>
    <% } %>

    <% groups.forEach(function(g) {
      var tongStr = '';
      var tongNum = 0;
      g.invoices.forEach(function(inv) {
        if (typeof inv.tongTien === 'number') tongNum += inv.tongTien;
      });
      if (tongNum > 0) tongStr = tongNum.toLocaleString('vi-VN') + ' ₫';
    %>
    <div class="ncc-card" data-key="<%= g.nccShort.toLowerCase() %>" data-full="<%= (g.tenDayDuNCC||'').toLowerCase() %>">
      <div class="ncc-head" onclick="toggle(this.parentElement)">
        <div class="ncc-avatar"><%= g.nccShort.charAt(0).toUpperCase() %></div>
        <div class="ncc-info">
          <div class="ncc-short"><%= g.nccShort %></div>
          <% if (g.tenDayDuNCC) { %><div class="ncc-full" title="<%= g.tenDayDuNCC %>"><%= g.tenDayDuNCC %></div><% } %>
        </div>
        <div class="ncc-meta">
          <span class="cnt-badge"><%= g.invoices.length %> HĐ</span>
          <% if (tongStr) { %><span class="tong-tien"><%= tongStr %></span><% } %>
          <span class="chev">▶</span>
        </div>
      </div>
      <div class="ncc-body">
        <table class="inv-tbl">
          <thead>
            <tr>
              <th>Số HĐ</th>
              <th>Ngày</th>
              <th>Nội dung</th>
              <th>Số tiền</th>
              <th>File PDF</th>
            </tr>
          </thead>
          <tbody>
            <% g.invoices.forEach(function(inv) {
              var tienHien = '';
              if (typeof inv.tongTien === 'number' && inv.tongTien > 0) tienHien = inv.tongTien.toLocaleString('vi-VN') + ' ₫';
              else if (typeof inv.tongTien === 'string' && inv.tongTien.trim()) tienHien = inv.tongTien;
              var ngayHien = '';
              if (inv.ngay) { var p = inv.ngay.split('-'); if(p.length===3) ngayHien = p[2]+'/'+p[1]+'/'+p[0]; }
              var nd = inv.noiDung || '';
            %>
            <tr data-row="<%= (inv.nccShort + ' ' + (inv.soHoaDon||'') + ' ' + (g.tenDayDuNCC||'')).toLowerCase() %>">
              <td><span class="tag-so"><%= inv.soHoaDon || '—' %></span></td>
              <td class="date-v"><%- ngayHien || '<span class="dash">—</span>' %></td>
              <td class="nd-v" title="<%= nd %>"><%- nd || '<span class="dash">—</span>' %></td>
              <td class="tien-v"><%- tienHien || '<span class="dash">—</span>' %></td>
              <td><a class="link-pdf" href="https://drive.google.com/file/d/<%= inv.driveId %>/view" target="_blank" rel="noopener">📄 Xem</a></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
    <% }) %>
  </div>
</div>

<script>
function toggle(card) { card.classList.toggle('open'); }

function goThang(v) {
  var url = new URL(location.href);
  v ? url.searchParams.set('thang', v) : url.searchParams.delete('thang');
  location.href = url.toString();
}

function doFilter() {
  var q = document.getElementById('qBox').value.toLowerCase().trim();
  document.querySelectorAll('.ncc-card').forEach(function(card) {
    var key = (card.dataset.key || '') + ' ' + (card.dataset.full || '');
    var rows = card.querySelectorAll('tbody tr');
    var anyRow = false;
    rows.forEach(function(r) {
      var match = !q || (r.dataset.row || '').includes(q) || key.includes(q);
      r.style.display = match ? '' : 'none';
      if (match) anyRow = true;
    });
    var show = !q || key.includes(q) || anyRow;
    card.style.display = show ? '' : 'none';
    if (q && show) card.classList.add('open');
    else if (!q) card.classList.remove('open');
  });
}
</script>
</body>
</html>

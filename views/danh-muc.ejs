<!DOCTYPE html>
<html lang="vi">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/nav') %>
  <main class="container">
    <h1><%= page.title %></h1>
    <p class="muted" style="margin-top:-10px;margin-bottom:12px;">
      Danh mục <%= page.title.toLowerCase() %> — dùng làm mã tham chiếu trong hóa đơn, chi phí, đối soát.
    </p>

    <!-- Tab chon cong ty -->
    <div style="display:flex;gap:0;margin-bottom:18px;border-bottom:2px solid #e0e0e0;">
      <a href="/danh-muc/<%= slug %>?company=kh_cu"
         style="padding:7px 20px;font-size:13px;font-weight:600;text-decoration:none;border-radius:6px 6px 0 0;
                <%= company === 'kh_cu' ? 'background:#1565c0;color:#fff;border-bottom:2px solid #1565c0;' : 'color:#555;' %>">
        KH Cũ
      </a>
      <a href="/danh-muc/<%= slug %>?company=kh_moi"
         style="padding:7px 20px;font-size:13px;font-weight:600;text-decoration:none;border-radius:6px 6px 0 0;
                <%= company === 'kh_moi' ? 'background:#1565c0;color:#fff;border-bottom:2px solid #1565c0;' : 'color:#555;' %>">
        KH Mới
      </a>
    </div>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>

    <!-- Upload Excel sync -->
    <section class="panel" style="margin-bottom:16px;">
      <div class="panel-head"><h2>&#128229; Đồng bộ từ Excel</h2></div>
      <form method="POST" action="/danh-muc/<%= slug %>/upload-excel" enctype="multipart/form-data"
            style="display:flex;flex-wrap:wrap;gap:10px;align-items:flex-end;padding-top:4px;">
        <input type="hidden" name="company" value="<%= company %>" />
        <div>
          <label style="display:block;font-size:12px;color:var(--muted);margin-bottom:3px;">Chọn file Excel (.xlsx) — <strong><%= company === 'kh_moi' ? 'KH Mới' : 'KH Cũ' %></strong></label>
          <input type="file" name="file" accept=".xlsx,.xls" required style="min-width:260px;" />
        </div>
        <button type="submit" class="btn btn-secondary">Đồng bộ</button>
        <span style="font-size:12px;color:var(--muted);align-self:center;">
          Tự động thêm mới, cập nhật tên, và xóa mã đã xóa khỏi file (chỉ xóa dòng nhập từ Excel).
        </span>
      </form>
      <% if (uploadMeta) { %>
      <div style="margin-top:10px;padding:8px 12px;background:#f8f9fa;border-radius:6px;display:flex;align-items:center;gap:12px;font-size:12px;color:var(--muted);">
        <span>📁 Lần tải gần nhất: <strong><%= uploadMeta.file_name %></strong> — <%= new Date(uploadMeta.uploaded_at).toLocaleString('vi-VN') %> — <%= uploadMeta.count %> mục</span>
        <form method="POST" action="/danh-muc/<%= slug %>/xoa-het" style="display:inline;"
          onsubmit="return confirm('Xóa toàn bộ danh sách <%= company === 'kh_moi' ? 'KH Mới' : 'KH Cũ' %> từ Excel?')">
          <input type="hidden" name="company" value="<%= company %>" />
          <button type="submit" class="btn btn-danger btn-sm" style="font-size:11px;padding:3px 10px;">Xóa danh sách</button>
        </form>
      </div>
      <% } %>
    </section>

    <% if (slug === 'ma-cong-trinh') { %>
    <!-- Cap nhat (doi) ma cong trinh hang loat -->
    <section class="panel" style="margin-bottom:16px;">
      <div class="panel-head">
        <h2>&#128260; Cập nhật mã công trình</h2>
        <button type="button" class="btn btn-secondary" onclick="toggleDoiMaPanel()">Cập nhật mã công trình</button>
      </div>
      <div id="doiMaPanel" style="display:none;padding-top:10px;">
        <ol style="font-size:13px;line-height:1.8;margin:0 0 12px 18px;color:var(--muted);">
          <li>Tải file mẫu bên dưới — đã có sẵn <strong>Mã công trình (cũ)</strong> + Tên hiện tại của <strong><%= company === 'kh_moi' ? 'KH Mới' : 'KH Cũ' %></strong>.</li>
          <li>Điền cột <strong>"Mã công trình mới"</strong> cho những dòng cần đổi (bỏ trống dòng không đổi).</li>
          <li>Tải file đã điền lên — hệ thống tự đổi mã ở Danh mục này VÀ ở tất cả nơi khác đang lưu mã cũ (Hợp đồng thuê, Doanh thu chia sẻ theo điểm, Map cửa hàng, đối soát Momo/Zalo/VNPay/Payoo/VietQR...), giữ nguyên tên công trình.</li>
        </ol>
        <div style="display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin-bottom:14px;">
          <a class="btn btn-secondary" href="/danh-muc/ma-cong-trinh/mau-doi-ma?company=<%= company %>">&#11015;&#65039; 1. Tải file mẫu (<%= rows.length %> mục)</a>
          <form method="POST" action="/danh-muc/ma-cong-trinh/doi-ma" enctype="multipart/form-data" style="display:flex;gap:10px;align-items:center;"
            onsubmit="return confirm('Xác nhận đổi mã công trình theo file đã tải lên?\n\nThao tác này sẽ cập nhật dữ liệu ở nhiều nơi trong hệ thống (hợp đồng thuê, doanh thu chia sẻ, đối soát...) và không thể tự động hoàn tác.')">
            <input type="hidden" name="company" value="<%= company %>" />
            <input type="file" name="file" accept=".xlsx,.xls" required />
            <button type="submit" class="btn btn-primary">2. Tải lên &amp; Đổi mã</button>
          </form>
        </div>
        <div style="font-size:12px;color:#8a6d00;background:#fff8e1;border-radius:6px;padding:10px 12px;">
          &#9888;&#65039; Có 2 chỗ hệ thống <strong>không tự đổi được</strong>: (1) các bảng đối soát Zalo/VNPay/Payoo/VietQR trên trang <strong>Đầu Ra</strong> đã map/lưu tay trước đó — lưu trong trình duyệt của bạn, không phải trên server; (2) map "Mã CT theo điểm" ở tab MTT trang Đầu Ra. Nếu sau khi đổi mã mà các trang đó vẫn hiện mã cũ, cần vào lại map/lưu tay theo mã mới.
        </div>
      </div>
    </section>
    <% } %>

    <!-- Form them moi -->
    <section class="panel" style="margin-bottom:16px;">
      <div class="panel-head"><h2>+ Thêm mới</h2></div>
      <form method="POST" action="/danh-muc/<%= slug %>/them" style="display:flex;flex-wrap:wrap;gap:10px;align-items:flex-end;padding-top:4px;">
        <input type="hidden" name="company" value="<%= company %>" />
        <div>
          <label style="display:block;font-size:12px;color:var(--muted);margin-bottom:3px;"><%= page.colLabel %> <span style="color:var(--color-chi)">*</span></label>
          <input type="text" name="ma" placeholder="Ví dụ: KVC001" required style="min-width:160px;" />
        </div>
        <div>
          <label style="display:block;font-size:12px;color:var(--muted);margin-bottom:3px;">Tên / Diễn giải</label>
          <input type="text" name="ten" placeholder="Tên đầy đủ" style="min-width:220px;" />
        </div>
        <div>
          <label style="display:block;font-size:12px;color:var(--muted);margin-bottom:3px;">Ghi chú</label>
          <input type="text" name="ghiChu" placeholder="Ghi chú thêm (nếu có)" style="min-width:180px;" />
        </div>
        <button type="submit" class="btn btn-primary">Thêm</button>
      </form>
    </section>

    <!-- Danh sach -->
    <section class="panel">
      <div class="panel-head">
        <h2>Danh sách (<%= rows.length %> mục)</h2>
        <form method="GET" action="/danh-muc/<%= slug %>" style="display:flex;gap:8px;align-items:center;">
          <input type="hidden" name="company" value="<%= company %>" />
          <input type="text" name="q" value="<%= searchQ %>" placeholder="Tìm kiếm..." style="width:200px;" />
          <button type="submit" class="btn btn-secondary" style="padding:6px 12px;">Tìm</button>
          <% if (searchQ) { %><a href="/danh-muc/<%= slug %>?company=<%= company %>" class="link-btn">✕ Bỏ lọc</a><% } %>
        </form>
      </div>
      <% if (rows.length === 0) { %>
        <p class="muted" style="padding:12px 0;">Chưa có mục nào<% if (searchQ) { %> khớp tìm kiếm<% } %>.</p>
      <% } else { %>
      <div class="table-scroll">
        <table class="table">
          <thead>
            <tr>
              <th style="width:180px;"><%= page.colLabel %></th>
              <th>Tên / Diễn giải</th>
              <th>Ghi chú</th>
              <th style="width:120px;">Ngày tạo</th>
              <th style="width:140px;text-align:center;">Thao tác</th>
            </tr>
          </thead>
          <tbody>
            <% rows.forEach(function(r) { %>
            <tr>
              <td><strong><%= r.ma %></strong></td>
              <td><%= r.ten || '—' %></td>
              <td><%= r.ghiChu || '—' %></td>
              <td style="color:var(--muted);font-size:12px;">
                <%= r.createdAt ? new Date(r.createdAt).toLocaleDateString('vi-VN') : '—' %>
              </td>
              <td style="text-align:center;">
                <button type="button" class="link-btn"
                  onclick="openEditModal(<%= r.id %>, <%- JSON.stringify(r.ma||'') %>, <%- JSON.stringify(r.ten||'') %>, <%- JSON.stringify(r.ghiChu||'') %>)"
                  style="margin-right:8px;font-weight:600;">✏️ Sửa</button>
                <form method="POST" action="/danh-muc/<%= slug %>/xoa/<%= r.id %>" style="display:inline;"
                  onsubmit="return confirm('Xóa mã &quot;<%= r.ma %>&quot;?')">
                  <input type="hidden" name="company" value="<%= company %>" />
                  <button type="submit" class="link-btn" style="color:var(--color-chi);">Xóa</button>
                </form>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% } %>
    </section>
  </main>

  <!-- Modal sửa mục -->
  <div id="editModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:9999;align-items:center;justify-content:center;">
    <div style="background:#fff;border-radius:10px;padding:28px 32px;min-width:360px;max-width:520px;width:90%;box-shadow:0 8px 32px rgba(0,0,0,.25);position:relative;">
      <h3 style="margin:0 0 20px;font-size:1.1rem;">✏️ Sửa mục</h3>
      <form id="editModalForm" method="POST" action="">
        <input type="hidden" name="company" value="<%= company %>" />
        <div style="margin-bottom:14px;">
          <label style="display:block;font-size:12px;color:#666;margin-bottom:4px;"><%= page.colLabel %> <span style="color:red">*</span></label>
          <input type="text" name="ma" id="modalMa" required
            style="width:100%;box-sizing:border-box;padding:8px 10px;border:1px solid #ccc;border-radius:6px;font-size:14px;" />
        </div>
        <div style="margin-bottom:14px;">
          <label style="display:block;font-size:12px;color:#666;margin-bottom:4px;">Tên / Diễn giải</label>
          <input type="text" name="ten" id="modalTen"
            style="width:100%;box-sizing:border-box;padding:8px 10px;border:1px solid #ccc;border-radius:6px;font-size:14px;" />
        </div>
        <div style="margin-bottom:20px;">
          <label style="display:block;font-size:12px;color:#666;margin-bottom:4px;">Ghi chú</label>
          <input type="text" name="ghiChu" id="modalGhiChu"
            style="width:100%;box-sizing:border-box;padding:8px 10px;border:1px solid #ccc;border-radius:6px;font-size:14px;" />
        </div>
        <div style="display:flex;gap:10px;justify-content:flex-end;">
          <button type="button" onclick="closeEditModal()"
            style="padding:8px 20px;border:1px solid #ccc;border-radius:6px;background:#f5f5f5;cursor:pointer;font-size:14px;">Hủy</button>
          <button type="submit"
            style="padding:8px 20px;border:none;border-radius:6px;background:#1565c0;color:#fff;cursor:pointer;font-size:14px;font-weight:600;">💾 Lưu</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    function toggleDoiMaPanel() {
      var el = document.getElementById('doiMaPanel');
      if (el) el.style.display = (el.style.display === 'none' || !el.style.display) ? 'block' : 'none';
    }
    function openEditModal(id, ma, ten, ghiChu) {
      document.getElementById('editModalForm').action = '/danh-muc/<%= slug %>/sua/' + id;
      document.getElementById('modalMa').value = ma;
      document.getElementById('modalTen').value = ten;
      document.getElementById('modalGhiChu').value = ghiChu || '';
      var m = document.getElementById('editModal');
      m.style.display = 'flex';
      setTimeout(function(){ document.getElementById('modalMa').focus(); document.getElementById('modalMa').select(); }, 50);
    }
    function closeEditModal() {
      document.getElementById('editModal').style.display = 'none';
    }
    document.getElementById('editModal').addEventListener('click', function(e) {
      if (e.target === this) closeEditModal();
    });
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') closeEditModal();
    });
  </script>
  <%- include('partials/scroll-restore') %>
</body>
</html>

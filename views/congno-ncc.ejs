<!DOCTYPE html>
<html lang="vi">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/nav') %>
  <main class="container">
    <h1>Công Nợ NCC — <%= COMPANIES[activeCompany].label %></h1>
    <p class="muted" style="margin-top:-10px;margin-bottom:20px;">
      Công nợ phải trả cho nhà cung cấp (NCC) — đối chiếu từng hóa đơn ở trang "Hóa Đơn Đầu Vào" với giao dịch
      chi trên đúng 2 Tài khoản Chi của <%= COMPANIES[activeCompany].label %>
      (<%= activeCompany === 'kh_cu' ? 'VPBANK9997, BIDV8651' : 'VP58888, BIDV8681' %>), khớp theo Tên đối ứng
      trên sao kê + đúng số tiền hóa đơn. Hóa đơn nào không tìm được giao dịch chi khớp thì tính là còn nợ.
      Đổi nút "<%= activeCompany === 'kh_cu' ? 'Mới' : 'Cũ' %>" ở góc trên bên trái để xem công ty kia.
    </p>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

    <section class="cards">
      <div class="card">
        <div class="card-label">Tổng hóa đơn (<%= tongSoHoaDon %>)</div>
        <div class="card-value"><%= grandTotalHoaDon.toLocaleString('vi-VN') %> đ</div>
      </div>
      <div class="card">
        <div class="card-label">Đã chi (khớp sao kê)</div>
        <div class="card-value"><%= grandTotalDaChi.toLocaleString('vi-VN') %> đ</div>
      </div>
      <div class="card">
        <div class="card-label">Còn nợ NCC</div>
        <div class="card-value"><%= grandTotalConNo.toLocaleString('vi-VN') %> đ</div>
      </div>
      <div class="card">
        <div class="card-label">Số hóa đơn chưa chi</div>
        <div class="card-value"><%= soHoaDonChuaChi %></div>
      </div>
      <div class="card">
        <div class="card-label">Chi rồi nhưng thiếu hóa đơn (<%= soLanMissingInvoice %> giao dịch)</div>
        <div class="card-value text-neg"><%= grandTotalMissingInvoice.toLocaleString('vi-VN') %> đ</div>
      </div>
    </section>

    <% if (missingInvoiceSummary.length > 0) { %>
    <section class="panel">
      <h2>⚠ Giao dịch chi CHƯA có hóa đơn (<%= missingInvoiceSummary.length %> nhà cung cấp cần bổ sung)</h2>
      <p class="muted">
        Tiền đã chi thật ra khỏi 2 tài khoản Chi của <%= COMPANIES[activeCompany].label %> (khớp Tên đối ứng), nhưng
        KHÔNG tìm thấy hóa đơn nào ở trang "Hóa Đơn Đầu Vào" khớp với khoản này -- có thể do quét Gmail lấy hóa đơn
        hiện chưa dùng được (thiếu cấu hình Google OAuth trên Railway) nên chưa tự gắn được link hóa đơn. Đây KHÔNG
        phải là còn nợ (tiền đã chi rồi), chỉ là còn thiếu hóa đơn giấy/PDF -- cần đi lấy bổ sung rồi nhập vào
        "Hóa Đơn Đầu Vào". Tên NCC dưới đây lấy tạm theo "Tên đối ứng" trên sao kê, có thể chưa đúng chính xác tên
        chính thức.
      </p>
      <div class="table-scroll">
        <table class="table">
          <thead>
            <tr>
              <th></th>
              <th>Tên đối ứng (NCC tạm)</th>
              <th>Số lần chi</th>
              <th>Tổng tiền</th>
            </tr>
          </thead>
          <tbody>
            <% missingInvoiceSummary.forEach(function (r, idx) { %>
            <tr class="ncc-summary-row" style="cursor:pointer" onclick="toggleNccDetail('missing-detail-<%= idx %>')">
              <td><span class="ncc-toggle-caret" id="missing-caret-<%= idx %>">▶</span></td>
              <td><%= r.tenNCC %></td>
              <td><%= r.soLan %></td>
              <td class="text-neg"><%= r.tongSoTien.toLocaleString('vi-VN') %> đ</td>
            </tr>
            <tr class="ncc-detail-row" id="missing-detail-<%= idx %>" style="display:none;">
              <td colspan="4" style="padding:0 0 14px 0; background:rgba(0,0,0,0.02);">
                <table class="table" style="margin:0;">
                  <thead>
                    <tr>
                      <th>Ngày chi</th>
                      <th>Số tiền</th>
                      <th>TK chi</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% r.items.forEach(function (m) { %>
                    <tr>
                      <td><%= m.date %></td>
                      <td><%= m.amount.toLocaleString('vi-VN') %> đ</td>
                      <td><%= m.bankName %></td>
                    </tr>
                    <% }) %>
                  </tbody>
                </table>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </section>
    <% } %>

    <!-- Filter bar -->
    <form method="GET" action="/cong-no/ncc" style="display:flex;flex-wrap:wrap;align-items:center;gap:10px;margin-bottom:14px;">
      <label style="display:flex;align-items:center;gap:6px;font-size:13px;">
        Tháng HĐ
        <select name="thang" onchange="this.form.submit()" style="font-size:13px;">
          <option value="">Tất cả</option>
          <% availableMonths.forEach(function(m) { %>
          <option value="<%= m %>" <%= thangFilter === m ? 'selected' : '' %>>
            Tháng <%= Number(m.slice(5,7)) %>/<%= m.slice(0,4) %>
          </option>
          <% }) %>
        </select>
      </label>
      <label style="display:flex;align-items:center;gap:6px;font-size:13px;">
        Tình trạng
        <select name="daChi" onchange="this.form.submit()" style="font-size:13px;">
          <option value="">Tất cả</option>
          <option value="0" <%= daChiFilter==='0'?'selected':'' %>>Chưa chi</option>
          <option value="1" <%= daChiFilter==='1'?'selected':'' %>>Đã chi</option>
        </select>
      </label>
      <input type="text" name="ncc" value="<%= nccFilter %>" placeholder="Tìm tên NCC..." style="font-size:13px;width:220px;" />
      <button type="submit" class="btn btn-secondary" style="padding:5px 12px;">Lọc</button>
      <% if (thangFilter || daChiFilter || nccFilter) { %>
        <a href="/cong-no/ncc" class="link-btn">✕ Bỏ lọc</a>
      <% } %>
    </form>

    <section class="panel">
      <div class="panel-head">
        <h2>Tổng hợp theo NCC (<%= nccSummary.length %> nhà cung cấp<% if (thangFilter) { %> — T<%= Number(thangFilter.slice(5,7)) %>/<%= thangFilter.slice(0,4) %><% } %>)</h2>
      </div>
      <p class="muted">Bấm vào 1 dòng NCC để xem/ẩn ngay tại chỗ chi tiết từng hóa đơn của NCC đó (đã chi hay chưa, chi ngày nào, tài khoản nào) — không tải lại trang.</p>
      <div class="table-scroll">
        <table class="table">
          <thead>
            <tr>
              <th></th>
              <th>Mã NCC</th>
              <th>Tên NCC</th>
              <th>Số hóa đơn</th>
              <th>Tổng hóa đơn</th>
              <th>Đã chi</th>
              <th>Còn nợ</th>
            </tr>
          </thead>
          <tbody>
            <% nccSummary.forEach(function (r, idx) { %>
            <tr class="ncc-summary-row" style="cursor:pointer" onclick="toggleNccDetail('ncc-detail-<%= idx %>')">
              <td><span class="ncc-toggle-caret" id="ncc-caret-<%= idx %>">▶</span></td>
              <td style="white-space:nowrap;font-size:12px;color:var(--muted);">
                <% if (r.maNCC) { %><span style="background:#e8f5e9;color:#2e7d32;padding:2px 6px;border-radius:4px;font-weight:600;"><%= r.maNCC %></span><% } else { %>—<% } %>
              </td>
              <td><%= r.tenNCC %></td>
              <td><%= r.soHoaDon %> <span class="muted">(<%= r.soChuaChi %> chưa chi)</span></td>
              <td><%= r.tongHoaDon.toLocaleString('vi-VN') %> đ</td>
              <td><%= r.daChi.toLocaleString('vi-VN') %> đ</td>
              <td class="<%= Math.abs(r.conNo) < 1000 ? 'text-pos' : 'text-neg' %>"><%= r.conNo.toLocaleString('vi-VN') %> đ</td>
            </tr>
            <tr class="ncc-detail-row" id="ncc-detail-<%= idx %>" style="display:none;">
              <td colspan="7" style="padding:0 0 14px 0; background:rgba(0,0,0,0.02);">
                <table class="table" style="margin:0;">
                  <thead>
                    <tr>
                      <th>Ngày HĐ</th>
                      <th>Số HĐ</th>
                      <th>Số tiền</th>
                      <th>Trạng thái</th>
                      <th>Ngày chi</th>
                      <th>TK chi</th>
                      <th>Còn nợ</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% r.invoices.forEach(function (inv) { %>
                    <tr>
                      <td><%= inv.ngayHD %></td>
                      <td><%= inv.soHoaDon %><% if (inv.kyHieuHD) { %> <span class="muted">(<%= inv.kyHieuHD %>)</span><% } %></td>
                      <td><%= inv.soTien.toLocaleString('vi-VN') %> đ</td>
                      <td>
                        <% if (inv.daChi) { %>
                        <span class="badge badge-thu">✓ Đã chi</span>
                        <% } else { %>
                        <span class="badge badge-warn">Chưa chi</span>
                        <% } %>
                      </td>
                      <td><%= inv.ngayChi %></td>
                      <td><%= inv.nganHangChi %></td>
                      <td class="<%= inv.conNo < 1000 ? 'text-pos' : 'text-neg' %>"><%= inv.conNo.toLocaleString('vi-VN') %> đ</td>
                    </tr>
                    <% }) %>
                  </tbody>
                </table>
              </td>
            </tr>
            <% }) %>
            <% if (nccSummary.length === 0) { %>
            <tr><td colspan="7" class="muted">Chưa có dữ liệu — cần có hóa đơn ở trang "Hóa Đơn Đầu Vào" trước.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </section>

    <script>
      // Chi Nhan, 2026-07-30: bam 1 dong NCC o bang tong hop -- hien/an ngay
      // bang chi tiet hoa don cua dung NCC do NGAY DUOI dong vua bam, hoan
      // toan bang JS phia trinh duyet (khong goi lai server, khong doi URL,
      // khong lam mat vi tri dang cuon) thay vi dieu huong sang trang loc
      // rieng nhu truoc (gay cam giac "nhay len dau trang" moi lan bam).
      function toggleNccDetail(id) {
        var row = document.getElementById(id);
        // Luyen, 2026-08-01: bang "Giao dịch chi CHƯA có hóa đơn" moi them
        // dung tien to "missing-detail-"/"missing-caret-" (khac "ncc-detail-"
        // /"ncc-caret-" cua bang NCC goc) de khong trung id -- ho tro ca 2
        // tien to trong 1 ham dung chung, tranh phai copy nguyen ham cho bang moi.
        var caretId = id.replace('ncc-detail-', 'ncc-caret-').replace('missing-detail-', 'missing-caret-');
        var caret = document.getElementById(caretId);
        if (!row) return;
        var isHidden = row.style.display === 'none' || !row.style.display;
        row.style.display = isHidden ? 'table-row' : 'none';
        if (caret) caret.textContent = isHidden ? '▼' : '▶';
        if (isHidden) setTimeout(function(){ row.scrollIntoView({ behavior: 'smooth', block: 'nearest' }); }, 50);
      }
    </script>

    <section class="panel" id="chi-tiet-hoa-don">
      <div class="panel-head">
        <h2>Chi tiết theo từng hóa đơn (<%= totalMatching %>)</h2>
      </div>

      <form method="GET" action="/cong-no/ncc" class="form-inline-tight" style="margin-bottom:10px;">
        <label>Trạng thái
          <select name="daChi" onchange="this.form.submit()">
            <option value="">-- Tất cả --</option>
            <option value="0" <%= daChiFilter === '0' ? 'selected' : '' %>>Chưa chi</option>
            <option value="1" <%= daChiFilter === '1' ? 'selected' : '' %>>Đã chi</option>
          </select>
        </label>
        <label>Tên NCC
          <input type="text" name="ncc" value="<%= nccFilter %>" placeholder="Tìm theo tên NCC..." />
        </label>
        <button type="submit" class="btn btn-secondary">Lọc</button>
        <% if (daChiFilter || nccFilter) { %>
        <a class="btn btn-secondary" href="/cong-no/ncc">Xóa lọc</a>
        <% } %>
      </form>

      <div class="table-scroll">
        <table class="table">
          <thead>
            <tr>
              <th>Ngày HĐ</th>
              <th>Số HĐ</th>
              <th>Tên NCC</th>
              <th>Số tiền</th>
              <th>Trạng thái</th>
              <th>Ngày chi</th>
              <th>TK chi</th>
              <th>Còn nợ</th>
            </tr>
          </thead>
          <tbody>
            <% rows.forEach(function (r) { %>
            <tr>
              <td><%= r.ngayHD %></td>
              <td><%= r.soHoaDon %><% if (r.kyHieuHD) { %> <span class="muted">(<%= r.kyHieuHD %>)</span><% } %></td>
              <td><%= r.tenNCC %></td>
              <td><%= r.soTien.toLocaleString('vi-VN') %> đ</td>
              <td>
                <% if (r.daChi) { %>
                <span class="badge badge-thu">✓ Đã chi</span>
                <% } else { %>
                <span class="badge badge-warn">Chưa chi</span>
                <% } %>
              </td>
              <td><%= r.ngayChi %></td>
              <td><%= r.nganHangChi %></td>
              <td class="<%= r.conNo < 1000 ? 'text-pos' : 'text-neg' %>"><%= r.conNo.toLocaleString('vi-VN') %> đ</td>
            </tr>
            <% }) %>
            <% if (rows.length === 0) { %>
            <tr><td colspan="8" class="muted">Không có hóa đơn nào khớp bộ lọc.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <% if (totalPages > 1) { %>
      <div class="pagination" style="margin-top:14px; display:flex; gap:6px; align-items:center; flex-wrap:wrap;">
        <a class="btn btn-secondary" href="/cong-no/ncc?<%= baseQs ? baseQs + '&' : '' %>page=<%= currentPage - 1 %>" <%= currentPage <= 1 ? 'style="pointer-events:none;opacity:.5;"' : '' %>>‹ Trang trước</a>
        <% for (let p = 1; p <= totalPages; p++) { %>
        <a class="hddv-page-link <%= p === currentPage ? 'active' : '' %>" href="/cong-no/ncc?<%= baseQs ? baseQs + '&' : '' %>page=<%= p %>"><%= p %></a>
        <% } %>
        <a class="btn btn-secondary" href="/cong-no/ncc?<%= baseQs ? baseQs + '&' : '' %>page=<%= currentPage + 1 %>" <%= currentPage >= totalPages ? 'style="pointer-events:none;opacity:.5;"' : '' %>>Trang sau ›</a>
      </div>
      <% } %>
    </section>
  </main>
</body>
</html>

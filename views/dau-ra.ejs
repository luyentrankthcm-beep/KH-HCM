      const inp = document.createElement('input');
      inp.value = cur;
      inp.style.cssText = 'width:' + (field==='soHD'?'90px':'110px') + ';border:1px solid #ea580c;border-radius:4px;padding:.15rem .3rem;font-size:.8em;' + (field==='tienHD'?'text-align:right':'text-align:center');
      inp.onblur = () => { saveVnpayHD(hdKey, field, inp.value); renderVnpayDoiSoat(); };
      inp.onkeydown = e => { if(e.key==='Enter'||e.key==='Escape') inp.blur(); };
      spanEl.replaceWith(inp);
      inp.focus(); inp.select();

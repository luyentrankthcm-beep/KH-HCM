    function parseMttSheet(data, isCu) {
      // Tìm dòng header (có 'Số HĐ')
      let headerIdx = -1;
      for (let i = 0; i < data.length; i++) {
        if (data[i].some(c => String(c||'').trim() === 'Số HĐ')) { headerIdx = i; break; }
      }
      if (headerIdx < 0) return [];
      const header = data[headerIdx];
      const fc = name => header.findIndex(c => String(c||'').trim() === name);
      const colNgay  = fc('Ngày HĐ');
      const colSoHD  = fc('Số HĐ');
      const colTong  = fc('Tổng TT HĐ htoan Misa');
      const colDV    = isCu ? fc('Nội dung xuất hóa đơn') : fc('Nội dung hóa đơn');
      const colMaDiem = isCu ? fc('Mã điểm trên misa thuế') : fc('Mã điểm ghi chú HT Misa');
      const colMaNCC  = isCu ? fc('Mã KH HT Misa') : fc('Mã NCC HT Misa');
      const colGhiChu    = fc('ghi chú');
      const colSoHopDong = fc('Số hợp đồng');
      const colThuHo  = isCu ? header.findIndex(c => String(c||'').includes('Dịch vụ thu hộ'))
                              : fc('Dịch vụ thu hộ');
      const rows = [];
      for (let i = headerIdx + 1; i < data.length; i++) {
        const r = data[i];
        const soHD = r[colSoHD];
        const tong = r[colTong];
        if (!soHD && !tong) continue;
        // Format ngày
        let ngay = '';
        const rawD = r[colNgay];
        if (typeof rawD === 'number') {
          // Excel serial → JS Date via XLSX
          const d = XLSX.SSF.parse_date_code(rawD);
          ngay = `${String(d.d).padStart(2,'0')}/${String(d.m).padStart(2,'0')}/${d.y}`;
        } else if (rawD instanceof Date) {
          ngay = `${String(rawD.getDate()).padStart(2,'0')}/${String(rawD.getMonth()+1).padStart(2,'0')}/${rawD.getFullYear()}`;
        } else if (rawD) { ngay = String(rawD); }
        rows.push({
          ngay,
          soHD: soHD || '',
          tongTien: typeof tong === 'number' ? tong : (parseFloat(String(tong).replace(/[^0-9.-]/g,''))||0),
          dichVu:   String(r[colDV]    ||''),
          maDiem:   String(r[colMaDiem]||''),
          maNCC:    String(r[colMaNCC] ||''),
          ghiChu:      String(r[colGhiChu]   ||''),
          soHopDong:   String(r[colSoHopDong]||'').toLowerCase().trim(),
          dichVuThuHo: String(r[colThuHo]    ||''),
        });
      }
      rows.sort((a,b) => (Number(a.soHD)||0) - (Number(b.soHD)||0));
      return rows;
    }

    function handleMttFile(file) {
      if (!file) return;
      const st = document.getElementById('mttUploadStatus');
      st.className = 'upload-status loading';
      st.textContent = '⏳ Đang đọc file...';
      const reader = new FileReader();
      reader.onload = function(e) {
        try {
          const wb = XLSX.read(e.target.result, { type: 'array', cellDates: false });
          // Tìm sheet KH Cũ (989)
          const shCuName  = wb.SheetNames.find(n => n.includes('989') && n.toLowerCase().includes('kê'));
          // Tìm sheet KH Mới (705 hoặc "kê ds xuất HĐ MTT" không có 989)
          const shMoiName = wb.SheetNames.find(n => !n.includes('989') && n.toLowerCase().includes('kê'));
          const cuData  = shCuName  ? XLSX.utils.sheet_to_json(wb.Sheets[shCuName],  { header:1, defval:'' }) : [];
          const moiData = shMoiName ? XLSX.utils.sheet_to_json(wb.Sheets[shMoiName], { header:1, defval:'' }) : [];
          // Merge (không ghi đè) — bỏ qua dòng đã có cùng Số HĐ
          const newCu  = parseMttSheet(cuData,  true);
          const newMoi = parseMttSheet(moiData, false);
          const exCuHD  = new Set(_mttCu.map(r => r.soHD));
          const exMoiHD = new Set(_mttMoi.map(r => r.soHD));
          const addCu   = newCu.filter(r => !exCuHD.has(r.soHD));
          const addMoi  = newMoi.filter(r => !exMoiHD.has(r.soHD));
          _mttCu  = [..._mttCu,  ...addCu];
          _mttMoi = [..._mttMoi, ...addMoi];
          // Sắp xếp lại theo soHD
          _mttCu.sort((a,b) => String(a.soHD).localeCompare(String(b.soHD), undefined, { numeric: true }));
          _mttMoi.sort((a,b) => String(a.soHD).localeCompare(String(b.soHD), undefined, { numeric: true }));
          try { localStorage.setItem(LS_MTT_CU,  JSON.stringify(_mttCu));  } catch(e) {}
          try { localStorage.setItem(LS_MTT_MOI, JSON.stringify(_mttMoi)); } catch(e) {}
          // Ghi lịch sử
          const hist = { fileName: file.name, uploadedAt: new Date().toLocaleString('vi'),
            cuAdded: addCu.length, moiAdded: addMoi.length,
            cuSkip: newCu.length - addCu.length, moiSkip: newMoi.length - addMoi.length };
          _mttHist.unshift(hist);
          if (_mttHist.length > 30) _mttHist.length = 30;
          try { localStorage.setItem(LS_MTT_HIST, JSON.stringify(_mttHist)); } catch(e) {}
          const skipMsg = (hist.cuSkip + hist.moiSkip) > 0 ? ` (bỏ qua ${hist.cuSkip + hist.moiSkip} trùng)` : '';
          st.className = 'upload-status ok';
          st.textContent = `✅ Thêm ${addCu.length} KH Cũ · ${addMoi.length} KH Mới${skipMsg} · Tổng: ${_mttCu.length}+${_mttMoi.length}`;
          closeMttModal();
          renderMttTable();
        } catch(err) {
          st.className = 'upload-status err';
          st.textContent = '❌ Lỗi: ' + err.message;
        }
      };
      reader.readAsArrayBuffer(file);
    }

    function populateMttMonthFilter(rows) {
      const sel = document.getElementById('mttMonthFilter');
      if (!sel) return;
      const cur = sel.value;
      const months = [...new Set(rows.map(r => {
        const p = r.ngay.split('/');
        return p.length === 3 ? `${p[1]}/${p[2]}` : '';
      }).filter(Boolean))].sort((a,b) => {
        const [ma,ya] = a.split('/'); const [mb,yb] = b.split('/');
        return (ya+ma).localeCompare(yb+mb);
      });
      sel.innerHTML = `<option value="">Tất cả</option>` + months.map(m => `<option value="${m}">${m}</option>`).join('');
      if (months.includes(cur)) sel.value = cur;
    }

    function renderMttTable() {
      const allRows = _mttActive === 'cu' ? _mttCu : _mttMoi;
      const label   = _mttActive === 'cu' ? 'KH Cũ (989)' : 'KH Mới (705)';
      const hasCu   = _mttCu.length > 0;
      const hasMoi  = _mttMoi.length > 0;
      if (!hasCu && !hasMoi) {
        document.getElementById('mttEmpty').style.display = 'block';
        document.getElementById('mttResults').style.display = 'none';
        document.getElementById('mttSubTabs').style.display = 'none';
        document.getElementById('mttSummary').style.display = 'none';
        return;
      }
      document.getElementById('mttEmpty').style.display = 'none';
      document.getElementById('mttResults').style.display = 'block';
      document.getElementById('mttSubTabs').style.display = 'flex';

      // Month filter
      populateMttMonthFilter(allRows);
      const selMonth = (document.getElementById('mttMonthFilter')||{}).value || '';
      const rows = selMonth ? allRows.filter(r => {
        const p = r.ngay.split('/'); return p.length === 3 && `${p[1]}/${p[2]}` === selMonth;
      }) : allRows;

      const fmt = n => Math.round(n).toLocaleString('vi');
      const tongAll  = rows.reduce((s,r) => s + r.tongTien, 0);
      const tongCuAll = _mttCu.filter(r => !selMonth || (() => { const p=r.ngay.split('/'); return p.length===3&&`${p[1]}/${p[2]}`===selMonth; })()).reduce((s,r)=>s+r.tongTien,0);
      const tongMoiAll = _mttMoi.filter(r => !selMonth || (() => { const p=r.ngay.split('/'); return p.length===3&&`${p[1]}/${p[2]}`===selMonth; })()).reduce((s,r)=>s+r.tongTien,0);

      // Summary
      const sumEl = document.getElementById('mttSummary');
      sumEl.style.display = 'flex';
      const cuCount  = selMonth ? _mttCu.filter(r=>{const p=r.ngay.split('/');return p.length===3&&`${p[1]}/${p[2]}`===selMonth;}).length : _mttCu.length;
      const moiCount = selMonth ? _mttMoi.filter(r=>{const p=r.ngay.split('/');return p.length===3&&`${p[1]}/${p[2]}`===selMonth;}).length : _mttMoi.length;
      const mkCard = (label, count, tong, color) =>
        `<div style="background:#fff;border:1px solid #e2e8f0;border-radius:8px;padding:.4rem .85rem;display:flex;flex-direction:column;min-width:160px">
          <span style="font-size:.75em;color:#64748b;font-weight:600">${label}</span>
          <span style="font-size:.85em;font-weight:700;color:#1e293b">${count} HĐ</span>
          <span style="font-size:1em;font-weight:800;color:${color}">${fmt(tong)}đ</span>
        </div>`;
      sumEl.innerHTML =

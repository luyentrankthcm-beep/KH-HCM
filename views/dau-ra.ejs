    function saveVnpayEditPanel(dateId, date, btnEl) {
      const gianList = btnEl && btnEl.dataset && btnEl.dataset.gians ? JSON.parse(btnEl.dataset.gians) : [];
      gianList.forEach(maCT => {
        const gKey = maCT.replace(/[^a-zA-Z0-9]/g,'_');
        const hdKey = `${date}|${maCT}`;
        if (!_vnpayHD[hdKey]) _vnpayHD[hdKey] = {};
        const dtOvr    = (document.getElementById(`vedit_dt_${dateId}_${gKey}`)    || {}).value;
        const netOvr   = (document.getElementById(`vedit_net_${dateId}_${gKey}`)   || {}).value;
        const soHD     = (document.getElementById(`vedit_soHD_${dateId}_${gKey}`)   || {}).value || '';
        const tienHD   = (document.getElementById(`vedit_tienHD_${dateId}_${gKey}`) || {}).value || '';
        _vnpayHD[hdKey].dtOvr  = dtOvr  != null ? dtOvr  : '';
        _vnpayHD[hdKey].netOvr = netOvr != null ? netOvr : '';
        _vnpayHD[hdKey].soHD   = soHD.trim();
        _vnpayHD[hdKey].tienHD = tienHD.trim();
        if (soHD.trim() || tienHD.trim()) _vnpayHD[hdKey]._manual = true;
      });
      try { lsSet(LS_VNPAY_HD, JSON.stringify(_vnpayHD)); } catch(e){}
      renderVnpayDoiSoat();
    }


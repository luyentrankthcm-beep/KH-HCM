    function exportMttCtMap() {
      const khKey   = _mttActive === 'hist' ? 'cu' : _mttActive;
      const srcRows = khKey === 'cu' ? _mttCu : _mttMoi;
      const label   = khKey === 'cu' ? '989' : '705';
      const khMap   = _mttCtMap[khKey] || {};
      const all = [...new Set(srcRows.map(r => r.maDiem).filter(Boolean))].sort();
      const aoa = [['Mã điểm HT Misa', 'KH', 'Mã công trình']];
      all.forEach(md => aoa.push([md, label, khMap[md] || '']));
      const wb = XLSX.utils.book_new();
      XLSX.utils.book_append_sheet(wb, XLSX.utils.aoa_to_sheet(aoa), `Map CT ${label}`);
      XLSX.writeFile(wb, `MTT_CT_Map_${label}.xlsx`);
    }

    function importMttCtMap(input) {
      const file = input.files[0]; if (!file) return;
      const khKey = _mttActive === 'hist' ? 'cu' : _mttActive;
      const reader = new FileReader();
      reader.onload = function(e) {
        try {
          const wb = XLSX.read(e.target.result, { type: 'array' });
          const data = XLSX.utils.sheet_to_json(wb.Sheets[wb.SheetNames[0]], { header:1, defval:'' });
          let updated = 0;
          if (!_mttCtMap[khKey]) _mttCtMap[khKey] = {};
          data.slice(1).forEach(row => {
            const md = String(row[0]||'').trim();
            const ct = String(row[2]||'').trim();
            if (md && ct) { _mttCtMap[khKey][md] = ct; updated++; }
          });
          try { localStorage.setItem(LS_MTT_CT_MAP, JSON.stringify(_mttCtMap)); } catch(er) {}
          alert(`✅ Đã nhập ${updated} mapping`);
          openMttCtMapModal();
          renderMttTable();
        } catch(err) { alert('Lỗi: ' + err.message); }
        input.value = '';
      };
      reader.readAsArrayBuffer(file);
    }


                  const hdKey = `${date}|${g}`;
                  const hd = _hdData[hdKey] || {};
                  const netVal = hd.netOvr != null && hd.netOvr !== '' ? hd.netOvr : net;
                  const dtVal  = hd.dtOvr  != null && hd.dtOvr  !== '' ? hd.dtOvr  : dg.amount;
                  const subGians = dg.gians && dg.gians.length > 0 ? dg.gians.join(', ') : g;

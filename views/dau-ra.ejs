    // hàng nhá và hình thức thanh toán tuy là 1 cửa hàng nhưng mà 2 hình
    // thức khác nhau thì tách ra cho tôi luôn nhá" -- mỗi (Cửa hàng, Hình
    // thức thanh toán QR/Thẻ) là 1 "gian" riêng, map maCT độc lập. Ngân hàng
    // ACB1268 cũng trả về ĐÚNG 2 giao dịch/ngày (1 QR + 1 Thẻ) với diễn giải
    // y hệt "CTY CPDV TRUC TUYEN CONG DONG VIET-PAYOO TT TD NGAY..." (khác
    // "QRCODE" hay không để phân biệt loại) -- nên khi đối soát NH trả về
    // phải so khớp ĐÚNG theo loại QR/Thẻ, không gộp chung.
    // ══════════════════════════════════════════
    const LS_PAYOO_FEE    = `payoo_fee_${COMPANY}`;
    const LS_PAYOO_SP_MAP = `payoo_sp_map_${COMPANY}`; // { [gian]: maCT }  gian = "Cửa hàng - QR/Thẻ"

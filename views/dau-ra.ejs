    // byDate builders -- y hệt logic bên renderZaloDoiSoat/renderVnpayDoiSoat/
    // renderPayooDoiSoat (không refactor lại các hàm render đang chạy tốt,
    // chỉ xây riêng bản dùng cho xuất Misa để tránh ảnh hưởng màn hình đối soát).
    function buildZaloByDateForExport() {
      const byDate = {};
      _zaloFee.forEach(r => {
        const isFunzone = r.maDiem==='FUNZONE1' || (r.dienThu||'').toUpperCase().includes('FUNZONE');
        if(!isFunzone) return; // rows kênh khác đã tách riêng vào _vnpayFee lúc nhập
        const ordVal = r.maFunzone ? _zaloOrders[String(r.maFunzone)] : undefined;
        const { tenSP: tenSP_lu, sku: skuLu } = unpackZaloOrder(ordVal);
        const maCT = ordVal !== undefined ? (getZaloMaCT(tenSP_lu, skuLu)||tenSP_lu||ordVal) : (_zaloUnk[r.date] || '_unknown_');
        if(!byDate[r.date]) byDate[r.date]={};
        if(!byDate[r.date][maCT]) byDate[r.date][maCT]={gross:0,phi:0,net:0,soDon:0};
        byDate[r.date][maCT].gross += r.gross;
        byDate[r.date][maCT].phi   += r.phi;
        byDate[r.date][maCT].net   += r.net;
        byDate[r.date][maCT].soDon += 1;
      });
      return byDate;
    }
    function buildVnpayByDateForExport() {
      const byDate = {};
      _vnpayFee.forEach(r => {
        const maCT = getVnpayMaCT(r.dienThu);
        if(!byDate[r.date]) byDate[r.date]={};
        if(!byDate[r.date][maCT]) byDate[r.date][maCT]={gross:0,phi:0,net:0,soDon:0};
        byDate[r.date][maCT].gross += r.gross;
        byDate[r.date][maCT].phi   += r.phi;
        byDate[r.date][maCT].net   += r.net;
        byDate[r.date][maCT].soDon += 1;
      });
      return byDate;
    }
    function buildPayooByDateForExport() {
      const byDate = {};
      _payooFee.forEach(r => {
        const maCT = getPayooMaCT(r.gian);
        if(!byDate[r.date]) byDate[r.date]={};
        if(!byDate[r.date][maCT]) byDate[r.date][maCT]={gross:0,phi:0,net:0,soDon:0,loai:r.loai};
        byDate[r.date][maCT].gross += r.gross;
        byDate[r.date][maCT].phi   += r.phi;
        byDate[r.date][maCT].net   += r.net;
        byDate[r.date][maCT].soDon += 1;
      });
      return byDate;
    }

    // Gom theo đợt NH trả về (payDate) -- KHÔNG auto-điều chỉnh chênh lệch
    // (khác Momo), cộng dồn dt/net thật theo từng Mã CT qua các ngày trong
    // đợt; ngày chưa có đợt NH trả thì fallback xuất riêng theo đúng ngày gốc.
    function buildZvpMisaRows({ byDate, getGianDisp, hdObj, bankPayments, dienGiaiSuffix, maDoiTuong, startSeq, fromIso, toIso }) {
      const ddmmToISO = d => { const [dd,mm,yy]=d.split('-'); return `${yy}-${mm}-${dd}`; };
      const toSlash   = d => d.replace(/-/g,'/');
      const inRangeDdmm = (d,f,t) => { const x=ddmmToISO(d); return x>=ddmmToISO(f) && x<=ddmmToISO(t); };
      const inRangeIso  = (d) => { const x=ddmmToISO(d); return x>=fromIso && x<=toIso; };
      const lyDoThu = 'Thu tiền khách hàng (không theo hóa đơn)';

      const allDates = Object.keys(byDate);
      const batches = [];
      const seenBatchKeys = new Set();
      const coveredDates = new Set();
      (bankPayments||[]).forEach(pay => {
        // Chi Nhan, 2026-09-11: 1 vai dong sao ke Payoo co dang dien giai la
        // (vd "TT TD NGAY 14.08 DEN 16.08.2026") server chua doan duoc thi
        // fromDate/toDate se la null -- bo qua an toan (roi vao fallback
        // "chua co dot NH tra" thay vi crash toan bo luc xuat).
        if (!pay.fromDate || !pay.toDate || !pay.payDate) return;
        const payDates = allDates.filter(d => inRangeDdmm(d, pay.fromDate, pay.toDate));
        if (!payDates.length) return;
        // Chi Nhan, 2026-09-11: Luyen phat hien "ngày 10 bị xuất nhầm 2 lần" --
        // goc re: Payoo tra tien THE va QR RIENG 2 dong sao ke khac nhau
        // ("...TT TD NGAY.....DVGIAITRIKH_TONG" va "...QRCODE.DVGIAITRIKH_TONG")
        // nhung CUNG 1 payDate + CUNG 1 khoang fromDate/toDate (vd ca 2 dong
        // deu tra cho ngay 09/09, cung ve tai khoan ngay 10/09) -- moi dong sao
        // ke duoc coi la 1 "dot NH tra" rieng, sinh ra 2 batch trung nhau ->
        // xuat lap toan bo dong cho ngay do. Cac dong nay KHONG cong so tien
        // lai (amount cua bank statement khong duoc dung truc tiep trong ham
        // nay, "Số tiền" lay tu du lieu doi soat theo maCT), nen chi can loai
        // batch trung (cung payDate + cung tap payDates) la du, khong can gop
        // amount.
        const batchKey = pay.payDate + '|' + payDates.slice().sort().join(',');
        if (seenBatchKeys.has(batchKey)) return;
        seenBatchKeys.add(batchKey);
        payDates.forEach(d => coveredDates.add(d));
        batches.push({ payDate: pay.payDate, payDates });
      });

      const rows = [];
      const skipped = [];
      let seq = startSeq;

      const collectByMaCT = (dates) => {
        const byMaCT = {};
        dates.forEach(date => {
          const ctData = byDate[date] || {};
          Object.keys(ctData).forEach(maCT => {
            if (maCT === '_unknown_') { skipped.push('(chưa xác định gian ngày ' + date + ')'); return; }
            const gDisp = getGianDisp(date, maCT, ctData[maCT]);
            const hd = hdObj[date + '|' + maCT] || {};
            // Chi Nhan, 2026-09-11: mot hoa don co the duoc ghi CHUNG tren
            // NHIEU ngay trong cung 1 dot NH tra (vd hoa don 3350 cover ca
            // ngay 5+6, xem ghi chu invoiceGroups ben renderZaloDoiSoat) --
            // dung Map theo soHD (khong push() thang vao mang) de KHONG cong
            // don/lap lai cung 1 so hoa don + so tien nhieu lan khi gom qua
            // nhieu ngay.
            if (!byMaCT[maCT]) byMaCT[maCT] = { dt: 0, net: 0, hdMap: new Map() };
            byMaCT[maCT].dt  += gDisp.dt;
            byMaCT[maCT].net += gDisp.net;
            const soHD = (hd.soHD || '').trim();
            if (soHD) {
              const tienHD = parseFloat(String(hd.tienHD || '').replace(/[^0-9.]/g, '')) || 0;
              byMaCT[maCT].hdMap.set(soHD, tienHD);
            }
          });
        });
        Object.values(byMaCT).forEach(b => {
          b.soHDs = [...b.hdMap.keys()];
          b.tienHD = [...b.hdMap.values()].reduce((s, v) => s + v, 0);
        });
        return byMaCT;
      };

      const pushBatch = (date, byMaCT) => {
        const maCTList = Object.keys(byMaCT).sort();
        if (!maCTList.length) return;
        const soCt = 'NTTK' + String(seq).padStart(7, '0') + '/26';
        maCTList.forEach(maCT => {
          const b = byMaCT[maCT];
          const soHD = b.soHDs.join(', ');
          const dienGiai = soHD
            ? `Thu tiền dịch vụ vui chơi giải trí - ${dienGiaiSuffix} theo HĐ ${soHD}`
            : `Thu tiền dịch vụ vui chơi giải trí - ${dienGiaiSuffix}`;
          rows.push({
            'Ngày hạch toán (*)': toSlash(date),
            'Ngày chứng từ (*)': toSlash(date),
            'Số chứng từ (*)': soCt,
            'Mã đối tượng': maDoiTuong,
            'Tên đối tượng': '',
            'Địa chỉ': '',
            'Nộp vào TK': ZVP_BANK_ACCOUNT,
            'Mở tại ngân hàng': ZVP_BANK_FULLNAME,
            'Lý do thu': lyDoThu,
            'Diễn giải lý do thu': dienGiai,
            'Mã nhân viên thu': '',
            'Diễn giải (hạch toán)': dienGiai,
            'TK Nợ (*)': 1121,
            'TK Có (*)': '131',
            'Số tiền': Math.round(b.net),
            'Mã đối tượng (hạch toán)': maDoiTuong,
            'Số khế ước đi vay': '',
            'Số khế ước cho vay': '',
            'Mã khoản mục chi phí': '',
            'Mã đơn vị': '',
            'Mã đối tượng THCP': '',
            'Mã công trình': maCT,
            'Số đơn đặt hàng': '',
            'Số đơn mua hàng': '',
            'Số hợp đồng mua': '',
            'Số hợp đồng bán': '',
            'Mã thống kê': '',
            'CP không hợp lý': '',
            'Số HĐ khớp': soHD,
            'Tổng tiền HĐ khớp': b.tienHD,
            'Doanh thu gộp (trước phí)': Math.round(b.dt),
            'Chênh lệch HĐ vs doanh thu': Math.round(b.tienHD - b.dt),
            'Trạng thái': !soHD ? 'Chưa có HĐ' : (Math.abs(b.tienHD - b.dt) <= 1000 ? 'Khớp' : 'Lệch'),
          });
        });
        seq++;
      };

      batches
        .slice()
        .sort((a, b) => ddmmToISO(a.payDate).localeCompare(ddmmToISO(b.payDate)))
        .forEach(bg => {
          if (!inRangeIso(bg.payDate)) return;
          pushBatch(bg.payDate, collectByMaCT(bg.payDates));
        });

      const unpaidDates = allDates.filter(d => !coveredDates.has(d) && inRangeIso(d));
      unpaidDates
        .slice()
        .sort((a, b) => ddmmToISO(a).localeCompare(ddmmToISO(b)))
        .forEach(date => {
          pushBatch(date, collectByMaCT([date]));
        });

      return { rows, skipped, nextSeq: seq };
    }

    async function confirmExportZvpMisa(kind) {
      const stEl = document.getElementById('zvpMisaModalStatus');
      const fromIso = (document.getElementById('zvpMisaFromDate')||{}).value;
      const toIso   = (document.getElementById('zvpMisaToDate')||{}).value;
      const startSeq = parseInt((document.getElementById('zvpMisaStartSeq')||{}).value, 10) || 1;
      if (!fromIso || !toIso) { if (stEl) stEl.textContent = 'Vui lòng chọn đủ Từ ngày và Đến ngày.'; return; }
      if (fromIso > toIso) { if (stEl) stEl.textContent = 'Từ ngày phải trước Đến ngày.'; return; }
      if (stEl) stEl.textContent = 'Đang tải dữ liệu ngân hàng...';
      try { await fetchBankZalo(); } catch(e) {}
      try { await fetchBankVnpay(); } catch(e) {}
      try { await fetchBankPayoo(); } catch(e) {}
      if (stEl) stEl.textContent = '';
      closeZvpMisaModal();

      function doOnline() {
        if (!_zaloFee.length) { return { ok:false, msg:'Chưa có dữ liệu Zalo Pay để xuất.' }; }
        const { rows, skipped } = buildZvpMisaRows({
          byDate: buildZaloByDateForExport(), getGianDisp: getGianDisp_Zalo_Wrap(),
          hdObj: _zaloHD, bankPayments: _bankZaloPayments,
          dienGiaiSuffix: 'VNP', maDoiTuong: 'VN PAY0102182292',
          startSeq, fromIso, toIso,
        });
        if (!rows.length) { return { ok:false, msg:'Không có dòng nào để xuất (Online/Zalo) trong khoảng ngày đã chọn.' }; }
        const wb = XLSX.utils.book_new();
        XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(rows), 'MISATHue Online');
        const fname = 'MISATHue-online_' + fromIso + '_den_' + toIso + '.xlsx';
        XLSX.writeFile(wb, fname);
        return { ok:true, fname, count: rows.length, skipped: skipped.length };
      }
      function doOffline() {
        if (!_vnpayFee.length && !_payooFee.length) { return { ok:false, msg:'Chưa có dữ liệu VNPay/Payoo để xuất.' }; }
        const vnpayPart = buildZvpMisaRows({
          byDate: buildVnpayByDateForExport(), getGianDisp: getVnpayGianDisp,
          hdObj: _vnpayHD, bankPayments: _bankVnpayPayments,
          dienGiaiSuffix: 'VNP', maDoiTuong: 'VN PAY0102182292',
          startSeq, fromIso, toIso,
        });
        const payooPart = buildZvpMisaRows({
          byDate: buildPayooByDateForExport(), getGianDisp: getPayooGianDisp,
          hdObj: _payooHD, bankPayments: _bankPayooPayments,
          dienGiaiSuffix: 'PAYOO', maDoiTuong: 'DONGVIET0305458683',
          startSeq: vnpayPart.nextSeq, fromIso, toIso,
        });
        const rows = [...vnpayPart.rows, ...payooPart.rows];
        const skipped = [...vnpayPart.skipped, ...payooPart.skipped];
        if (!rows.length) { return { ok:false, msg:'Không có dòng nào để xuất (Offline/VNPay+Payoo) trong khoảng ngày đã chọn.' }; }
        const wb = XLSX.utils.book_new();
        XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(rows), 'MISAThue OFFLINE');
        const fname = 'MISATHue-offline_' + fromIso + '_den_' + toIso + '.xlsx';
        XLSX.writeFile(wb, fname);
        return { ok:true, fname, count: rows.length, skipped: skipped.length };
      }

      if (kind === 'online') {
        const r = doOnline();
        if (!r.ok) { alert(r.msg); return; }
        alert(`✅ Đã xuất ${r.count} dòng vào file ${r.fname}` + (r.skipped ? `\n\n⚠️ Bỏ qua ${r.skipped} nhóm chưa xác định gian.` : ''));
      } else if (kind === 'offline') {
        const r = doOffline();
        if (!r.ok) { alert(r.msg); return; }
        alert(`✅ Đã xuất ${r.count} dòng (VNPay + Payoo) vào file ${r.fname}` + (r.skipped ? `\n\n⚠️ Bỏ qua ${r.skipped} nhóm chưa xác định gian.` : ''));
      } else if (kind === 'all') {
        // Chi Nhan, 2026-09-11: "cho cái xuất 1 lần cả 3 luôn nhá" -- xuất cả
        // Online (Zalo) va Offline (VNPay+Payoo) chi voi 1 lan bam, dung
        // chung 1 bo tham so (fromIso/toIso/startSeq) nhu khi bam rieng tung
        // cai. 2 file van tach rieng (dung cau truc/ten file nhu cu) vi
        // Online va Offline la 2 file Misa khac nhau, khong gop chung sheet.
        const r1 = doOnline();
        const r2 = doOffline();
        const msgs = [];
        if (r1.ok) msgs.push(`✅ Online: ${r1.count} dòng → ${r1.fname}` + (r1.skipped ? ` (bỏ qua ${r1.skipped} nhóm)` : ''));
        else msgs.push(`⚠️ Online: ${r1.msg}`);
        if (r2.ok) msgs.push(`✅ Offline: ${r2.count} dòng → ${r2.fname}` + (r2.skipped ? ` (bỏ qua ${r2.skipped} nhóm)` : ''));
        else msgs.push(`⚠️ Offline: ${r2.msg}`);
        alert(msgs.join('\n'));
      }
    }
    // getGianDisp cho Zalo không có tên hàm riêng dùng chung như VNPay/Payoo
    // (định nghĩa cục bộ trong renderZaloDoiSoat) -- tạo bản wrap riêng cho
    // xuất Misa, y hệt logic getGianDisp trong renderZaloDoiSoat.
    function getGianDisp_Zalo_Wrap() {
      return (date, maCT, d) => {
        const hd = _zaloHD[date+'|'+maCT] || {};
        const dt  = (hd.dtOvr  != null && hd.dtOvr  !== '') ? (parseFloat(String(hd.dtOvr).replace(/[^0-9.-]/g,''))||0)  : d.gross;
        const net = (hd.netOvr != null && hd.netOvr !== '') ? (parseFloat(String(hd.netOvr).replace(/[^0-9.-]/g,''))||0) : d.net;
        return { dt, net };
      };
    }


          <td style="padding:.4rem .75rem;text-align:right;font-weight:600">${r.soHD}</td>
          <td style="padding:.4rem .75rem;text-align:right;color:#15803d;font-weight:600">${fmt(r.tongTien)}</td>
          <td style="padding:.4rem .75rem;color:#475569;font-size:.82em">${r.dichVu}</td>
          <td style="padding:.4rem .75rem;font-size:.82em"><span style="font-weight:600">${r.maDiem}</span>${cseTag}${maCT?`<br><span style="color:#6366f1;font-size:.85em">↳ ${maCT}</span>`:''}</td>
          <td style="padding:.4rem .75rem;font-size:.82em">${r.maNCC}</td>

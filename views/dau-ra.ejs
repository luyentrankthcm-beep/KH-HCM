<!DOCTYPE html>
<html lang="vi">
<head>
  <%- include('partials/head') %>
  <title>Đầu Ra – Doanh Thu – K&H</title>
  <style>
    .company-badge {
      display:inline-flex; align-items:center; gap:.4rem;
      background:<%= activeCompany === 'kh_cu' ? '#dbeafe' : '#dcfce7' %>;
      color:<%= activeCompany === 'kh_cu' ? '#1e40af' : '#166534' %>;
      border:1px solid <%= activeCompany === 'kh_cu' ? '#93c5fd' : '#86efac' %>;
      border-radius:20px; padding:.2rem .75rem; font-size:.82em; font-weight:700;
      margin-bottom:1rem;
    }
    /* TABS */
    .tab-bar { display:flex; gap:0; border-bottom:2px solid #1e3a5f; margin-bottom:1.25rem; }
    .tab-btn { padding:.5rem 1.25rem; font-weight:600; font-size:.88em; cursor:pointer; border:none; background:#e8f0fe; color:#1e3a5f; border-radius:6px 6px 0 0; margin-right:3px; }
    .tab-btn.active { background:#1e3a5f; color:#fff; }
    .tab-btn:hover:not(.active) { background:#c7d7f8; }
    .tab-panel { display:none; }
    .tab-panel.active { display:block; }
    .sub-tab-bar { display:flex; gap:4px; margin-bottom:1rem; flex-wrap:wrap; }
    .sub-tab-btn { padding:.3rem 1rem; font-size:.83em; font-weight:600; cursor:pointer; border:1px solid #cbd5e1; background:#f8fafc; color:#475569; border-radius:20px; }
    .sub-tab-btn.active { background:#2563eb; color:#fff; border-color:#2563eb; }
    .sub-tab-btn:hover:not(.active) { background:#e0e7ff; border-color:#818cf8; }
    .sub-panel { display:none; }
    .sub-panel.active { display:block; }
    /* MOMO HEADER */
    .channel-header { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:.5rem; margin-bottom:1rem; padding:.75rem 1rem; background:#f8fafc; border:1px solid #e2e8f0; border-radius:8px; }
    .acct-info { font-size:.88em; color:#475569; }
    .acct-info strong { color:#1e3a5f; font-size:1em; }
    .btn-nhap { background:#7c3aed; color:#fff; border:none; border-radius:6px; padding:.42rem 1rem; cursor:pointer; font-weight:600; font-size:.85em; display:inline-flex; align-items:center; gap:.35rem; }
    .btn-nhap:hover { background:#6d28d9; }
    /* EMPTY STATE */
    .empty-state { text-align:center; padding:3rem 1rem; }
    .empty-state .big-icon { font-size:3rem; margin-bottom:.75rem; }
    .empty-state p { color:#94a3b8; font-size:.9em; }
    /* UPLOAD MODAL */
    .modal-overlay { display:none; position:fixed; inset:0; background:rgba(15,23,42,.55); z-index:300; align-items:center; justify-content:center; }
    .modal-overlay.open { display:flex; }
    .modal-box { background:#fff; border-radius:12px; width:min(500px,94vw); padding:1.5rem; box-shadow:0 20px 60px rgba(0,0,0,.25); }
    .modal-box h3 { margin:0 0 .4rem; font-size:1.05rem; color:#1e3a5f; }
    .modal-sub { font-size:.82em; color:#64748b; margin:0 0 1rem; }
    .upload-area { border:2px dashed #94a3b8; border-radius:8px; padding:2rem 1rem; text-align:center; cursor:pointer; color:#64748b; font-size:.88em; transition:.2s; }
    .upload-area:hover { border-color:#7c3aed; background:#faf5ff; color:#7c3aed; }
    .upload-area .big-icon { font-size:2.5rem; display:block; margin-bottom:.5rem; }
    .upload-status { margin-top:.75rem; font-size:.85em; min-height:1.5em; }
    .upload-status.ok { color:#16a34a; }
    .upload-status.err { color:#dc2626; }
    .upload-status.loading { color:#2563eb; }
    .modal-actions { display:flex; justify-content:flex-end; gap:.5rem; margin-top:1rem; }
    .btn-cancel { background:#f1f5f9; border:1px solid #cbd5e1; border-radius:5px; padding:.38rem 1rem; cursor:pointer; font-size:.85em; }
    /* RESULTS */
    .results-toolbar { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:.5rem; margin-bottom:.75rem; }
    .results-meta { font-size:.82em; color:#64748b; }
    .btn-export { background:#16a34a; color:#fff; border:none; border-radius:5px; padding:.35rem .85rem; cursor:pointer; font-size:.82em; font-weight:600; }
    .btn-export:hover { background:#15803d; }
    .pivot-wrap { overflow-x:auto; max-height:60vh; overflow-y:auto; border:1px solid #e2e8f0; border-radius:8px; }
    .pivot-table { width:100%; border-collapse:collapse; font-size:.82em; }
    .pivot-table th { background:#1e3a5f; color:#fff; padding:.42rem .6rem; white-space:nowrap; position:sticky; top:0; z-index:5; text-align:right; }
    .pivot-table th:first-child { text-align:left; position:sticky; left:0; z-index:10; background:#1e3a5f; }
    .pivot-table td { padding:.38rem .6rem; border-bottom:1px solid #f1f5f9; white-space:nowrap; text-align:right; }
    .pivot-table td:first-child { text-align:left; font-weight:600; color:#1e3a5f; position:sticky; left:0; background:#fff; z-index:2; border-right:1px solid #e2e8f0; }
    .pivot-table tbody tr:nth-child(odd) td { background:#f8fafc; }
    .pivot-table tbody tr:nth-child(odd) td:first-child { background:#f8fafc; }
    .pivot-table tbody tr:hover td { background:#eff6ff !important; }
    .pivot-table tfoot td { background:#1e3a5f !important; color:#fff; font-weight:700; position:sticky; bottom:0; }
    .pivot-table tfoot td:first-child { background:#1e3a5f !important; }
    .cell-zero { color:#d1d5db; }
    /* HISTORY */
    .history-item { background:#f8fafc; border:1px solid #e2e8f0; border-radius:8px; padding:.75rem 1rem; margin-bottom:.5rem; display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:.5rem; }
    .history-item .h-name { font-weight:600; color:#1e3a5f; font-size:.88em; }
    .history-item .h-meta { font-size:.78em; color:#64748b; }
    .badge-added { background:#dcfce7; color:#166534; border-radius:4px; padding:.05rem .4rem; font-size:.78em; font-weight:700; }
    .badge-skip  { background:#fef9c3; color:#854d0e; border-radius:4px; padding:.05rem .4rem; font-size:.78em; font-weight:700; }
    .cell-val { color:#15803d; }
    .total-col { background:#e0f2fe !important; color:#0369a1; font-weight:700; border-left:2px solid #7dd3fc; }
    /* FILTER */
    .filter-bar { display:flex; gap:.5rem; flex-wrap:wrap; align-items:center; margin-bottom:.75rem; font-size:.83em; }
    .filter-bar input, .filter-bar select { padding:.28rem .5rem; border:1px solid #cbd5e1; border-radius:4px; font-size:.85em; }
    /* DETAIL TABLE */
    .detail-table { width:100%; border-collapse:collapse; font-size:.82em; }
    .detail-table th { background:#1e3a5f; color:#fff; padding:.4rem .6rem; text-align:left; white-space:nowrap; position:sticky; top:0; z-index:5; }
    .detail-table td { padding:.36rem .6rem; border-bottom:1px solid #f1f5f9; }
    .detail-table tbody tr:hover td { background:#eff6ff; }
    .badge-vang-lai { background:#fef9c3; color:#854d0e; border-radius:4px; padding:.05rem .3rem; font-size:.78em; }
    /* MAP CT */
    .btn-mapct { background:#6366f1; color:#fff; border:none; border-radius:5px; padding:.35rem .85rem; cursor:pointer; font-size:.82em; font-weight:600; }
    .btn-mapct:hover { background:#4f46e5; }
    .ct-badge { display:inline-block; background:#e0e7ff; color:#4338ca; border-radius:4px; padding:.05rem .4rem; font-size:.73em; font-weight:700; margin-top:2px; }
    .ct-chiase-badge { display:inline-block; background:#dcfce7; color:#166534; border-radius:4px; padding:.05rem .4rem; font-size:.7em; font-weight:600; margin-left:3px; }
    /* MAP CT MODAL */
    .ctmap-modal-box { background:#fff; border-radius:12px; width:min(640px,96vw); max-height:90vh; display:flex; flex-direction:column; box-shadow:0 20px 60px rgba(0,0,0,.25); }
    .ctmap-modal-box .modal-header { display:flex; align-items:center; justify-content:space-between; padding:1rem 1.25rem .75rem; border-bottom:1px solid #e2e8f0; }
    .ctmap-modal-box .modal-header h3 { margin:0; font-size:1rem; color:#1e3a5f; }
    .ctmap-modal-box .modal-body { overflow-y:auto; padding:.75rem 1.25rem; flex:1; }
    .ctmap-modal-box .modal-footer { padding:.75rem 1.25rem; border-top:1px solid #e2e8f0; display:flex; justify-content:flex-end; gap:.5rem; }
    .ct-map-table { width:100%; border-collapse:collapse; font-size:.84em; }
    .ct-map-table th { background:#f1f5f9; padding:.45rem .6rem; text-align:left; font-weight:600; color:#475569; }
    .ct-map-table td { padding:.4rem .6rem; border-bottom:1px solid #f1f5f9; vertical-align:middle; }
    .ct-map-table tr:last-child td { border-bottom:none; }
    .ct-input { width:150px; border:1px solid #cbd5e1; border-radius:6px; padding:.3rem .5rem; font-size:.85em; }
    .ct-input:focus { outline:none; border-color:#6366f1; box-shadow:0 0 0 2px #e0e7ff; }
    /* ĐOÁI SOÁT NGÀY */
    .doisoat-table { width:100%; border-collapse:collapse; font-size:.92em; }
    .doisoat-table .day-row td { background:#1e3a5f; color:#fff; font-weight:700; padding:.5rem .75rem; }
    .doisoat-table .gian-row td { padding:.38rem .75rem; border-bottom:1px solid #f1f5f9; }
    .doisoat-table .gian-row:nth-child(even) td { background:#f8fafc; }
    .doisoat-table .gian-row:hover td { background:#eff6ff !important; }
    .doisoat-table .gian-total td { background:#e0f2fe; font-weight:700; color:#0369a1; padding:.4rem .75rem; border-top:1px solid #bae6fd; }
  </style>
</head>
<body>
  <%- include('partials/nav') %>
  <main class="container">
    <h1 class="page-title">Đầu Ra – Doanh Thu</h1>

    <div class="company-badge">
      <%= activeCompany === 'kh_cu' ? '🏢 KH Cũ' : '🏗️ KH Mới' %>
    </div>

    <!-- TOP TABS -->
    <div class="tab-bar">
      <button class="tab-btn active" onclick="switchTab('momo', this)">🟣 Momo</button>
      <button class="tab-btn" onclick="switchTab('zvp', this)">🔵 Zalo/VNPay/Payoo</button>
      <button class="tab-btn" onclick="switchTab('vietqr', this)">🟢 Viet QR</button>
      <button class="tab-btn" onclick="switchTab('mtt', this)">🔶 MTT / Hoàn tiền</button>
    </div>

    <!-- ==================== MOMO TAB ==================== -->
    <div id="momo" class="tab-panel active">

      <!-- Account header -->
      <div class="channel-header">
        <div class="acct-info">
          Tài khoản Momo: <strong><%= activeCompany === 'kh_cu' ? '0xxx – KH Cũ' : '7701 – KH Mới' %></strong>
        </div>
        <button class="btn-nhap" onclick="openMomoModal()">📤 Nhập liệu đối soát</button>
      </div>

      <!-- Sub-tabs -->
      <div class="sub-tab-bar" id="momoSubTabs" style="display:none">
        <button class="sub-tab-btn active" onclick="switchSub('momo','pivot',this)">📊 Theo gian</button>
        <button class="sub-tab-btn" onclick="switchSub('momo','doisoat',this); populateMonthFilter(); renderDoiSoatNgay(); fetchBankMomo()">📅 Đối soát ngày</button>
        <button class="sub-tab-btn" onclick="switchSub('momo','detail',this)">📋 Chi tiết GD</button>
        <button class="sub-tab-btn" onclick="switchSub('momo','history',this)">🕓 Lịch sử tải</button>
      </div>

      <!-- Sub: Pivot -->
      <div id="momo-pivot" class="sub-panel active">
        <div id="momoEmpty" class="empty-state">
          <div class="big-icon">📂</div>
          <p>Chưa có dữ liệu<br>Nhấn <strong>Nhập liệu đối soát</strong> để tải file Excel từ Momo Business</p>
        </div>
        <div id="momoResults" style="display:none">
          <div class="results-toolbar">
            <div class="results-meta" id="momoMeta"></div>
            <div style="display:flex;gap:.5rem">
              <button class="btn-mapct" onclick="openCtMapModal()">🗺️ Map CT</button>
              <button class="btn-export" onclick="exportPivot()">⬇️ Xuất Excel</button>
              <button onclick="clearMomoData()" style="background:#ef4444;color:#fff;border:none;border-radius:5px;padding:.35rem .75rem;cursor:pointer;font-size:.82em;font-weight:600">🗑️ Xóa dữ liệu</button>
            </div>
          </div>
          <div class="filter-bar">
            <label>Lọc gian:</label>
            <input type="text" id="filterGian" placeholder="Tìm mã gian..." oninput="renderPivot()">
            <label>Nhóm:</label>
            <select id="filterGroup" onchange="renderPivot()">
              <option value="">Tất cả</option>
            </select>
          </div>
          <div class="pivot-wrap">
            <table class="pivot-table" id="pivotTable">
              <thead id="pivotHead"></thead>
              <tbody id="pivotBody"></tbody>
              <tfoot id="pivotFoot"></tfoot>
            </table>
          </div>
        </div>
      </div>

      <!-- Sub: Detail -->
      <div id="momo-detail" class="sub-panel">
        <div class="filter-bar">
          <input type="text" id="filterDetail" placeholder="Tìm gian, mã GD..." oninput="renderDetail()" style="width:200px">
          <select id="filterDate" onchange="renderDetail()"><option value="">Tất cả ngày</option></select>
        </div>
        <div style="overflow-x:auto;max-height:65vh;overflow-y:auto;border:1px solid #e2e8f0;border-radius:8px;">
          <table class="detail-table">
            <thead><tr>
              <th>#</th><th>Ngày</th><th>Giờ</th><th>Gian</th>
              <th>Số tiền đến</th><th>Loại GD</th><th>Mã đơn</th>
            </tr></thead>
            <tbody id="detailBody"></tbody>
          </table>
        </div>
      </div>

      <!-- Sub: Đối soát ngày -->
      <div id="momo-doisoat" class="sub-panel">
        <div class="filter-bar" style="margin-bottom:.5rem;align-items:center">
          <label style="font-size:.82em;font-weight:600;color:#1e3a5f">Tháng:</label>
          <select id="filterMonth" onchange="renderDoiSoatNgay()" style="padding:.3rem .6rem;border:1px solid #cbd5e1;border-radius:6px;font-size:.85em;font-weight:600;background:#fff;cursor:pointer"></select>
          <span style="font-size:.78em;color:#94a3b8">· Nhóm theo đợt NH trả · Nhập số HĐ để lưu</span>
        </div>
        <div style="overflow-x:auto;max-height:70vh;overflow-y:auto;border:1px solid #e2e8f0;border-radius:8px;">
          <table class="doisoat-table">
            <thead>
              <tr style="background:#1e3a5f;color:#fff;position:sticky;top:0;z-index:10">
                <th style="padding:.5rem .75rem;min-width:200px;text-align:left">Mã CT / Gian</th>
                <th style="padding:.5rem .75rem;text-align:right;min-width:120px">Doanh thu</th>
                <th style="padding:.5rem .75rem;text-align:right;min-width:100px">Phí Momo</th>
                <th style="padding:.5rem .75rem;text-align:right;min-width:120px">Tiền Net</th>
                <th style="padding:.5rem .75rem;text-align:right;min-width:130px;background:#1e4a6f">Tiền NH về</th>
                <th style="padding:.5rem .75rem;min-width:140px">Số hóa đơn</th>
                <th style="padding:.5rem .75rem;text-align:right;min-width:120px">Tiền HĐ</th>
              </tr>
            </thead>
            <tbody id="doiSoatBody"></tbody>
          </table>
        </div>
      </div>

      <!-- Sub: History -->
      <div id="momo-history" class="sub-panel">
        <div id="historyList" style="max-height:60vh;overflow-y:auto">
          <p class="empty-hint">Chưa có lịch sử tải lên</p>
        </div>
      </div>
    </div>

    <!-- ==================== ZVP TAB ==================== -->
    <div id="zvp" class="tab-panel">
      <div class="channel-header">
        <div class="acct-info">Zalo/VNPay/Payoo</div>
        <button class="btn-nhap" style="background:#2563eb" disabled>📤 Nhập liệu đối soát</button>
      </div>
      <div class="empty-state"><div class="big-icon">🔵</div><p>Chưa thiết lập – <%= activeCompany === 'kh_cu' ? 'KH Cũ' : 'KH Mới' %></p></div>
    </div>

    <!-- ==================== VIET QR TAB ==================== -->
    <div id="vietqr" class="tab-panel">
      <div class="channel-header">
        <div class="acct-info">Viet QR</div>
        <button class="btn-nhap" style="background:#16a34a" disabled>📤 Nhập liệu đối soát</button>
      </div>
      <div class="empty-state"><div class="big-icon">🟢</div><p>Chưa thiết lập – <%= activeCompany === 'kh_cu' ? 'KH Cũ' : 'KH Mới' %></p></div>
    </div>

    <!-- ==================== MTT TAB ==================== -->
    <div id="mtt" class="tab-panel">
      <div class="channel-header">
        <div class="acct-info">
          MTT / Hoàn tiền &nbsp;<span style="font-size:.78em;color:#64748b">· File đối soát hoàn tiền từ các kênh thanh toán</span>
        </div>
        <button class="btn-nhap" style="background:#d97706" onclick="openMttModal()">📤 Nhập file MTT</button>
      </div>

      <div id="mttEmpty" class="empty-state">
        <div class="big-icon">🔶</div>
        <p>Chưa có dữ liệu MTT<br>Nhấn <strong>Nhập file MTT</strong> để tải lên · Hệ thống tự nhận dạng KH Cũ / KH Mới</p>
      </div>

      <div id="mttResults" style="display:none">
        <div class="results-toolbar">
          <div class="results-meta" id="mttMeta"></div>
          <div style="display:flex;gap:.5rem">
            <button onclick="clearMttData()" style="background:#ef4444;color:#fff;border:none;border-radius:5px;padding:.35rem .75rem;cursor:pointer;font-size:.82em;font-weight:600">🗑️ Xóa dữ liệu</button>
          </div>
        </div>
        <div style="overflow-x:auto;border:1px solid #e2e8f0;border-radius:8px;max-height:65vh;overflow-y:auto">
          <table style="width:100%;border-collapse:collapse;font-size:.83em">
            <thead><tr id="mttHead" style="background:#92400e;color:#fff;position:sticky;top:0"></tr></thead>
            <tbody id="mttBody"></tbody>
          </table>
        </div>
      </div>
    </div>

  </main>

  <!-- ==================== MODAL ==================== -->
  <div id="momoModal" class="modal-overlay" onclick="if(event.target===this)closeMomoModal()">
    <div class="modal-box">
      <h3>📤 Nhập liệu đối soát Momo</h3>
      <p class="modal-sub">File Excel xuất từ cổng Momo Business → Lịch sử giao dịch → Xuất file</p>
      <div class="upload-area" onclick="document.getElementById('momoFileInput').click()">
        <span class="big-icon">📂</span>
        <div>Nhấn để chọn file <strong>.xlsx</strong></div>
        <div style="font-size:.78em;margin-top:.25rem;color:#94a3b8">Hoặc kéo thả file vào đây</div>
        <input type="file" id="momoFileInput" accept=".xlsx,.xls" style="display:none" onchange="handleMomoFile(this.files[0])">
      </div>
      <div id="momoUploadStatus" class="upload-status"></div>
      <div class="modal-actions">
        <button class="btn-cancel" onclick="closeMomoModal()">Đóng</button>
      </div>
    </div>
  </div>

  <!-- ==================== CT MAP MODAL ==================== -->
  <div id="ctMapModal" class="modal-overlay" onclick="if(event.target===this)document.getElementById('ctMapModal').classList.remove('open')">
    <div class="ctmap-modal-box">
      <div class="modal-header">
        <h3>🗺️ Map Công Trình</h3>
        <button onclick="document.getElementById('ctMapModal').classList.remove('open')" style="border:none;background:none;font-size:1.2rem;cursor:pointer;color:#64748b">✕</button>
      </div>
      <div class="modal-body">
        <p style="font-size:.8em;color:#64748b;margin:0 0 .75rem">Gán mã công trình cho từng gian. Mã sẽ hiện trong bảng Pivot và Đối soát ngày.</p>
        <datalist id="ctCodeList"></datalist>
        <table class="ct-map-table">
          <thead>
            <tr>
              <th>Tên gian (Momo)</th>
              <th>Mã công trình</th>
              <th style="text-align:center">DT Chia sẻ?</th>
            </tr>
          </thead>
          <tbody id="ctMapBody"></tbody>
        </table>
      </div>
      <div class="modal-footer">
        <button class="btn-cancel" onclick="document.getElementById('ctMapModal').classList.remove('open')">Hủy</button>
        <button onclick="saveCtMapModal()" style="background:#6366f1;color:#fff;border:none;border-radius:6px;padding:.45rem 1.2rem;cursor:pointer;font-weight:600">💾 Lưu</button>
      </div>
    </div>
  </div>

  <!-- ==================== MTT MODAL ==================== -->
  <div id="mttModal" class="modal-overlay" onclick="if(event.target===this)closeMttModal()">
    <div class="modal-box">
      <h3>📤 Nhập file MTT – Hoàn tiền</h3>
      <p class="modal-sub">Tải file đối soát MTT (Excel/CSV). Hệ thống đọc cấu trúc để Claude thiết lập parser.</p>
      <div class="upload-area" onclick="document.getElementById('mttFileInput').click()">
        <span class="big-icon">📂</span>
        <div>Nhấn để chọn file <strong>.xlsx / .csv</strong></div>
        <div style="font-size:.78em;margin-top:.25rem;color:#94a3b8">Hoặc kéo thả vào đây</div>
        <input type="file" id="mttFileInput" accept=".xlsx,.xls,.csv" style="display:none" onchange="handleMttFile(this.files[0])">
      </div>
      <div id="mttUploadStatus" class="upload-status"></div>
      <div style="margin-top:.75rem;padding:.6rem .75rem;background:#fef9c3;border-radius:6px;font-size:.8em;color:#854d0e">
        ⚠️ Format file MTT chưa cấu hình. Tải lên → Claude xem cấu trúc → thiết lập parser.
      </div>
      <div class="modal-actions">
        <button class="btn-cancel" onclick="closeMttModal()">Đóng</button>
      </div>
    </div>
  </div>

  <!-- SheetJS -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
  <script>
    // ── Company key (for localStorage namespacing) ──
    const COMPANY = '<%= activeCompany %>';
    const LS_ROWS    = `momo_rows_${COMPANY}`;
    const LS_HISTORY = `momo_history_${COMPANY}`;
    const LS_CT_MAP   = `momo_ct_map_${COMPANY}`;
    const LS_CT_CODES = `momo_ct_codes_${COMPANY}`;
    const LS_HD_DATA  = `momo_hd_${COMPANY}`;

    // ── Tab switching ──
    function switchTab(id, btn) {
      document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
      document.querySelectorAll('.tab-bar .tab-btn').forEach(b => b.classList.remove('active'));
      document.getElementById(id).classList.add('active');
      btn.classList.add('active');
    }
    function switchSub(tabId, subId, btn) {
      const panel = document.getElementById(tabId);
      panel.querySelectorAll('.sub-panel').forEach(p => p.classList.remove('active'));
      panel.querySelectorAll('.sub-tab-btn').forEach(b => b.classList.remove('active'));
      document.getElementById(tabId + '-' + subId).classList.add('active');
      btn.classList.add('active');
    }

    // ── Modal ──
    function openMomoModal() { document.getElementById('momoModal').classList.add('open'); }
    function closeMomoModal() { document.getElementById('momoModal').classList.remove('open'); }

    // ── Drag & drop ──
    const uploadArea = document.querySelector('.upload-area');
    uploadArea.addEventListener('dragover', e => { e.preventDefault(); uploadArea.style.borderColor = '#7c3aed'; });
    uploadArea.addEventListener('dragleave', () => { uploadArea.style.borderColor = ''; });
    uploadArea.addEventListener('drop', e => {
      e.preventDefault(); uploadArea.style.borderColor = '';
      if (e.dataTransfer.files[0]) handleMomoFile(e.dataTransfer.files[0]);
    });

    // ── Global data store ──
    let _rows = [];     // [{date, time, gian, amount, loaiGD, maDon, txId, feeRate}]
    let _dates = [];
    let _gians = [];
    let _history = []; // [{fileName, uploadedAt, added, skipped, fmt}]
    let _ctMap   = {}; // { [gian]: { maCT, isChiaSe } }
    let _ctCodes = []; // ['CT001', 'CT002', ...]
    let _hdData  = {}; // { [`${date}|${gian}`]: { soHD, soTienHD, tienNH } }
    let _bankMomoPayments = []; // [{ payDate:"DD-MM-YYYY", amount, fromDate, toDate }]

    // ── localStorage helpers ──
    function saveRows()    { try { localStorage.setItem(LS_ROWS, JSON.stringify(_rows)); } catch(e){} }
    function saveHistory() { try { localStorage.setItem(LS_HISTORY, JSON.stringify(_history)); } catch(e){} }
    function saveCtMap()   { try { localStorage.setItem(LS_CT_MAP, JSON.stringify(_ctMap)); localStorage.setItem(LS_CT_CODES, JSON.stringify(_ctCodes)); } catch(e){} }
    function saveHdData()  { try { localStorage.setItem(LS_HD_DATA, JSON.stringify(_hdData)); } catch(e){} }
    function loadStored() {
      try {
        const r  = localStorage.getItem(LS_ROWS);
        const h  = localStorage.getItem(LS_HISTORY);
        const m  = localStorage.getItem(LS_CT_MAP);
        const c  = localStorage.getItem(LS_CT_CODES);
        const hd = localStorage.getItem(LS_HD_DATA);
        if (r)  _rows    = JSON.parse(r);
        if (h)  _history = JSON.parse(h);
        if (m)  _ctMap   = JSON.parse(m);
        if (c)  _ctCodes = JSON.parse(c);
        if (hd) _hdData  = JSON.parse(hd);
      } catch(e) { _rows = []; _history = []; }
    }
    function saveHdField(key, field, val) {
      if (!_hdData[key]) _hdData[key] = {};
      _hdData[key][field] = val;
      saveHdData();
    }

    // ── Recompute derived arrays & refresh UI ──
    function refreshUI() {
      _dates = [...new Set(_rows.map(r => r.date))].sort((a, b) => {
        const p = d => { const [dd,mm,yy] = d.split('-'); return `${yy}-${mm}-${dd}`; };
        return p(a).localeCompare(p(b));
      });
      _gians = [...new Set(_rows.map(r => r.gian))].sort();

      const grpSet = new Set(_gians.map(g => g.split(' ')[0]));
      const grpSel = document.getElementById('filterGroup');
      grpSel.innerHTML = '<option value="">Tất cả</option>';
      [...grpSet].sort().forEach(g => { const o = document.createElement('option'); o.value = g; o.textContent = g; grpSel.appendChild(o); });

      const dateSel = document.getElementById('filterDate');
      dateSel.innerHTML = '<option value="">Tất cả ngày</option>';
      _dates.forEach(d => { const o = document.createElement('option'); o.value = d; o.textContent = d; dateSel.appendChild(o); });

      if (_rows.length) {
        document.getElementById('momoEmpty').style.display = 'none';
        document.getElementById('momoResults').style.display = 'block';
        document.getElementById('momoSubTabs').style.display = 'flex';
        const totalAmt = _rows.reduce((s,r) => s + r.amount, 0);
        document.getElementById('momoMeta').textContent =
          `${_rows.length.toLocaleString('vi')} GD · ${_gians.length} gian · ${_dates.length} ngày · Tổng: ${totalAmt.toLocaleString('vi')}đ`;
      }

      populateMonthFilter();
      renderPivot();
      renderDetail();
      renderHistory();
    }

    // ── Populate month filter ──
    function populateMonthFilter() {
      const sel = document.getElementById('filterMonth');
      if (!sel) return;
      const months = [...new Set(_dates.map(d => {
        const [dd, mm, yy] = d.split('-');
        return `${mm}/${yy}`;
      }))].sort((a, b) => {
        const [ma, ya] = a.split('/');
        const [mb, yb] = b.split('/');
        return (ya + ma).localeCompare(yb + mb);
      });
      const curVal = sel.value;
      sel.innerHTML = months.map(m => `<option value="${m}">${m}</option>`).join('');
      const today = new Date();
      const curMonth = String(today.getMonth()+1).padStart(2,'0') + '/' + today.getFullYear();
      sel.value = months.includes(curVal) ? curVal
                : months.includes(curMonth) ? curMonth
                : (months[months.length - 1] || '');
    }

    // ── Clear data ──
    function clearMomoData() {
      if (!confirm('Xóa toàn bộ dữ liệu Momo đã lưu?')) return;
      _rows = []; _history = [];
      saveRows(); saveHistory();
      document.getElementById('momoEmpty').style.display = 'block';
      document.getElementById('momoResults').style.display = 'none';
      document.getElementById('momoSubTabs').style.display = 'none';
      renderHistory();
    }

    // ── Parse file ──
    function handleMomoFile(file) {
      if (!file) return;
      const st = document.getElementById('momoUploadStatus');
      st.className = 'upload-status loading';
      st.textContent = '⏳ Đang đọc file...';

      const reader = new FileReader();
      reader.onload = function(e) {
        try {
          const wb = XLSX.read(e.target.result, { type: 'array', cellDates: false });
          const ws = wb.Sheets[wb.SheetNames[0]];
          const data = XLSX.utils.sheet_to_json(ws, { header: 1, defval: '' });

          // Detect format: search first 5 rows for known headers
          let headerIdx = -1, fmt = '';
          for (let i = 0; i < Math.min(5, data.length); i++) {
            const row = data[i].map(c => String(c));
            if (row.some(c => c.includes('Thời gian TT'))) { headerIdx = i; fmt = 'v1'; break; }
            if (row.some(c => c.includes('Mã cửa hàng') || c.includes('Tên cửa hàng'))) { headerIdx = i; fmt = 'v2'; break; }
            if (row.some(c => c.includes('Thời gian')) && row.some(c => c.includes('Số tiền'))) { headerIdx = i; fmt = 'v2'; break; }
          }
          if (headerIdx < 0) throw new Error('Không nhận ra định dạng file. Hỗ trợ file từ Momo Business (Transactions / Transaction_report).');

          const hdr = data[headerIdx].map(c => String(c));
          const colIdx = name => hdr.findIndex(h => h.includes(name));

          // Parse into temp array
          const newRows = [];

          // Helper: tính feeRate theo Nguồn tiền + Công ty
          function calcFeeRate(nguonTien) {
            if (COMPANY === 'kh_cu') return 0.011; // KH Cũ: cố định 1.1%
            // KH Mới: theo Nguồn tiền
            const nt = String(nguonTien || '').toLowerCase();
            if (nt.includes('momo')) return 0.01;
            if (nt.includes('tra sau') || nt.includes('trả sau')) return 0.012;
            if (nt) return 0.003; // ngân hàng / ATM / QR ngân hàng
            return 0.01; // mặc định nếu không rõ
          }

          if (fmt === 'v1') {
            const C = {
              tgian:     colIdx('Thời gian TT'),
              den:       colIdx('Số tiền đến'),
              status:    colIdx('Trạng thái'),
              noiDung:   colIdx('Nội dung'),
              maDon:     colIdx('Mã đơn hàng'),
              maTham:    colIdx('Mã tham chiếu'),
              loaiGD:    colIdx('Loại giao dịch'),
              nguonTien: colIdx('Nguồn tiền'),
            };
            for (let i = headerIdx + 1; i < data.length; i++) {
              const r = data[i];
              if (!r[C.tgian]) continue;
              if (String(r[C.status] || '') !== 'Thành công') continue;
              const tgian    = String(r[C.tgian]);
              const maDon    = String(r[C.maDon] || '');
              const maTham   = String(r[C.maTham] || '');
              const txId     = maTham || maDon;
              const noiDung  = String(r[C.noiDung] || '');
              const loaiGD   = String(r[C.loaiGD] || '');
              const nguonTien = C.nguonTien >= 0 ? String(r[C.nguonTien] || '') : '';
              const feeRate  = calcFeeRate(nguonTien);
              let gian = 'Vãng lai';
              const m = noiDung.match(/VQR\w+\s+(.+)/);
              if (m) { const g = m[1].trim(); gian = (g === 'PaymentForOrder' || g === '-') ? 'Vãng lai' : g; }
              else if (loaiGD === 'Vãng lai') gian = 'Vãng lai';
              newRows.push({ date: tgian.substring(0,10), time: tgian.substring(11,19),
                gian, amount: Number(r[C.den])||0, loaiGD, maDon, txId, nguonTien, feeRate });
            }
          } else {
            const C = {
              tgian:   colIdx('Thời gian'),
              amount:  colIdx('Số tiền'),
              status:  colIdx('Trạng thái'),
              tenGian: colIdx('Tên cửa hàng'),
              maGian:  colIdx('Mã cửa hàng'),
              maDon:   colIdx('Mã đơn hàng'),
              maGD:    colIdx('Mã giao dịch'),
              loaiGD:  colIdx('Loại giao dịch'),
            };
            for (let i = headerIdx + 1; i < data.length; i++) {
              const r = data[i];
              if (!r[C.tgian]) continue;
              if (String(r[C.status] || '') !== 'Thành công') continue;
              const tgian   = String(r[C.tgian]);
              const maDon   = String(r[C.maDon] || '');
              const maGD    = String(r[C.maGD] || '');
              const txId    = maDon || maGD;
              const tenGian = String(r[C.tenGian] || '');
              const maGian  = String(r[C.maGian] || '');
              const feeRate = calcFeeRate(''); // v2 không có Nguồn tiền → default
              newRows.push({ date: tgian.substring(0,10), time: tgian.substring(11,19),
                gian: tenGian || maGian || 'Vãng lai',
                amount: Number(r[C.amount])||0,
                loaiGD: String(r[C.loaiGD]||''), maDon, txId, nguonTien: '', feeRate });
            }
          }

          if (!newRows.length) throw new Error('Không có dữ liệu hợp lệ (Thành công) trong file.');

          // Dedup: filter out txIds already in _rows
          const existingIds = new Set(_rows.map(r => r.txId).filter(Boolean));
          const toAdd   = newRows.filter(r => !r.txId || !existingIds.has(r.txId));
          const skipped = newRows.length - toAdd.length;

          // Merge
          _rows = [..._rows, ...toAdd];
          saveRows();

          // Save history
          _history.unshift({
            fileName: file.name, fmt,
            uploadedAt: new Date().toLocaleString('vi'),
            added: toAdd.length, skipped, total: newRows.length
          });
          saveHistory();

          refreshUI();

          st.className = 'upload-status ok';
          st.textContent = `✅ Thêm ${toAdd.length.toLocaleString('vi')} GD · Bỏ qua ${skipped} trùng lặp`;
          setTimeout(closeMomoModal, 1800);

        } catch(err) {
          st.className = 'upload-status err';
          st.textContent = '❌ ' + err.message;
        }
      };
      reader.readAsArrayBuffer(file);
    }

    // ── Render pivot table ──
    function renderPivot() {
      const filterGian = document.getElementById('filterGian').value.toLowerCase();
      const filterGrp  = document.getElementById('filterGroup').value;

      const gians = _gians.filter(g => {
        if (filterGian && !g.toLowerCase().includes(filterGian)) return false;
        if (filterGrp && !g.startsWith(filterGrp)) return false;
        return true;
      });

      // Build pivot map: gian → date → total
      const pivot = {};
      _rows.forEach(r => {
        if (!gians.includes(r.gian)) return;
        if (!pivot[r.gian]) pivot[r.gian] = {};
        pivot[r.gian][r.date] = (pivot[r.gian][r.date] || 0) + r.amount;
      });

      const fmt = n => n ? n.toLocaleString('vi') : '<span class="cell-zero">–</span>';

      // Head
      const head = document.getElementById('pivotHead');
      head.innerHTML = '<tr><th>Gian</th>' + _dates.map(d => `<th>${d}</th>`).join('') + '<th class="total-col">Tổng</th></tr>';

      // Body
      const tbody = document.getElementById('pivotBody');
      let html = '';
      gians.forEach(g => {
        let rowTotal = 0;
        const cells = _dates.map(d => {
          const v = (pivot[g] || {})[d] || 0;
          rowTotal += v;
          return `<td>${fmt(v)}</td>`;
        }).join('');
        const ct = _ctMap[g] || {};
        const ctLabel = ct.maCT ? `<br><span class="ct-badge">${ct.maCT}</span>${ct.isChiaSe ? '<span class="ct-chiase-badge">CS</span>' : ''}` : '';
        html += `<tr><td>${g}${ctLabel}</td>${cells}<td class="total-col cell-val">${rowTotal.toLocaleString('vi')}</td></tr>`;
      });
      tbody.innerHTML = html || '<tr><td colspan="99" style="text-align:center;color:#94a3b8;padding:1rem">Không có gian nào khớp</td></tr>';

      // Foot (totals)
      const foot = document.getElementById('pivotFoot');
      let grandTotal = 0;
      const dateTotals = _dates.map(d => {
        const t = _rows.filter(r => gians.includes(r.gian) && r.date === d).reduce((s,r) => s + r.amount, 0);
        grandTotal += t;
        return `<td>${t.toLocaleString('vi')}</td>`;
      }).join('');
      foot.innerHTML = `<tr><td>Tổng cộng</td>${dateTotals}<td class="total-col">${grandTotal.toLocaleString('vi')}</td></tr>`;
    }

    // ── Render detail table ──
    function renderDetail() {
      const q     = document.getElementById('filterDetail').value.toLowerCase();
      const dFilter = document.getElementById('filterDate').value;
      const rows = _rows.filter(r => {
        if (dFilter && r.date !== dFilter) return false;
        if (q && !r.gian.toLowerCase().includes(q) && !r.maDon.toLowerCase().includes(q)) return false;
        return true;
      }).slice(0, 500); // cap at 500 for performance

      const fmt = n => n.toLocaleString('vi');
      let html = '';
      rows.forEach((r, i) => {
        html += `<tr>
          <td>${i+1}</td>
          <td>${r.date}</td>
          <td>${r.time}</td>
          <td>${r.gian === 'Vãng lai' ? `<span class="badge-vang-lai">Vãng lai</span>` : r.gian}</td>
          <td style="text-align:right;color:#15803d;font-weight:600">${fmt(r.amount)}</td>
          <td>${r.loaiGD}</td>
          <td style="font-size:.78em;color:#64748b">${r.maDon}</td>
        </tr>`;
      });
      document.getElementById('detailBody').innerHTML = html || '<tr><td colspan="7" style="text-align:center;color:#94a3b8;padding:1rem">Không có dữ liệu</td></tr>';
    }

    // ── Render history ──
    function renderHistory() {
      const el = document.getElementById('historyList');
      if (!el) return;
      if (!_history.length) {
        el.innerHTML = '<p style="color:#94a3b8;text-align:center;padding:2rem">Chưa có lịch sử tải lên</p>';
        return;
      }
      el.innerHTML = _history.map((h, i) => `
        <div class="history-item">
          <div style="display:flex;align-items:center;gap:.5rem;flex-wrap:wrap">
            <strong style="color:#1e293b">📄 ${h.fileName}</strong>
            <span style="font-size:.75em;color:#64748b">${h.uploadedAt}</span>
            <span style="font-size:.73em;background:#e0e7ff;color:#4338ca;padding:.1rem .45rem;border-radius:999px">${h.fmt === 'v1' ? 'Transactions' : 'Transaction Report'}</span>
          </div>
          <div style="margin-top:.4rem;display:flex;gap:.5rem;align-items:center">
            <span class="badge-added">+${h.added.toLocaleString('vi')} mới</span>
            <span class="badge-skip">${h.skipped} trùng bỏ qua</span>
            <span style="font-size:.78em;color:#64748b">Tổng trong file: ${h.total.toLocaleString('vi')} GD</span>
          </div>
        </div>`).join('');
    }

    // ── Map CT Modal ──
    function openCtMapModal() {
      if (!_gians.length) { alert('Chưa có dữ liệu gian. Vui lòng tải file Momo trước.'); return; }
      // Populate datalist
      const dl = document.getElementById('ctCodeList');
      dl.innerHTML = _ctCodes.map(c => `<option value="${c}">`).join('');
      // Build rows
      const tbody = document.getElementById('ctMapBody');
      tbody.innerHTML = _gians.map(g => {
        const m = _ctMap[g] || {};
        return `<tr>
          <td style="font-weight:600;color:#1e3a5f">${g}</td>
          <td><input class="ct-input" data-gian="${g}" list="ctCodeList" value="${m.maCT||''}" placeholder="Vd: CT2025001"></td>
          <td style="text-align:center"><input type="checkbox" data-gian="${g}" class="ct-chiase" ${m.isChiaSe?'checked':''}></td>
        </tr>`;
      }).join('');
      document.getElementById('ctMapModal').classList.add('open');
    }

    function saveCtMapModal() {
      const inputs  = document.querySelectorAll('#ctMapBody .ct-input');
      const checks  = document.querySelectorAll('#ctMapBody .ct-chiase');
      inputs.forEach((inp, i) => {
        const gian    = inp.dataset.gian;
        const maCT    = inp.value.trim().toUpperCase();
        const isChiaSe = checks[i].checked;
        if (maCT) {
          _ctMap[gian] = { maCT, isChiaSe };
          if (!_ctCodes.includes(maCT)) _ctCodes.push(maCT);
        } else {
          delete _ctMap[gian];
        }
      });
      saveCtMap();
      document.getElementById('ctMapModal').classList.remove('open');
      renderPivot(); // re-render with CT labels
      renderDoiSoatNgay();
    }

    // ── Đối soát ngày ──
    function renderDoiSoatNgay() {
      const el = document.getElementById('doiSoatBody');
      if (!el || !_rows.length) {
        if (el) el.innerHTML = '<tr><td colspan="7" style="text-align:center;color:#94a3b8;padding:1.5rem">Chưa có dữ liệu</td></tr>';
        return;
      }

      // Lọc theo tháng đang chọn
      const selMonth = (document.getElementById('filterMonth') || {}).value || '';
      const filteredDates = _dates.filter(d => {
        if (!selMonth) return true;
        const [dd, mm, yy] = d.split('-');
        return `${mm}/${yy}` === selMonth;
      });
      if (!filteredDates.length) {
        el.innerHTML = '<tr><td colspan="7" style="text-align:center;color:#94a3b8;padding:1.5rem">Không có dữ liệu cho tháng đã chọn</td></tr>';
        return;
      }

      // Group: date → gian → {amount, fee}
      const byDate = {};
      _rows.forEach(r => {
        if (!filteredDates.includes(r.date)) return;
        if (!byDate[r.date]) byDate[r.date] = {};
        if (!byDate[r.date][r.gian]) byDate[r.date][r.gian] = { amount: 0, fee: 0 };
        const rate = r.feeRate != null ? r.feeRate : (COMPANY === 'kh_cu' ? 0.011 : 0.01);
        byDate[r.date][r.gian].amount += r.amount;
        byDate[r.date][r.gian].fee    += r.amount * rate; // cộng dồn float, round 1 lần khi hiển thị
      });

      const fmtN = n => Math.round(n).toLocaleString('vi');
      const ddmmToISO = d => { const [dd,mm,yy] = d.split('-'); return `${yy}-${mm}-${dd}`; };
      const inRange = (date, from, to) => {
        const d = ddmmToISO(date);
        return d >= ddmmToISO(from) && d <= ddmmToISO(to);
      };

      // Render các hàng cho 1 ngày (sub-rows theo gian)
      const renderDateRows = (date) => {
        const gianData = byDate[date] || {};
        const gianList = Object.keys(gianData).sort();
        if (!gianList.length) return '';
        const dayDT  = gianList.reduce((s,g) => s + gianData[g].amount, 0);
        const dayPhi = Math.round(gianList.reduce((s,g) => s + gianData[g].fee, 0));
        const dayNet = dayDT - dayPhi;
        let out = `<tr style="background:#374151;color:#e5e7eb;">
          <td colspan="7" style="padding:.38rem .75rem .38rem 1.25rem;font-size:.87em">
            📅 <strong>${date}</strong> &nbsp;·&nbsp; DT: ${fmtN(dayDT)}đ &nbsp;·&nbsp; Phí: ${fmtN(dayPhi)}đ &nbsp;·&nbsp; Net: <strong style="color:#93c5fd">${fmtN(dayNet)}đ</strong>
          </td></tr>`;
        gianList.forEach(g => {
          const dg  = gianData[g];
          const feeR = Math.round(dg.fee);
          const net = dg.amount - feeR;
          const ct  = _ctMap[g] || {};
          const ctLine = ct.maCT
            ? `<span class="ct-badge">${ct.maCT}</span>${ct.isChiaSe ? '<span class="ct-chiase-badge">CS</span>' : ''}`
            : '<span style="color:#94a3b8;font-size:.74em;font-style:italic">chưa map</span>';
          const hdKey = `${date}|${g}`;
          const hd    = _hdData[hdKey] || {};
          out += `<tr class="gian-row">
            <td style="padding-left:2rem"><div>${ctLine}</div><div style="font-size:.82em;color:#475569;margin-top:1px">${g}</div></td>
            <td style="text-align:right;color:#15803d;font-weight:600">${fmtN(dg.amount)}</td>
            <td style="text-align:right;color:#dc2626">${fmtN(feeR)}</td>
            <td style="text-align:right;color:#2563eb;font-weight:700">${fmtN(net)}</td>
            <td><input type="text" value="${hd.tienNH||''}" placeholder="Nhập..."
              style="width:110px;border:1px solid #bae6fd;border-radius:4px;padding:.25rem .4rem;font-size:.8em;text-align:right;background:#f0f9ff"
              onchange="saveHdField('${hdKey}','tienNH',this.value)"></td>
            <td><input type="text" value="${hd.soHD||''}" placeholder="0000123"
              style="width:120px;border:1px solid #cbd5e1;border-radius:4px;padding:.25rem .4rem;font-size:.8em"
              onchange="saveHdField('${hdKey}','soHD',this.value)"></td>
            <td><input type="text" value="${hd.soTienHD||''}" placeholder="0"
              style="width:100px;border:1px solid #cbd5e1;border-radius:4px;padding:.25rem .4rem;font-size:.8em;text-align:right"
              onchange="saveHdField('${hdKey}','soTienHD',this.value)"></td>
          </tr>`;
        });
        return out;
      };

      let html = '';
      const coveredDates = new Set();

      // Nhóm theo đợt NH trả về
      const hasBankPayments = _bankMomoPayments.length > 0;
      if (hasBankPayments) {
        _bankMomoPayments.forEach(pay => {
          // Chỉ lấy ngày Momo trong tháng đang lọc & nằm trong khoảng trả của đợt này
          const payDates = filteredDates.filter(d => inRange(d, pay.fromDate, pay.toDate));
          // Hiển thị header đợt dù payDates rỗng (để biết NH đã trả nhưng Momo tháng này không có)
          const momoNet = payDates.reduce((s, d) => {
            return s + Object.values(byDate[d] || {}).reduce((s2, v) => s2 + v.amount - Math.round(v.fee), 0);
          }, 0);
          const diff = pay.amount - momoNet;
          const matchIcon = payDates.length === 0 ? '' : (Math.abs(diff) < 1000 ? '✅' : '⚠️');
          const diffText = payDates.length > 0 && Math.abs(diff) >= 1000
            ? ` · Chênh: <span style="color:#fbbf24">${diff > 0 ? '+' : ''}${fmtN(diff)}đ</span>`
            : '';
          const momoNetText = payDates.length > 0
            ? ` · Momo Net: <strong>${fmtN(momoNet)}đ</strong> ${matchIcon}${diffText}`
            : '';

          html += `<tr>
            <td colspan="7" style="background:#1e4a6f;color:#e0f2fe;padding:.6rem .75rem;font-weight:700;font-size:.9em;border-top:2px solid #0ea5e9">
              📦 NH trả về <strong>${pay.payDate}</strong>: ${fmtN(pay.amount)}đ
              &nbsp;·&nbsp; Momo ngày <span style="color:#bae6fd">${pay.fromDate}</span> → <span style="color:#bae6fd">${pay.toDate}</span>${momoNetText}
            </td>
          </tr>`;

          payDates.forEach(d => {
            coveredDates.add(d);
            html += renderDateRows(d);
          });
        });
      }

      // Ngày Momo chưa có đợt NH trả về
      const unpaidDates = filteredDates.filter(d => !coveredDates.has(d));
      if (unpaidDates.length) {
        if (hasBankPayments) {
          // Chỉ hiện header "Chưa có NH" khi đã có ít nhất 1 đợt NH (để phân biệt với ngày bình thường)
          const unpaidNet = unpaidDates.reduce((s, d) =>
            s + Object.values(byDate[d] || {}).reduce((s2, v) => s2 + v.amount - Math.round(v.fee), 0), 0);
          html += `<tr>
            <td colspan="7" style="background:#78350f;color:#fef3c7;padding:.6rem .75rem;font-weight:700;font-size:.9em;border-top:2px solid #d97706">
              ⏳ Chưa có NH trả về &nbsp;·&nbsp; Tổng Net: ${fmtN(unpaidNet)}đ
            </td>
          </tr>`;
        }
        unpaidDates.forEach(d => { html += renderDateRows(d); });
      }

      el.innerHTML = html || '<tr><td colspan="7" style="text-align:center;color:#94a3b8;padding:1.5rem">Chưa có dữ liệu</td></tr>';
    }

    // ── Export pivot ──
    function exportPivot() {
      if (!_rows.length) return;
      const wb = XLSX.utils.book_new();
      const aoa = [['Gian', ..._dates, 'Tổng']];
      const pivot = {};
      _rows.forEach(r => {
        if (!pivot[r.gian]) pivot[r.gian] = {};
        pivot[r.gian][r.date] = (pivot[r.gian][r.date] || 0) + r.amount;
      });
      let grandTotal = 0;
      _gians.forEach(g => {
        let rowT = 0;
        const vals = _dates.map(d => { const v = (pivot[g]||{})[d]||0; rowT+=v; return v; });
        grandTotal += rowT;
        aoa.push([g, ...vals, rowT]);
      });
      aoa.push(['Tổng cộng', ..._dates.map(d => _rows.filter(r=>r.date===d).reduce((s,r)=>s+r.amount,0)), grandTotal]);
      const ws = XLSX.utils.aoa_to_sheet(aoa);
      XLSX.utils.book_append_sheet(wb, ws, 'Momo pivot');
      XLSX.writeFile(wb, 'Momo_pivot.xlsx');
    }

    // ── MTT / Hoàn tiền ──
    const LS_MTT = `mtt_rows_${COMPANY}`;
    let _mttRows = [];

    function openMttModal()  { document.getElementById('mttModal').classList.add('open'); }
    function closeMttModal() { document.getElementById('mttModal').classList.remove('open'); }

    function handleMttFile(file) {
      if (!file) return;
      const st = document.getElementById('mttUploadStatus');
      st.className = 'upload-status loading';
      st.textContent = '⏳ Đang đọc file...';
      const reader = new FileReader();
      reader.onload = function(e) {
        try {
          const wb   = XLSX.read(e.target.result, { type: 'array', cellDates: false });
          const ws   = wb.Sheets[wb.SheetNames[0]];
          const data = XLSX.utils.sheet_to_json(ws, { header: 1, defval: '' });
          const preview = data.slice(0, 10).map(r => r.map(c => String(c).substring(0,30)).join(' | ')).join('\n');
          st.className = 'upload-status ok';
          st.innerHTML = `✅ Đọc được ${data.length} dòng · ${wb.SheetNames.length} sheet · Sheet đầu: <em>${wb.SheetNames[0]}</em><br>
            <details open style="margin-top:.4rem;font-size:.78em">
              <summary>Cấu trúc 10 dòng đầu (gửi cho Claude để thiết lập parser)</summary>
              <pre style="background:#f1f5f9;border-radius:4px;padding:.5rem;overflow-x:auto;margin:.4rem 0;font-size:.73em;max-height:200px;white-space:pre-wrap">${preview}</pre>
            </details>`;
        } catch(err) {
          st.className = 'upload-status err';
          st.textContent = '❌ Lỗi đọc file: ' + err.message;
        }
      };
      reader.readAsArrayBuffer(file);
    }

    function clearMttData() {
      if (!confirm('Xóa toàn bộ dữ liệu MTT?')) return;
      _mttRows = [];
      try { localStorage.removeItem(LS_MTT); } catch(e) {}
      document.getElementById('mttEmpty').style.display = 'block';
      document.getElementById('mttResults').style.display = 'none';
    }

    // ── Fetch các đợt NH trả Momo về cho Đối soát ngày ──
    async function fetchBankMomo() {
      if (!_dates.length) return;
      const toYMD = d => { const [dd,mm,yy] = d.split('-'); return `${yy}-${mm}-${dd}`; };
      const sorted = [..._dates].sort((a, b) => toYMD(a).localeCompare(toYMD(b)));
      const from = toYMD(sorted[0]);
      const to   = toYMD(sorted[sorted.length - 1]);
      const account = '7701'; // BIDV 7701 – Momo KH Mới & KH Cũ
      try {
        const res  = await fetch(`/api/dau-ra/bank-momo?account=${account}&from=${from}&to=${to}`);
        const json = await res.json();
        if (json.ok) {
          _bankMomoPayments = json.payments || [];
          renderDoiSoatNgay(); // re-render với dữ liệu NH
        }
      } catch(e) { /* im lặng nếu fail */ }
    }

    // ── Init: restore from localStorage (script is at end of body, DOM already ready) ──
    loadStored();
    if (_rows.length) refreshUI();
    renderHistory();
  </script>
</body>
</html>

    function excelSerialToDateStr(serial) {
      // Excel date serial → DD-MM-YYYY
      const d = new Date(Math.round((serial - 25569) * 86400 * 1000));
      return `${String(d.getUTCDate()).padStart(2,'0')}-${String(d.getUTCMonth()+1).padStart(2,'0')}-${d.getUTCFullYear()}`;
    }

    function handleZaloOrderFile(inp) {
      if (!inp.files[0]) return;
      const fname = inp.files[0].name;
      const reader = new FileReader();
      reader.onload = e => {
        try {
          const wb = XLSX.read(new Uint8Array(e.target.result), {type:'array'});
          const ws = wb.Sheets[wb.SheetNames[0]];
          const rows = XLSX.utils.sheet_to_json(ws, {header:1, defval:''});
          const hdr = rows[0];
          const fc = k => hdr.indexOf(k);
          const iDate=fc('Ngày đặt hàng'), iStatus=fc('Trạng thái đơn hàng');
          const iPay=fc('Trạng thái thanh toán');
          const iSP=fc('Tên sản phẩm'), iOrder=fc('Mã đơn hàng');
          const iSku=fc('Sku');

          // Lưu compact {maOrder: maCT} — ~4x nhỏ hơn array, tránh quota exceeded
          let addedCount=0, totalInFile=0, excludedByStatus=0;
          rows.slice(1).forEach(r => {
            // Chi Nhan, 2026-09-10: Luyen nghi "chua xac dinh gian" co the do
            // lot qua giao dich chua thanh cong -- trim() ky lai 2 cot trang
            // thai (phong khi Excel co khoang trang thua/an) truoc khi so
            // sanh, thay vi so sanh truc tiep r[iPay]/r[iStatus] nhu cu.
            //
            // Luyen, 2026-09-10 (sau): phat hien don #134119/#134108 THUC SU
            // co trong file OrderDetails (Da thanh toan) nhung bi loai vi
            // "Trang thai don hang" = "Da huy" -- trong khi BaoCaoPhi (nguon
            // xac nhan tien THAT SU ve) van ghi nhan GD do la "Thanh cong".
            // Tuc la don bi huy tren he thong quan ly don SAU KHI da thu tien
            // that (khong hoan tien), nen van phai tinh doanh thu. Bo dieu
            // kien loai theo "Da huy" -- chi con dua vao Trang thai thanh
            // toan (da co BaoCaoPhi tu loc "Thanh cong" o buoc khac roi).
            // Luyen, 2026-09-10 (thêm nữa): đơn #139605/#139809/#139738... đã
            // kiểm tra tận nơi -- KHÔNG phải lỗi Unicode, mà "Trạng thái
            // thanh toán" của các đơn này trong OrderDetails THẬT SỰ là
            // "Chờ xử lý" (chưa cập nhật thành Đã thanh toán trên hệ thống
            // quản lý đơn), dù BaoCaoPhi (nguồn xác nhận tiền thật đã về, đã
            // lọc "Thành công") thì đã ghi nhận GD thành công rồi. Tương tự
            // case "Đã hủy" ở trên -- OrderDetails chỉ dùng để LẤY TÊN SẢN
            // PHẨM/SKU (xác định gian), không dùng để xác nhận có thu tiền
            // hay không (việc đó BaoCaoPhi đã làm rồi) -- nên bỏ luôn điều
            // kiện lọc theo Trạng thái thanh toán, chỉ cần có Mã đơn + Ngày.
            if(!r[iDate]) { excludedByStatus++; return; }
            totalInFile++;
            const maOrder = String(r[iOrder]||'').trim().replace(/^#/,'');
            const tenSP   = String(r[iSP]||'').trim();
            const sku     = iSku>-1 ? String(r[iSku]||'').trim() : '';
            if(!maOrder || _zaloOrders[maOrder] !== undefined) return;
            _zaloOrders[maOrder] = packZaloOrder(tenSP, sku); // tenSP (+sku); maCT resolved at render time
            if(tenSP && !_zaloSpMap[tenSP]) _zaloSpMap[tenSP]='';
            // Luyen, 2026-09-10: Sku ổn định hơn tên SP (tên đổi theo khuyến
            // mãi, vd "SNOWFUN TÂN PHÚ" vs Sku cố định "AMTP") -- thêm Sku
            // làm key map riêng, seed sẵn vài mã Luyen đã xác nhận.
            if(sku && _zaloSpMap[sku]===undefined) _zaloSpMap[sku] = SKU_CT_DEFAULTS[sku] || '';
            addedCount++;
          });
          // Lưu OrderMap vào localStorage, thử giảm size nếu bị quota
          const orderJson = JSON.stringify(_zaloOrders);
          let savedOK = false;
          try { lsSet(LS_ZALO_ORDERS, orderJson); savedOK = true; } catch(e1) {
            // Thử xóa các key cũ không cần thiết rồi save lại
            try {
              lsRemove('zalo_orders_kh_cu'); // key cũ array format
              lsRemove('zalo_orders_kh_moi');
              lsSet(LS_ZALO_ORDERS, orderJson); savedOK = true;
            } catch(e2) {
              alert('⚠️ Không lưu được dữ liệu vào bộ nhớ trình duyệt (localStorage đầy).\nSau khi F5 sẽ cần tải lại file.\nHãy thử xóa cache trình duyệt hoặc dùng tab ẩn danh.');
            }
          }
          lsSet(LS_ZALO_SP_MAP, JSON.stringify(_zaloSpMap));

          _zaloHist.unshift({type:'order', file:fname, at:new Date().toLocaleString('vi'), added:addedCount, skip:totalInFile-addedCount, total:Object.keys(_zaloOrders).length});
          lsSet(LS_ZALO_HIST, JSON.stringify(_zaloHist));

          renderZaloSummary(); renderZaloDoiSoat(); renderZaloCtMap(); renderZaloHist();
          alert(`✅ OrderDetails: +${addedCount} đơn mới · Bỏ qua ${totalInFile-addedCount} trùng${excludedByStatus?' · Bỏ qua '+excludedByStatus+' dòng thiếu Ngày đặt hàng':''}\nTổng tích lũy: ${Object.keys(_zaloOrders).length} đơn`);
        } catch(err) { alert('Lỗi đọc file OrderDetails: ' + err.message); }
      };
      reader.readAsArrayBuffer(inp.files[0]);
      inp.value='';
    }

    function handleZaloFeeFile(inp) {
      if (!inp.files[0]) return;
      const fname = inp.files[0].name;
      const reader = new FileReader();
      reader.onload = e => {
        try {
          const wb = XLSX.read(new Uint8Array(e.target.result), {type:'array'});
          // Tìm đúng sheet có data (không phải sheet CONFIG) — scan sheet nào có 'STT' ở cột đầu
          let ws = null;
          for(const sn of wb.SheetNames){
            const s = wb.Sheets[sn];
            const test = XLSX.utils.sheet_to_json(s,{header:1,defval:'',sheetRows:5,raw:true});
            if(test.some(r=>String(r[0]||'').trim()==='STT')){ws=s;break;}
          }
          if(!ws) ws = wb.Sheets[wb.SheetNames[0]]; // fallback
          const rows = XLSX.utils.sheet_to_json(ws, {header:1, defval:'', raw:true});
          const toNum = v => { if(typeof v==='number') return v; return parseFloat(String(v||'').replace(/[^0-9.-]/g,'')) || 0; };
          const HDR=2;
          // Chi Nhan, 2026-09-12: Luyen tai 1 file BaoCaoPhi moi (VNPay
          // Offline: GHOST BRIDE MEGA DN/FARM AEON MALL HUE/GHOST VC TIMES
          // CITY), ket qua "+0 GD moi" ca 2 ben Zalo lan VNPay -- goc re: cong
          // ty phat hanh BaoCaoPhi vua THEM 1 COT MOI "Lọc ngày" ngay sau STT
          // (thay doi dinh dang file, khong bao truoc), day TOAN BO cac cot
          // sau do LECH DI 1 VI TRI so voi cac chi so HARDCODE cu (vd cot
          // "Số tiền trước KM" tu vi tri 21 doi thanh 22) -- khien iGross cu
          // tro nham vao cot "Kênh thanh toán KTS" (chu, khong phai so) nen
          // rawDataRows loc ra RONG (typeof number that bai voi MOI dong),
          // im lang bao "+0 GD moi" thay vi bao loi ro rang. Fix TAN GOC: do
          // vi tri cot BANG TEN header (indexOf) thay vi hardcode so, tu dong
          // thich nghi neu cong ty phat hanh doi thu tu/them cot lan nua --
          // fallback ve so hardcode cu neu khong tim thay ten (file rat cu).
          const hdr = rows[HDR] || [];
          const findCol = (name, fallbackIdx) => { const i = hdr.indexOf(name); return i >= 0 ? i : fallbackIdx; };
          const iTime      = findCol('Thời gian GD', 1);
          const iMaGD      = findCol('Mã giao dịch', 2);
          const iMaDiem    = findCol('Mã điểm thu', 4);
          const iDienThu   = findCol('Điểm thu', 5);
          const iMaDonZalo = findCol('Mã đơn hàng', 8);
          const iGross     = findCol('Số tiền trước KM', 21);
          const iPhi       = findCol('Số tiền phí thu hộ', 26);
          const iGhiChu    = findCol('Ghi chú', 44);
          const iTrangThai = findCol('Trạng thái', 42);
          // Validate: nếu cột Gross của row đầu tiên không phải số → báo lỗi debug
          const sample = rows[HDR+1];
          console.log('[BaoCaoPhi] cols=',{iTime,iMaGD,iMaDiem,iDienThu,iMaDonZalo,iGross,iPhi,iGhiChu,iTrangThai},'row0=',rows[0]?.[0],'hdr2=',rows[HDR]?.[0],rows[HDR]?.[1],'sampleGross=',sample?.[iGross],'sampleTime=',sample?.[iTime]);
          if(sample && typeof sample[iGross] !== 'number')
            console.warn('[BaoCaoPhi] WARN: gross col',iGross,'=',sample[iGross],'(not number!) — hdr:',hdr);

          // Chi Nhan, 2026-09-10: Luyen nghi cac dong "chua xac dinh gian"
          // co the do lot giao dich CHUA THANH CONG (vd "Het han thanh toan",
          // "Khong thanh cong") -- cot Trang thai (AQ, iTrangThai=42) da duoc
          // loc dung == 'Thanh cong' tu truoc, chi them log de de kiem tra.
          //
          // Luyen, 2026-09-11: đã thử bỏ lọc Trạng thái (nghĩ 3 dòng VNPAY
          // "Không thành công" cộng đúng 510.000đ trùng khoản lệch ngày
          // 08-09-2026) NHƯNG Luyen xác nhận ngân hàng KHÔNG hề trả khoản
          // 510k đó về -- lọc "Thành công" là ĐÚNG, trùng hợp số liệu chỉ là
          // ngẫu nhiên. Revert lại đúng như cũ: chỉ tính dòng Trạng thái ==
          // "Thành công". Khoản lệch 510k ngày đó do nguyên nhân khác, cần
          // điều tra riêng (không phải do lọc Trạng thái).
          const rawDataRows = rows.slice(HDR+1).filter(r => typeof r[iGross]==='number' && r[iGross]>0);
          const excludedByStatus = rawDataRows.filter(r => String(r[iTrangThai]||'').trim()!=='Thành công').length;
          if (excludedByStatus) console.log('[BaoCaoPhi] Bo qua', excludedByStatus, 'dong khac "Thành công" (vd Het han/Khong thanh cong).');
          const newRows = rawDataRows
            .filter(r => String(r[iTrangThai]||'').trim()==='Thành công')
            .map(r => {
              // Chi Nhan, 2026-09-10: cot "Thoi gian GD" (iTime) thuong la
              // chuoi "07/09/2026 10:23:00" nhung 1 so dong (tuy file/tuy
              // dinh dang cell Excel) lai bi doc thanh SO SERIAL THO cua Excel
              // (vd 46235.00011574074) thay vi chuoi da format -- neu khong
              // xu ly rieng, .split('/') tren so nay se KHONG ra du 3 phan,
              // khien "date" giu nguyen chuoi so do va bang doi soat hien
              // dong "46235.00011574074/undefined/undefined" (Luyen bao loi
              // nay). Fix: neu r[iTime] la number thi doi qua DD-MM-YYYY
              // bang excelSerialToDateStr() truoc, khong dua qua split('/').
              let date;
              if (typeof r[iTime] === 'number') {
                date = excelSerialToDateStr(r[iTime]);
              } else {
                const tg = String(r[iTime]||'').split(' ')[0]; // "07/09/2026"
                const parts = tg.split('/');
                date = parts.length===3 ? `${parts[0]}-${parts[1]}-${parts[2]}` : tg;
              }
              const gc = String(r[iGhiChu]||'');
              const mFunzone = gc.match(/don hang\s+(\d+)/i);
              const gross = r[iGross];
              const phi   = toNum(r[iPhi]);
              return {
                date,
                maFunzone: mFunzone ? mFunzone[1] : '',
                maDonZalo: String(r[iMaDonZalo]||'').trim(),
                // Chi Nhan, 2026-09-10: cac gian moi (Ghost/Farm Mega DN, Farm
                // Aeon Hue...) khong dung Zalo Mini App nen cot "Ma don hang"
                // (I) luon RONG -> truoc day dedup chi dua vao maDonZalo nen
                // cac dong nay KHONG THE dedup, moi lan up lai file la cong
                // don lap. Fix: dung them "Ma giao dich" (C, iMaGD=2) — cot
                // nay do he thong thanh toan sinh ra, LUON DUY NHAT cho MOI
                // dong bat ke gian nao — lam key du phong khi maDonZalo rong.
                maGD: String(r[iMaGD]||'').trim(),
                maDiem: String(r[iMaDiem]||'').trim(),
                dienThu: String(r[iDienThu]||'').trim(),
                gross,
                phi,
                net: gross - phi,
              };
            });

          // Luyen, 2026-09-10: "vnpay nó chia ra theo điểm... ngoại trừ điểm
          // thu FUNZONE MINI APP còn lại mỗi điểm thu là 1 gian" -- CÙNG 1
          // file BaoCaoPhi này giờ nuôi 2 tab độc lập: điểm thu FUNZONE MINI
          // APP (Zalo Mini App, đã map qua OrderDetails/Sku) → _zaloFee như
          // cũ; MỌI điểm thu khác (QR-Offline, không có app riêng) → tab
          // VNPay (_vnpayFee), mỗi Điểm thu = 1 gian trực tiếp.
          const isFunzoneRow = r => r.maDiem==='FUNZONE1' || (r.dienThu||'').toUpperCase().includes('FUNZONE');
          const zaloRows  = newRows.filter(isFunzoneRow);
          const vnpayRows = newRows.filter(r=>!isFunzoneRow(r));

          // MERGE + DEDUP theo maDonZalo, fallback sang maGD nếu maDonZalo rỗng
          // (gian không có app Zalo Mini App) — cộng dồn, không replace.
          const dedupKey = r => r.maDonZalo || r.maGD;
          const exFeeKeys = new Set(_zaloFee.map(r=>dedupKey(r)).filter(Boolean));
          const addedFee = zaloRows.filter(r=>dedupKey(r) && !exFeeKeys.has(dedupKey(r)));
          _zaloFee = [..._zaloFee, ...addedFee];
          try { lsSet(LS_ZALO_FEE, JSON.stringify(_zaloFee)); } catch(e) {
            // Nếu đầy localStorage, lưu 3000 GD gần nhất
            _zaloFee = _zaloFee.slice(-3000);
            try { lsSet(LS_ZALO_FEE, JSON.stringify(_zaloFee)); } catch(e2){}
          }

          const exVnpayKeys = new Set(_vnpayFee.map(r=>dedupKey(r)).filter(Boolean));
          const addedVnpay = vnpayRows.filter(r=>dedupKey(r) && !exVnpayKeys.has(dedupKey(r)));
          _vnpayFee = [..._vnpayFee, ...addedVnpay];
          try { lsSet(LS_VNPAY_FEE, JSON.stringify(_vnpayFee)); } catch(e) {
            _vnpayFee = _vnpayFee.slice(-3000);
            try { lsSet(LS_VNPAY_FEE, JSON.stringify(_vnpayFee)); } catch(e2){}
          }

          // Auto-add Điểm thu vào SpMap để user có thể map mã CT (2 bảng riêng)
          zaloRows.forEach(r => {
            if(r.dienThu && !(_zaloSpMap[r.dienThu])) _zaloSpMap[r.dienThu]='';
          });
          lsSet(LS_ZALO_SP_MAP, JSON.stringify(_zaloSpMap));
          vnpayRows.forEach(r => {
            if(r.dienThu && _vnpaySpMap[r.dienThu]===undefined) _vnpaySpMap[r.dienThu]='';
          });
          lsSet(LS_VNPAY_SP_MAP, JSON.stringify(_vnpaySpMap));

          _zaloHist.unshift({type:'fee', file:fname, at:new Date().toLocaleString('vi'), added:zaloRows.length, skip:0});
          lsSet(LS_ZALO_HIST, JSON.stringify(_zaloHist));
          _vnpayHist.unshift({type:'fee', file:fname, at:new Date().toLocaleString('vi'), added:vnpayRows.length, skip:0});
          lsSet(LS_VNPAY_HIST, JSON.stringify(_vnpayHist));

          renderZaloSummary(); renderZaloDoiSoat(); renderZaloHist();
          renderVnpaySummary(); renderVnpayDoiSoat(); renderVnpayHist(); renderVnpayCtMap();
          fetchBankZalo(); fetchBankVnpay();
          alert(`✅ BaoCaoPhi: Zalo Pay +${addedFee.length} GD mới (bỏ ${zaloRows.length-addedFee.length} trùng) · VNPay +${addedVnpay.length} GD mới (bỏ ${vnpayRows.length-addedVnpay.length} trùng)\nTổng: Zalo ${_zaloFee.length} GD · VNPay ${_vnpayFee.length} GD`);
        } catch(err) { alert('Lỗi đọc file BaoCaoPhi: ' + err.message); }
      };
      reader.readAsArrayBuffer(inp.files[0]);
      inp.value='';
    }

    // Chi Nhan, 2026-09-10: file "Báo cáo giao dịch bán hàng Payoo" -- cấu
    // trúc CỐ ĐỊNH đã xác minh: sheet duy nhất "Báo cáo", header ở row index
    // 8 (data từ row 9). B(1)=Cửa hàng, C(2)=Ngày giao dịch (Excel serial có
    // giờ), G(6)=Hình thức thanh toán ("Quét mã QR"|"Thẻ"), N(13)=Số hóa đơn
    // (unique cho dòng QR), O(14)=Mã chuẩn chi (unique cho dòng Thẻ),
    // V(21)=Số tiền thanh toán (gross), W(22)=Phí xử lý GD, X(23)=Thành tiền
    // (net), AE(30)=Mã cửa hàng. File tự thân đã chỉ chứa GD thành công
    // (không có cột trạng thái, không cần lọc như BaoCaoPhi).
    function handlePayooFile(inp) {
      if (!inp.files[0]) return;
      const fname = inp.files[0].name;
      const reader = new FileReader();
      reader.onload = e => {
        try {
          const wb = XLSX.read(new Uint8Array(e.target.result), {type:'array'});
          const ws = wb.Sheets[wb.SheetNames[0]];
          const rows = XLSX.utils.sheet_to_json(ws, {header:1, defval:'', raw:true});
          const toNum = v => { if(typeof v==='number') return v; return parseFloat(String(v||'').replace(/[^0-9.-]/g,'')) || 0; };
          const HDR=8, iCuaHang=1, iNgay=2, iHinhThuc=6, iSoHD=13, iMaChuanChi=14, iGross=21, iPhi=22, iNet=23, iMaCuaHang=30;
          const rawDataRows = rows.slice(HDR+1).filter(r => typeof r[iGross]==='number' && r[iGross]>0);
          if (!rawDataRows.length) { alert('Không đọc được dòng dữ liệu nào — kiểm tra lại có đúng file "Giao dịch bán hàng Payoo" không.'); return; }
          const newRows = rawDataRows.map(r => {
            const ht = String(r[iHinhThuc]||'').trim();
            const isThe = ht === 'Thẻ';
            const loai = isThe ? 'THE' : 'QR';
            const cuaHang = String(r[iCuaHang]||'').trim();
            const gian = cuaHang + ' - ' + (isThe ? 'Thẻ' : 'QR');
            let date;
            const rawD = r[iNgay];
            if (typeof rawD === 'number') { date = excelSerialToDateStr(rawD); }
            else { const tg = String(rawD||'').split(' ')[0]; const p = tg.split('/'); date = p.length===3 ? `${p[0]}-${p[1]}-${p[2]}` : tg; }
            // Dedup: dòng QR dùng "Số hóa đơn" (unique/QR), dòng Thẻ dùng "Mã
            // chuẩn chi" (unique/Thẻ) -- "Số hóa đơn" LẶP LẠI ở dòng Thẻ nên
            // không dùng được cho loại này.
            const idKey = isThe ? String(r[iMaChuanChi]||'').trim() : String(r[iSoHD]||'').trim();
            return {
              date, gian, loai,
              maCuaHang: String(r[iMaCuaHang]||'').trim(),
              dedupKey: idKey ? (loai+'_'+idKey) : '',
              gross: r[iGross],
              phi: toNum(r[iPhi]),
              net: toNum(r[iNet]),
            };
          });
          const exKeys = new Set(_payooFee.map(r=>r.dedupKey).filter(Boolean));
          const added = newRows.filter(r=>r.dedupKey && !exKeys.has(r.dedupKey));
          _payooFee = [..._payooFee, ...added];
          try { lsSet(LS_PAYOO_FEE, JSON.stringify(_payooFee)); } catch(e) {
            _payooFee = _payooFee.slice(-6000);
            try { lsSet(LS_PAYOO_FEE, JSON.stringify(_payooFee)); } catch(e2){}
          }
          added.forEach(r => { if(r.gian && _payooSpMap[r.gian]===undefined) _payooSpMap[r.gian]=''; });
          lsSet(LS_PAYOO_SP_MAP, JSON.stringify(_payooSpMap));
          _payooHist.unshift({type:'fee', file:fname, at:new Date().toLocaleString('vi'), added:added.length, skip:newRows.length-added.length});
          lsSet(LS_PAYOO_HIST, JSON.stringify(_payooHist));
          renderPayooSummary(); renderPayooDoiSoat(); renderPayooHist(); renderPayooCtMap();
          fetchBankPayoo();
          alert(`✅ Payoo: +${added.length} GD mới (bỏ ${newRows.length-added.length} trùng)\nTổng: ${_payooFee.length} GD`);
        } catch(err) { alert('Lỗi đọc file Payoo: ' + err.message); }
      };
      reader.readAsArrayBuffer(inp.files[0]);
      inp.value='';
    }

    function renderZaloSummary() {
      const el = document.getElementById('zalo_summary');
      if(!el) return;
      const n = Object.keys(_zaloOrders).length;
      if(!n) { el.textContent = ''; return; }
      // Kiểm tra localStorage có thực sự lưu được không
      const stored = localStorage.getItem(LS_ZALO_ORDERS);
      const storedN = stored ? Object.keys(JSON.parse(stored)||{}).length : 0;
      const saved = storedN === n;
      el.innerHTML = `${n} đơn <span style="font-size:.75em;color:${saved?'#86efac':'#fca5a5'}" title="${saved?'Đã lưu vào bộ nhớ trình duyệt':'⚠️ Chưa lưu được — F5 sẽ mất dữ liệu!'}">${saved?'💾':'⚠️ chưa lưu'}</span>`;
    }

    function getZaloMaCT(tenSP, sku) {
      // 0. Exact map theo Sku (mã sản phẩm cố định, không đổi theo khuyến mãi
      // như tên sản phẩm) -- ưu tiên cao nhất nếu có.
      if(sku){ const bySku = (_zaloSpMap[sku]||'').trim(); if(bySku) return bySku; }
      // 1. Exact map (user-configured)
      const exact = (_zaloSpMap[tenSP]||'').trim();
      if(exact) return exact;
      // 2. Partial match in user map (key is substring of tenSP)
      for(const [k,v] of Object.entries(_zaloSpMap)){
        if(k && v && tenSP.toUpperCase().includes(k.toUpperCase())) return v.trim();
      }
      // 3. Keyword fallback for Điểm thu values from BaoCaoPhi
      const up = tenSP.toUpperCase();
      const KW = [
        ['GHOST','GHOST'],['SNOW','SNOW'],['TUTU','TUTU'],
        ['FARM AEON','FARM AEON HUE'],['FARM MEGA','FARM MEGA DN'],
        ['FARM','FARM'],['FUNZONE','FUNZONE'],
        ['LOTTE','LOTTE'],['AEON','AEON'],['GO!','GO'],
        ['BIG C','BIGC'],['COOPMART','COOP'],['MM MEGA','MM'],
        ['VINCOM','VINCOM'],['SENSE','SENSE'],
      ];
      for(const [kw,ct] of KW){ if(up.includes(kw)) return ct; }
      return null;
    }

    function populateZaloMonthFilter() {
      const sel = document.getElementById('zaloFilterMonth');
      if(!sel) return;
      const months = [...new Set(_zaloFee.map(r => {
        const p = r.date ? r.date.split('-') : [];
        return p.length===3 ? p[1]+'/'+p[2] : '';
      }).filter(Boolean))].sort().reverse();
      const cur = sel.value;
      sel.innerHTML = '<option value="">-- Tất cả --</option>'
        + months.map(m=>`<option value="${m}"${m===cur?' selected':''}>${m}</option>`).join('');
    }

    function renderZaloDoiSoat() {
      const el = document.getElementById('zaloDoiSoatBody');
      if(!el) return;
      if(!Object.keys(_zaloOrders).length && !_zaloFee.length) {
        el.innerHTML='<div class="empty-state"><div class="big-icon">🔵</div><p>Tải OrderDetails + BaoCaoPhi để bắt đầu đối soát</p></div>';
        return;
      }
      const fmtN = n => Math.round(n).toLocaleString('vi');
      const iso  = d => { const p=d.split('-'); return p[2]+'-'+p[1]+'-'+p[0]; };
      const sortDate = (a,b) => iso(a).localeCompare(iso(b));
      const inRange = (d,f,t) => !f||!t ? false : iso(d)>=iso(f) && iso(d)<=iso(t);

      // Chi Nhan, 2026-09-10: cho phep Luyen "Sửa" tay Doanh thu/Net của 1
      // gian trong 1 ngày (giống bên Momo) khi số tự động lệch/sai -- lưu
      // đè vào _zaloHD[date+'|'+maCT].dtOvr / .netOvr, dùng hàm này ở MỌI
      // chỗ tính DT/Net (bảng ngày, tổng NH trả về, tổng theo gian) để nhất
      // quán, không chỉ hiện ở 1 chỗ.
      const getGianDisp = (date, maCT, d) => {
        const hd = _zaloHD[date+'|'+maCT] || {};
        const dt  = (hd.dtOvr  != null && hd.dtOvr  !== '') ? (parseFloat(String(hd.dtOvr).replace(/[^0-9.-]/g,''))||0)  : d.gross;
        const net = (hd.netOvr != null && hd.netOvr !== '') ? (parseFloat(String(hd.netOvr).replace(/[^0-9.-]/g,''))||0) : d.net;
        return { dt, net, phi: dt - net, hasDtOvr: hd.dtOvr!=null && hd.dtOvr!=='', hasNetOvr: hd.netOvr!=null && hd.netOvr!=='' };
      };
      const computeZaloDayNet = (date, byDateRef) => {
        const ctData = byDateRef[date]; if(!ctData) return 0;
        return Object.entries(ctData).reduce((s,[maCT,d]) => s + getGianDisp(date,maCT,d).net, 0);
      };

      if (_zaloFee.length) {
        populateZaloMonthFilter();
        const selMonth = (document.getElementById('zaloFilterMonth')||{}).value || '';

        // Build byDate from BaoCaoPhi (FUNZONE only)
        const byDate = {};
        let nFunzone=0, nOther=0, nNoMatch=0;
        _zaloFee.forEach(r => {
          const isFunzone = r.maDiem==='FUNZONE1' || (r.dienThu||'').toUpperCase().includes('FUNZONE');
          if(!isFunzone){ nOther++; return; }
          nFunzone++;
          const ordVal = r.maFunzone ? _zaloOrders[String(r.maFunzone)] : undefined;
          if(ordVal === undefined) nNoMatch++;
          const { tenSP: tenSP_lu, sku: skuLu } = unpackZaloOrder(ordVal);
          const maCT = ordVal !== undefined ? (getZaloMaCT(tenSP_lu, skuLu)||tenSP_lu||ordVal) : (_zaloUnk[r.date] || '_unknown_');
          if(!byDate[r.date]) byDate[r.date]={};
          if(!byDate[r.date][maCT]) byDate[r.date][maCT]={gross:0,phi:0,net:0,soDon:0};
          byDate[r.date][maCT].gross += r.gross;
          byDate[r.date][maCT].phi   += r.phi;
          byDate[r.date][maCT].net   += r.net;
          byDate[r.date][maCT].soDon += 1;
        });
        const allDates = Object.keys(byDate).sort(sortDate);
        const filteredDates = selMonth
          ? allDates.filter(d => { const p=d.split('-'); return p[1]+'/'+p[2]===selMonth; })
          : allDates;

        let totGross=0,totPhi=0,totNet=0,totN=0;
        filteredDates.forEach(dt=>Object.entries(byDate[dt]).forEach(([maCT,d])=>{const gDisp=getGianDisp(dt,maCT,d);totGross+=gDisp.dt;totPhi+=gDisp.phi;totNet+=gDisp.net;totN+=d.soDon;}));

        let html = '<div style="margin-bottom:.5rem;font-size:.82em;color:#64748b">';
        html += '\u{1F4CA} FUNZONE: <strong>'+nFunzone+'</strong> GD · '+filteredDates.length+' ngày';
        if(nNoMatch && Object.keys(_zaloOrders).length) html += ' · <span style="color:#f59e0b">Chưa khớp: '+nNoMatch+'</span>';
        if(!Object.keys(_zaloOrders).length) html += ' · <span style="color:#ef4444">Chưa tải OrderDetails!</span>';
        if(nOther) html += ' · <span style="color:#94a3b8">VNPay khác: '+nOther+'</span>';
        html += '</div>';

        // Luyen, 2026-09-10: "cái nào tải lên có sản phẩm mới á bạn hiện bên
        // kia nhá tôi sẽ map với hiện lên chính giữa cái đối soát theo ngày
        // luôn cho tôi cảnh báo có tên sản phẩm mới" -- ten SP/diem thu MOI
        // da duoc handleZaloOrderFile/handleZaloFeeFile tu dong them vao
        // _zaloSpMap (gia tri rong) de hien san trong man "Map Tên SP → CT",
        // o day them banner canh bao NOI BAT ngay dau Doi soat ngay, bam vao
        // nhay thang sang man Map.
        const unmappedSp = Object.entries(_zaloSpMap).filter(([k,v]) => !v);
        if (unmappedSp.length) {
          html += '<div style="background:#fef3c7;border:1px solid #f59e0b;border-radius:8px;padding:.6rem 1rem;margin-bottom:.6rem;font-size:.87em;color:#92400e;display:flex;justify-content:space-between;align-items:center;gap:.6rem;flex-wrap:wrap">'
            +'<span>⚠️ Có <strong>'+unmappedSp.length+'</strong> tên sản phẩm / điểm thu <strong>MỚI</strong> chưa map mã CT (vd: '+unmappedSp.slice(0,3).map(([k])=>k).join(', ')+(unmappedSp.length>3?'...':'')+') — các giao dịch này sẽ hiện tên gốc thay vì đúng gian cho tới khi map.</span>'
            +'<button onclick="switchZaloSub(\'map\')" style="background:#f59e0b;color:#fff;border:none;border-radius:6px;padding:.3rem .8rem;font-weight:700;cursor:pointer;white-space:nowrap">🗺️ Map ngay</button>'
            +'</div>';
        }

        // Luyen, 2026-09-10: "ngày 5 với ngày 6 xuất chung 1 cái cộng 1 cái
        // trừ, cấn trừ qua đi, cùng 1 mã đơn vị (Số HĐ)" -- hóa đơn 3350 gộp
        // 2 ngày cho VC TC DIY KVCN, autoMapMttZalo chia tỷ lệ theo DT từng
        // ngày nhưng không khớp CHÍNH XÁC thực tế (05/09 dư -229k, 06/09 dư
        // +229k dù TỔNG 2 ngày khớp hóa đơn tuyệt đối). Gom theo (maCT|Số HĐ)
        // qua MỌI ngày (không chỉ ngày đang lọc) -- nếu tổng DT các ngày
        // trong nhóm khớp tổng Tiền HĐ (lệch <1.000đ) thì cấn trừ, hiện
        // Chênh = 0đ cho TỪNG ngày trong nhóm thay vì để mỗi ngày lệch dương
        // âm riêng lẻ do chia tỷ lệ không tròn.
        const invoiceGroups = {}; // "maCT|soHD" -> {dt, tienHD, dates:[]}
        allDates.forEach(dt => {
          const ctData0 = byDate[dt]; if(!ctData0) return;
          Object.keys(ctData0).forEach(maCT => {
            const hd = _zaloHD[dt+'|'+maCT] || {};
            const soHD = (hd.soHD||'').trim();
            if(!soHD) return;
            const gDisp0 = getGianDisp(dt, maCT, ctData0[maCT]);
            const tienHD0 = parseFloat((hd.tienHD||'0').toString().replace(/[^0-9.-]/g,''))||0;
            const key = maCT+'|'+soHD;
            if(!invoiceGroups[key]) invoiceGroups[key] = {dt:0, tienHDs:[], dates:[]};
            invoiceGroups[key].dt += gDisp0.dt;
            invoiceGroups[key].tienHDs.push(tienHD0);
            invoiceGroups[key].dates.push(dt);
          });
        });
        // Luyen, 2026-09-10: "nếu xuất hóa đơn này cộng trừ cấn trừ qua lại
        // đi cho nó hết [lệch]" -- Luyen thường nhập NGUYÊN số tiền hóa đơn
        // gộp trên MỌI ngày nó che phủ (không tự chia), nên CỘNG DỒN tienHD
        // qua các ngày (như code cũ) sẽ tính ra gấp đôi/gấp ba số thật, khiến
        // "cấn trừ" không bao giờ khớp. Nếu mọi ngày trong nhóm ghi CÙNG 1 số
        // tiền (không tự chia) thì tổng = đúng số đó (không cộng dồn); chỉ
        // cộng dồn khi các ngày có số tiền KHÁC nhau (đã tự chia theo tỷ lệ,
        // như nút "Map MTT" tự làm).
        Object.values(invoiceGroups).forEach(g => {
          const uniq = [...new Set(g.tienHDs.filter(v=>v>0))];
          g.tienHD = uniq.length <= 1 ? (uniq[0]||0) : g.tienHDs.reduce((s,v)=>s+v,0);
        });

        // Helper: render one date block
        const renderDateBlock = date => {
          const ctData = byDate[date];
          if(!ctData) return '';
          const ctKeys = Object.keys(ctData).sort((a,b)=>{if(a==='_unknown_')return 1;if(b==='_unknown_')return -1;return a.localeCompare(b);});
          const disps = {}; // maCT -> {dt,net,phi,hasDtOvr,hasNetOvr}
          ctKeys.forEach(maCT => { disps[maCT] = getGianDisp(date, maCT, ctData[maCT]); });
          const dayGross=ctKeys.reduce((s,g)=>s+disps[g].dt,0);
          const dayNet=ctKeys.reduce((s,g)=>s+disps[g].net,0);
          const dayN=Object.values(ctData).reduce((s,d)=>s+d.soDon,0);
          const [dd,mm,yyyy]=date.split('-');
          const dateId = date.replace(/-/g,'_');
          let out = '<div style="margin-bottom:.8rem">'
            +'<div style="background:#1e3a5f;color:#fff;padding:.4rem .75rem;font-weight:700;font-size:.87em;display:flex;justify-content:space-between;cursor:pointer" onclick="toggleZaloEditPanel(\''+dateId+'\')">'
            +'<span>\u{1F4C5} '+dd+'/'+mm+'/'+yyyy+'</span>'
            +'<span style="font-size:.81em;font-weight:400;color:#93c5fd">'+dayN+' GD · DT: '+fmtN(dayGross)+'đ · Net: '+fmtN(dayNet)+'đ &nbsp;<span style="opacity:.8">✏️ Sửa</span></span>'
            +'</div>'
            +'<table style="width:100%;border-collapse:collapse;font-size:.84em">'
            +'<thead><tr style="background:#2d4a6e;color:#e2e8f0">'
            +'<th style="padding:.3rem .6rem;text-align:left">Mã CT (Gian)</th>'
            +'<th style="text-align:right;padding:.3rem .4rem">Số GD</th>'
            +'<th style="text-align:right;padding:.3rem .4rem">DT trước KM</th>'
            +'<th style="text-align:right;padding:.3rem .4rem">Phí GW</th>'
            +'<th style="text-align:right;padding:.3rem .4rem">Net GW</th>'
            +'<th style="text-align:center;padding:.3rem .4rem">Số HĐ</th>'
            +'<th style="text-align:right;padding:.3rem .4rem">Tiền HĐ</th>'
            +'<th style="text-align:right;padding:.3rem .4rem">Chênh</th>'
            +'</tr></thead><tbody>';
          ctKeys.forEach((maCT,i) => {
            const d = ctData[maCT];
            const gDisp = disps[maCT];
            const isUnknown = maCT==='_unknown_';
            const ctLabel = isUnknown ? '<span style="color:#94a3b8;font-style:italic">Chưa xác định gian</span>' : '<span class="ct-badge">'+maCT+'</span>';
            const hdKey = date+'|'+maCT;
            const hd = _zaloHD[hdKey] || {};
            const tienHD = parseFloat((hd.tienHD||'0').toString().replace(/[^0-9.-]/g,''))||0;
            // Luyen, 2026-09-10: "hóa đơn check với gian là check tiền
            // trước khuyến mãi" -- hóa đơn xuất theo DT TRƯỚC KM (gDisp.dt),
            // không phải Net GW (đã trừ phí GW) -- so sánh với Net trước đây
            // khiến MỌI dòng đều lệch đúng bằng đúng số phí GW, tưởng là
            // chênh thật nhưng không phải.
            //
            // Luyen, 2026-09-10 (thêm): hóa đơn xuất chung nhiều ngày (vd
            // ngày 5+6 cùng Số HĐ 3350) -- nếu TỔNG các ngày trong nhóm khớp
            // tổng Tiền HĐ (lệch <1.000đ) thì cấn trừ, hiện Chênh=0 cho từng
            // ngày thay vì để mỗi ngày lệch dương/âm riêng do chia tỷ lệ
            // không tròn số.
            const soHDNow = (hd.soHD||'').trim();
            const grp = soHDNow ? invoiceGroups[maCT+'|'+soHDNow] : null;
            // Luyen, 2026-09-10: hóa đơn gộp nhiều ngày (vd "3271, 3272" cùng
            // 1 tổng tiền ghi trên MỌI ngày nó che phủ) -- chia đều phần tiền
            // hóa đơn theo TỶ LỆ DT từng ngày trong nhóm rồi mới so, thay vì
            // so mỗi ngày với TOÀN BỘ số tiền hóa đơn (tính trùng, ra số vô
            // nghĩa dương/âm ngược nhau). Tự động cấn về ~0 khi tổng khớp,
            // và hiện đúng phần lệch thật (chia đều) khi tổng KHÔNG khớp.
            const chenh = (grp && grp.dates.length > 1 && grp.tienHD)
              ? (gDisp.dt - grp.tienHD * (grp.dt > 0 ? (gDisp.dt / grp.dt) : (1 / grp.dates.length)))
              : (tienHD ? (gDisp.dt - tienHD) : null);
            const chenhColor = chenh===null?'#94a3b8':(Math.abs(chenh)<1000?'#16a34a':(chenh<0?'#ef4444':'#d97706'));
            const chenhTxt = chenh===null?'—':((chenh>0?'+':'')+fmtN(chenh));
            const bg = i%2===0?'#f8fafc':'#fff';
            const escKey = hdKey.replace(/'/g,"\\'");
            const soHDDisplay = hd.soHD
              ? '<span style="font-size:.8em;cursor:pointer" onclick="zHDEdit(this,\''+escKey+'\',\'soHD\')">'+hd.soHD+' ✏️</span>'
              : '<span style="color:#94a3b8;font-size:.75em;cursor:pointer" onclick="zHDEdit(this,\''+escKey+'\',\'soHD\')">…</span>';
            const tienHDDisplay = hd.tienHD
              ? '<span style="font-size:.8em;cursor:pointer;color:#15803d" onclick="zHDEdit(this,\''+escKey+'\',\'tienHD\')">'+hd.tienHD+' ✏️</span>'
              : '<span style="color:#94a3b8;font-size:.75em;cursor:pointer" onclick="zHDEdit(this,\''+escKey+'\',\'tienHD\')">…</span>';
            // Luyen, 2026-09-10: "chưa xác định thêm có thể xóa với nếu tôi
            // thêm mã công trình thì map vào công trình đó luôn nếu có ở
            // trên còn không thì hiện dưới" -- Map đã tự gộp vào gian có sẵn
            // nếu trùng mã CT (nhóm theo đúng string key), thêm nút Xóa để
            // bỏ hẳn các GD "chưa xác định gian" của ngày này khi không map
            // được (vd giao dịch rác/lỗi).
            // Luyen, 2026-09-10: "cho tôi nhấn vô 1 cái khung coi ngày chưa
            // xác định là đơn nào, trạng thái/tiền phí mà chưa có á" -- thêm
            // nút "Xem chi tiết" mở khung liệt kê từng GD chưa xác định gian
            // của ngày này (mã đơn Zalo, mã đơn Funzone, điểm thu, DT, phí,
            // và LÝ DO cụ thể vì sao chưa xác định được).
            const unkInput = isUnknown
              ? '<div style="margin-top:.2rem"><input placeholder="Mã CT..." id="unkCT_'+date.replace(/-/g,'')+'"'
                +' style="width:110px;border:1px solid #f59e0b;border-radius:4px;padding:.12rem .3rem;font-size:.74em"'
                +' onkeydown="if(event.key===\'Enter\'){saveZaloUnkCT(\''+date+'\',this.value)}"'
                +'>&nbsp;<button style="font-size:.71em;padding:.1rem .3rem;background:#f59e0b;color:#fff;border:none;border-radius:3px;cursor:pointer"'
                +' onclick="saveZaloUnkCT(\''+date+'\',document.getElementById(\'unkCT_'+date.replace(/-/g,'')+'\').value)">Map</button>'
                +'&nbsp;<button style="font-size:.71em;padding:.1rem .3rem;background:#dc2626;color:#fff;border:none;border-radius:3px;cursor:pointer"'
                +' onclick="deleteZaloUnkGroup(\''+date+'\')">🗑 Xóa</button>'
                +'&nbsp;<button style="font-size:.71em;padding:.1rem .3rem;background:#0891b2;color:#fff;border:none;border-radius:3px;cursor:pointer"'
                +' onclick="toggleZaloUnkDetail(\''+date+'\')">👁 Xem chi tiết</button>'
                +'<div id="unkDetail_'+date.replace(/-/g,'')+'" style="display:none"></div></div>'
              : '';
            out += '<tr style="background:'+bg+'">'
              +'<td style="padding:.3rem .6rem">'+ctLabel+unkInput+'</td>'
              +'<td style="text-align:right;padding:.3rem .4rem;color:#64748b">'+d.soDon+'</td>'
              +'<td style="text-align:right;padding:.3rem .4rem;color:#15803d;font-weight:600">'+fmtN(gDisp.dt)+(gDisp.hasDtOvr?'<sup style="color:#f59e0b;font-size:.7em">✏</sup>':'')+'</td>'
              +'<td style="text-align:right;padding:.3rem .4rem;color:#ef4444">'+fmtN(gDisp.phi)+'</td>'
              +'<td style="text-align:right;padding:.3rem .4rem;color:#2563eb;font-weight:700">'+fmtN(gDisp.net)+(gDisp.hasNetOvr?'<sup style="color:#f59e0b;font-size:.7em">✏</sup>':'')+'</td>'
              +'<td style="padding:.3rem .3rem;text-align:center">'+soHDDisplay+'</td>'
              +'<td style="padding:.3rem .3rem;text-align:right">'+tienHDDisplay+'</td>'
              +'<td style="text-align:right;padding:.3rem .4rem;font-weight:700;color:'+chenhColor+'">'+chenhTxt+'</td>'
              +'</tr>';
          });
          out += '</tbody></table>';
          // Bảng chỉnh sửa (ẩn mặc định, toggle khi bấm vào tiêu đề ngày) --
          // giống panel "✏️ Sửa" bên Momo: cho sửa Doanh thu / Net trực tiếp.
          out += '<div id="edit_zalo_'+dateId+'" style="display:none;padding:.6rem .75rem;background:#f8fafc;border:1px dashed #3b82f6;border-top:none">'
            +'<div style="font-size:.8em;font-weight:700;color:#1e3a5f;margin-bottom:.4rem">✏️ Chỉnh sửa – '+dd+'/'+mm+'/'+yyyy+'</div>'
            +'<div style="overflow-x:auto"><table style="min-width:640px;border-collapse:collapse;font-size:.8em">'
            +'<thead><tr style="background:#e0e7ff;color:#1e3a5f">'
            +'<th style="padding:.25rem .5rem;text-align:left;border:1px solid #c7d2fe">Mã CT / Gian</th>'
            +'<th style="padding:.25rem .5rem;text-align:right;border:1px solid #c7d2fe">DT (sửa được)</th>'
            +'<th style="padding:.25rem .5rem;text-align:right;border:1px solid #c7d2fe">Net (sửa được)</th>'
            +'<th style="padding:.25rem .5rem;border:1px solid #c7d2fe">Số HĐ</th>'
            +'<th style="padding:.25rem .5rem;text-align:right;border:1px solid #c7d2fe">Tiền HĐ</th>'
            +'</tr></thead><tbody>'
            +ctKeys.map(maCT => {
              const d = ctData[maCT];
              const gDisp = disps[maCT];
              const hd = _zaloHD[date+'|'+maCT] || {};
              const gKey = maCT.replace(/[^a-zA-Z0-9]/g,'_');
              return '<tr>'
                +'<td style="padding:.25rem .5rem;border:1px solid #e2e8f0;font-size:.9em">'+(maCT==='_unknown_'?'<i>Chưa xác định</i>':maCT)+'</td>'
                +'<td style="padding:.25rem .5rem;border:1px solid #e2e8f0;text-align:right">'
                  +'<input id="zedit_dt_'+dateId+'_'+gKey+'" type="text" value="'+gDisp.dt+'" style="width:105px;border:1px solid #bbf7d0;border-radius:4px;padding:.15rem .3rem;text-align:right;background:#f0fdf4;color:#15803d;font-weight:600"></td>'
                +'<td style="padding:.25rem .5rem;border:1px solid #e2e8f0;text-align:right">'
                  +'<input id="zedit_net_'+dateId+'_'+gKey+'" type="text" value="'+gDisp.net+'" style="width:105px;border:1px solid #bfdbfe;border-radius:4px;padding:.15rem .3rem;text-align:right;background:#eff6ff;color:#0d47a1;font-weight:700"></td>'
                +'<td style="padding:.25rem .5rem;border:1px solid #e2e8f0">'
                  +'<input id="zedit_soHD_'+dateId+'_'+gKey+'" type="text" value="'+(hd.soHD||'')+'" placeholder="0000123" style="width:100px;border:1px solid #cbd5e1;border-radius:4px;padding:.15rem .3rem"></td>'
                +'<td style="padding:.25rem .5rem;border:1px solid #e2e8f0;text-align:right">'
                  +'<input id="zedit_tienHD_'+dateId+'_'+gKey+'" type="text" value="'+(hd.tienHD||'')+'" placeholder="0" style="width:100px;border:1px solid #cbd5e1;border-radius:4px;padding:.15rem .3rem;text-align:right"></td>'
                +'</tr>';
            }).join('')
            +'</tbody></table></div>'
            +'<div style="margin-top:.5rem;display:flex;gap:.5rem">'
            +'<button onclick="saveZaloEditPanel(\''+dateId+'\',\''+date+'\',this)" data-gians=\''+JSON.stringify(ctKeys).replace(/'/g,'&#39;')+'\' style="background:#16a34a;color:#fff;border:none;border-radius:6px;padding:.3rem .8rem;font-weight:700;font-size:.8em;cursor:pointer">💾 Lưu</button>'
            +'<button onclick="toggleZaloEditPanel(\''+dateId+'\')" style="background:#6b7280;color:#fff;border:none;border-radius:6px;padding:.3rem .8rem;font-weight:600;font-size:.8em;cursor:pointer">✕ Đóng</button>'
            +'</div></div></div>';
          return out;
        };

        // GROUP BY NH PAYMENT (Momo style)
        const coveredDates = new Set();
        if(_bankZaloPayments.length) {
          _bankZaloPayments.forEach(pay => {
            const payAllDates = allDates.filter(d => inRange(d, pay.fromDate, pay.toDate));
            const payRenderDates = filteredDates.filter(d => inRange(d, pay.fromDate, pay.toDate));
            if(selMonth && payRenderDates.length===0){ payAllDates.forEach(d=>coveredDates.add(d)); return; }
            const zaloNet = payAllDates.reduce((s,d)=>s+computeZaloDayNet(d,byDate),0);
            const chenh = pay.amount - zaloNet;
            const chCol = Math.abs(chenh)<1000?'#86efac':(chenh<0?'#fca5a5':'#fcd34d');
            const chTxt = (chenh>=0?'+':'')+fmtN(chenh);
            html += '<div style="background:#1e4a6f;color:#e0f2fe;padding:.5rem .8rem;font-weight:700;font-size:.87em;border-top:2px solid #0ea5e9;border-radius:4px;margin-top:.5rem;display:flex;flex-wrap:wrap;gap:.6rem;align-items:center">'
              +'<span>💳 NH trả về <strong>'+pay.payDate+'</strong>:'
              +'<span style="background:#0369a1;padding:.05rem .45rem;border-radius:5px;margin-left:.4rem">'+fmtN(pay.amount)+'đ</span></span>'
              +(pay.fromDate?'<span style="font-weight:400;color:#bae6fd;font-size:.84em">ZaloPay '
                +pay.fromDate+(pay.toDate&&pay.toDate!==pay.fromDate?' → '+pay.toDate:'')+'</span>':'')
              +(payAllDates.length?'<span style="font-weight:400;color:#bae6fd;font-size:.84em">Net: '+fmtN(zaloNet)+'đ</span>':'')
              +(payAllDates.length?'<span style="color:'+chCol+';font-weight:900">'+(Math.abs(chenh)<1000?'✅':'⚠️')+' Chênh: '+chTxt+'đ</span>':'')
              +'</div>';
            payAllDates.forEach(d=>coveredDates.add(d));
            payRenderDates.forEach(d=>{ html += renderDateBlock(d); });
          });
        }

        // Dates not covered by any NH payment
        const unpaidDates = filteredDates.filter(d=>!coveredDates.has(d));
        if(unpaidDates.length) {
          if(_bankZaloPayments.length) {
            const unpaidNet = unpaidDates.reduce((s,d)=>s+computeZaloDayNet(d,byDate),0);
            html += '<div style="background:#78350f;color:#fef3c7;padding:.5rem .8rem;font-weight:700;font-size:.86em;border-top:2px solid #d97706;border-radius:4px;margin-top:.5rem">'
              +'⏳ Chưa có NH trả về &nbsp;·&nbsp; Tổng Net: '+fmtN(unpaidNet)+'đ</div>';
          }
          unpaidDates.forEach(d=>{ html += renderDateBlock(d); });
        }

        // Per-gian totals (across filteredDates)
        const byGian = {};
        filteredDates.forEach(dt => {
          Object.entries(byDate[dt]).forEach(([maCT,d]) => {
            const gDisp = getGianDisp(dt, maCT, d);
            if(!byGian[maCT]) byGian[maCT]={soDon:0,gross:0,phi:0,net:0};
            byGian[maCT].soDon+=d.soDon; byGian[maCT].gross+=gDisp.dt; byGian[maCT].phi+=gDisp.phi; byGian[maCT].net+=gDisp.net;
          });
        });
        const gianKeys = Object.keys(byGian).filter(k=>k!=='_unknown_').sort();
        if(byGian['_unknown_']) gianKeys.push('_unknown_');
        html += '<table style="width:100%;border-collapse:collapse;font-size:.85em;margin-top:.6rem"><tbody>'
          +'<tr style="background:#1e3a5f;color:#fff;font-weight:700">'
          +'<td style="padding:.5rem .75rem">TỔNG CỘNG ('+filteredDates.length+' ngày)</td>'
          +'<td style="text-align:right;padding:.5rem .5rem">'+totN+' GD</td>'
          +'<td style="text-align:right;padding:.5rem .5rem">'+fmtN(totGross)+'</td>'
          +'<td style="text-align:right;padding:.5rem .5rem">'+fmtN(totPhi)+'</td>'
          +'<td style="text-align:right;padding:.5rem .5rem">'+fmtN(totNet)+'</td>'
          +'<td colspan="3"></td></tr>';
        gianKeys.forEach((maCT,i) => {
          const g = byGian[maCT];
          const lbl = maCT==='_unknown_' ? '<span style="color:#94a3b8;font-style:italic">Chưa xác định</span>' : '<span class="ct-badge">'+maCT+'</span>';
          html += '<tr style="background:'+(i%2===0?'#f0f4f8':'#e8f0f8')+'">'
            +'<td style="padding:.3rem .75rem;padding-left:1.5rem">'+lbl+'</td>'
            +'<td style="text-align:right;padding:.3rem .5rem;color:#64748b">'+g.soDon+'</td>'
            +'<td style="text-align:right;padding:.3rem .5rem;color:#15803d;font-weight:600">'+fmtN(g.gross)+'</td>'
            +'<td style="text-align:right;padding:.3rem .5rem;color:#ef4444">'+fmtN(g.phi)+'</td>'
            +'<td style="text-align:right;padding:.3rem .5rem;color:#2563eb;font-weight:700">'+fmtN(g.net)+'</td>'
            +'<td colspan="3"></td></tr>';
        });
        html += '</tbody></table>';
        el.innerHTML = html;
      } else {
        // ── FALLBACK: chỉ có OrderDetails, chưa có BaoCaoPhi ──
        const ctCount = {};
        Object.entries(_zaloOrders).forEach(([maOrder, ordVal]) => {
          const { tenSP, sku } = unpackZaloOrder(ordVal);
          const maCT = getZaloMaCT(tenSP, sku) || tenSP;
          ctCount[maCT] = (ctCount[maCT]||0) + 1;
        });
        let html = '<div style="padding:1rem;color:#94a3b8;font-size:.88em">';
        html += `<p>Đã tải <strong>${Object.keys(_zaloOrders).length}</strong> đơn hàng. Tải thêm BaoCaoPhi để đối soát.</p>`;
        html += '<table style="border-collapse:collapse;font-size:.9em"><tr><th style="text-align:left;padding:.25rem .75rem;color:#94a3b8">Gian</th><th style="padding:.25rem .75rem;color:#94a3b8">Số đơn</th></tr>';
        Object.entries(ctCount).sort((a,b)=>b[1]-a[1]).forEach(([maCT,n])=>{
          html += `<tr><td style="padding:.2rem .75rem"><span class="ct-badge">${maCT}</span></td><td style="padding:.2rem .75rem;color:#e5e7eb">${n}</td></tr>`;
        });
        html += '</table></div>';
        el.innerHTML = html;
      }
    }

    function autoMapZaloSP() {
      // Dùng keyword overlap từ các SP đã map để tự điền SP chưa map
      const mapped = Object.entries(_zaloSpMap).filter(([,ct]) => ct);
      if(!mapped.length) { alert('Chưa có SP nào được map — hãy map ít nhất vài SP trước.'); return; }
      // Chuẩn hóa: loại emoji, ký tự đặc biệt, lowercase
      const normalize = s => s.toLowerCase()
        .replace(/[\u{1F300}-\u{1FFFF}]/gu,'')
        .replace(/[^a-zA-ZÀ-ỹ0-9\s]/g,' ')
        .split(/\s+/).filter(w=>w.length>1);
      let filled = 0;
      Object.keys(_zaloSpMap).forEach(sp => {
        if(_zaloSpMap[sp]) return;
        const spW = normalize(sp);
        let bestCT='', bestScore=0;
        mapped.forEach(([mSP, mCT]) => {
          const mW = normalize(mSP);
          const common = spW.filter(w => mW.includes(w)).length;
          const score = common / Math.max(spW.length, mW.length);
          if(score > bestScore && score >= 0.35) { bestScore=score; bestCT=mCT; }
        });
        if(bestCT) { _zaloSpMap[sp]=bestCT; filled++; }
      });
      lsSet(LS_ZALO_SP_MAP, JSON.stringify(_zaloSpMap));
      renderZaloCtMap(); renderZaloDoiSoat();
      alert(`⚡ Auto map: điền được ${filled} SP · Còn ${Object.values(_zaloSpMap).filter(v=>!v).length} chưa map`);
    }

    function exportZaloSpMap() {
      const rows = [['Tên sản phẩm','Mã CT']];
      Object.entries(_zaloSpMap).sort((a,b)=>a[0].localeCompare(b[0])).forEach(([sp,ct])=>rows.push([sp,ct]));
      const ws = XLSX.utils.aoa_to_sheet(rows);
      const wb = XLSX.utils.book_new(); XLSX.utils.book_append_sheet(wb,ws,'Map SP-CT');
      XLSX.writeFile(wb,'ZaloPay_MapSP_CT.xlsx');
    }

    // Nhập lại file Excel đã xuất (hoặc chỉnh sửa) ở trên -- cột A = Tên sản
    // phẩm, cột B = Mã CT. Ghi đè mapping hiện có theo đúng tên sản phẩm.
    function importZaloSpMap(input) {
      const file = input.files[0]; if (!file) return;
      const reader = new FileReader();
      reader.onload = function(e) {
        try {
          const wb = XLSX.read(e.target.result, { type: 'array' });
          const data = XLSX.utils.sheet_to_json(wb.Sheets[wb.SheetNames[0]], { header:1, defval:'' });
          let updated = 0;
          data.slice(1).forEach(row => {
            const sp = String(row[0]||'').trim();
            const ct = String(row[1]||'').trim();
            if (sp && ct) { _zaloSpMap[sp] = ct; updated++; }
          });
          lsSet(LS_ZALO_SP_MAP, JSON.stringify(_zaloSpMap));
          alert(`✅ Đã nhập ${updated} mapping`);
          renderZaloCtMap();
          renderZaloDoiSoat();
        } catch(err) { alert('Lỗi: ' + err.message); }
        input.value = '';
      };
      reader.readAsArrayBuffer(file);
    }

    function renderZaloCtMap() {
      const el = document.getElementById('zaloCtMapContent');
      if(!el) return;
      const tenSPs = Object.keys(_zaloSpMap).sort();
      if(!tenSPs.length) {
        el.innerHTML='<div class="empty-state"><div class="big-icon">🗺️</div><p>Tải OrderDetails để thấy danh sách Tên SP</p></div>';
        return;
      }
      const unmappedCount = tenSPs.filter(k=>!_zaloSpMap[k]).length;
      // Toolbar
      let html = `<div style="display:flex;align-items:center;gap:.5rem;margin-bottom:.6rem;flex-wrap:wrap">
        <span style="font-size:.83em;color:#64748b">${tenSPs.length} sản phẩm · <span style="color:${unmappedCount?'#d97706':'#16a34a'}">${unmappedCount} chưa map</span></span>
        <button onclick="autoMapZaloSP()" style="background:#7c3aed;color:#fff;border:none;border-radius:5px;padding:.25rem .7rem;cursor:pointer;font-size:.8em;font-weight:700">⚡ Auto Map</button>
        <button onclick="exportZaloSpMap()" style="background:#0891b2;color:#fff;border:none;border-radius:5px;padding:.25rem .7rem;cursor:pointer;font-size:.8em">⬇️ Xuất Excel</button>
        <label style="background:#059669;color:#fff;border:none;border-radius:5px;padding:.25rem .7rem;cursor:pointer;font-size:.8em;display:inline-flex;align-items:center;gap:.3rem">
          📤 Nhập từ Excel <input type="file" accept=".xlsx,.xls" style="display:none" onchange="importZaloSpMap(this)">
        </label>
      </div>`;
      // 1 bảng duy nhất — unmapped trước (nền vàng nhạt), mapped sau (nền xanh nhạt)
      html += '<table style="width:100%;border-collapse:collapse;font-size:.84em"><thead><tr style="background:#e0e7ff;color:#1e3a5f"><th style="padding:.3rem .6rem;text-align:left">Tên sản phẩm / Mã Sku</th><th style="padding:.3rem .4rem;width:180px">Mã CT</th><th style="padding:.3rem .4rem;width:56px"></th></tr></thead><tbody>';
      // Luyen, 2026-09-10: "tên sản phẩm kì" -- từ khi thêm map theo Sku, bảng
      // này lẫn cả tên sản phẩm (dài, có dấu, nhiều khoảng trắng) VÀ mã Sku
      // (ngắn, không dấu, không khoảng trắng, vd "AMTP", "farmPT-CT") khiến
      // Luyen thấy lạ. Đánh dấu rõ dòng nào là Sku bằng nhãn xanh để phân biệt.
      const looksLikeSku = s => !/\s/.test(s) && s.length <= 24;
      tenSPs.forEach((sp, i) => {
        const isMapped = !!_zaloSpMap[sp];
        const bg = isMapped ? (i%2?'#f0fdf4':'#dcfce7') : (i%2?'#fff':'#fffbeb');
        const borderCol = isMapped ? '#86efac' : '#cbd5e1';
        const esc = sp.replace(/'/g,"&#39;").replace(/"/g,'&quot;');
        const skuTag = looksLikeSku(sp) ? ' <span style="background:#dbeafe;color:#1d4ed8;font-size:.72em;font-weight:700;padding:.05rem .35rem;border-radius:4px;vertical-align:middle">Sku</span>' : '';
        html += `<tr style="background:${bg}">
          <td style="padding:.3rem .6rem;font-size:.79em">${isMapped?'':' ⏳ '}${sp}${skuTag}</td>
          <td style="padding:.3rem .4rem">
            <input id="zsp_${i}" data-sp="${esc}" value="${(_zaloSpMap[sp]||'').replace(/"/g,'&quot;')}" placeholder="Mã CT"
              style="width:100%;border:1px solid ${borderCol};border-radius:4px;padding:.2rem .35rem;background:${isMapped?'#f0fdf4':'#fff'}"
              onkeydown="if(event.key==='Enter')saveZaloSpMap(this)">
          </td>
          <td style="padding:.3rem .4rem">
            <button onclick="saveZaloSpMap(document.getElementById('zsp_${i}'))"
              style="background:${isMapped?'#16a34a':'#2563eb'};color:#fff;border:none;border-radius:4px;padding:.2rem .5rem;cursor:pointer;font-size:.78em">Lưu</button>
          </td>
        </tr>`;
      });
      html += '</tbody></table>';
      el.innerHTML = html;
    }


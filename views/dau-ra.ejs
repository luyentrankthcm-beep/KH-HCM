    // Chi Nhan, 2026-09-10: tu sua cac dong _zaloFee da bi luu sai "date" tu
    // truoc (chuoi so serial Excel tho nhu "46235.00011574074" thay vi
    // "DD-MM-YYYY") do bug da fix o handleZaloFeeFile -- xem ghi chu tren.
    // Chay 1 lan luc tai trang, khong can Luyen tai lai file nao ca.
    (function repairZaloFeeDates() {
      let fixed = 0;
      _zaloFee.forEach(r => {
        if (!/^\d{1,2}-\d{1,2}-\d{4}$/.test(r.date || '')) {
          const num = parseFloat(r.date);
          if (!isNaN(num) && num > 20000 && num < 90000) {
            try { r.date = excelSerialToDateStr(num); fixed++; } catch(e) {}
          }
        }
      });
      if (fixed) {
        try { lsSet(LS_ZALO_FEE, JSON.stringify(_zaloFee)); } catch(e) {}
        console.log('[ZaloPay] Da tu sua ' + fixed + ' dong bi loi ngay (serial Excel).');
      }
    })();


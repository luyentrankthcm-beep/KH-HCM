    function handleVietQrTxnFile(inp, bank) {
      if (!inp.files[0]) return;
      const fname = inp.files[0].name;
      const reader = new FileReader();
      reader.onload = e => {
        try {
          const wb = XLSX.read(new Uint8Array(e.target.result), {type:'array'});
          const ws = wb.Sheets['Transactions'] || wb.Sheets[wb.SheetNames.find(n=>/transaction/i.test(n))||''] || wb.Sheets[wb.SheetNames[0]];
          const rows = XLSX.utils.sheet_to_json(ws, {header:1, defval:'', raw:true});
          if (!rows.length) { alert('Không đọc được dòng dữ liệu nào từ file.'); return; }
          const hdr = rows[0];
          const normHdr = s => String(s||'').toLowerCase().normalize('NFC').trim();
          const findCol = (...kw) => hdr.findIndex(h => kw.some(k => normHdr(h).includes(k)));
          // Cấu trúc đã xác nhận (sheet "Transactions", header row 0): A=STT,
          // B=Thời gian TT, C=Số tiền đến, D=Số tiền đi, E=Loại, F=Trạng
          // thái, G=Mã tham chiếu, H=Mã đơn hàng, I=Mã điểm bán, J=Mã cửa
          // hàng, K=Tài khoản nhận, L=Thời gian tạo, M=Nội dung TT (có mã
          // VQR nhúng), N=Ghi chú, O=Loại giao dịch. Dò theo tên cột trước,
          // fallback về vị trí cột đã xác nhận nếu không tìm thấy tên.
          let iTime = findCol('thời gian tt','thoi gian tt'); if(iTime<0) iTime=1;
          let iAmt  = findCol('số tiền đến','so tien den');   if(iAmt<0)  iAmt=2;
          let iStatus = findCol('trạng thái','trang thai');   if(iStatus<0) iStatus=5;
          let iRef  = findCol('mã tham chiếu','ma tham chieu'); if(iRef<0) iRef=6;
          let iDiem = findCol('mã điểm bán','ma diem ban');    if(iDiem<0) iDiem=8;
          let iCuaHang = findCol('mã cửa hàng','ma cua hang'); if(iCuaHang<0) iCuaHang=9;
          let iTK   = findCol('tài khoản nhận','tai khoan nhan'); if(iTK<0) iTK=10;
          let iNoiDung = findCol('nội dung','noi dung');       if(iNoiDung<0) iNoiDung=12;

          const toNum = v => { if(typeof v==='number') return v; return parseFloat(String(v||'').replace(/[^0-9.-]/g,'')) || 0; };
          const badStatus = /thất bại|that bai|huỷ|huy|error|lỗi|loi|fail/i;
          // Chi Nhan, 2026-09-11: ma VQR cua BIDV dai 13 ky tu nhung cua MB
          // chi dai 11 ky tu -- dung do dai linh hoat cho khop ca 2 phia
          // (phia sao ke NH trong routes/dau-ra.js cung da sua tuong tu).
          const vqrRe = /VQR[A-Za-z0-9]{8,20}/;

          const rawDataRows = rows.slice(1).filter(r => toNum(r[iAmt]) > 0);
          if (!rawDataRows.length) { alert('Không đọc được giao dịch nào có "Số tiền đến" > 0 — kiểm tra lại đúng file export giao dịch Viet QR chưa.'); return; }
          const newRows = [];
          let excludedByStatus = 0;
          let excludedByAccount = 0;
          const wrongAccSamples = new Set();
          const expectedSuffix = VIETQR_BANK_ACC_SUFFIX[bank];
          rawDataRows.forEach(r => {
            const st = String(r[iStatus]||'').trim();
            if (st && badStatus.test(st)) { excludedByStatus++; return; }
            const taiKhoanNhan = String(r[iTK]||'').trim();
            if (expectedSuffix && taiKhoanNhan) {
              const accDigits = taiKhoanNhan.split(' - ')[0].replace(/\D/g,'');
              if (accDigits && !accDigits.endsWith(expectedSuffix)) {
                excludedByAccount++; wrongAccSamples.add(taiKhoanNhan); return;
              }
            }
            let date;
            const rawD = r[iTime];
            if (typeof rawD === 'number') { date = excelSerialToDateStr(rawD); }
            else { const tg = String(rawD||'').split(' ')[0]; const p = tg.split('/'); date = p.length===3 ? `${p[0]}-${p[1]}-${p[2]}` : tg; }
            const noiDung = String(r[iNoiDung]||'');
            const mVqr = vqrRe.exec(noiDung);
            const vqrCode = mVqr ? mVqr[0] : '';
            const maThamChieu = String(r[iRef]||'').trim();
            const maDiemBan = String(r[iDiem]||'').trim();
            const amount = toNum(r[iAmt]);
            const dedupKey = maThamChieu || vqrCode || (date+'|'+amount+'|'+maDiemBan);
            newRows.push({ date, amount, maThamChieu, maDiemBan, maCuaHang: String(r[iCuaHang]||'').trim(), vqrCode, noiDung: noiDung.substring(0,120), dedupKey });
          });
          const exKeys = new Set(_vietqrTxn[bank].map(r=>r.dedupKey).filter(Boolean));
          const added = newRows.filter(r=>r.dedupKey && !exKeys.has(r.dedupKey));
          _vietqrTxn[bank] = [..._vietqrTxn[bank], ...added];
          try { lsSet(lsVietqrTxnKey(bank), JSON.stringify(_vietqrTxn[bank])); } catch(e) {
            _vietqrTxn[bank] = _vietqrTxn[bank].slice(-6000);
            try { lsSet(lsVietqrTxnKey(bank), JSON.stringify(_vietqrTxn[bank])); } catch(e2){}
          }
          added.forEach(r => {
            if(!r.maCuaHang) return;
            // Tự seed tên điểm bán ngay nếu đã có sẵn trong bảng tham chiếu
            // store-export (Luyen tải trước hoặc sau đều được, tự khớp lại
            // mỗi lần render), nếu chưa có thì để trống cho tới khi map.
            if(_vietqrDiemName[r.maCuaHang]===undefined) {
              const ref = _vietqrCuaHangRef[r.maCuaHang];
              _vietqrDiemName[r.maCuaHang] = ref ? (ref.tenDiemBan || ref.tenCuaHang || '') : '';
            }
          });
          lsSet(LS_VIETQR_DIEM_NAME, JSON.stringify(_vietqrDiemName));

          _vietqrHist[bank].unshift({file:fname, at:new Date().toLocaleString('vi'), added:added.length, skip:newRows.length-added.length, wrongAcc:excludedByAccount});
          lsSet(lsVietqrHistKey(bank), JSON.stringify(_vietqrHist[bank]));

          _vietqrWrongAcc[bank] = excludedByAccount;
          renderVietQrSummary(bank); renderVietQrDoiSoat(bank); renderVietQrHist(bank); renderVietQrDiemMap(); renderVietQrCtMap();
          fetchBankVietQr(bank);
          let msg = `${VIETQR_BANK_LABEL[bank]}: +${added.length} GD mới (bỏ ${newRows.length-added.length} trùng${excludedByStatus?', '+excludedByStatus+' GD trạng thái lỗi':''})\nTổng: ${_vietqrTxn[bank].length} GD`;
          if (excludedByAccount > 0) {
            msg = `⚠️ CẢNH BÁO: file có ${excludedByAccount} dòng "Tài khoản nhận" là [${[...wrongAccSamples].join(', ')}] — KHÔNG khớp tài khoản ${VIETQR_BANK_LABEL[bank]}. Các dòng này đã bị BỎ QUA, không nhập vào tab này.\nRất có thể bạn tải nhầm file của ngân hàng khác — kiểm tra lại trước khi map!\n\n` + msg;
            alert(msg);
          } else {
            alert('✅ ' + msg);
          }
        } catch(err) { alert('Lỗi đọc file Viet QR: ' + err.message); }
      };
      reader.readAsArrayBuffer(inp.files[0]);
      inp.value='';
    }

    // File "store-export" (Luyen tải, sheet "store-export"): STT, Tên cửa
    // hàng, Mã cửa hàng, Mã điểm bán, Tên điểm bán, Doanh thu ngày, Số lượng
    // GD ngày, Ngày tạo — đã xác nhận đúng cấu trúc trên dữ liệu thật ngày
    // 2026-09-11. Khoá join với file giao dịch Viet QR là "Mã cửa hàng" (mã
    // 10 ký tự, KHÔNG PHẢI "Mã điểm bán" — 2 file dùng 2 hệ mã điểm bán khác
    // nhau, xem ghi chú ở đầu block Viet QR). Nhiều "Mã cửa hàng" có thể
    // cùng chung 1 "Mã điểm bán"/"Tên điểm bán".
    function handleVietQrStoreExportFile(inp) {
      if (!inp.files[0]) return;
      const fname = inp.files[0].name;
      const reader = new FileReader();
      reader.onload = e => {
        try {
          const wb = XLSX.read(new Uint8Array(e.target.result), {type:'array'});
          const ws = wb.Sheets['store-export'] || wb.Sheets[wb.SheetNames[0]];
          const rows = XLSX.utils.sheet_to_json(ws, {header:1, defval:''});
          if (!rows.length) { alert('File rỗng.'); return; }
          const hdr = rows[0];
          const normHdr = s => String(s||'').toLowerCase().normalize('NFC').trim();
          const findCol = (...kw) => hdr.findIndex(h => kw.some(k=>normHdr(h).includes(k)));
          let iTenCuaHang = findCol('tên cửa hàng','ten cua hang'); if(iTenCuaHang<0) iTenCuaHang=1;
          let iMaCuaHang  = findCol('mã cửa hàng','ma cua hang');   if(iMaCuaHang<0) iMaCuaHang=2;
          let iMaDiem     = findCol('mã điểm bán','ma diem ban');   if(iMaDiem<0) iMaDiem=3;
          let iTenDiem    = findCol('tên điểm bán','ten diem ban'); if(iTenDiem<0) iTenDiem=4;

          let total = 0, autoFilled = 0;
          rows.slice(1).forEach(r => {
            const maCH = String(r[iMaCuaHang]||'').trim();
            if (!maCH) return;
            total++;
            const info = {
              maDiemBan: String(r[iMaDiem]||'').trim(),
              tenDiemBan: String(r[iTenDiem]||'').trim(),
              tenCuaHang: String(r[iTenCuaHang]||'').trim(),
            };
            _vietqrCuaHangRef[maCH] = info;
            const auto = info.tenDiemBan || info.tenCuaHang;
            // Không ghi đè nếu Luyen đã tự sửa tay ở bảng "Map Cửa hàng → Tên"
            if (auto && !_vietqrDiemManual[maCH]) {
              if (_vietqrDiemName[maCH] !== auto) autoFilled++;
              _vietqrDiemName[maCH] = auto;
            }
          });
          lsSet(LS_VIETQR_CUA_HANG_REF, JSON.stringify(_vietqrCuaHangRef));
          lsSet(LS_VIETQR_DIEM_NAME, JSON.stringify(_vietqrDiemName));
          VIETQR_BANKS.forEach(b => renderVietQrDoiSoat(b));
          renderVietQrDiemMap(); renderVietQrCtMap();
          const mappedCount = Object.values(_vietqrDiemName).filter(Boolean).length;
          alert(`✅ Đã đọc ${total} dòng cửa hàng · Tự map ${autoFilled} tên điểm bán\nCác Mã cửa hàng đang xuất hiện trong GD Viet QR đã map tên: ${mappedCount}/${Object.keys(_vietqrDiemName).length}`);
        } catch(err) { alert('Lỗi đọc file Cửa hàng/Điểm bán: ' + err.message); }
      };
      reader.readAsArrayBuffer(inp.files[0]);
      inp.value='';
    }

    function getVietQrTenDiem(maCuaHang) {
      const t = (_vietqrDiemName[maCuaHang]||'').trim();
      return t || maCuaHang;
    }
    // Luyen, 2026-09-11: "mỗi 1 cái điểm bán ngân hàng trống khác nhau là
    // của 1 công trình khác nhau á đừng có mặc định đưa vô 1 gian với toàn
    // bộ các ngân hàng á" -- Tên điểm bán THẬT (đã map trong
    // _vietqrDiemName, VD "POSH Sân Bay Vinh") thì đúng là dùng chung Mã CT
    // cho cả 3 NH (cùng 1 địa điểm thật, có thể qua nhiều tài khoản ngân
    // hàng). NHƯNG khi CHƯA map được tên thật (rớt về "-" hoặc về đúng mã
    // cửa hàng thô) thì đó chỉ là 1 "thùng rác" tạm của riêng từng ngân hàng
    // -- "-" của MB11521268 (giao dịch GLN TRANSFER) không liên quan gì "-"
    // của BIDV77020, KHÔNG được lấy chung 1 Mã CT. Nên: tên thật -> key dùng
    // chung; tên còn là fallback -> tách riêng theo từng ngân hàng.
    function vietqrCtKey(bank, maCuaHang) {
      const ten = getVietQrTenDiem(maCuaHang);
      const isReal = !!(_vietqrDiemName[maCuaHang]||'').trim();
      return isReal ? ten : (bank + '::' + ten);
    }
    function getVietQrMaCT(bank, maCuaHang) {
      const ten = getVietQrTenDiem(maCuaHang);
      const m = (_vietqrCtMap[vietqrCtKey(bank, maCuaHang)]||'').trim();
      return m || ten;
    }
    function saveVietQrDiemName(inp) {
      const ma = inp.dataset.ma;
      _vietqrDiemName[ma] = inp.value.trim();
      _vietqrDiemManual[ma] = true; // đã sửa tay -- lần tải file store-export sau không tự ghi đè nữa
      lsSet(LS_VIETQR_DIEM_NAME, JSON.stringify(_vietqrDiemName));
      lsSet(LS_VIETQR_DIEM_MANUAL, JSON.stringify(_vietqrDiemManual));
      renderVietQrDiemMap(); renderVietQrCtMap();
      VIETQR_BANKS.forEach(b => renderVietQrDoiSoat(b));
    }
    function saveVietQrCtMap(inp) {
      const ten = inp.dataset.ten;
      _vietqrCtMap[ten] = inp.value.trim();
      lsSet(LS_VIETQR_CT_MAP, JSON.stringify(_vietqrCtMap));
      renderVietQrCtMap();
      VIETQR_BANKS.forEach(b => renderVietQrDoiSoat(b));
    }

    // Luyen, 2026-09-11: "chỗ map tên với mã công trình á nếu tôi đang ở
    // viet qr khác thì chỉ hiện trang đó thôi đừng hiện map của 77020 á chỉ
    // hiện các mã có trong giao dịch của trang tôi đang xem thôi á" -- truoc
    // gio ham nay gop CHUNG ma cua hang cua ca 3 ngan hang lai roi ghi y het
    // 1 bang do vao ca 3 tab (vi _vietqrDiemName/_vietqrCtMap dung chung),
    // nen dang xem MB11521268 van thay ca ma/ten cua BIDV77020. Gia tri map
    // (_vietqrDiemName/_vietqrCtMap) van dung chung binh thuong, nhung DANH
    // SACH HIEN THI o moi tab gio loc rieng theo dung _vietqrTxn[bank] cua
    // tab do thoi.
    function renderVietQrDiemMap() {
      VIETQR_BANKS.forEach(bank => {
        const mas = [...new Set(_vietqrTxn[bank].map(r=>r.maCuaHang).filter(Boolean))].sort();
        let html;
        if (!mas.length) {
          html = '<div class="empty-state"><div class="big-icon">🗺️</div><p>Tải file giao dịch Viet QR để thấy danh sách cửa hàng</p></div>';
        } else {
          const unmapped = mas.filter(m => !(_vietqrDiemName[m]||'').trim()).length;
          html = `<div style="font-size:.83em;color:#64748b;margin-bottom:.6rem">${mas.length} mã cửa hàng · <span style="color:${unmapped?'#d97706':'#16a34a'}">${unmapped} chưa map tên</span></div>`;
          html += '<table style="width:100%;border-collapse:collapse;font-size:.84em"><thead><tr style="background:#d1fae5;color:#065f46"><th style="padding:.3rem .6rem;text-align:left">Mã cửa hàng</th><th style="padding:.3rem .4rem;text-align:left">Tên điểm bán</th><th style="padding:.3rem .4rem;width:56px"></th></tr></thead><tbody>';
          mas.forEach((ma,i) => {
            const isMapped = !!(_vietqrDiemName[ma]||'').trim();
            const bg = isMapped ? (i%2?'#f0fdf4':'#dcfce7') : (i%2?'#fff':'#fffbeb');
            const esc = ma.replace(/'/g,"&#39;").replace(/"/g,'&quot;');
            html += `<tr style="background:${bg}">
              <td style="padding:.3rem .6rem;font-family:monospace;font-size:.85em">${ma}</td>
              <td style="padding:.3rem .4rem"><input id="vdn_${bank}_${i}" data-ma="${esc}" value="${(_vietqrDiemName[ma]||'').replace(/"/g,'&quot;')}" placeholder="Tên điểm bán"
                style="width:100%;border:1px solid ${isMapped?'#86efac':'#cbd5e1'};border-radius:4px;padding:.2rem .35rem;background:${isMapped?'#f0fdf4':'#fff'}"
                onkeydown="if(event.key==='Enter')saveVietQrDiemName(this)"></td>
              <td style="padding:.3rem .4rem"><button onclick="saveVietQrDiemName(this.closest('tr').querySelector('input'))" style="background:${isMapped?'#16a34a':'#2563eb'};color:#fff;border:none;border-radius:4px;padding:.2rem .5rem;cursor:pointer;font-size:.78em">Lưu</button></td>
            </tr>`;
          });
          html += '</tbody></table>';
        }
        const el = document.getElementById('vietqrDiemMapContent_'+bank);
        if (el) el.innerHTML = html;
      });
    }

    function renderVietQrCtMap() {
      VIETQR_BANKS.forEach(bank => {
        const allMa = new Set(_vietqrTxn[bank].map(r=>r.maCuaHang).filter(Boolean));
        // key -> {ten, isReal} -- key la thu that dung de doc/ghi _vietqrCtMap
        // (xem ghi chu o vietqrCtKey), ten la text hien thi cho nguoi dung.
        const entries = new Map();
        allMa.forEach(ma => {
          const ten = getVietQrTenDiem(ma);
          const isReal = !!(_vietqrDiemName[ma]||'').trim();
          const key = vietqrCtKey(bank, ma);
          if (!entries.has(key)) entries.set(key, { ten, isReal });
        });
        const keyList = [...entries.keys()].sort((a,b) => entries.get(a).ten.localeCompare(entries.get(b).ten));
        let html;
        if (!keyList.length) {
          html = '<div class="empty-state"><div class="big-icon">🏗️</div><p>Map tên điểm bán trước khi map Mã CT</p></div>';
        } else {
          const unmapped = keyList.filter(k => !(_vietqrCtMap[k]||'').trim()).length;
          html = `<div style="font-size:.83em;color:#64748b;margin-bottom:.6rem">${keyList.length} tên điểm bán · <span style="color:${unmapped?'#d97706':'#16a34a'}">${unmapped} chưa map CT</span></div>`;
          html += '<table style="width:100%;border-collapse:collapse;font-size:.84em"><thead><tr style="background:#dbeafe;color:#1e3a8a"><th style="padding:.3rem .6rem;text-align:left">Tên điểm bán</th><th style="padding:.3rem .4rem;width:180px">Mã CT</th><th style="padding:.3rem .4rem;width:56px"></th></tr></thead><tbody>';
          keyList.forEach((key,i) => {
            const { ten, isReal } = entries.get(key);
            const isMapped = !!(_vietqrCtMap[key]||'').trim();
            const bg = isMapped ? (i%2?'#f0fdf4':'#dcfce7') : (i%2?'#fff':'#fffbeb');
            const esc = key.replace(/'/g,"&#39;").replace(/"/g,'&quot;');
            let tenDisp = ten ? ten : '<span style="color:#94a3b8;font-style:italic">(chưa có tên)</span>';
            // Luyen: danh dau ro cac gian "-"/chua map ten la RIENG cua ngan
            // hang nay, khong dung chung voi 2 ngan hang kia (xem vietqrCtKey).
            if (!isReal) tenDisp += ` <span style="color:#94a3b8;font-size:.72em">(riêng ${VIETQR_BANK_LABEL[bank]})</span>`;
            html += `<tr style="background:${bg}">
              <td style="padding:.3rem .6rem;font-size:.85em">${tenDisp}</td>
              <td style="padding:.3rem .4rem"><input id="vct_${bank}_${i}" data-ten="${esc}" value="${(_vietqrCtMap[key]||'').replace(/"/g,'&quot;')}" placeholder="Mã CT"
                style="width:100%;border:1px solid ${isMapped?'#86efac':'#cbd5e1'};border-radius:4px;padding:.2rem .35rem;background:${isMapped?'#f0fdf4':'#fff'}"
                onkeydown="if(event.key==='Enter')saveVietQrCtMap(this)"></td>
              <td style="padding:.3rem .4rem"><button onclick="saveVietQrCtMap(this.closest('tr').querySelector('input'))" style="background:${isMapped?'#16a34a':'#2563eb'};color:#fff;border:none;border-radius:4px;padding:.2rem .5rem;cursor:pointer;font-size:.78em">Lưu</button></td>
            </tr>`;
          });
          html += '</tbody></table>';
        }
        const el = document.getElementById('vietqrCtMapContent_'+bank);
        if (el) el.innerHTML = html;
      });
    }

    // Luyen, 2026-09-11: "cho cái xuất xuống tải lên lại đi" / "chỗ này nè
    // map mã cửa hàng với tên cửa hàng đi" -- danh sách map (nhất là Map Tên
    // → Mã CT, MB11521268 có tới 86 dòng chưa map) gõ tay từng dòng quá lâu.
    // Thêm Xuất Excel (tải danh sách hiện tại xuống, điền cột bên phải trong
    // Excel cho nhanh) + Tải lên (đọc lại file đã điền, ghi đè vào đúng map),
    // cho CẢ 2 bảng: Map Cửa hàng → Tên điểm bán (key = Mã cửa hàng, vốn đã
    // duy nhất) và Map Tên → Mã CT (key = vietqrCtKey, tính lại lúc tải lên
    // dựa theo đúng "Tên điểm bán" ghi trong file để khớp đúng dòng).
    function exportVietQrDiemMap(bank) {
      const mas = [...new Set(_vietqrTxn[bank].map(r=>r.maCuaHang).filter(Boolean))].sort();
      if (!mas.length) { alert('Chưa có dữ liệu để xuất.'); return; }
      const rows = mas.map(ma => ({ 'Mã cửa hàng': ma, 'Tên điểm bán': _vietqrDiemName[ma] || '' }));
      const wb = XLSX.utils.book_new();
      XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(rows), 'MapCuaHang');
      XLSX.writeFile(wb, `VietQR_MapCuaHang_${VIETQR_BANK_LABEL[bank]}.xlsx`);
    }

    function handleVietQrDiemMapUpload(inp, bank) {
      if (!inp.files[0]) return;
      const reader = new FileReader();
      reader.onload = e => {
        try {
          const wb = XLSX.read(new Uint8Array(e.target.result), {type:'array'});
          const ws = wb.Sheets[wb.SheetNames[0]];
          const rows = XLSX.utils.sheet_to_json(ws, {defval:''});
          let updated = 0;
          rows.forEach(r => {
            const ma  = String(r['Mã cửa hàng']||'').trim();
            const ten = String(r['Tên điểm bán']||'').trim();
            if (!ma || !ten) return;
            _vietqrDiemName[ma] = ten;
            _vietqrDiemManual[ma] = true;
            updated++;
          });
          lsSet(LS_VIETQR_DIEM_NAME, JSON.stringify(_vietqrDiemName));
          lsSet(LS_VIETQR_DIEM_MANUAL, JSON.stringify(_vietqrDiemManual));
          renderVietQrDiemMap(); renderVietQrCtMap();
          VIETQR_BANKS.forEach(b => renderVietQrDoiSoat(b));
          alert(`✅ Đã cập nhật ${updated} tên điểm bán từ file.`);
        } catch(err) { alert('Lỗi đọc file: ' + err.message); }
      };
      reader.readAsArrayBuffer(inp.files[0]);
      inp.value = '';
    }

    function exportVietQrCtMap(bank) {
      const allMa = new Set(_vietqrTxn[bank].map(r=>r.maCuaHang).filter(Boolean));
      const entries = new Map();
      allMa.forEach(ma => {
        const ten = getVietQrTenDiem(ma);
        const key = vietqrCtKey(bank, ma);
        if (!entries.has(key)) entries.set(key, ten);
      });
      const keyList = [...entries.keys()].sort((a,b) => (entries.get(a)||'').localeCompare(entries.get(b)||''));
      if (!keyList.length) { alert('Chưa có dữ liệu để xuất (cần map Tên điểm bán trước).'); return; }
      const rows = keyList.map(key => ({
        'Tên điểm bán': entries.get(key) || '(chưa có tên)',
        'Mã CT': _vietqrCtMap[key] || '',
      }));
      const wb = XLSX.utils.book_new();
      XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(rows), 'MapTenCT');
      XLSX.writeFile(wb, `VietQR_MapTenCT_${VIETQR_BANK_LABEL[bank]}.xlsx`);
    }

    function handleVietQrCtMapUpload(inp, bank) {
      if (!inp.files[0]) return;
      const reader = new FileReader();
      reader.onload = e => {
        try {
          const wb = XLSX.read(new Uint8Array(e.target.result), {type:'array'});
          const ws = wb.Sheets[wb.SheetNames[0]];
          const rows = XLSX.utils.sheet_to_json(ws, {defval:''});
          // Xay lai bang tra ten -> key CHINH XAC nhu renderVietQrCtMap dang
          // dung, de biet nen ghi vao key nao (real key = ten, hoac
          // bank::ten neu la ten fallback rieng ngan hang).
          const allMa = new Set(_vietqrTxn[bank].map(r=>r.maCuaHang).filter(Boolean));
          const tenToKey = new Map();
          allMa.forEach(ma => {
            const ten = getVietQrTenDiem(ma);
            const key = vietqrCtKey(bank, ma);
            if (!tenToKey.has(ten)) tenToKey.set(ten, key);
          });
          let updated = 0;
          const notFound = [];
          rows.forEach(r => {
            let ten = String(r['Tên điểm bán']||'').trim();
            const maCT = String(r['Mã CT']||'').trim();
            if (!ten || !maCT) return;
            if (ten === '(chưa có tên)') ten = '';
            const key = tenToKey.get(ten);
            if (key === undefined) { notFound.push(ten || '(trống)'); return; }
            _vietqrCtMap[key] = maCT;
            updated++;
          });
          lsSet(LS_VIETQR_CT_MAP, JSON.stringify(_vietqrCtMap));
          renderVietQrCtMap();
          VIETQR_BANKS.forEach(b => renderVietQrDoiSoat(b));
          alert(`✅ Đã cập nhật ${updated} mã CT từ file.`
            + (notFound.length ? `\n⚠️ Không khớp được ${notFound.length} tên điểm bán (danh sách có thể đã đổi, tải lại file mẫu mới): ${notFound.slice(0,5).join(', ')}${notFound.length>5?'...':''}` : ''));
        } catch(err) { alert('Lỗi đọc file: ' + err.message); }
      };
      reader.readAsArrayBuffer(inp.files[0]);
      inp.value = '';
    }

    function renderVietQrSummary(bank) {
      const el = document.getElementById('vietqr_summary_'+bank);
      if(el) {
        const n = _vietqrTxn[bank].length;
        if(!n) { el.textContent=''; }
        else {
          const matched = _vietqrTxn[bank].filter(r=>getVietQrBankHit(bank, r)).length;
          el.innerHTML = `${n} GD · <span style="color:${matched===n?'#16a34a':'#d97706'}">${matched}/${n} khớp NH</span>`;
        }
      }
      // Luyen, 2026-09-11: "dựa vào chỗ ngân hàng trả về á đặt cảnh báo nếu
      // tải lên sai nhá với lại có gian mới chưa map dc cx đặt cảnh báo" --
      // banner do ngay duoi ten ngan hang, luon hien (khong can bam vao tab
      // con khac moi thay) khi (1) lan tai gan nhat co dong sai tai khoan
      // ngan hang, hoac (2) dang co ma cua hang thuc te chua map duoc Tên
      // điểm bán.
      const panel = document.getElementById('vietqr_'+bank);
      if (!panel) return;
      let warnEl = document.getElementById('vietqrWarnBanner_'+bank);
      if (!warnEl) {
        warnEl = document.createElement('div');
        warnEl.id = 'vietqrWarnBanner_'+bank;
        const header = panel.querySelector('.channel-header');
        if (header) header.insertAdjacentElement('afterend', warnEl); else panel.prepend(warnEl);
      }
      const msgs = [];
      if (_vietqrWrongAcc[bank] > 0) {
        msgs.push(`⚠️ Lần tải gần nhất có ${_vietqrWrongAcc[bank]} dòng "Tài khoản nhận" không khớp ${VIETQR_BANK_LABEL[bank]} — nghi tải nhầm file ngân hàng khác, các dòng đó đã KHÔNG được nhập.`);
      }
      const unmappedCodes = new Set();
      _vietqrTxn[bank].forEach(r => { if (r.maCuaHang && r.maCuaHang!=='-' && !(_vietqrDiemName[r.maCuaHang]||'').trim()) unmappedCodes.add(r.maCuaHang); });
      if (unmappedCodes.size > 0) {
        msgs.push(`⚠️ Có ${unmappedCodes.size} mã cửa hàng mới (gian mới) chưa map được Tên điểm bán — vào tab "🏪 Map Cửa hàng → Tên điểm bán" để map.`);
      }
      warnEl.innerHTML = msgs.map(m => `<div style="background:#fffbeb;border:1px solid #f59e0b;color:#92400e;border-radius:6px;padding:.4rem .7rem;font-size:.8em;margin:.4rem 0;font-weight:600">${m}</div>`).join('');
    }

    function populateVietQrMonthFilter(bank) {
      const sel = document.getElementById('vietqrFilterMonth_'+bank);
      if(!sel) return;
      const months = [...new Set(_vietqrTxn[bank].map(r => { const p=r.date?r.date.split('-'):[]; return p.length===3?p[1]+'/'+p[2]:''; }).filter(Boolean))].sort().reverse();
      const cur = sel.value;
      sel.innerHTML = '<option value="">-- Tất cả --</option>' + months.map(m=>`<option value="${m}"${m===cur?' selected':''}>${m}</option>`).join('');
    }

    function renderVietQrDoiSoat(bank) {
      const el = document.getElementById('vietqrDoiSoatBody_'+bank);
      if(!el) return;
      const txns = _vietqrTxn[bank];
      if(!txns.length) {
        el.innerHTML = '<div class="empty-state"><div class="big-icon">🟢</div><p>Tải file giao dịch '+VIETQR_BANK_LABEL[bank]+' để bắt đầu đối soát</p></div>';
        return;
      }
      const fmtN = n => Math.round(n).toLocaleString('vi');
      const iso  = d => { const p=d.split('-'); return p[2]+'-'+p[1]+'-'+p[0]; };
      const sortDate = (a,b) => iso(a).localeCompare(iso(b));

      populateVietQrMonthFilter(bank);
      const selMonth = (document.getElementById('vietqrFilterMonth_'+bank)||{}).value || '';

      const byDate = {}; // date -> maCT -> {amount, soGD, matched, tenDiem}
      txns.forEach(r => {
        const tenDiem = getVietQrTenDiem(r.maCuaHang);
        const maCT = getVietQrMaCT(bank, r.maCuaHang);
        const bankHit = getVietQrBankHit(bank, r);
        const amount = bankHit ? bankHit.amount : r.amount; // ngân hàng làm chuẩn
        if(!byDate[r.date]) byDate[r.date]={};
        if(!byDate[r.date][maCT]) byDate[r.date][maCT]={amount:0,soGD:0,matched:0,tenDiem};
        byDate[r.date][maCT].amount += amount;
        byDate[r.date][maCT].soGD += 1;
        if(bankHit) byDate[r.date][maCT].matched += 1;
      });
      const allDates = Object.keys(byDate).sort(sortDate);
      const filteredDates = selMonth ? allDates.filter(d => { const p=d.split('-'); return p[1]+'/'+p[2]===selMonth; }) : allDates;

      // Luyen, 2026-09-11: "cho tôi nút sửa nhá với lại sửa nhá giống bên
      // vnpay á" -- them "Số tiền (NH)" sua duoc tay (amtOvr, giong dtOvr cua
      // Payoo/VNPay), dinh nghia som de dung cho ca tinh tong lan render tung
      // dong ngay ben duoi.
      const getVietQrGianDisp = (hdKey, rawAmount) => {
        const hd = _vietqrHD[bank][hdKey] || {};
        const amt = (hd.amtOvr != null && hd.amtOvr !== '') ? (parseFloat(String(hd.amtOvr).replace(/[^0-9.-]/g,''))||0) : rawAmount;
        return { amt, hasAmtOvr: hd.amtOvr!=null && hd.amtOvr!=='' };
      };

      let totAmount=0, totN=0, totMatched=0;
      filteredDates.forEach(dt=>Object.entries(byDate[dt]).forEach(([maCT,d])=>{totAmount+=getVietQrGianDisp(dt+'|'+maCT,d.amount).amt;totN+=d.soGD;totMatched+=d.matched;}));

      let html = '<div style="margin-bottom:.5rem;font-size:.82em;color:#64748b">';
      html += '📊 '+VIETQR_BANK_LABEL[bank]+': <strong>'+txns.length+'</strong> GD · '+filteredDates.length+' ngày · '
        + '<span style="color:'+(totMatched===totN?'#16a34a':'#d97706')+'">'+totMatched+'/'+totN+' khớp NH</span>';
      html += '</div>';

      const unmappedTen = new Set();
      txns.forEach(r => { const t=getVietQrTenDiem(r.maCuaHang); const k=vietqrCtKey(bank, r.maCuaHang); if(!(_vietqrCtMap[k]||'').trim()) unmappedTen.add(t); });
      if (unmappedTen.size) {
        html += '<div style="background:#fef3c7;border:1px solid #f59e0b;border-radius:8px;padding:.6rem 1rem;margin-bottom:.6rem;font-size:.87em;color:#92400e;display:flex;justify-content:space-between;align-items:center;gap:.6rem;flex-wrap:wrap">'
          +'<span>⚠️ Có <strong>'+unmappedTen.size+'</strong> điểm bán chưa map mã CT.</span>'
          +'<button onclick="switchVietQrSub(\''+bank+'\',\'ctmap\')" style="background:#f59e0b;color:#fff;border:none;border-radius:6px;padding:.3rem .8rem;font-weight:700;cursor:pointer;white-space:nowrap">🗺️ Map ngay</button>'
          +'</div>';
      }

      const invoiceGroups = {};
      allDates.forEach(dt => {
        const ctData0 = byDate[dt]; if(!ctData0) return;
        Object.keys(ctData0).forEach(maCT => {
          const hd = _vietqrHD[bank][dt+'|'+maCT] || {};
          const soHD = (hd.soHD||'').trim();
          if(!soHD) return;
          const gDisp0 = getVietQrGianDisp(dt+'|'+maCT, ctData0[maCT].amount);
          const tienHD0 = parseFloat((hd.tienHD||'0').toString().replace(/[^0-9.-]/g,''))||0;
          const key = maCT+'|'+soHD;
          if(!invoiceGroups[key]) invoiceGroups[key] = {dt:0, tienHDs:[], dates:[]};
          invoiceGroups[key].dt += gDisp0.amt;
          invoiceGroups[key].tienHDs.push(tienHD0);
          invoiceGroups[key].dates.push(dt);
        });
      });
      Object.values(invoiceGroups).forEach(g => {
        const uniq = [...new Set(g.tienHDs.filter(v=>v>0))];
        g.tienHD = uniq.length <= 1 ? (uniq[0]||0) : g.tienHDs.reduce((s,v)=>s+v,0);
      });

      const renderDateBlock = date => {
        const ctData = byDate[date];
        if(!ctData) return '';
        const ctKeys = Object.keys(ctData).sort((a,b)=>a.localeCompare(b));
        const disps = {};
        ctKeys.forEach(maCT => { disps[maCT] = getVietQrGianDisp(date+'|'+maCT, ctData[maCT].amount); });
        const dayAmount = ctKeys.reduce((s,g)=>s+disps[g].amt,0);
        const dayN = ctKeys.reduce((s,g)=>s+ctData[g].soGD,0);
        const dayMatched = ctKeys.reduce((s,g)=>s+ctData[g].matched,0);
        const [dd,mm,yyyy]=date.split('-');
        const dateId = date.replace(/-/g,'_');
        let out = '<div style="margin-bottom:.8rem">'
          +'<div style="background:#14532d;color:#fff;padding:.4rem .75rem;font-weight:700;font-size:.87em;display:flex;justify-content:space-between;cursor:pointer" onclick="toggleVietQrEditPanel(\''+bank+'\',\''+dateId+'\')">'
          +'<span>📅 '+dd+'/'+mm+'/'+yyyy+'</span>'
          +'<span style="font-size:.81em;font-weight:400;color:#bbf7d0">'+dayN+' GD · '+fmtN(dayAmount)+'đ'
          +(dayMatched===dayN?' · ✅ khớp NH':' · ⚠️ '+dayMatched+'/'+dayN+' khớp NH')+' &nbsp;<span style="opacity:.8">✏️ Sửa</span></span>'
          +'</div>'
          +'<table style="width:100%;border-collapse:collapse;font-size:.84em">'
          +'<thead><tr style="background:#166534;color:#f0fdf4">'
          +'<th style="padding:.3rem .6rem;text-align:left">Mã CT (Điểm bán)</th>'
          +'<th style="text-align:right;padding:.3rem .4rem">Số GD</th>'
          +'<th style="text-align:right;padding:.3rem .4rem">Số tiền (NH)</th>'
          +'<th style="text-align:center;padding:.3rem .4rem">Khớp NH</th>'
          +'<th style="text-align:center;padding:.3rem .4rem">Số HĐ</th>'
          +'<th style="text-align:right;padding:.3rem .4rem">Tiền HĐ</th>'
          +'<th style="text-align:right;padding:.3rem .4rem">Chênh</th>'
          +'</tr></thead><tbody>';
        ctKeys.forEach((maCT,i) => {
          const d = ctData[maCT];
          const gDisp = disps[maCT];
          const hdKey = date+'|'+maCT;
          const hd = _vietqrHD[bank][hdKey] || {};
          const tienHD = parseFloat((hd.tienHD||'0').toString().replace(/[^0-9.-]/g,''))||0;
          const soHDNow = (hd.soHD||'').trim();
          const grp = soHDNow ? invoiceGroups[maCT+'|'+soHDNow] : null;
          const chenh = (grp && grp.dates.length > 1 && grp.tienHD)
            ? (gDisp.amt - grp.tienHD * (grp.dt > 0 ? (gDisp.amt / grp.dt) : (1 / grp.dates.length)))
            : (tienHD ? (gDisp.amt - tienHD) : null);
          const chenhColor = chenh===null?'#94a3b8':(Math.abs(chenh)<1000?'#16a34a':(chenh<0?'#ef4444':'#d97706'));
          const chenhTxt = chenh===null?'—':((chenh>0?'+':'')+fmtN(chenh));
          const bg = i%2===0?'#f0fdf4':'#fff';
          const escKey = hdKey.replace(/'/g,"\\'");
          const soHDDisplay = hd.soHD
            ? '<span style="font-size:.8em;cursor:pointer" onclick="vqHDEdit(this,\''+bank+'\',\''+escKey+'\',\'soHD\')">'+hd.soHD+' ✏️</span>'
            : '<span style="color:#94a3b8;font-size:.75em;cursor:pointer" onclick="vqHDEdit(this,\''+bank+'\',\''+escKey+'\',\'soHD\')">…</span>';
          const tienHDDisplay = hd.tienHD
            ? '<span style="font-size:.8em;cursor:pointer;color:#15803d" onclick="vqHDEdit(this,\''+bank+'\',\''+escKey+'\',\'tienHD\')">'+hd.tienHD+' ✏️</span>'
            : '<span style="color:#94a3b8;font-size:.75em;cursor:pointer" onclick="vqHDEdit(this,\''+bank+'\',\''+escKey+'\',\'tienHD\')">…</span>';
          const matchTag = d.soGD===0 ? '—' : (d.matched===d.soGD ? '<span style="color:#16a34a">✅</span>' : (d.matched===0 ? '<span style="color:#ef4444">❌</span>' : '<span style="color:#d97706">⚠️ '+d.matched+'/'+d.soGD+'</span>'));
          out += '<tr style="background:'+bg+'">'
            +'<td style="padding:.3rem .6rem"><span class="ct-badge">'+maCT+'</span><div style="font-size:.76em;color:#64748b">'+d.tenDiem+'</div></td>'
            +'<td style="text-align:right;padding:.3rem .4rem;color:#64748b">'+d.soGD+'</td>'
            +'<td style="text-align:right;padding:.3rem .4rem;color:#15803d;font-weight:700">'+fmtN(gDisp.amt)+(gDisp.hasAmtOvr?'<sup style="color:#f59e0b;font-size:.7em">✏</sup>':'')+'</td>'
            +'<td style="text-align:center;padding:.3rem .4rem">'+matchTag+'</td>'
            +'<td style="padding:.3rem .3rem;text-align:center">'+soHDDisplay+'</td>'
            +'<td style="padding:.3rem .3rem;text-align:right">'+tienHDDisplay+'</td>'
            +'<td style="text-align:right;padding:.3rem .4rem;font-weight:700;color:'+chenhColor+'">'+chenhTxt+'</td>'
            +'</tr>';
        });
        out += '</tbody></table>';
        out += '<div id="edit_vietqr_'+bank+'_'+dateId+'" style="display:none;padding:.6rem .75rem;background:#f8fafc;border:1px dashed #16a34a;border-top:none">'
          +'<div style="font-size:.8em;font-weight:700;color:#14532d;margin-bottom:.4rem">✏️ Chỉnh sửa – '+dd+'/'+mm+'/'+yyyy+'</div>'
          +'<div style="overflow-x:auto"><table style="min-width:560px;border-collapse:collapse;font-size:.8em">'
          +'<thead><tr style="background:#dcfce7;color:#14532d">'
          +'<th style="padding:.25rem .5rem;text-align:left;border:1px solid #bbf7d0">Mã CT / Điểm bán</th>'
          +'<th style="padding:.25rem .5rem;text-align:right;border:1px solid #bbf7d0">Số tiền (sửa được)</th>'
          +'<th style="padding:.25rem .5rem;border:1px solid #bbf7d0">Số HĐ</th>'
          +'<th style="padding:.25rem .5rem;text-align:right;border:1px solid #bbf7d0">Tiền HĐ</th>'
          +'</tr></thead><tbody>'
          +ctKeys.map(maCT => {
            const hd = _vietqrHD[bank][date+'|'+maCT] || {};
            const gDisp = disps[maCT];
            const gKey = maCT.replace(/[^a-zA-Z0-9]/g,'_');
            return '<tr>'
              +'<td style="padding:.25rem .5rem;border:1px solid #e2e8f0;font-size:.9em">'+maCT+'</td>'
              +'<td style="padding:.25rem .5rem;border:1px solid #e2e8f0;text-align:right">'
                +'<input id="vqedit_amt_'+bank+'_'+dateId+'_'+gKey+'" type="text" value="'+gDisp.amt+'" style="width:110px;border:1px solid #bbf7d0;border-radius:4px;padding:.15rem .3rem;text-align:right;background:#f0fdf4;color:#15803d;font-weight:600"></td>'
              +'<td style="padding:.25rem .5rem;border:1px solid #e2e8f0">'
                +'<input id="vqedit_soHD_'+bank+'_'+dateId+'_'+gKey+'" type="text" value="'+(hd.soHD||'')+'" placeholder="0000123" style="width:100px;border:1px solid #cbd5e1;border-radius:4px;padding:.15rem .3rem"></td>'
              +'<td style="padding:.25rem .5rem;border:1px solid #e2e8f0;text-align:right">'
                +'<input id="vqedit_tienHD_'+bank+'_'+dateId+'_'+gKey+'" type="text" value="'+(hd.tienHD||'')+'" placeholder="0" style="width:100px;border:1px solid #cbd5e1;border-radius:4px;padding:.15rem .3rem;text-align:right"></td>'
              +'</tr>';
          }).join('')
          +'</tbody></table></div>'
          +'<div style="margin-top:.5rem;display:flex;gap:.5rem">'
          +'<button onclick="saveVietQrEditPanel(\''+bank+'\',\''+dateId+'\',\''+date+'\',this)" data-gians=\''+JSON.stringify(ctKeys).replace(/'/g,'&#39;')+'\' style="background:#16a34a;color:#fff;border:none;border-radius:6px;padding:.3rem .8rem;font-weight:700;font-size:.8em;cursor:pointer">💾 Lưu</button>'
          +'<button onclick="toggleVietQrEditPanel(\''+bank+'\',\''+dateId+'\')" style="background:#6b7280;color:#fff;border:none;border-radius:6px;padding:.3rem .8rem;font-weight:600;font-size:.8em;cursor:pointer">✕ Đóng</button>'
          +'</div></div></div>';
        return out;
      };

      filteredDates.forEach(d => { html += renderDateBlock(d); });

      const byGian = {};
      filteredDates.forEach(dt => {
        Object.entries(byDate[dt]).forEach(([maCT,d]) => {
          if(!byGian[maCT]) byGian[maCT]={soGD:0,amount:0};
          byGian[maCT].soGD+=d.soGD; byGian[maCT].amount+=d.amount;
        });
      });
      const gianKeys = Object.keys(byGian).sort();
      html += '<table style="width:100%;border-collapse:collapse;font-size:.85em;margin-top:.6rem"><tbody>'
        +'<tr style="background:#14532d;color:#fff;font-weight:700">'
        +'<td style="padding:.5rem .75rem">TỔNG CỘNG ('+filteredDates.length+' ngày)</td>'
        +'<td style="text-align:right;padding:.5rem .5rem">'+totN+' GD</td>'
        +'<td style="text-align:right;padding:.5rem .5rem">'+fmtN(totAmount)+'</td>'
        +'<td colspan="4"></td></tr>';
      gianKeys.forEach((maCT,i) => {
        const g = byGian[maCT];
        html += '<tr style="background:'+(i%2===0?'#f0fdf4':'#dcfce7')+'">'
          +'<td style="padding:.3rem .75rem;padding-left:1.5rem"><span class="ct-badge">'+maCT+'</span></td>'
          +'<td style="text-align:right;padding:.3rem .5rem;color:#64748b">'+g.soGD+'</td>'
          +'<td style="text-align:right;padding:.3rem .5rem;color:#15803d;font-weight:700">'+fmtN(g.amount)+'</td>'
          +'<td colspan="4"></td></tr>';
      });
      html += '</tbody></table>';
      el.innerHTML = html;
    }

    // ══════════════════════════════════════════
    // XUẤT MISA — VIET QR (BIDV7704 / BIDV77020 / MB11521268)
    // Chi Nhan, 2026-09-11: "cho tôi cái xuất misa nhá cái bảng xuất có thể
    // từng cái hay xuất 1 lúc tất cả nha để có chỗ ngân hàng khác nhau số
    // mỗi 1 ngày là 1 chứng từ" -- mau cot + quy uoc dien giai lay DUNG theo
    // file mau Luyen gui (MISAThue-vietqr-bidv7702), la file xuat cua he
    // thong CU (routes/doisoat-vietqr.js, TK 8640107702/BIDV, Mã đối tượng
    // co dinh "KL") -- xac nhan: MOI NGAY la 1 so chung tu rieng (khong gom
    // nhieu ngay vao 1 dot nhu Momo/Zalo/VNPay/Payoo, vi VietQR doi soat
    // TUNG GIAO DICH qua ngan hang lam chuan ngay, khong co do tre thanh
    // toan theo dot nhu cac kenh kia), "Số tiền" = "Doanh thu (VietQR)" =
    // CUNG 1 gia tri (khac Momo/Zalo/VNPay/Payoo co tach dt/net truoc-sau
    // phi -- VietQR khong tach). Mã đối tượng/Mã đối tượng (hạch toán) LUON
    // la "KL" co dinh (giong y het file mau, khong doi theo ngan hang).
    // "Nộp vào TK"/"Mở tại ngân hàng" lay THEO TUNG NGAN HANG (tu
    // _vietqrBankInfo, do fetchBankVietQr dien vao sau khi bam "Làm mới NH").
    function openVietQrMisaModal() {
      document.getElementById('vietqrMisaModal').classList.add('open');
      const stEl = document.getElementById('vietqrMisaModalStatus');
      if (stEl) stEl.textContent = '';
    }
    function closeVietQrMisaModal() {
      document.getElementById('vietqrMisaModal').classList.remove('open');
    }
    function buildVietQrByDateForExport(bank) {
      const byDate = {};
      (_vietqrTxn[bank]||[]).forEach(r => {
        const maCT = getVietQrMaCT(bank, r.maCuaHang);
        const bankHit = getVietQrBankHit(bank, r);
        const amount = bankHit ? bankHit.amount : r.amount; // ngân hàng làm chuẩn
        if (!byDate[r.date]) byDate[r.date] = {};
        if (!byDate[r.date][maCT]) byDate[r.date][maCT] = { amount: 0 };
        byDate[r.date][maCT].amount += amount;
      });
      return byDate;
    }
    function getVietQrAmtDisp(bank, hdKey, rawAmount) {
      const hd = _vietqrHD[bank][hdKey] || {};
      return (hd.amtOvr != null && hd.amtOvr !== '') ? (parseFloat(String(hd.amtOvr).replace(/[^0-9.-]/g,''))||0) : rawAmount;
    }
    function buildVietQrMisaRows({ bank, byDate, fromIso, toIso, startSeq }) {
      const ddmmToISO = d => { const [dd,mm,yy]=d.split('-'); return `${yy}-${mm}-${dd}`; };
      const toSlash   = d => d.replace(/-/g,'/');
      const inRangeIso = d => { const x = ddmmToISO(d); return x >= fromIso && x <= toIso; };
      const lyDoThu = 'Thu tiền khách hàng (không theo hóa đơn)';
      const info = _vietqrBankInfo[bank];
      const bankAccount  = info ? info.account  : '';
      const bankFullName = info ? info.fullName : '';

      const dates = Object.keys(byDate)
        .filter(inRangeIso)
        .sort((a, b) => ddmmToISO(a).localeCompare(ddmmToISO(b)));

      const rows = [];
      let seq = startSeq;
      dates.forEach(date => {
        const ctData = byDate[date] || {};
        const maCTList = Object.keys(ctData).sort();
        if (!maCTList.length) return;
        const soCt = 'NTTK' + String(seq).padStart(7, '0') + '/26';
        maCTList.forEach(maCT => {
          const hdKey = date + '|' + maCT;
          const hd = _vietqrHD[bank][hdKey] || {};
          const amt = getVietQrAmtDisp(bank, hdKey, ctData[maCT].amount);
          const soHD = (hd.soHD || '').trim();
          const tienHD = parseFloat(String(hd.tienHD || '').replace(/[^0-9.]/g, '')) || 0;
          const dienGiai = soHD
            ? `Thu tiền dịch vụ vui chơi giải trí - KL theo HĐ ${soHD}`
            : `Thu tiền dịch vụ vui chơi giải trí - KL`;
          rows.push({
            'Ngày hạch toán (*)': toSlash(date),
            'Ngày chứng từ (*)': toSlash(date),
            'Số chứng từ (*)': soCt,
            'Mã đối tượng': 'KL',
            'Tên đối tượng': '',
            'Địa chỉ': '',
            'Nộp vào TK': bankAccount,
            'Mở tại ngân hàng': bankFullName,
            'Lý do thu': lyDoThu,
            'Diễn giải lý do thu': dienGiai,
            'Mã nhân viên thu': '',
            'Diễn giải (hạch toán)': dienGiai,
            'TK Nợ (*)': 1121,
            'TK Có (*)': '131',
            'Số tiền': Math.round(amt),
            'Mã đối tượng (hạch toán)': 'KL',
            'Số khế ước đi vay': '',
            'Số khế ước cho vay': '',
            'Mã khoản mục chi phí': '',
            'Mã đơn vị': '',
            'Mã đối tượng THCP': '',
            'Mã công trình': maCT,
            'Số đơn đặt hàng': '',
            'Số đơn mua hàng': '',
            'Số hợp đồng mua': '',
            'Số hợp đồng bán': '',
            'Mã thống kê': '',
            'CP không hợp lý': '',
            'Số HĐ khớp': soHD,
            'Tổng tiền HĐ khớp': tienHD,
            'Doanh thu (VietQR)': Math.round(amt),
            'Chênh lệch HĐ vs doanh thu': Math.round(tienHD - amt),
            'Trạng thái': !soHD ? 'Chưa có HĐ' : (Math.abs(tienHD - amt) <= 1000 ? 'Khớp' : 'Lệch'),
          });
        });
        seq++;
      });
      return { rows, nextSeq: seq };
    }
    async function confirmExportVietQrMisa(bankOrAll) {
      const stEl = document.getElementById('vietqrMisaModalStatus');
      const fromIso = (document.getElementById('vietqrMisaFromDate')||{}).value;
      const toIso   = (document.getElementById('vietqrMisaToDate')||{}).value;
      const startSeq = parseInt((document.getElementById('vietqrMisaStartSeq')||{}).value, 10) || 1;
      if (!fromIso || !toIso) { if (stEl) stEl.textContent = 'Vui lòng chọn đủ Từ ngày và Đến ngày.'; return; }
      if (fromIso > toIso) { if (stEl) stEl.textContent = 'Từ ngày phải trước Đến ngày.'; return; }

      const banksToExport = bankOrAll === 'all' ? VIETQR_BANKS : [bankOrAll];
      if (stEl) stEl.textContent = 'Đang tải dữ liệu ngân hàng...';
      for (const b of banksToExport) { try { await fetchBankVietQr(b); } catch(e) {} }
      if (stEl) stEl.textContent = '';
      closeVietQrMisaModal();

      const results = [];
      banksToExport.forEach(bank => {
        if (!_vietqrTxn[bank].length) { results.push({ bank, ok:false, msg:'Chưa có dữ liệu giao dịch.' }); return; }
        if (!_vietqrBankInfo[bank]) { results.push({ bank, ok:false, msg:'Chưa lấy được thông tin TK ngân hàng — bấm "Làm mới NH" ở tab này trước.' }); return; }
        const { rows } = buildVietQrMisaRows({
          bank, byDate: buildVietQrByDateForExport(bank),
          fromIso, toIso, startSeq,
        });
        if (!rows.length) { results.push({ bank, ok:false, msg:'Không có dòng nào để xuất trong khoảng ngày đã chọn.' }); return; }
        const wb = XLSX.utils.book_new();
        XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(rows), 'MISAThue VietQR');
        const fname = 'MISAThue-vietqr-' + bank + '_' + fromIso + '_den_' + toIso + '.xlsx';
        XLSX.writeFile(wb, fname);
        results.push({ bank, ok:true, fname, count: rows.length });
      });

      const msgs = results.map(r => r.ok
        ? `✅ ${VIETQR_BANK_LABEL[r.bank]}: ${r.count} dòng → ${r.fname}`
        : `⚠️ ${VIETQR_BANK_LABEL[r.bank]}: ${r.msg}`);
      alert(msgs.join('\n'));
    }

    function saveVietQrHD(bank, hdKey, field, val) {
      if(!_vietqrHD[bank][hdKey]) _vietqrHD[bank][hdKey] = {};
      _vietqrHD[bank][hdKey][field] = val.trim();
      if (field==='soHD'||field==='tienHD') _vietqrHD[bank][hdKey]._manual = true;
      try { lsSet(lsVietqrHDKey(bank), JSON.stringify(_vietqrHD[bank])); } catch(e){}
    }
    function vqHDEdit(spanEl, bank, hdKey, field) {
      const cur = _vietqrHD[bank][hdKey] ? (_vietqrHD[bank][hdKey][field]||'') : '';
      const inp = document.createElement('input');
      inp.value = cur;
      inp.style.cssText = 'width:' + (field==='soHD'?'90px':'110px') + ';border:1px solid #16a34a;border-radius:4px;padding:.15rem .3rem;font-size:.8em;' + (field==='tienHD'?'text-align:right':'text-align:center');
      inp.onblur = () => { saveVietQrHD(bank, hdKey, field, inp.value); renderVietQrDoiSoat(bank); };
      inp.onkeydown = e => { if(e.key==='Enter'||e.key==='Escape') inp.blur(); };
      spanEl.replaceWith(inp);
      inp.focus(); inp.select();
    }

    // Luyen, 2026-09-11: "cho tôi nút sửa nhá với lại sửa nhá giống bên vnpay
    // á" -- mo/dong bang sua ngay giong cac kenh khac (togglePayooEditPanel),
    // va luu lai "Số tiền (NH)" sua tay (amtOvr) + Số HĐ/Tiền HĐ cho tung ma
    // CT trong ngay do, roi ve lai bang.
    function toggleVietQrEditPanel(bank, dateId) {
      const row = document.getElementById('edit_vietqr_' + bank + '_' + dateId);
      if (!row) return;
      row.style.display = row.style.display === 'none' ? '' : 'none';
    }
    function saveVietQrEditPanel(bank, dateId, date, btnEl) {
      const gianList = btnEl && btnEl.dataset && btnEl.dataset.gians ? JSON.parse(btnEl.dataset.gians) : [];
      gianList.forEach(maCT => {
        const gKey = maCT.replace(/[^a-zA-Z0-9]/g,'_');
        const hdKey = date + '|' + maCT;
        if (!_vietqrHD[bank][hdKey]) _vietqrHD[bank][hdKey] = {};
        const amtEl   = document.getElementById('vqedit_amt_'+bank+'_'+dateId+'_'+gKey);
        const soHDEl  = document.getElementById('vqedit_soHD_'+bank+'_'+dateId+'_'+gKey);
        const tienEl  = document.getElementById('vqedit_tienHD_'+bank+'_'+dateId+'_'+gKey);
        const amtOvr  = amtEl ? amtEl.value.trim() : '';
        const soHD    = soHDEl ? soHDEl.value.trim() : '';
        const tienHD  = tienEl ? tienEl.value.trim() : '';
        _vietqrHD[bank][hdKey].amtOvr = amtOvr;
        _vietqrHD[bank][hdKey].soHD   = soHD;
        _vietqrHD[bank][hdKey].tienHD = tienHD;
        if (amtOvr || soHD || tienHD) _vietqrHD[bank][hdKey]._manual = true;
      });
      try { lsSet(lsVietqrHDKey(bank), JSON.stringify(_vietqrHD[bank])); } catch(e){}
      renderVietQrDoiSoat(bank);
    }

    function renderVietQrHist(bank) {
      const el = document.getElementById('vietqrHistBody_'+bank);
      if(!el) return;
      const hist = _vietqrHist[bank];
      if(!hist.length) { el.innerHTML='<div class="empty-state"><div class="big-icon">⏱️</div><p>Chưa có lịch sử tải</p></div>'; return; }
      let html='<table style="width:100%;border-collapse:collapse;font-size:.84em"><thead><tr style="background:#dcfce7;color:#166534"><th style="padding:.3rem .5rem;text-align:left">File</th><th style="padding:.3rem .5rem">Thêm</th><th style="padding:.3rem .5rem">Bỏ qua</th><th style="padding:.3rem .5rem;text-align:left">Thời gian</th></tr></thead><tbody>';
      hist.slice(0,20).forEach((h,i) => {
        html+=`<tr style="background:${i%2?'#f0fdf4':'#fff'}">
          <td style="padding:.3rem .5rem;font-size:.8em;color:#475569">${h.file}</td>
          <td style="padding:.3rem .5rem;text-align:center;color:#16a34a;font-weight:700">+${h.added}</td>
          <td style="padding:.3rem .5rem;text-align:center;color:#94a3b8">${h.skip}</td>
          <td style="padding:.3rem .5rem;font-size:.8em;color:#64748b">${h.at}</td>
        </tr>`;
      });
      html+='</tbody></table>';
      el.innerHTML=html;
    }

    function toggleBankVietQrDetail(bank) {
      const p = document.getElementById('bankVietQrDetailPanel_'+bank);
      if(p) p.style.display = p.style.display==='none' ? '' : 'none';
    }
    function renderBankVietQrRaw(bank) {
      const tb = document.getElementById('bankVietQrRawBody_'+bank);
      if(!tb) return;
      const list = _bankVietqr[bank] || [];
      if(!list.length) { tb.innerHTML = '<tr><td colspan="4" style="color:#64748b;padding:.4rem">Không tìm thấy giao dịch nào có mã VQR</td></tr>'; return; }
      tb.innerHTML = list.slice(0,300).map((t,i) => {
        const amt = Math.round(t.amount).toLocaleString('vi');
        return `<tr style="border-top:1px solid #14532d">
          <td style="padding:.2rem .5rem;color:#64748b">${i+1}</td>
          <td style="padding:.2rem .5rem;color:#bbf7d0">${t.date}</td>
          <td style="padding:.2rem .5rem;text-align:right;color:#86efac">${amt}đ</td>
          <td style="padding:.2rem .5rem;color:#94a3b8;font-size:.78em">${t.vqrCode || t.reference || ''} — ${(t.desc||'').substring(0,60)}</td>
        </tr>`;
      }).join('');
    }
    async function fetchBankVietQr(bank) {
      const st = document.getElementById('bankVietQrStatus_'+bank);
      if(st) st.textContent = '⏳ Đang tải...';
      try {
        const res = await fetch('/api/dau-ra/bank-vietqr?bank='+bank);
        const json = await res.json();
        if(json.ok) {
          _bankVietqr[bank] = json.transactions || [];
          _bankVietqrMap[bank] = {};
          _bankVietqrRefMap[bank] = {};
          _vietqrBankInfo[bank] = { account: json.bankAccount || '', fullName: json.bankFullName || '' };
          _bankVietqr[bank].forEach(t => {
            if(t.vqrCode) _bankVietqrMap[bank][t.vqrCode] = t;
            if(t.reference) _bankVietqrRefMap[bank][t.reference] = t;
          });
          if(st) st.textContent = '✓ '+_bankVietqr[bank].length+' GD ngân hàng có mã VQR/mã tham chiếu';
          renderBankVietQrRaw(bank);
          renderVietQrSummary(bank);
          renderVietQrDoiSoat(bank);
        } else if(st) st.textContent = '❌ '+json.error;
      } catch(e) { if(st) st.textContent = '❌ Lỗi kết nối'; }
    }
    async function fetchBankVietQrRefresh(bank) {
      await fetchBankVietQr(bank);
      const p = document.getElementById('bankVietQrDetailPanel_'+bank);
      if(p) p.style.display = '';
    }

    // ── Auto map MTT → Viet QR ── mirror autoMapMttPayoo, chỉ đổi nguồn
    // gross theo _vietqrTxn (đã áp dụng "ngân hàng làm chuẩn") và lọc dịch
    // vụ thu hộ theo "vietqr"/tên ngân hàng — CHƯA xác nhận chính xác text
    // MTT dùng cho Viet QR, cần Luyen kiểm tra lại nếu không ra kết quả.
    function autoMapMttVietQr(bank) {
      const khKey = COMPANY === 'kh_cu' ? 'cu' : 'moi';
      const mttRows = khKey === 'cu' ? _mttCu : _mttMoi;
      if (!mttRows.length) { alert('Chưa có dữ liệu MTT. Vui lòng tải file MTT trước.'); return; }
      // Luyen, 2026-09-11: "chỗ hóa đơn á có chỗ dịch vụ thu hộ là 7020 là
      // của 7020 á" -- xac nhan tren du lieu that: MTT ghi "Dịch vụ thu hộ"
      // dang "POSH+JP MB (7020) 29,30,31" (khong ghi ten/ma ngan hang day
      // du) -- so khop theo so cuoi TK trong dau ngoac "(ddd(d))", KHONG
      // dung ten ngan hang day du nhu truoc (khong bao gio khop). Rieng
      // MB11521268: Luyen gui sample "POSH+JP MB (268) 29,30" -- ngoac chi
      // co 3 so cuoi "268" (khong phai 4 so "1268" nhu doan truoc), da doi
      // xac nhan lai tren toan bo du lieu MTT that: dung 26 dong dang
      // "POSH+JP MB (268) <ngay>", khong dong nao khac trung "268" gay
      // nham lan.
      //
      // Chi Nhan, 2026-09-12: them 4 TK Viet QR cua KH Moi -- Luyen xac nhan
      // tag "Dịch vụ thu hộ" dung cho tung TK: BIDV7702 = "MTD MN", BIDV77021
      // = "VietQR POSH MB", MB02865168 = "POSH TK168"/"JP TK168", BIDV8613600999
      // = "QR JP" (deu kem theo ngay o cuoi, giong cau truc KH Cu). DUNG LAI
      // CHINH XAC cac regex tagPattern da xac nhan/dang chay that trong
      // CHANNELS cua routes/doisoat-vietqr.js (khong doan lai) -- doi tu so
      // khop chuoi con (bankKeywords.some(s.includes)) sang regex .test() vi
      // 3 TK bidv77021/mb02865168/bidv8613600999 co phan tag CHUNG got chu
      // ("VietQR POSH MB"/"QR JP") chi khac o hau to "tk 168" hay khong -- so
      // khop chuoi con don gian se bi LAN (vd "qr jp" cung la substring cua
      // "qr jp tk 168") neu khong loai truong hop co "tk" bang lookahead nhu
      // ban goc.
      const VIETQR_TAG_PATTERN = {
        bidv7704:   /POSH\+JP\s*MB\s*\(7704\)/i,
        bidv77020:  /POSH\+JP\s*MB\s*\(7020\)/i,
        mb11521268: /POSH\+JP\s*MB\s*\(268\)/i,
        bidv7702:      /MTD\s*MN/i,
        bidv77021:     /VietQR\s*POSH\s*MB(?!\s*tk)/i,
        mb02865168:    /(?:VietQR\s*POSH\s*MB|POSH|QR\s*JP)\s*tk\s*168/i,
        bidv8613600999:/QR\s*JP(?!\s*tk)/i,
      };
      const tagPattern = VIETQR_TAG_PATTERN[bank];
      const vqMtt = mttRows.filter(r => {
        const s = r.dichVuThuHo || '';
        if (tagPattern && tagPattern.test(s)) return true;
        // Fallback chung (giu lai hanh vi cu cho KH Cu): dong nao ghi ro chu
        // "vietqr"/"viet qr" ma khong khop tag rieng cua bat ky TK nao khac.
        const low = s.toLowerCase();
        return (low.includes('vietqr') || low.includes('viet qr')) &&
          !Object.entries(VIETQR_TAG_PATTERN).some(([b,p]) => b!==bank && p.test(s));
      });
      if (!vqMtt.length) { alert('Không tìm thấy hóa đơn MTT nào khớp Viet QR / '+VIETQR_BANK_LABEL[bank]+'.\nKiểm tra lại cột "Dịch vụ thu hộ" trong MTT (có thể chưa đúng từ khóa lọc, báo lại để chỉnh).'); return; }

      const maDiemToMaCT = _mttCtMap[khKey] || {};
      const parseDays = s => { const m = /(\d+(?:\s*,\s*\d+)*)\s*$/.exec(s||''); if(!m) return []; return m[1].split(',').map(x=>parseInt(x.trim(),10)).filter(n=>!isNaN(n)); };
      const resolveDate = (ngayHD, dayNum) => {
        const p = String(ngayHD||'').split('/'); if(p.length!==3) return null;
        const dd=+p[0], mm=+p[1], yy=+p[2]; let month=mm, year=yy;
        if (dayNum > dd) { month -= 1; if(month<1){month=12;year-=1;} }
        return String(dayNum).padStart(2,'0')+'-'+String(month).padStart(2,'0')+'-'+year;
      };

      const grossByDateCT = {};
      _vietqrTxn[bank].forEach(r => {
        const tenDiem = getVietQrTenDiem(r.maCuaHang);
        const maCT = getVietQrMaCT(bank, r.maCuaHang);
        const bankHit = getVietQrBankHit(bank, r);
        const amt = bankHit ? bankHit.amount : r.amount;
        const key = r.date+'|'+maCT;
        grossByDateCT[key] = (grossByDateCT[key]||0) + amt;
      });

      Object.keys(_vietqrHD[bank]).forEach(k => {
        if (_vietqrHD[bank][k] && !_vietqrHD[bank][k]._manual) { delete _vietqrHD[bank][k].soHD; delete _vietqrHD[bank][k].tienHD; }
      });

      let filled = 0, skipped = 0;
      vqMtt.forEach(r => {
        const days = parseDays(r.dichVuThuHo);
        if (!days.length || !r.ngay) return;
        const maCT = maDiemToMaCT[r.maDiem] || r.maDiem;
        const dates = days.map(d => resolveDate(r.ngay, d)).filter(Boolean);
        if (!dates.length) return;
        const grosses = dates.map(dt => grossByDateCT[dt+'|'+maCT] || 0);
        const totalGross = grosses.reduce((s,g)=>s+g,0);
        dates.forEach((dt,i) => {
          const hdKey = dt+'|'+maCT;
          const existing = _vietqrHD[bank][hdKey];
          if (existing && existing._manual) { skipped++; return; }
          const share = totalGross>0 ? (grosses[i]/totalGross) : (1/dates.length);
          const portion = Math.round(r.tongTien * share);
          if (!_vietqrHD[bank][hdKey]) _vietqrHD[bank][hdKey] = {};
          const prevHD = String(_vietqrHD[bank][hdKey].soHD||'').split(',').map(s=>s.trim()).filter(Boolean);
          if (!prevHD.includes(String(r.soHD))) prevHD.push(String(r.soHD));
          _vietqrHD[bank][hdKey].soHD = prevHD.join(', ');
          _vietqrHD[bank][hdKey].tienHD = String((parseFloat(_vietqrHD[bank][hdKey].tienHD)||0) + portion);
          filled++;
        });
      });

      try { lsSet(lsVietqrHDKey(bank), JSON.stringify(_vietqrHD[bank])); } catch(e){}
      renderVietQrDoiSoat(bank);
      alert(`✅ Map xong: ${filled} ô hóa đơn (tự chia tỷ lệ / cộng dồn nếu gộp nhiều ngày) · Bỏ qua ${skipped} ô đã tự nhập tay`);
    }

    // Init Zalo Pay + VNPay + Payoo + Viet QR
    renderZaloSummary(); renderZaloDoiSoat(); renderZaloCtMap(); renderZaloHist();
    fetchBankZalo();
    renderVnpaySummary(); renderVnpayDoiSoat(); renderVnpayCtMap(); renderVnpayHist();
    fetchBankVnpay();
    renderPayooSummary(); renderPayooDoiSoat(); renderPayooCtMap(); renderPayooHist();
    fetchBankPayoo();
    VIETQR_BANKS.forEach(b => { renderVietQrSummary(b); renderVietQrDoiSoat(b); renderVietQrHist(b); fetchBankVietQr(b); });
    renderVietQrDiemMap(); renderVietQrCtMap();

  </script>
</body>
</html>

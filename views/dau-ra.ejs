    // ── Auto map MTT → Payoo Đối soát ── (Luyen, 2026-09-10: "cho 1 chỗ map
    // với hóa đơn nữa nè chỗ dịch vụ thu hộ á để payoo" -- y hệt
    // autoMapMttVnpay, chỉ đổi lọc dịch vụ thu hộ sang "payoo" và tính DT
    // theo _payooFee (getPayooMaCT). "Dịch vụ thu hộ" MTT của Payoo không
    // phân biệt QR/Thẻ (vd "PAYOO 5,6") -- không sao vì maDiem trong MTT map
    // sang ĐÚNG 1 Mã CT, và Mã CT đó trong _payooFee vốn đã CỘNG GỘP cả QR
    // lẫn Thẻ nếu Luyen map cả 2 hình thức của 1 cửa hàng về cùng 1 Mã CT
    // (giống cách đối soát ngân hàng cũng đã gộp chung).
    function autoMapMttPayoo() {
      const khKey   = COMPANY === 'kh_cu' ? 'cu' : 'moi';
      const mttRows = khKey === 'cu' ? _mttCu : _mttMoi;
      if (!mttRows.length) { alert('Chưa có dữ liệu MTT. Vui lòng tải file MTT trước.'); return; }

      const payooMtt = mttRows.filter(r => (r.dichVuThuHo||'').toLowerCase().includes('payoo'));
      if (!payooMtt.length) { alert('Không tìm thấy hóa đơn MTT nào có dịch vụ thu hộ = PAYOO.'); return; }

      const maDiemToMaCT = _mttCtMap[khKey] || {};

      const parseDays = s => {
        const m = /(\d+(?:\s*,\s*\d+)*)\s*$/.exec(s||'');
        if (!m) return [];
        return m[1].split(',').map(x=>parseInt(x.trim(),10)).filter(n=>!isNaN(n));
      };
      const resolveDate = (ngayHD, dayNum) => {
        const p = String(ngayHD||'').split('/');
        if (p.length !== 3) return null;
        const dd = +p[0], mm = +p[1], yy = +p[2];
        let month = mm, year = yy;
        if (dayNum > dd) { month -= 1; if (month < 1) { month = 12; year -= 1; } }
        return String(dayNum).padStart(2,'0')+'-'+String(month).padStart(2,'0')+'-'+year;
      };

      const grossByDateCT = {};
      _payooFee.forEach(r => {
        const maCT = getPayooMaCT(r.gian);
        const key = r.date+'|'+maCT;
        grossByDateCT[key] = (grossByDateCT[key]||0) + r.gross;
      });

      Object.keys(_payooHD).forEach(k => {
        if (_payooHD[k] && !_payooHD[k]._manual) {
          delete _payooHD[k].soHD; delete _payooHD[k].tienHD;
        }
      });

      let filled = 0, skipped = 0;
      payooMtt.forEach(r => {
        const days = parseDays(r.dichVuThuHo);
        if (!days.length || !r.ngay) return;
        const maCT = maDiemToMaCT[r.maDiem] || r.maDiem;
        const dates = days.map(d => resolveDate(r.ngay, d)).filter(Boolean);
        if (!dates.length) return;
        const grosses = dates.map(dt => grossByDateCT[dt+'|'+maCT] || 0);
        const totalGross = grosses.reduce((s,g)=>s+g,0);
        dates.forEach((dt, i) => {
          const hdKey = dt+'|'+maCT;
          const existing = _payooHD[hdKey];
          if (existing && existing._manual) { skipped++; return; }
          const share = totalGross>0 ? (grosses[i]/totalGross) : (1/dates.length);
          const portion = Math.round(r.tongTien * share);
          if (!_payooHD[hdKey]) _payooHD[hdKey] = {};
          const prevHD = String(_payooHD[hdKey].soHD||'').split(',').map(s=>s.trim()).filter(Boolean);
          if (!prevHD.includes(String(r.soHD))) prevHD.push(String(r.soHD));
          _payooHD[hdKey].soHD   = prevHD.join(', ');
          _payooHD[hdKey].tienHD = String((parseFloat(_payooHD[hdKey].tienHD)||0) + portion);
          filled++;
        });
      });

      try { lsSet(LS_PAYOO_HD, JSON.stringify(_payooHD)); } catch(e){}
      renderPayooDoiSoat();
      alert(`✅ Map xong: ${filled} ô hóa đơn (tự chia tỷ lệ / cộng dồn nếu gộp nhiều ngày) · Bỏ qua ${skipped} ô đã tự nhập tay`);
    }

    function savePayooHD(hdKey, field, val) {
      if(!_payooHD[hdKey]) _payooHD[hdKey] = {};
      _payooHD[hdKey][field] = val.trim();
      if (field === 'soHD' || field === 'tienHD') _payooHD[hdKey]._manual = true;
      try { lsSet(LS_PAYOO_HD, JSON.stringify(_payooHD)); } catch(e){}
    }
    function pHDEdit(spanEl, hdKey, field) {
      const cur = _payooHD[hdKey] ? (_payooHD[hdKey][field]||'') : '';
      const inp = document.createElement('input');

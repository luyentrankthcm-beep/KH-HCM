    // ── Fetch các đợt NH trả Momo về cho Đối soát ngày ──
    async function fetchBankMomo() {
      if (!_dates.length) return;
      const toYMD = d => { const [dd,mm,yy] = d.split('-'); return `${yy}-${mm}-${dd}`; };
      const sorted = [..._dates].sort((a, b) => toYMD(a).localeCompare(toYMD(b)));
      const from = toYMD(sorted[0]);
      const to   = toYMD(sorted[sorted.length - 1]);
      // Luyen, 2026-09-11: trước đây hardcode '7701' (chỉ đúng cho KH Mới -
      // TK 8620107701) khiến KH Cũ (TK 8699123456) KHÔNG BAO GIỜ khớp được
      // ngân hàng nào -- _bankMomoPayments luôn rỗng, mất hẳn tính năng gom
      // theo đợt NH trả cho KH Cũ. Sửa lại theo đúng COMPANY như MOMO_BANK_ACCOUNT.
      const account = COMPANY === 'kh_moi' ? '7701' : '123456';
      try {
        const res  = await fetch(`/api/dau-ra/bank-momo?account=${account}&from=${from}&to=${to}`);
        const json = await res.json();
        if (json.ok) {
          _bankMomoPayments = json.payments || [];
          renderDoiSoatNgay();
        }
      } catch(e) { /* im lặng nếu fail */ }
    }

    // ── Fetch net thực từ Tổng Momo (server) để hiển thị số đúng trong Đối soát ngày ──
    async function fetchServerNet() {
      if (!_dates.length) return;
      const toYMD = d => { const [dd,mm,yy] = d.split('-'); return `${yy}-${mm}-${dd}`; };
      const sorted = [..._dates].sort((a, b) => toYMD(a).localeCompare(toYMD(b)));
      const from = toYMD(sorted[0]);
      const to   = toYMD(sorted[sorted.length - 1]);
      try {
        const res  = await fetch(`/api/dau-ra/momo-net-by-code?from=${from}&to=${to}`);
        const json = await res.json();
        if (json.ok) {
          _serverNet   = json.netByCode   || {};
          _serverGross = json.grossByCode || {};
          renderDoiSoatNgay();
        }
      } catch(e) { /* im lặng nếu fail */ }
    }


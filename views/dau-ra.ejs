      _vnpayHD[hdKey][field] = val.trim();
      if (field === 'soHD' || field === 'tienHD') _vnpayHD[hdKey]._manual = true;
      try { lsSet(LS_VNPAY_HD, JSON.stringify(_vnpayHD)); } catch(e){}
    }
    function vHDEdit(spanEl, hdKey, field) {

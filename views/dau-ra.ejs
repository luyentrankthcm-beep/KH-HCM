      inp.style.cssText = 'width:' + (field==='soHD'?'90px':'110px') + ';border:1px solid #7c3aed;border-radius:4px;padding:.15rem .3rem;font-size:.8em;' + (field==='tienHD'?'text-align:right':'text-align:center');
      inp.onblur = () => { savePayooHD(hdKey, field, inp.value); renderPayooDoiSoat(); };
      inp.onkeydown = e => { if(e.key==='Enter'||e.key==='Escape') inp.blur(); };
      spanEl.replaceWith(inp);
      inp.focus(); inp.select();
    }


  <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
  <script>
    // ── Company key (for localStorage namespacing) ──
    const COMPANY = '<%= activeCompany %>';

    // ── Đồng bộ dữ liệu với SERVER (để mở web ở máy/trình duyệt/tài khoản
    // nào cũng thấy giống nhau, không còn lệ thuộc localStorage của riêng
    // từng trình duyệt nữa) ──
    // Toàn bộ code phía dưới đọc localStorage NGAY khi script chạy (không đợi
    // sự kiện gì cả) nên phải kéo dữ liệu server về ghi đè vào localStorage
    // TRƯỚC khi các đoạn code đó chạy -- dùng XHR đồng bộ (chặn 1 nhịp lúc
    // tải trang) thay vì fetch bất đồng bộ để đảm bảo đúng thứ tự này, không
    // phải sửa lại toàn bộ logic đọc/parse/render đã có bên dưới.
    // Giữ tham chiếu GỐC tới localStorage.setItem/removeItem (bind sẵn) --
    // dùng biến _rawLsSet/_rawLsRemove bên trong lsSet/lsRemove (thay vì gọi
    // thẳng localStorage.setItem/removeItem) để tránh gọi đệ quy vô hạn.
    const _rawLsSet    = localStorage.setItem.bind(localStorage);
    const _rawLsRemove = localStorage.removeItem.bind(localStorage);
    const _rawLsGet    = localStorage.getItem.bind(localStorage);

    // Chi Nhan, 2026-09-10: Luyen báo "tải Payoo lên xong, F5 lại thì mất hết
    // chỉ còn 1 ngày" -- ĐIỀU TRA: server vẫn lưu ĐỦ 6256 dòng (kiểm tra qua
    // /api/dau-ra/kv-all), nhưng localStorage của trình duyệt CHỈ có 46 dòng.
    // Nguyên nhân thật: trình duyệt giới hạn localStorage ~5MB/site — cộng dồn
    // Momo+MTT+Zalo+VNPay+Payoo đã gần chạm mức này (đo được 4.7MB), nên khi
    // hydrateFromServer() ghi đè localStorage bằng dữ liệu server cho TỪNG
    // key, key Payoo (~1MB, ghi sau các key khác) bị trình duyệt TỪ CHỐI ghi
    // (lỗi "exceeded the quota") — code cũ "try{...}catch(e){}" NUỐT LỖI ÂM
    // THẦM nên không ai biết, để lại giá trị CŨ/NHỎ hơn trong localStorage từ
    // lần lưu trước đó, khiến trang đọc nhầm dữ liệu cũ dù server có đủ.
    // Fix TẬN GỐC (áp dụng chung cho MỌI key hiện tại lẫn sau này, không cần
    // sửa từng chỗ đọc localStorage rải rác khắp file): giữ 1 bản sao dữ liệu
    // server NGAY TRONG BỘ NHỚ (_serverKv) và THAY THẾ luôn localStorage.getItem
    // để ưu tiên đọc từ bản sao này khi có — dù ghi thật xuống đĩa localStorage
    // có thất bại do đầy quota, mọi đoạn code đọc lại NGAY SAU ĐÓ trong phiên
    // này vẫn thấy đúng dữ liệu server mới nhất (localStorage lúc này chỉ còn
    // là lớp cache "cố gắng tốt nhất", không còn là nguồn có thể làm mất dữ
    // liệu nữa).
    let _serverKv = {};
    // Luyen, 2026-09-11: "sao lại bị mất dữ liệu rồi nè" -- Momo tu nhien chi
    // con hien "84 GD · 2 ngày" du server van luu du 12.420 dong (kiem tra
    // truc tiep qua /api/dau-ra/kv-all luc do van thay du) -- goc re: request
    // dong bo nay chay dung luc Railway dang restart (deploy code moi) nen
    // nhan ve loi 502 tam thoi (server chua kip nhan request), khien
    // "if (xhr.status === 200)" false va _serverKv bi bo trong RONG, roi moi
    // localStorage.getItem sau do fallback ve du lieu THAT trong trinh duyet
    // (con lai tu lan bi tran quota rat lau truoc -- xem ghi chu ngay tren) --
    // dung 46-84 dong con sot, KHONG phai mat that. Them thu lai vai lan neu
    // status khac 200 hoac loi mang -- 502 luc dang restart deploy thuong tu
    // het chi sau 1-2 giay, thu lai ngay (khong can cho, XHR dong bo da du
    // do tre) se vuot qua duoc hau het truong hop nay.
    (function hydrateFromServer() {
      for (let attempt = 1; attempt <= 4; attempt++) {
        try {
          const xhr = new XMLHttpRequest();
          xhr.open('GET', '/api/dau-ra/kv-all', false); // false = đồng bộ (chặn)
          xhr.send(null);
          if (xhr.status === 200) {
            const res = JSON.parse(xhr.responseText);
            if (res && res.ok && res.data) {
              _serverKv = res.data;
              Object.keys(res.data).forEach(k => {
                try { _rawLsSet(k, res.data[k]); } catch(e) { console.warn('[hydrate] localStorage đầy quota, giữ tạm trong bộ nhớ cho key:', k, e.message); }
              });
            }
            return;
          }
          console.warn('[hydrate] status', xhr.status, '-- thử lại lần', attempt);
        } catch(e) { console.warn('[hydrate] lỗi mạng, thử lại lần', attempt, e.message); }
      }
      console.error('Không đồng bộ được dữ liệu từ server sau nhiều lần thử -- trang có thể hiện thiếu dữ liệu, tải lại (F5) để thử lại.');
    })();
    localStorage.getItem = function(key) {
      if (Object.prototype.hasOwnProperty.call(_serverKv, key)) return _serverKv[key];
      return _rawLsGet(key);
    };
    // Đẩy dữ liệu lên server mỗi khi có thay đổi.
    // Chi Nhan, 2026-09-10: Luyen bao "tôi tải lên xong nhấn F5 mất hết dữ
    // liệu" -- truoc day dung fetch() bat-dong-bo kieu "fire-and-forget",
    // neu Luyen F5/dong tab NGAY sau khi tai file (nhat la file lon nhu Momo
    // ~12 nghin dong) thi request POST len server co the CHUA kip xong da bi
    // huy giua chung -> lan sau load lai, server tra ve du lieu CU (hoac
    // rong), ghi de mat du lieu vua tai. Doi sang XMLHttpRequest DONG BO
    // (giong cach hydrateFromServer dang doc), de ham lsSet/lsRemove CHI
    // return sau khi server da luu xong -- dam bao F5 ngay sau khi tai file
    // van an toan, khong mat du lieu (danh doi: khung UI dung khoang 1 giay
    // trong luc luu, chap nhan duoc de tranh mat du lieu).
    // Chi Nhan, 2026-09-11: Luyen bao "tôi đẩy map lên xong hay đối soát tải
    // xong cái lát quay lại lại mất" -- goc re: ham nay truoc day GUI XONG LA
    // COI NHU XONG, khong he kiem tra xhr.status/response -- neu request
    // trung dung luc Railway dang restart (vd ngay sau 1 lan tôi git push
    // trong luc Luyen dang thao tac) se nhan ve loi 502/500 (hoac loi mang),
    // XHR dong bo KHONG throw exception cho truong hop nay (chi throw khi mat
    // ket noi han), nen catch(e) khong bat duoc, ham tra ve BINH THUONG nhu
    // da luu thanh cong -- man hinh Luyen dang xem van con du lieu (o
    // localStorage/bo nho), nhung SERVER THUC RA CHUA HE NHAN DUOC. Den luc
    // sau do quay lai / mo may khac, hydrateFromServer keo du lieu THAT tu
    // server ve (khong co ban vua sua) -- nhin nhu "bi mat" nhung thuc chat
    // la CHUA BAO GIO DUOC LUU. Fix: kiem tra xhr.status===200 VA
    // res.ok===true, thu lai toi 4 lan (loi 502 luc restart thuong tu het chi
    // sau 1-2 giay) - neu van that bai het thi BAO LOI RO RANG cho Luyen biet
    // (thay vi im lang mat du lieu), de Luyen thu lai thao tac ngay.
    function kvPush(key, value) {
      for (let attempt = 1; attempt <= 4; attempt++) {
        try {
          const xhr = new XMLHttpRequest();
          xhr.open('POST', '/api/dau-ra/kv', false); // false = đồng bộ, đợi lưu xong
          xhr.setRequestHeader('Content-Type', 'application/json');
          xhr.send(JSON.stringify({ key, value }));
          if (xhr.status === 200) {
            let res = null;
            try { res = JSON.parse(xhr.responseText); } catch(e) {}
            if (res && res.ok) return; // luu thanh cong
            console.warn('[kvPush] server trả lỗi, thử lại lần', attempt, res && res.error);
          } else {
            console.warn('[kvPush] status', xhr.status, '-- thử lại lần', attempt);
          }
        } catch(e) { console.warn('[kvPush] lỗi mạng, thử lại lần', attempt, e.message); }
      }
      alert('⚠️ LƯU DỮ LIỆU LÊN SERVER THẤT BẠI (key: ' + key + ') sau nhiều lần thử.\n\nThay đổi vừa rồi CÓ THỂ CHƯA được lưu -- vui lòng tải lại trang (F5) để kiểm tra, và làm lại thao tác nếu cần. Đừng đóng tab/tắt máy ngay lúc này.');
    }
    function kvRemove(key) {
      for (let attempt = 1; attempt <= 4; attempt++) {
        try {
          const xhr = new XMLHttpRequest();
          xhr.open('POST', '/api/dau-ra/kv-delete', false);
          xhr.setRequestHeader('Content-Type', 'application/json');
          xhr.send(JSON.stringify({ key }));
          if (xhr.status === 200) {
            let res = null;
            try { res = JSON.parse(xhr.responseText); } catch(e) {}
            if (res && res.ok) return;
            console.warn('[kvRemove] server trả lỗi, thử lại lần', attempt, res && res.error);
          } else {
            console.warn('[kvRemove] status', xhr.status, '-- thử lại lần', attempt);
          }
        } catch(e) { console.warn('[kvRemove] lỗi mạng, thử lại lần', attempt, e.message); }
      }
      alert('⚠️ XOÁ DỮ LIỆU TRÊN SERVER THẤT BẠI (key: ' + key + ') sau nhiều lần thử.\n\nVui lòng tải lại trang (F5) để kiểm tra lại.');
    }
    // Thay cho localStorage.setItem/removeItem trực tiếp: vẫn ghi local như
    // cũ (đọc lại tức thì) + đồng thời đẩy lên server ở nền. Cập nhật
    // _serverKv NGAY (đồng bộ) trước khi thử ghi localStorage thật -- đề
    // phòng ghi localStorage thật bị đầy quota (xem ghi chú hydrateFromServer
    // ở trên), các lần đọc SAU trong cùng phiên vẫn thấy đúng giá trị mới.
    function lsSet(key, val) {
      _serverKv[key] = val;
      try { _rawLsSet(key, val); } catch(e) { console.warn('[lsSet] localStorage đầy quota, chỉ giữ trong bộ nhớ + server:', key, e.message); }
      kvPush(key, val);
    }
    function lsRemove(key) {
      delete _serverKv[key];
      try { _rawLsRemove(key); } catch(e) {}
      kvRemove(key);
    }
    const LS_ROWS    = `momo_rows_${COMPANY}`;
    const LS_HISTORY = `momo_history_${COMPANY}`;
    const LS_CT_MAP   = `momo_ct_map_${COMPANY}`;
    const LS_CT_CODES = `momo_ct_codes_${COMPANY}`;
    const LS_HD_DATA  = `momo_hd_${COMPANY}`;

    // ── Tab switching ──
    const LS_ACTIVE_TAB     = `dauRaTab_${COMPANY}`;
    const LS_ACTIVE_ZVP_SUB = `dauRaZvpSub_${COMPANY}`;
    function switchTab(id, btn) {
      document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
      document.querySelectorAll('.tab-bar .tab-btn').forEach(b => b.classList.remove('active'));
      document.getElementById(id).classList.add('active');
      btn.classList.add('active');
      try { localStorage.setItem(LS_ACTIVE_TAB, id); } catch(e) {}
    }
    function switchZvpTab(sub) {
      ['zalo','vnpay','payoo'].forEach(s => {
        document.getElementById('zvp_' + s).classList.toggle('active', s === sub);
        document.getElementById('zvp_btn_' + s).classList.toggle('active', s === sub);
      });
      try { localStorage.setItem(LS_ACTIVE_ZVP_SUB, sub); } catch(e) {}
    }
    function switchSub(tabId, subId, btn) {
      const panel = document.getElementById(tabId);
      panel.querySelectorAll('.sub-panel').forEach(p => p.classList.remove('active'));
      panel.querySelectorAll('.sub-tab-btn').forEach(b => b.classList.remove('active'));
      document.getElementById(tabId + '-' + subId).classList.add('active');
      btn.classList.add('active');
    }

    // ── Modal ──
    function openMomoModal() { document.getElementById('momoModal').classList.add('open'); }
    function closeMomoModal() { document.getElementById('momoModal').classList.remove('open'); }

    // ── Drag & drop ──
    const uploadArea = document.querySelector('.upload-area');
    uploadArea.addEventListener('dragover', e => { e.preventDefault(); uploadArea.style.borderColor = '#7c3aed'; });
    uploadArea.addEventListener('dragleave', () => { uploadArea.style.borderColor = ''; });
    uploadArea.addEventListener('drop', e => {
      e.preventDefault(); uploadArea.style.borderColor = '';
      if (e.dataTransfer.files[0]) handleMomoFile(e.dataTransfer.files[0]);
    });

    // ── Global data store ──
    let _rows = [];     // [{date, time, gian, amount, loaiGD, maDon, txId, feeRate}]
    let _dates = [];
    let _gians = [];
    let _history = []; // [{fileName, uploadedAt, added, skipped, fmt}]
    let _ctMap   = {}; // { [gian]: { maCT, isChiaSe } }
    let _ctCodes = []; // ['CT001', 'CT002', ...]
    let _hdData  = {}; // { [`${date}|${gian}`]: { soHD, soTienHD, tienNH } }
    let _bankMomoPayments = []; // [{ payDate:"DD-MM-YYYY", amount, fromDate, toDate }]
    let _bankZaloPayments = []; // [{payDate, amount, fromDate, toDate}]
    let _bankVnpayPayments = []; // [{payDate, amount, fromDate, toDate}] -- VNPay QR Offline (khác Zalo Mini App)
    let _serverNet   = {}; // { "YYYY-MM-DD|CT_CODE": netAmount } từ Tổng Momo thực
    let _serverGross = {}; // { "YYYY-MM-DD|CT_CODE": grossAmount } từ Tổng Momo thực

    // ── localStorage helpers ──
    function saveRows()    { try { lsSet(LS_ROWS, JSON.stringify(_rows)); } catch(e){} }
    function saveHistory() { try { lsSet(LS_HISTORY, JSON.stringify(_history)); } catch(e){} }
    function saveCtMap()   { try { lsSet(LS_CT_MAP, JSON.stringify(_ctMap)); lsSet(LS_CT_CODES, JSON.stringify(_ctCodes)); } catch(e){} }
    function saveHdData()  { try { lsSet(LS_HD_DATA, JSON.stringify(_hdData)); } catch(e){} }
    function loadStored() {
      try {
        const r  = localStorage.getItem(LS_ROWS);
        const h  = localStorage.getItem(LS_HISTORY);
        const m  = localStorage.getItem(LS_CT_MAP);
        const c  = localStorage.getItem(LS_CT_CODES);
        const hd = localStorage.getItem(LS_HD_DATA);
        if (r)  _rows    = JSON.parse(r);
        if (h)  _history = JSON.parse(h);
        if (m)  _ctMap   = JSON.parse(m);
        if (c)  _ctCodes = JSON.parse(c);
        if (hd) _hdData  = JSON.parse(hd);
      } catch(e) { _rows = []; _history = []; }
    }
    function saveHdField(key, field, val) {
      if (!_hdData[key]) _hdData[key] = {};
      _hdData[key][field] = val;
      saveHdData();
    }

    // ── Auto map MTT → Momo Đối soát ──
    function autoMapMttMomo() {
      const khKey   = COMPANY === 'kh_cu' ? 'cu' : 'moi';
      const mttRows = khKey === 'cu' ? _mttCu : _mttMoi;
      if (!mttRows.length) { alert('Chưa có dữ liệu MTT. Vui lòng tải file MTT trước.'); return; }

      // Chỉ lấy dòng có dichVuThuHo chứa "momo"
      const momoMtt = mttRows.filter(r => (r.dichVuThuHo||'').toLowerCase().includes('momo'));
      if (!momoMtt.length) { alert('Không tìm thấy hóa đơn MTT nào có dịch vụ thu hộ = momo.'); return; }

      // Build MTT lookup: ngay(DD/MM/YYYY) → maDiem → [rows]
      const mttByDateDiem = {};
      momoMtt.forEach(r => {
        if (!mttByDateDiem[r.ngay]) mttByDateDiem[r.ngay] = {};
        if (!mttByDateDiem[r.ngay][r.maDiem]) mttByDateDiem[r.ngay][r.maDiem] = [];
        mttByDateDiem[r.ngay][r.maDiem].push(r);
      });

      // maDiem → maCT (MTT ct map cho KH đang xem)
      const maDiemToMaCT = _mttCtMap[khKey] || {};
      // Reverse: maCT → maDiem
      const maCTtoDiem = {};
      Object.entries(maDiemToMaCT).forEach(([md, mc]) => { if (mc) maCTtoDiem[mc] = md; });

      // Helper: momo date DD-MM-YYYY → invoice date DD/MM/YYYY after N days
      const addDays = (ddmmyyyy, n) => {
        const [dd,mm,yy] = ddmmyyyy.split('-');
        const d = new Date(Number(yy), Number(mm)-1, Number(dd));
        d.setDate(d.getDate() + n);
        return `${String(d.getDate()).padStart(2,'0')}/${String(d.getMonth()+1).padStart(2,'0')}/${d.getFullYear()}`;
      };

      // Groups per momo date (group by maCT, same as byDate rendering)
      const dateGroups = {};
      _rows.forEach(r => {
        if (!dateGroups[r.date]) dateGroups[r.date] = new Set();
        const maCT = (_ctMap[r.gian] || {}).maCT || r.gian;
        dateGroups[r.date].add(maCT); // groupKey = maCT || gian
      });

      let filled = 0, skipped = 0;
      Object.entries(dateGroups).forEach(([momoDate, groupSet]) => {
        const invCandidates = [1,2,3,4].map(n => addDays(momoDate, n));
        groupSet.forEach(groupKey => {
          const hdKey = `${momoDate}|${groupKey}`;
          if (_hdData[hdKey] && _hdData[hdKey].soHD) { skipped++; return; }
          // groupKey là maCT (hoặc raw gian nếu chưa map)
          const maCT   = groupKey;
          const maDiem = maCTtoDiem[maCT];
          let matched = null;
          for (const inv of invCandidates) {
            if (maDiem && mttByDateDiem[inv] && mttByDateDiem[inv][maDiem]) {
              matched = mttByDateDiem[inv][maDiem]; break;
            }
            if (maCT && mttByDateDiem[inv] && mttByDateDiem[inv][maCT]) {
              matched = mttByDateDiem[inv][maCT]; break;
            }
          }
          if (!matched) return;
          if (!_hdData[hdKey]) _hdData[hdKey] = {};
          const soHDs = [...new Set(matched.map(r => String(r.soHD)))].join(', ');
          const tongTien = matched.reduce((s, r) => s + r.tongTien, 0);
          _hdData[hdKey].soHD     = soHDs;
          _hdData[hdKey].soTienHD = String(Math.round(tongTien));
          filled++;
        });
      });

      saveHdData();
      renderDoiSoatNgay();
      alert(`✅ Map xong: ${filled} ô hóa đơn · Bỏ qua ${skipped} ô đã có`);
    }

    // ── Auto map MTT → Zalo Đối soát ── (Luyen, 2026-09-10: "thêm cho tôi
    // cái map với hóa đơn... chỗ hóa đơn dịch vụ thu hộ là ZALO MINI APP" --
    // giống hệt nút Map MTT → Momo, chỉ đổi lọc dichVuThuHo sang "zalo" và
    // ghi vào _zaloHD thay vì _hdData.)
    //
    // Luyen, 2026-09-10 (bản 2): phát hiện cột "Dịch vụ thu hộ" của MTT thực
    // ra ghi kèm NGÀY (trong tháng) mà hóa đơn đó thu hộ ngay trong tên, vd
    // "ZALO MINI APP 29,30,31" nghĩa là hóa đơn này GỘP CHUNG doanh thu 3
    // ngày 29-30-31 (của tháng TRƯỚC ngày hóa đơn, vì 29>ngày HĐ) làm MỘT
    // hóa đơn duy nhất cho 1 gian. Bản cũ đoán mù ngày hóa đơn (+1..+4 ngày
    // sau ngày đối soát) nên có lúc gán TRÙNG 1 hóa đơn cho nhiều ngày (VD
    // 30/08 và 31/08 cùng bị gán hóa đơn 3235/3238/3239/3264 -> Chênh sai vì
    // đếm 2 lần), có lúc lại BỎ SÓT ngày (vd thiếu hẳn ngày 29/08). Sửa: đọc
    // ĐÚNG (các) ngày ghi trong cột thu hộ thay vì đoán, và khi 1 hóa đơn gộp
    // nhiều ngày thì CHIA tiền hóa đơn theo đúng tỷ lệ DT trước KM thực tế
    // của từng ngày (không copy nguyên số tiền vào mỗi ngày).
    function autoMapMttZalo() {
      const khKey   = COMPANY === 'kh_cu' ? 'cu' : 'moi';
      const mttRows = khKey === 'cu' ? _mttCu : _mttMoi;
      if (!mttRows.length) { alert('Chưa có dữ liệu MTT. Vui lòng tải file MTT trước.'); return; }

      // Chỉ lấy dòng có dịch vụ thu hộ = ZALO MINI APP (chứa "zalo")
      const zaloMtt = mttRows.filter(r => (r.dichVuThuHo||'').toLowerCase().includes('zalo'));
      if (!zaloMtt.length) { alert('Không tìm thấy hóa đơn MTT nào có dịch vụ thu hộ = ZALO MINI APP.'); return; }

      // maDiem → maCT (dùng chung bảng Map Mã Điểm → Mã Công Trình MTT với bên Momo)
      const maDiemToMaCT = _mttCtMap[khKey] || {};

      // Tách các ngày-trong-tháng ghi ở cuối "Dịch vụ thu hộ", vd
      // "ZALO MINI APP 29,30,31" -> [29,30,31]; "ZALO MINI APP 4" -> [4]
      const parseDays = s => {
        const m = /(\d+(?:\s*,\s*\d+)*)\s*$/.exec(s||'');
        if (!m) return [];
        return m[1].split(',').map(x=>parseInt(x.trim(),10)).filter(n=>!isNaN(n));
      };
      // Quy ra ngày thật DD-MM-YYYY (định dạng Zalo dùng): so ngày trong cột
      // thu hộ với ngày hóa đơn (ngayHD "DD/MM/YYYY") -- nếu lớn hơn thì
      // thuộc THÁNG TRƯỚC (vd HĐ 03/09 ghi ngày 29,30,31 -> tháng 08).
      const resolveDate = (ngayHD, dayNum) => {
        const p = String(ngayHD||'').split('/');
        if (p.length !== 3) return null;
        const dd = +p[0], mm = +p[1], yy = +p[2];
        let month = mm, year = yy;
        if (dayNum > dd) { month -= 1; if (month < 1) { month = 12; year -= 1; } }
        return String(dayNum).padStart(2,'0')+'-'+String(month).padStart(2,'0')+'-'+year;
      };

      // DT trước KM thực tế từng ngày|maCT (từ dữ liệu Zalo FUNZONE, giống
      // byDate trong renderZaloDoiSoat) -- dùng để chia tỷ lệ khi 1 hóa đơn
      // gộp nhiều ngày.
      const grossByDateCT = {};
      _zaloFee.forEach(r => {
        const isFunzone = r.maDiem==='FUNZONE1' || (r.dienThu||'').toUpperCase().includes('FUNZONE');
        if(!isFunzone) return;
        const ordVal = r.maFunzone ? _zaloOrders[String(r.maFunzone)] : undefined;
        const { tenSP: tenSP_lu, sku: skuLu } = unpackZaloOrder(ordVal);
        const maCT = ordVal !== undefined ? (getZaloMaCT(tenSP_lu, skuLu)||tenSP_lu||ordVal) : (_zaloUnk[r.date] || '_unknown_');
        const key = r.date+'|'+maCT;
        grossByDateCT[key] = (grossByDateCT[key]||0) + r.gross;
      });

      // Xóa các ô KHÔNG PHẢI do Luyen tự tay sửa (không có _manual) để tính
      // lại từ đầu mỗi lần bấm nút -- tránh cộng dồn nhiều lần khi bấm lặp
      // lại, và tự động SỬA LUÔN các ô bị gán sai từ lần chạy phiên bản cũ
      // (trước khi có logic chia tỷ lệ này). Ô nào Luyen đã tự sửa tay
      // (_manual=true, đánh dấu trong zHDEdit/saveZaloEditPanel) thì giữ
      // nguyên, không đụng vào.
      Object.keys(_zaloHD).forEach(k => {
        if (_zaloHD[k] && !_zaloHD[k]._manual) {
          delete _zaloHD[k].soHD; delete _zaloHD[k].tienHD;
        }
      });

      let filled = 0, skipped = 0;
      zaloMtt.forEach(r => {
        const days = parseDays(r.dichVuThuHo);
        if (!days.length || !r.ngay) return;
        const maCT = maDiemToMaCT[r.maDiem] || r.maDiem;
        const dates = days.map(d => resolveDate(r.ngay, d)).filter(Boolean);
        if (!dates.length) return;
        const grosses = dates.map(dt => grossByDateCT[dt+'|'+maCT] || 0);
        const totalGross = grosses.reduce((s,g)=>s+g,0);
        dates.forEach((dt, i) => {
          const hdKey = dt+'|'+maCT;
          const existing = _zaloHD[hdKey];
          if (existing && existing._manual) { skipped++; return; } // Luyen đã tự nhập tay
          const share = totalGross>0 ? (grosses[i]/totalGross) : (1/dates.length);
          const portion = Math.round(r.tongTien * share);
          if (!_zaloHD[hdKey]) _zaloHD[hdKey] = {};
          const prevHD = String(_zaloHD[hdKey].soHD||'').split(',').map(s=>s.trim()).filter(Boolean);
          if (!prevHD.includes(String(r.soHD))) prevHD.push(String(r.soHD));
          _zaloHD[hdKey].soHD    = prevHD.join(', ');
          _zaloHD[hdKey].tienHD  = String((parseFloat(_zaloHD[hdKey].tienHD)||0) + portion);
          filled++;
        });
      });

      try { lsSet(LS_ZALO_HD, JSON.stringify(_zaloHD)); } catch(e){}
      renderZaloDoiSoat();
      alert(`✅ Map xong: ${filled} ô hóa đơn (tự chia tỷ lệ nếu hóa đơn gộp nhiều ngày) · Bỏ qua ${skipped} ô đã tự nhập tay`);
    }

    function toggleEditPanel(dateId) {
      const row = document.getElementById('edit_' + dateId);
      if (!row) return;
      row.style.display = row.style.display === 'none' ? '' : 'none';
    }
    function saveEditPanel(dateId, date, btnEl) {
      const gianList = btnEl && btnEl.dataset && btnEl.dataset.gians ? JSON.parse(btnEl.dataset.gians) : [];
      gianList.forEach(g => {
        const gKey = g.replace(/[^a-zA-Z0-9]/g,'_');
        const hdKey = `${date}|${g}`;
        if (!_hdData[hdKey]) _hdData[hdKey] = {};
        const tienNH   = (document.getElementById(`edit_tienNH_${dateId}_${gKey}`)   || {}).value || '';
        const soHD     = (document.getElementById(`edit_soHD_${dateId}_${gKey}`)     || {}).value || '';
        const soTienHD = (document.getElementById(`edit_soTienHD_${dateId}_${gKey}`) || {}).value || '';
        const dtOvr    = (document.getElementById(`edit_dtOvr_${dateId}_${gKey}`)    || {}).value;
        const netOvr   = (document.getElementById(`edit_netOvr_${dateId}_${gKey}`)   || {}).value;
        _hdData[hdKey].tienNH   = tienNH;
        _hdData[hdKey].soHD     = soHD;
        _hdData[hdKey].soTienHD = soTienHD;
        _hdData[hdKey].dtOvr    = dtOvr  != null ? dtOvr  : '';
        _hdData[hdKey].netOvr   = netOvr != null ? netOvr : '';
      });
      saveHdData();
      renderDoiSoatNgay();
      // Panel tự đóng sau khi lưu (đã cập nhật số trên bảng)
    }

    // ── Recompute derived arrays & refresh UI ──
    function refreshUI() {
      _dates = [...new Set(_rows.map(r => r.date))].sort((a, b) => {
        const p = d => { const [dd,mm,yy] = d.split('-'); return `${yy}-${mm}-${dd}`; };
        return p(a).localeCompare(p(b));
      });
      _gians = [...new Set(_rows.map(r => r.gian))].sort();

      const grpSet = new Set(_gians.map(g => g.split(' ')[0]));
      const grpSel = document.getElementById('filterGroup');
      grpSel.innerHTML = '<option value="">Tất cả</option>';
      [...grpSet].sort().forEach(g => { const o = document.createElement('option'); o.value = g; o.textContent = g; grpSel.appendChild(o); });

      const dateSel = document.getElementById('filterDate');
      dateSel.innerHTML = '<option value="">Tất cả ngày</option>';
      _dates.forEach(d => { const o = document.createElement('option'); o.value = d; o.textContent = d; dateSel.appendChild(o); });

      if (_rows.length) {
        document.getElementById('momoEmpty').style.display = 'none';
        document.getElementById('momoResults').style.display = 'block';
        document.getElementById('momoSubTabs').style.display = 'flex';
        const totalAmt = _rows.reduce((s,r) => s + r.amount, 0);
        document.getElementById('momoMeta').textContent =
          `${_rows.length.toLocaleString('vi')} GD · ${_gians.length} gian · ${_dates.length} ngày · Tổng: ${totalAmt.toLocaleString('vi')}đ`;
      }

      populateMonthFilter();
      renderPivot();
      renderDetail();
      renderHistory();
      fetchBankMomo();
      fetchServerNet();
    }

    // ── Populate month filter ──
    function populateMonthFilter() {
      const sel = document.getElementById('filterMonth');
      if (!sel) return;
      const months = [...new Set(_dates.map(d => {
        const [dd, mm, yy] = d.split('-');
        return `${mm}/${yy}`;
      }))].sort((a, b) => {
        const [ma, ya] = a.split('/');
        const [mb, yb] = b.split('/');
        return (ya + ma).localeCompare(yb + mb);
      });
      const curVal = sel.value;
      sel.innerHTML = `<option value="">Tất cả</option>` + months.map(m => `<option value="${m}">${m}</option>`).join('');
      const today = new Date();
      const curMonth = String(today.getMonth()+1).padStart(2,'0') + '/' + today.getFullYear();
      sel.value = months.includes(curVal) ? curVal
                : months.includes(curMonth) ? curMonth
                : (months[months.length - 1] || '');
    }

    // ── Clear data ──
    function clearMomoData() {
      if (!confirm('Xóa toàn bộ dữ liệu Momo đã lưu?')) return;
      _rows = []; _history = [];
      saveRows(); saveHistory();
      document.getElementById('momoEmpty').style.display = 'block';
      document.getElementById('momoResults').style.display = 'none';
      document.getElementById('momoSubTabs').style.display = 'none';
      renderHistory();
    }

    // ── Parse file ──
    function handleMomoFile(file) {
      if (!file) return;
      const st = document.getElementById('momoUploadStatus');
      st.className = 'upload-status loading';
      st.textContent = '⏳ Đang đọc file...';

      const reader = new FileReader();
      reader.onload = function(e) {
        try {
          const wb = XLSX.read(e.target.result, { type: 'array', cellDates: false });
          const ws = wb.Sheets[wb.SheetNames[0]];
          const data = XLSX.utils.sheet_to_json(ws, { header: 1, defval: '' });

          // Detect format: search first 5 rows for known headers
          let headerIdx = -1, fmt = '';
          for (let i = 0; i < Math.min(5, data.length); i++) {
            const row = data[i].map(c => String(c));
            if (row.some(c => c.includes('Thời gian TT'))) { headerIdx = i; fmt = 'v1'; break; }
            if (row.some(c => c.includes('Mã cửa hàng') || c.includes('Tên cửa hàng'))) { headerIdx = i; fmt = 'v2'; break; }
            if (row.some(c => c.includes('Thời gian')) && row.some(c => c.includes('Số tiền'))) { headerIdx = i; fmt = 'v2'; break; }
          }
          if (headerIdx < 0) throw new Error('Không nhận ra định dạng file. Hỗ trợ file từ Momo Business (Transactions / Transaction_report).');

          const hdr = data[headerIdx].map(c => String(c));
          const colIdx = name => hdr.findIndex(h => h.includes(name));

          // Parse into temp array
          const newRows = [];

          // Helper: tính feeRate theo Nguồn tiền + Công ty
          function calcFeeRate(nguonTien) {
            if (COMPANY === 'kh_cu') return 0.011; // KH Cũ: cố định 1.1%
            // KH Mới: theo Nguồn tiền
            const nt = String(nguonTien || '').toLowerCase();
            if (nt.includes('momo')) return 0.01;
            if (nt.includes('tra sau') || nt.includes('trả sau')) return 0.012;
            if (nt) return 0.003; // ngân hàng / ATM / QR ngân hàng
            return 0.01; // mặc định nếu không rõ
          }

          if (fmt === 'v1') {
            const C = {
              tgian:     colIdx('Thời gian TT'),
              den:       colIdx('Số tiền đến'),
              status:    colIdx('Trạng thái'),
              noiDung:   colIdx('Nội dung'),
              maDon:     colIdx('Mã đơn hàng'),
              maTham:    colIdx('Mã tham chiếu'),
              loaiGD:    colIdx('Loại giao dịch'),
              nguonTien: colIdx('Nguồn tiền'),
            };
            for (let i = headerIdx + 1; i < data.length; i++) {
              const r = data[i];
              if (!r[C.tgian]) continue;
              if (String(r[C.status] || '') !== 'Thành công') continue;
              const tgian    = String(r[C.tgian]);
              const maDon    = String(r[C.maDon] || '');
              const maTham   = String(r[C.maTham] || '');
              const txId     = maTham || maDon;
              const noiDung  = String(r[C.noiDung] || '');
              const loaiGD   = String(r[C.loaiGD] || '');
              const nguonTien = C.nguonTien >= 0 ? String(r[C.nguonTien] || '') : '';
              const feeRate  = calcFeeRate(nguonTien);
              let gian = 'Vãng lai';
              const m = noiDung.match(/VQR\w+\s+(.+)/);
              if (m) { const g = m[1].trim(); gian = (g === 'PaymentForOrder' || g === '-') ? 'Vãng lai' : g; }
              else if (loaiGD === 'Vãng lai') gian = 'Vãng lai';
              newRows.push({ date: tgian.substring(0,10), time: tgian.substring(11,19),
                gian, amount: Number(r[C.den])||0, loaiGD, maDon, txId, nguonTien, feeRate });
            }
          } else {
            const C = {
              tgian:      colIdx('Thời gian'),
              amount:     colIdx('Số tiền'),
              status:     colIdx('Trạng thái'),
              tenGian:    colIdx('Tên cửa hàng'),
              maGian:     colIdx('Mã cửa hàng'),
              maDon:      colIdx('Mã đơn hàng'),
              maGD:       colIdx('Mã giao dịch'),
              loaiGD:     colIdx('Loại giao dịch'),
              nguonTien:  colIdx('Nguồn tiền'),
              // Cột phí/net thực tế từ Momo (nếu có trong file)
              phi:        Math.max(colIdx('Phí giao dịch'), colIdx('Phí'), colIdx('Phí MoMo')),
              soTienNhan: Math.max(colIdx('Số tiền thực nhận'), colIdx('Số tiền cửa hàng nhận'), colIdx('Tiền nhận')),
            };
            for (let i = headerIdx + 1; i < data.length; i++) {
              const r = data[i];
              if (!r[C.tgian]) continue;
              if (String(r[C.status] || '') !== 'Thành công') continue;
              const tgian     = String(r[C.tgian]);
              const maDon     = String(r[C.maDon] || '');
              const maGD      = String(r[C.maGD] || '');
              const txId      = maDon || maGD;
              const tenGian   = String(r[C.tenGian] || '');
              const maGian    = String(r[C.maGian] || '');
              const nguonTien = C.nguonTien >= 0 ? String(r[C.nguonTien] || '') : '';
              const gross     = Number(r[C.amount]) || 0;
              // Ưu tiên đọc phí/net thực tế từ file; fallback về tính theo nguonTien
              let feeAmt = null;
              if (C.phi >= 0 && r[C.phi] !== '' && r[C.phi] != null) {
                feeAmt = Math.abs(Number(r[C.phi]) || 0);
              } else if (C.soTienNhan >= 0 && r[C.soTienNhan] !== '' && r[C.soTienNhan] != null) {
                feeAmt = gross - (Number(r[C.soTienNhan]) || 0);
              }
              const feeRate = feeAmt != null ? (gross ? feeAmt / gross : 0) : calcFeeRate(nguonTien);
              newRows.push({ date: tgian.substring(0,10), time: tgian.substring(11,19),
                gian: tenGian || maGian || 'Vãng lai',
                amount: gross,
                loaiGD: String(r[C.loaiGD]||''), maDon, txId, nguonTien: '', feeRate });
            }
          }

          if (!newRows.length) throw new Error('Không có dữ liệu hợp lệ (Thành công) trong file.');

          // Dedup: filter out txIds already in _rows
          const existingIds = new Set(_rows.map(r => r.txId).filter(Boolean));
          const toAdd   = newRows.filter(r => !r.txId || !existingIds.has(r.txId));
          const skipped = newRows.length - toAdd.length;

          // Merge
          _rows = [..._rows, ...toAdd];
          saveRows();

          // Save history
          _history.unshift({
            fileName: file.name, fmt,
            uploadedAt: new Date().toLocaleString('vi'),
            added: toAdd.length, skipped, total: newRows.length
          });
          saveHistory();

          refreshUI();

          st.className = 'upload-status ok';
          st.textContent = `✅ Thêm ${toAdd.length.toLocaleString('vi')} GD · Bỏ qua ${skipped} trùng lặp`;
          setTimeout(closeMomoModal, 1800);

        } catch(err) {
          st.className = 'upload-status err';
          st.textContent = '❌ ' + err.message;
        }
      };
      reader.readAsArrayBuffer(file);
    }

    // ── Render pivot table ──
    function renderPivot() {
      const filterGian = document.getElementById('filterGian').value.toLowerCase();
      const filterGrp  = document.getElementById('filterGroup').value;

      const gians = _gians.filter(g => {
        if (filterGian && !g.toLowerCase().includes(filterGian)) return false;
        if (filterGrp && !g.startsWith(filterGrp)) return false;
        return true;
      });

      // Build pivot map: gian → date → total
      const pivot = {};
      _rows.forEach(r => {
        if (!gians.includes(r.gian)) return;
        if (!pivot[r.gian]) pivot[r.gian] = {};
        pivot[r.gian][r.date] = (pivot[r.gian][r.date] || 0) + r.amount;
      });

      const fmt = n => n ? n.toLocaleString('vi') : '<span class="cell-zero">–</span>';

      // Head
      const head = document.getElementById('pivotHead');
      head.innerHTML = '<tr><th>Gian</th>' + _dates.map(d => `<th>${d}</th>`).join('') + '<th class="total-col">Tổng</th></tr>';

      // Body
      const tbody = document.getElementById('pivotBody');
      let html = '';
      gians.forEach(g => {
        let rowTotal = 0;
        const cells = _dates.map(d => {
          const v = (pivot[g] || {})[d] || 0;
          rowTotal += v;
          return `<td>${fmt(v)}</td>`;
        }).join('');
        const ct = _ctMap[g] || {};
        const ctLabel = ct.maCT ? `<br><span class="ct-badge">${ct.maCT}</span>${ct.isChiaSe ? '<span class="ct-chiase-badge">CS</span>' : ''}` : '';
        html += `<tr><td>${g}${ctLabel}</td>${cells}<td class="total-col cell-val">${rowTotal.toLocaleString('vi')}</td></tr>`;
      });
      tbody.innerHTML = html || '<tr><td colspan="99" style="text-align:center;color:#94a3b8;padding:1rem">Không có gian nào khớp</td></tr>';

      // Foot (totals)
      const foot = document.getElementById('pivotFoot');
      let grandTotal = 0;
      const dateTotals = _dates.map(d => {
        const t = _rows.filter(r => gians.includes(r.gian) && r.date === d).reduce((s,r) => s + r.amount, 0);
        grandTotal += t;
        return `<td>${t.toLocaleString('vi')}</td>`;
      }).join('');
      foot.innerHTML = `<tr><td>Tổng cộng</td>${dateTotals}<td class="total-col">${grandTotal.toLocaleString('vi')}</td></tr>`;
    }

    // ── Render detail table ──
    function renderDetail() {
      const q     = document.getElementById('filterDetail').value.toLowerCase();
      const dFilter = document.getElementById('filterDate').value;
      const rows = _rows.filter(r => {
        if (dFilter && r.date !== dFilter) return false;
        if (q && !r.gian.toLowerCase().includes(q) && !r.maDon.toLowerCase().includes(q)) return false;
        return true;
      }).slice(0, 500); // cap at 500 for performance

      const fmt = n => n.toLocaleString('vi');
      let html = '';
      rows.forEach((r, i) => {
        html += `<tr>
          <td>${i+1}</td>
          <td>${r.date}</td>
          <td>${r.time}</td>
          <td>${r.gian === 'Vãng lai' ? `<span class="badge-vang-lai">Vãng lai</span>` : r.gian}</td>
          <td style="text-align:right;color:#15803d;font-weight:600">${fmt(r.amount)}</td>
          <td>${r.loaiGD}</td>
          <td style="font-size:.78em;color:#64748b">${r.maDon}</td>
        </tr>`;
      });
      document.getElementById('detailBody').innerHTML = html || '<tr><td colspan="6" style="text-align:center;color:#94a3b8;padding:1rem">Không có dữ liệu</td></tr>';
    }


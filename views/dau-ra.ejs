    function saveCtMapModal() {
      const inputs  = document.querySelectorAll('#ctMapBody .ct-input');
      const checks  = document.querySelectorAll('#ctMapBody .ct-chiase');
      inputs.forEach((inp, i) => {
        const gian    = inp.dataset.gian;
        const maCT    = inp.value.trim().toUpperCase();
        const isChiaSe = checks[i].checked;
        if (maCT) {
          _ctMap[gian] = { maCT, isChiaSe };
          if (!_ctCodes.includes(maCT)) _ctCodes.push(maCT);
        } else {
          delete _ctMap[gian];
        }
      });
      saveCtMap();
      document.getElementById('ctMapModal').classList.remove('open');
      renderPivot(); // re-render with CT labels
      renderDoiSoatNgay();
    }

    // ── Đối soát ngày ──
    function renderDoiSoatNgay() {
      const el = document.getElementById('doiSoatBody');
      if (!el || !_rows.length) {
        if (el) el.innerHTML = '<tr><td colspan="6" style="text-align:center;color:#94a3b8;padding:1.5rem">Chưa có dữ liệu</td></tr>';
        return;
      }

      // Lọc theo tháng đang chọn
      const selMonth = (document.getElementById('filterMonth') || {}).value || '';
      const filteredDates = _dates.filter(d => {
        if (!selMonth) return true;
        const [dd, mm, yy] = d.split('-');
        return `${mm}/${yy}` === selMonth;
      });
      if (!filteredDates.length) {
        el.innerHTML = '<tr><td colspan="6" style="text-align:center;color:#94a3b8;padding:1.5rem">Không có dữ liệu cho tháng đã chọn</td></tr>';
        return;
      }

      // Group: date → groupKey(maCT||gian) → {amount, fee, maCT, gians[]}
      // Các sub-gian cùng maCT được cộng dồn vào 1 bucket để hiện 1 dòng duy nhất
      const byDate = {};
      _rows.forEach(r => {
        if (!byDate[r.date]) byDate[r.date] = {};
        const maCT = (_ctMap[r.gian] || {}).maCT;
        const gKey = maCT || r.gian; // group by maCT if mapped, else raw gian
        if (!byDate[r.date][gKey]) byDate[r.date][gKey] = { amount: 0, fee: 0, maCT: maCT || null, gians: [] };
        const rate = r.feeRate != null ? r.feeRate : (COMPANY === 'kh_cu' ? 0.011 : 0.01);
        byDate[r.date][gKey].amount += r.amount;
        byDate[r.date][gKey].fee    += r.amount * rate;
        if (!byDate[r.date][gKey].gians.includes(r.gian)) byDate[r.date][gKey].gians.push(r.gian);
      });

      const fmtN = n => Math.round(n).toLocaleString('vi');
      const ddmmToISO = d => { const [dd,mm,yy] = d.split('-'); return `${yy}-${mm}-${dd}`; };
      const inRange = (date, from, to) => {
        const d = ddmmToISO(date);
        return d >= ddmmToISO(from) && d <= ddmmToISO(to);
      };

      // Batch-level chênh adjustment: { "date|gian": số đ cần cộng/trừ }
      let _batchAdjMap = {};

      // Tính net thực tế (sau server data + rounding) cho 1 ngày — dùng cho batch header
      const computeDayFinalNet = (date) => {
        const gianData = byDate[date] || {};
        const gList = Object.keys(gianData).sort();
        if (!gList.length) return 0;
        const nets = gList.map(g => {
          const dg = gianData[g];
          const hd = _hdData[`${date}|${g}`] || {};
          const maCT = dg.maCT;
          const serverKey = maCT ? `${ddmmToISO(date)}|${maCT}` : null;
          let serverNetVal = serverKey && _serverNet[serverKey] != null ? _serverNet[serverKey] : null;
          const net = (hd.netOvr != null && hd.netOvr !== '') ? (parseFloat(String(hd.netOvr).replace(/[^0-9.-]/g,''))||0)
                    : (serverNetVal != null ? serverNetVal : (dg.amount - Math.round(dg.fee)));
          return net;
        });
        const dayNet = nets.reduce((s,n) => s+n, 0);
        let rounded = nets.map(n => Math.round(n));
        const sumR = rounded.reduce((s,n) => s+n, 0);
        const adj = Math.round(dayNet) - sumR;
        if (adj !== 0) {
          const maxIdx = nets.reduce((mi, n, i) => n >= nets[mi] ? i : mi, 0);
          rounded[maxIdx] += adj;
        }
        const dayNH = gList.reduce((s,g) => {
          const v = parseFloat(String((_hdData[`${date}|${g}`]||{}).tienNH||'').replace(/[^0-9.]/g,''))||0;
          return s + v;
        }, 0);
        const sumFinal = rounded.reduce((s,n) => s+n, 0);
        const nhChenh = dayNH > 0 ? (dayNH - sumFinal) : 0;
        if (nhChenh === 1 || nhChenh === -1) return sumFinal + nhChenh;
        return sumFinal;
      };

      // Render các hàng cho 1 ngày (sub-rows theo groupKey=maCT||gian) + bảng chỉnh sửa
      const renderDateRows = (date) => {
        const gianData = byDate[date] || {};
        const gianList = Object.keys(gianData).sort(); // groupKey list
        if (!gianList.length) return '';

        const getGianDisplay = (g) => {
          const dg = gianData[g];
          const feeR = Math.round(dg.fee);
          const hd = _hdData[`${date}|${g}`] || {};
          const maCT = dg.maCT; // đã lưu sẵn khi build byDate
          const serverKey = maCT ? `${ddmmToISO(date)}|${maCT}` : null;
          let serverNetVal  = serverKey && _serverNet[serverKey]   != null ? _serverNet[serverKey]   : null;
          let serverGrossVal = serverKey && _serverGross[serverKey] != null ? _serverGross[serverKey] : null;
          // Không cần chia tỉ lệ nữa — dg.amount đã là tổng của cả nhóm maCT
          const dt  = (hd.dtOvr  != null && hd.dtOvr  !== '') ? (parseFloat(String(hd.dtOvr).replace(/[^0-9.-]/g,''))||0)
                     : (serverGrossVal != null ? serverGrossVal : dg.amount);
          const net = (hd.netOvr != null && hd.netOvr !== '') ? (parseFloat(String(hd.netOvr).replace(/[^0-9.-]/g,''))||0)
                     : (serverNetVal != null ? serverNetVal : (dg.amount - feeR));
          return { dt, net, fee: dt - net, fromServer: serverNetVal != null };
        };
        const dayDT  = gianList.reduce((s,g) => s + getGianDisplay(g).dt,  0);
        const dayNet = gianList.reduce((s,g) => s + getGianDisplay(g).net, 0);
        const dayPhi = dayDT - dayNet;
        const dayNH  = gianList.reduce((s,g) => {
          const v = parseFloat(String((_hdData[`${date}|${g}`]||{}).tienNH||'').replace(/[^0-9.]/g,''))||0;
          return s + v;
        }, 0);
        const dateId = date.replace(/-/g,'_');
        const _gDisps = {};
        gianList.forEach(g => { _gDisps[g] = getGianDisplay(g); });
        const _totalNetRounded = gianList.reduce((s,g) => s + Math.round(_gDisps[g].net), 0);
        const _dayNetRounded = Math.round(dayNet);
        const _netAdj = _dayNetRounded - _totalNetRounded;
        if (_netAdj !== 0) {
          const largestG = gianList.reduce((a,b) => _gDisps[a].net >= _gDisps[b].net ? a : b);
          _gDisps[largestG] = { ..._gDisps[largestG], net: _gDisps[largestG].net + _netAdj };
        }
        const _sumAfterAdj = gianList.reduce((s,g) => s + Math.round(_gDisps[g].net), 0);
        const _nhChenhRaw = dayNH > 0 ? (dayNH - _sumAfterAdj) : 0;
        if (_nhChenhRaw === 1 || _nhChenhRaw === -1) {
          const largestGN = gianList.reduce((a,b) => _gDisps[a].net >= _gDisps[b].net ? a : b);
          _gDisps[largestGN] = { ..._gDisps[largestGN], net: _gDisps[largestGN].net + _nhChenhRaw };
        }
        gianList.forEach(g => {
          const bAdj = _batchAdjMap[`${date}|${g}`];
          if (bAdj) _gDisps[g] = { ..._gDisps[g], net: _gDisps[g].net + bAdj };
        });
        const _finalNetSum = gianList.reduce((s,g) => s + Math.round(_gDisps[g].net), 0);
        const _finalPhi = dayDT - _finalNetSum;
        const _nhChenhFinal = dayNH > 0 ? (dayNH - _finalNetSum) : null;
        let out = `<tr style="background:#374151;color:#e5e7eb;cursor:pointer" onclick="toggleEditPanel('${dateId}')">
          <td colspan="6" style="padding:.38rem .75rem .38rem 1.25rem;font-size:.87em">
            📅 <strong>${date}</strong>
            &nbsp;·&nbsp; DT: ${fmtN(dayDT)}đ
            &nbsp;·&nbsp; Phí: ${fmtN(_finalPhi)}đ
            &nbsp;·&nbsp; Net: <strong style="color:#93c5fd">${fmtN(_finalNetSum)}đ</strong>
            ${dayNH ? `&nbsp;·&nbsp; NH: <strong style="color:#fbbf24">${fmtN(dayNH)}đ</strong>` : ''}
            ${_nhChenhFinal !== null ? `&nbsp;·&nbsp; ${_nhChenhFinal !== 0 ? '⚠️' : '✅'} Chênh: <strong style="color:${_nhChenhFinal===0?'#4ade80':'#fca5a5'}">${_nhChenhFinal>0?'+':''}${fmtN(_nhChenhFinal)}đ</strong>` : ''}
            <span style="float:right;font-size:.8em;opacity:.7">✏️ Sửa</span>
          </td></tr>`;

        gianList.forEach(g => {
          const dg    = gianData[g];
          const gDisp = _gDisps[g];
          const isMapped = dg.maCT !== null;
          // g IS maCT khi mapped, hoặc raw gian khi unmapped
          const ctLine = isMapped
            ? `<span class="ct-badge">${g}</span>`
            : '<span style="color:#94a3b8;font-size:.74em;font-style:italic">chưa map</span>';
          const subGianLine = dg.gians && dg.gians.length > 0 ? dg.gians.join(' · ') : g;
          const hdKey = `${date}|${g}`;
          const hd    = _hdData[hdKey] || {};
          const hasOvr = (hd.dtOvr != null && hd.dtOvr !== '') || (hd.netOvr != null && hd.netOvr !== '');
          out += `<tr class="gian-row">
            <td style="padding-left:2rem"><div>${ctLine}</div><div style="font-size:.82em;color:#475569;margin-top:1px">${subGianLine}</div></td>
            <td style="text-align:right;color:#15803d;font-weight:600">${fmtN(gDisp.dt)}${hasOvr&&hd.dtOvr?'<sup style="color:#f59e0b;font-size:.7em">✏</sup>':''}</td>
            <td style="text-align:right;color:#dc2626">${fmtN(Math.round(gDisp.fee))}</td>
            <td class="col-net" style="text-align:right">${fmtN(Math.round(gDisp.net))}${hasOvr&&hd.netOvr?'<sup style="color:#f59e0b;font-size:.7em">✏</sup>':''}</td>
            <td>${hd.soHD ? `<span style="font-size:.82em;font-weight:600">${hd.soHD}</span>` : '<span style="color:#cbd5e1;font-size:.78em">–</span>'}</td>
            <td>${hd.soTienHD ? `<span style="font-size:.82em;font-weight:600">${fmtN(parseFloat(String(hd.soTienHD).replace(/[^0-9.]/g,''))||0)}đ</span>` : '<span style="color:#cbd5e1;font-size:.78em">–</span>'}</td>
          </tr>`;
        });
        // Dòng tổng cuối ngày
        out += `<tr class="gian-total">
          <td style="padding-left:2rem;font-weight:700;color:#0369a1">Tổng cộng</td>
          <td style="text-align:right;color:#15803d;font-weight:700">${fmtN(dayDT)}</td>
          <td style="text-align:right;color:#dc2626;font-weight:700">${fmtN(_finalPhi)}</td>
          <td class="col-net" style="text-align:right;font-weight:800">${fmtN(_finalNetSum)}</td>
          <td colspan="2"></td>
        </tr>`;
        // Bảng chỉnh sửa (ẩn mặc định, toggle khi click header ngày)
        out += `<tr id="edit_${dateId}" style="display:none">
          <td colspan="6" style="padding:.75rem 1rem;background:#f8fafc;border-top:2px dashed #3b82f6">
            <div style="font-size:.82em;font-weight:700;color:#1e3a5f;margin-bottom:.5rem">✏️ Chỉnh sửa – ${date}</div>
            <div style="overflow-x:auto">
            <table style="min-width:820px;border-collapse:collapse;font-size:.82em">
              <thead><tr style="background:#e0e7ff;color:#1e3a5f">
                <th style="padding:.3rem .5rem;text-align:left;border:1px solid #c7d2fe">Mã CT / Gian</th>
                <th style="padding:.3rem .5rem;text-align:right;border:1px solid #c7d2fe">Doanh thu</th>
                <th style="padding:.3rem .5rem;text-align:right;border:1px solid #c7d2fe">Net (sửa được)</th>
                <th style="padding:.3rem .5rem;border:1px solid #c7d2fe">Số HĐ</th>
                <th style="padding:.3rem .5rem;text-align:right;border:1px solid #c7d2fe">Tiền HĐ</th>
                <th style="padding:.3rem .5rem;text-align:right;border:1px solid #c7d2fe">Tiền NH</th>
              </tr></thead>
              <tbody>
                ${gianList.map(g => {
                  const dg = gianData[g];
                  const feeR = Math.round(dg.fee);
                  const net = dg.amount - feeR;
                  const hdKey = `${date}|${g}`;
                  const hd = _hdData[hdKey] || {};
                  const netVal = hd.netOvr != null && hd.netOvr !== '' ? hd.netOvr : net;
                  const dtVal  = hd.dtOvr  != null && hd.dtOvr  !== '' ? hd.dtOvr  : dg.amount;
                  const subGians = dg.gians && dg.gians.length > 0 ? dg.gians.join(', ') : g;
                  const gKey = g.replace(/[^a-zA-Z0-9]/g,'_');
                  return `<tr>
                    <td style="padding:.3rem .5rem;border:1px solid #e2e8f0;color:#374151;font-size:.8em">${g}<br><span style="color:#94a3b8;font-size:.9em">${subGians}</span></td>
                    <td style="padding:.3rem .5rem;border:1px solid #e2e8f0;text-align:right">
                      <input id="edit_dtOvr_${dateId}_${gKey}" type="text" value="${dtVal}"
                        style="width:110px;border:1px solid #bbf7d0;border-radius:4px;padding:.2rem .35rem;text-align:right;background:#f0fdf4;color:#15803d;font-weight:600">
                    </td>
                    <td style="padding:.3rem .5rem;border:1px solid #e2e8f0;text-align:right">
                      <input id="edit_netOvr_${dateId}_${gKey}" type="text" value="${netVal}"
                        style="width:110px;border:1px solid #bfdbfe;border-radius:4px;padding:.2rem .35rem;text-align:right;background:#eff6ff;color:#0d47a1;font-weight:700">
                    </td>
                    <td style="padding:.3rem .5rem;border:1px solid #e2e8f0">
                      <input id="edit_soHD_${dateId}_${gKey}" type="text" value="${hd.soHD||''}" placeholder="0000123"
                        style="width:120px;border:1px solid #cbd5e1;border-radius:4px;padding:.2rem .35rem">
                    </td>
                    <td style="padding:.3rem .5rem;border:1px solid #e2e8f0;text-align:right">
                      <input id="edit_soTienHD_${dateId}_${gKey}" type="text" value="${hd.soTienHD||''}" placeholder="0"
                        style="width:100px;border:1px solid #cbd5e1;border-radius:4px;padding:.2rem .35rem;text-align:right">
                    </td>
                    <td style="padding:.3rem .5rem;border:1px solid #e2e8f0;text-align:right">
                      <input id="edit_tienNH_${dateId}_${gKey}" type="text" value="${hd.tienNH||''}" placeholder="0"
                        style="width:100px;border:1px solid #fde68a;border-radius:4px;padding:.2rem .35rem;text-align:right;background:#fffbeb;color:#92400e;font-weight:600">
                    </td>
                  </tr>`;
                }).join('')}
              </tbody>
            </table>
            </div>
            <div style="margin-top:.6rem;display:flex;gap:.5rem">
              <button onclick="saveEditPanel('${dateId}','${date}',this)"
                data-gians='${JSON.stringify(gianList).replace(/'/g,"&#39;")}'
                style="background:#16a34a;color:#fff;border:none;border-radius:6px;padding:.35rem .9rem;font-weight:700;font-size:.82em;cursor:pointer">💾 Lưu</button>
              <button onclick="toggleEditPanel('${dateId}')"
                style="background:#6b7280;color:#fff;border:none;border-radius:6px;padding:.35rem .9rem;font-weight:600;font-size:.82em;cursor:pointer">✕ Đóng</button>
            </div>
          </td>
        </tr>`;
        return out;
      };

      let html = '';
      const coveredDates = new Set();

      // Nhóm theo đợt NH trả về
      const hasBankPayments = _bankMomoPayments.length > 0;
      if (hasBankPayments) {
        _bankMomoPayments.forEach(pay => {
          // Tất cả ngày Momo trong khoảng trả (dùng cho tính chênh — không lọc tháng)
          const payDates = _dates.filter(d => inRange(d, pay.fromDate, pay.toDate));
          // Chỉ render ngày thuộc tháng đang chọn
          const renderDates = selMonth ? payDates.filter(d => filteredDates.includes(d)) : payDates;
          // Ẩn hoàn toàn đợt này nếu không có ngày nào trong tháng đang chọn
          if (selMonth && renderDates.length === 0) { payDates.forEach(d => coveredDates.add(d)); return; }
          const momoNet = payDates.reduce((s, d) => s + computeDayFinalNet(d), 0);
          const chenhNH = payDates.length > 0 ? (pay.amount - momoNet) : null;
          // Nếu chênh ≤ 700đ: tự điều chỉnh vào gian có amount cao nhất trong payDates
          if (chenhNH !== null && chenhNH !== 0 && Math.abs(chenhNH) <= 700) {
            let maxAmt = -1, adjDate = null, adjGian = null;
            payDates.forEach(d => {
              Object.entries(byDate[d] || {}).forEach(([g, dg]) => {
                if (dg.amount > maxAmt) { maxAmt = dg.amount; adjDate = d; adjGian = g; }
              });
            });
            if (adjDate && adjGian) _batchAdjMap[`${adjDate}|${adjGian}`] = chenhNH;
          }
          const displayChenh = (chenhNH !== null && Math.abs(chenhNH) <= 700) ? 0 : chenhNH;
          const momoNetText = payDates.length > 0
            ? ` · Momo Net: <strong>${fmtN(momoNet)}đ</strong>`
            : '';
          const chenhText = displayChenh !== null
            ? ` &nbsp;·&nbsp; ${displayChenh !== 0 ? '⚠️' : '✅'} <span style="color:${displayChenh===0?'#4ade80':'#fca5a5'}">Chênh: <strong>${displayChenh>0?'+':''}${fmtN(displayChenh)}đ</strong></span>`
            : '';

          html += `<tr>
            <td colspan="6" style="background:#1e4a6f;color:#e0f2fe;padding:.6rem .75rem;font-weight:700;font-size:.9em;border-top:2px solid #0ea5e9">
              📦 NH trả về <strong>${pay.payDate}</strong>:
              <span style="font-size:1.12em;font-weight:900;color:#fff;background:#0369a1;padding:.05rem .55rem;border-radius:6px;margin:0 2px">${fmtN(pay.amount)}đ</span>
              &nbsp;·&nbsp; Momo ngày <span style="color:#bae6fd">${pay.fromDate}</span> → <span style="color:#bae6fd">${pay.toDate}</span>${momoNetText}${chenhText}
            </td>
          </tr>`;

          payDates.forEach(d => coveredDates.add(d));
          renderDates.forEach(d => { html += renderDateRows(d); });
        });
      }

      // Ngày Momo chưa có đợt NH trả về
      const unpaidDates = filteredDates.filter(d => !coveredDates.has(d));
      if (unpaidDates.length) {
        if (hasBankPayments) {
          // Chỉ hiện header "Chưa có NH" khi đã có ít nhất 1 đợt NH (để phân biệt với ngày bình thường)
          const unpaidNet = unpaidDates.reduce((s, d) =>
            s + Object.values(byDate[d] || {}).reduce((s2, v) => s2 + v.amount - Math.round(v.fee), 0), 0);
          html += `<tr>
            <td colspan="6" style="background:#78350f;color:#fef3c7;padding:.6rem .75rem;font-weight:700;font-size:.9em;border-top:2px solid #d97706">
              ⏳ Chưa có NH trả về &nbsp;·&nbsp; Tổng Net: ${fmtN(unpaidNet)}đ
            </td>
          </tr>`;
        }
        unpaidDates.forEach(d => { html += renderDateRows(d); });
      }

      el.innerHTML = html || '<tr><td colspan="6" style="text-align:center;color:#94a3b8;padding:1.5rem">Chưa có dữ liệu</td></tr>';
    }

    // ── Export pivot ──
    function exportPivot() {
      if (!_rows.length) return;
      const wb = XLSX.utils.book_new();
      const aoa = [['Gian', ..._dates, 'Tổng']];
      const pivot = {};
      _rows.forEach(r => {
        if (!pivot[r.gian]) pivot[r.gian] = {};
        pivot[r.gian][r.date] = (pivot[r.gian][r.date] || 0) + r.amount;
      });
      let grandTotal = 0;
      _gians.forEach(g => {
        let rowT = 0;
        const vals = _dates.map(d => { const v = (pivot[g]||{})[d]||0; rowT+=v; return v; });
        grandTotal += rowT;
        aoa.push([g, ...vals, rowT]);
      });
      aoa.push(['Tổng cộng', ..._dates.map(d => _rows.filter(r=>r.date===d).reduce((s,r)=>s+r.amount,0)), grandTotal]);
      const ws = XLSX.utils.aoa_to_sheet(aoa);
      XLSX.utils.book_append_sheet(wb, ws, 'Momo pivot');
      XLSX.writeFile(wb, 'Momo_pivot.xlsx');
    }

    // ── Xuất Misa (toolbar chính, có modal chọn ngày + số chứng từ) ──
    // Luyen, 2026-09-11: "cho thêm cho tôi sao cái lịch sử tải á thêm cái
    // xuất file Misa cho tôi nhá ... số với gian lấy ra á cũng là soa khi
    // trừ phí nhá với diễn giải á" -- xuất ĐÚNG định dạng "MISATHUE123456"
    // (mẫu phiếu thu tiền gửi nhập AMIS), lấy số liệu TỪ CHÍNH trang Đầu Ra.
    //
    // Update 2026-09-11 (2): "cột ngày hoạch toán là cột ngày ngân hàng trả
    // tiền về á ... nếu mà ngân hàng trả về gom lại thì gom lại cho tôi luôn
    // nhá giống bên đối soát momo á gom lại về đúng ngày trả về cộng các đối
    // soát thực của khoản tiền đó lấy ngân hàng làm chuẩn" -- "Ngày hạch
    // toán"/"Ngày chứng từ" giờ lấy theo NGÀY NGÂN HÀNG THỰC TRẢ TIỀN VỀ
    // (đợt "NH trả về" -- _bankMomoPayments, y hệt logic renderDoiSoatNgay),
    // KHÔNG phải ngày giao dịch Momo. Nếu 1 đợt NH trả gộp nhiều ngày Momo
    // lại (fromDate→toDate), GOM các ngày đó thành 1 chứng từ duy nhất theo
    // từng Mã CT (cộng dồn), và dùng ĐÚNG số tiền ngân hàng trả về làm chuẩn
    // (chênh lệch làm tròn ≤700đ dồn vào Mã CT có số tiền lớn nhất trong đợt,
    // y hệt _batchAdjMap bên renderDoiSoatNgay). Ngày Momo NÀO CHƯA có đợt NH
    // trả về thì fallback xuất riêng theo đúng ngày Momo như cũ. Kèm modal
    // chọn khoảng ngày hạch toán cần xuất + số chứng từ bắt đầu (nối tiếp
    // lần xuất trước, tránh trùng số NTTK).
    // Chi Nhan, 2026-09-12: Luyen bao "tôi chọn KH mới nè xuất ra giống mẫu
    // hôm bửa á mà tk 7701 á sao nó hiện 123456 KH cũ dạ" -- du lieu THAT
    // trong file xuat (Nộp vào TK) da dung tu truoc (MOMO_BANK_ACCOUNT o
    // duoi da re nhanh theo COMPANY dung roi), nhung TIEU DE MODAL + ten
    // sheet/ten file lai bi HARDCODE cung "MISATHUE123456" bat ke cong ty --
    // gay hieu lam nham la xuat nham tai khoan (dù so lieu ben trong van
    // dung). Sua: tinh nhan MISATHUE7701 (kh_moi) / MISATHUE123456 (kh_cu)
    // dua theo COMPANY, dung chung cho ca tieu de modal LAN sheet/ten file.
    const MOMO_MISA_LABEL = COMPANY === 'kh_moi' ? 'MISATHUE7701' : 'MISATHUE123456';
    function openMomoMisaModal() {
      if (!_rows.length) { alert('Chưa có dữ liệu Momo để xuất.'); return; }
      const titleEl = document.getElementById('momoMisaModalTitle');
      if (titleEl) titleEl.textContent = '📥 Xuất Misa (' + MOMO_MISA_LABEL + ')';
      const ddmmToISO = d => { const [dd,mm,yy] = d.split('-'); return `${yy}-${mm}-${dd}`; };
      const sorted = [..._dates].sort((a,b) => ddmmToISO(a).localeCompare(ddmmToISO(b)));
      const fromEl = document.getElementById('misaFromDate');
      const toEl   = document.getElementById('misaToDate');
      const seqEl  = document.getElementById('misaStartSeq');
      const stEl   = document.getElementById('momoMisaModalStatus');
      if (stEl) stEl.textContent = '';
      if (fromEl) fromEl.value = ddmmToISO(sorted[0]);
      if (toEl)   toEl.value   = ddmmToISO(sorted[sorted.length-1]);
      if (seqEl)  seqEl.value  = 1;
      document.getElementById('momoMisaModal').classList.add('open');
    }
    function closeMomoMisaModal() {
      document.getElementById('momoMisaModal').classList.remove('open');
    }

    async function confirmExportMomoMisa() {
      const stEl = document.getElementById('momoMisaModalStatus');
      const fromIso = (document.getElementById('misaFromDate')||{}).value;
      const toIso   = (document.getElementById('misaToDate')||{}).value;
      const startSeq = parseInt((document.getElementById('misaStartSeq')||{}).value, 10) || 1;
      if (!fromIso || !toIso) { if (stEl) stEl.textContent = 'Vui lòng chọn đủ Từ ngày và Đến ngày.'; return; }
      if (fromIso > toIso) { if (stEl) stEl.textContent = 'Từ ngày phải trước Đến ngày.'; return; }
      if (stEl) stEl.textContent = 'Đang tải dữ liệu ngân hàng...';
      // Đảm bảo có dữ liệu mới nhất từ server trước khi tính (đợt NH trả + net thực)
      try { await fetchBankMomo(); } catch(e) {}
      try { await fetchServerNet(); } catch(e) {}
      if (stEl) stEl.textContent = '';
      closeMomoMisaModal();
      runExportMomoMisa(fromIso, toIso, startSeq);
    }

    function buildMisaRow({ date, soCt, maCT, dt, net, soHD, tienHD, dienGiai, bankAcc, bankName, toSlash }) {
      return {
        'Ngày hạch toán (*)': toSlash(date),
        'Ngày chứng từ (*)': toSlash(date),
        'Số chứng từ (*)': soCt,
        'Mã đối tượng': 'TRỰC TUYẾN0305289153',
        'Tên đối tượng': '',
        'Địa chỉ': '',
        'Nộp vào TK': bankAcc,
        'Mở tại ngân hàng': bankName,
        'Lý do thu': 'Thu tiền khách hàng (không theo hóa đơn)',
        'Diễn giải lý do thu': dienGiai,
        'Mã nhân viên thu': '',
        'Diễn giải (hạch toán)': dienGiai,
        'TK Nợ (*)': 1121,
        'TK Có (*)': '131',
        'Số tiền': Math.round(net),
        'Mã đối tượng (hạch toán)': 'TRỰC TUYẾN0305289153',
        'Số khế ước đi vay': '',
        'Số khế ước cho vay': '',
        'Mã khoản mục chi phí': '',
        'Mã đơn vị': '',
        'Mã đối tượng THCP': '',
        'Mã công trình': maCT,
        'Số đơn đặt hàng': '',
        'Số đơn mua hàng': '',
        'Số hợp đồng mua': '',
        'Số hợp đồng bán': '',
        'Mã thống kê': '',
        'CP không hợp lý': '',
        'Số HĐ khớp': soHD,
        'Tổng tiền HĐ khớp': tienHD,
        'Doanh thu gộp (trước phí)': Math.round(dt),
        'Chênh lệch HĐ vs doanh thu': Math.round(tienHD - dt),
        'Trạng thái': !soHD ? 'Chưa có HĐ' : (Math.abs(tienHD - dt) <= 1000 ? 'Khớp' : 'Lệch'),
      };
    }

    function runExportMomoMisa(fromIso, toIso, startSeq) {
      const toSlash   = d => d.replace(/-/g, '/'); // "DD-MM-YYYY" -> "DD/MM/YYYY"
      const ddmmToISO = d => { const [dd,mm,yy] = d.split('-'); return `${yy}-${mm}-${dd}`; };
      const inRangeDdmm = (dateDdmm, fromDdmm, toDdmm) => {
        const d = ddmmToISO(dateDdmm);
        return d >= ddmmToISO(fromDdmm) && d <= ddmmToISO(toDdmm);
      };
      const inRangeIso = (dateDdmm) => {
        const d = ddmmToISO(dateDdmm);
        return d >= fromIso && d <= toIso;
      };

      const MOMO_BANK_ACCOUNT  = COMPANY === 'kh_moi' ? 8620107701 : 8699123456;
      const MOMO_BANK_FULLNAME = 'Ngân hàng TMCP Đầu tư và Phát triển Việt Nam';

      // byDate: TẤT CẢ ngày Momo (không lọc theo khoảng xuất) -- 1 đợt NH trả
      // có thể gộp ngày Momo nằm ngoài khoảng đang chọn xuất, cần đủ dữ liệu
      // để tính đúng chênh lệch làm tròn của cả đợt.
      const byDate = {};
      _rows.forEach(r => {
        if (!byDate[r.date]) byDate[r.date] = {};
        const maCT = (_ctMap[r.gian] || {}).maCT;
        const gKey = maCT || r.gian;
        if (!byDate[r.date][gKey]) byDate[r.date][gKey] = { amount: 0, fee: 0, maCT: maCT || null, gians: [] };
        const rate = r.feeRate != null ? r.feeRate : (COMPANY === 'kh_cu' ? 0.011 : 0.01);
        byDate[r.date][gKey].amount += r.amount;
        byDate[r.date][gKey].fee    += r.amount * rate;
        if (!byDate[r.date][gKey].gians.includes(r.gian)) byDate[r.date][gKey].gians.push(r.gian);
      });

      // Net thực 1 ngày -- y hệt computeDayFinalNet bên renderDoiSoatNgay.
      const computeDayFinalNet = (date) => {
        const gianData = byDate[date] || {};
        const gList = Object.keys(gianData).sort();
        if (!gList.length) return 0;
        const nets = gList.map(g => {
          const dg = gianData[g];
          const hd = _hdData[`${date}|${g}`] || {};
          const maCT = dg.maCT;
          const serverKey = maCT ? `${ddmmToISO(date)}|${maCT}` : null;
          let serverNetVal = serverKey && _serverNet[serverKey] != null ? _serverNet[serverKey] : null;
          const net = (hd.netOvr != null && hd.netOvr !== '') ? (parseFloat(String(hd.netOvr).replace(/[^0-9.-]/g,''))||0)
                    : (serverNetVal != null ? serverNetVal : (dg.amount - Math.round(dg.fee)));
          return net;
        });
        const dayNet = nets.reduce((s,n) => s+n, 0);
        let rounded = nets.map(n => Math.round(n));
        const sumR = rounded.reduce((s,n) => s+n, 0);
        const adj = Math.round(dayNet) - sumR;
        if (adj !== 0) {
          const maxIdx = nets.reduce((mi, n, i) => n >= nets[mi] ? i : mi, 0);
          rounded[maxIdx] += adj;
        }
        const dayNH = gList.reduce((s,g) => {
          const v = parseFloat(String((_hdData[`${date}|${g}`]||{}).tienNH||'').replace(/[^0-9.]/g,''))||0;
          return s + v;
        }, 0);
        const sumFinal = rounded.reduce((s,n) => s+n, 0);
        const nhChenh = dayNH > 0 ? (dayNH - sumFinal) : 0;
        if (nhChenh === 1 || nhChenh === -1) return sumFinal + nhChenh;
        return sumFinal;
      };

      // dt/net thực cho 1 (date, gKey) -- y hệt getGianDisplay bên renderDoiSoatNgay.
      const getGianDT = (date, g) => {
        const dg = byDate[date][g];
        const feeR = Math.round(dg.fee);
        const hd = _hdData[`${date}|${g}`] || {};
        const maCT = dg.maCT;
        const serverKey = maCT ? `${ddmmToISO(date)}|${maCT}` : null;
        const serverNetVal   = serverKey && _serverNet[serverKey]   != null ? _serverNet[serverKey]   : null;
        const serverGrossVal = serverKey && _serverGross[serverKey] != null ? _serverGross[serverKey] : null;
        const dt  = (hd.dtOvr  != null && hd.dtOvr  !== '') ? (parseFloat(String(hd.dtOvr).replace(/[^0-9.-]/g,''))||0)
                   : (serverGrossVal != null ? serverGrossVal : dg.amount);
        const net = (hd.netOvr != null && hd.netOvr !== '') ? (parseFloat(String(hd.netOvr).replace(/[^0-9.-]/g,''))||0)
                   : (serverNetVal != null ? serverNetVal : (dg.amount - feeR));
        return { dt, net, hd };
      };

      // Chênh lệch làm tròn của từng đợt NH trả, dồn vào (date|gKey) có amount
      // lớn nhất trong đợt -- y hệt _batchAdjMap bên renderDoiSoatNgay.
      const batchAdjMap = {};
      const hasBankPayments = _bankMomoPayments.length > 0;
      const batches = [];
      if (hasBankPayments) {
        _bankMomoPayments.forEach(pay => {
          const payDates = _dates.filter(d => inRangeDdmm(d, pay.fromDate, pay.toDate));
          if (!payDates.length) return;
          const momoNet = payDates.reduce((s,d) => s + computeDayFinalNet(d), 0);
          const chenhNH = pay.amount - momoNet;
          if (chenhNH !== 0 && Math.abs(chenhNH) <= 700) {
            let maxAmt = -1, adjDate = null, adjGian = null;
            payDates.forEach(d => {
              Object.entries(byDate[d] || {}).forEach(([g, dg]) => {
                if (dg.amount > maxAmt) { maxAmt = dg.amount; adjDate = d; adjGian = g; }
              });
            });
            if (adjDate && adjGian) batchAdjMap[`${adjDate}|${adjGian}`] = chenhNH;
          }
          batches.push({ payDate: pay.payDate, payDates });
        });
      }

      const rows = [];
      const skippedUnmapped = [];
      const coveredDates = new Set();
      let seq = startSeq;

      // 1) Các đợt NH trả về -- gom tất cả ngày Momo trong đợt thành 1 chứng
      // từ theo đúng ngày NH thực trả, cộng dồn theo từng Mã CT.
      batches
        .slice()
        .sort((a,b) => ddmmToISO(a.payDate).localeCompare(ddmmToISO(b.payDate)))
        .forEach(bg => {
          bg.payDates.forEach(d => coveredDates.add(d));
          if (!inRangeIso(bg.payDate)) return;
          const byMaCT = {};
          bg.payDates.forEach(date => {
            const gianData = byDate[date] || {};
            Object.keys(gianData).forEach(g => {
              const dg = gianData[g];
              if (!dg.maCT) { skippedUnmapped.push(dg.gians.join(', ') || g); return; }
              const { dt, net, hd } = getGianDT(date, g);
              const bAdj = batchAdjMap[`${date}|${g}`] || 0;
              if (!byMaCT[dg.maCT]) byMaCT[dg.maCT] = { dt: 0, net: 0, soHDs: [], tienHD: 0 };
              byMaCT[dg.maCT].dt  += dt;
              byMaCT[dg.maCT].net += net + bAdj;
              const soHD = (hd.soHD||'').trim();
              if (soHD) {
                byMaCT[dg.maCT].soHDs.push(soHD);
                byMaCT[dg.maCT].tienHD += parseFloat(String(hd.soTienHD||'').replace(/[^0-9.]/g,'')) || 0;
              }
            });
          });
          const maCTList = Object.keys(byMaCT).sort();
          if (!maCTList.length) return;
          const soCt = 'NTTK' + String(seq).padStart(7,'0') + '/26';
          maCTList.forEach(maCT => {
            const b = byMaCT[maCT];
            const soHD = b.soHDs.join(', ');
            const dienGiai = soHD
              ? `Thu tiền dịch vụ vui chơi giải trí - MM theo HĐ ${soHD}`
              : 'Thu tiền dịch vụ vui chơi giải trí - MM';
            rows.push(buildMisaRow({
              date: bg.payDate, soCt, maCT, dt: b.dt, net: b.net,
              soHD, tienHD: b.tienHD, dienGiai,
              bankAcc: MOMO_BANK_ACCOUNT, bankName: MOMO_BANK_FULLNAME, toSlash,
            }));
          });
          seq++;
        });

      // 2) Ngày Momo CHƯA có đợt NH trả về -- fallback xuất riêng theo đúng
      // ngày Momo (như trước), lọc theo khoảng ngày hạch toán đang chọn.
      const unpaidDates = _dates.filter(d => !coveredDates.has(d) && inRangeIso(d));
      unpaidDates
        .slice()
        .sort((a,b) => ddmmToISO(a).localeCompare(ddmmToISO(b)))
        .forEach(date => {
          const gianData = byDate[date] || {};
          const gianList = Object.keys(gianData).sort();
          if (!gianList.length) return;
          const soCt = 'NTTK' + String(seq).padStart(7,'0') + '/26';
          let used = false;
          gianList.forEach(g => {
            const dg = gianData[g];
            if (!dg.maCT) { skippedUnmapped.push(dg.gians.join(', ') || g); return; }
            const { dt, net, hd } = getGianDT(date, g);
            const soHD = (hd.soHD||'').trim();
            const tienHD = parseFloat(String(hd.soTienHD||'').replace(/[^0-9.]/g,'')) || 0;
            const dienGiai = soHD
              ? `Thu tiền dịch vụ vui chơi giải trí - MM theo HĐ ${soHD}`
              : 'Thu tiền dịch vụ vui chơi giải trí - MM';
            rows.push(buildMisaRow({
              date, soCt, maCT: dg.maCT, dt, net, soHD, tienHD, dienGiai,
              bankAcc: MOMO_BANK_ACCOUNT, bankName: MOMO_BANK_FULLNAME, toSlash,
            }));
            used = true;
          });
          if (used) seq++;
        });

      if (!rows.length) { alert('Không có gian nào đã map Mã CT để xuất trong khoảng ngày đã chọn -- vào tab "📊 Theo gian" bấm "Map CT" map trước rồi xuất lại.'); return; }

      const wb = XLSX.utils.book_new();
      const ws = XLSX.utils.json_to_sheet(rows);
      XLSX.utils.book_append_sheet(wb, ws, MOMO_MISA_LABEL);
      const fname = MOMO_MISA_LABEL + '_Momo_' + fromIso + '_den_' + toIso + '.xlsx';
      XLSX.writeFile(wb, fname);

      if (skippedUnmapped.length) {
        const uniq = [...new Set(skippedUnmapped)];
        alert(`✅ Đã xuất ${rows.length} dòng vào file ${fname}\n\n⚠️ Bỏ qua ${uniq.length} gian CHƯA map Mã CT (vào tab "Map CT" map rồi xuất lại):\n${uniq.slice(0,10).join(', ')}${uniq.length>10?'...':''}`);
      } else {
        alert(`✅ Đã xuất ${rows.length} dòng vào file ${fname}`);
      }
    }

    // ── MTT / Hóa đơn ──
    const LS_MTT_CU     = `mtt_cu_${COMPANY}`;
    const LS_MTT_MOI    = `mtt_moi_${COMPANY}`;
    const LS_MTT_CT_MAP = `mtt_ct_map_${COMPANY}`;
    const LS_MTT_HIST   = `mtt_hist_${COMPANY}`;
    let _mttCu     = [];
    let _mttMoi    = [];
    let _mttActive = COMPANY === 'kh_cu' ? 'cu' : 'moi';
    let _mttCtMap  = { cu: {}, moi: {} }; // tách riêng KH Cũ / KH Mới
    let _mttHist   = []; // [{ fileName, uploadedAt, cuCount, moiCount }]

    try { const s = localStorage.getItem(LS_MTT_CU);     if (s) _mttCu     = JSON.parse(s); } catch(e) {}
    try { const s = localStorage.getItem(LS_MTT_MOI);    if (s) _mttMoi    = JSON.parse(s); } catch(e) {}
    try {
      const s = localStorage.getItem(LS_MTT_CT_MAP);
      if (s) {
        const parsed = JSON.parse(s);
        // Migration: nếu data cũ là flat object → bỏ qua, dùng cấu trúc mới
        if (parsed && typeof parsed.cu === 'object') _mttCtMap = parsed;
      }
    } catch(e) {}
    try { const s = localStorage.getItem(LS_MTT_HIST);   if (s) _mttHist   = JSON.parse(s); } catch(e) {}
    if (_mttCu.length || _mttMoi.length) { renderMttTable(); }

    function openMttModal()  { document.getElementById('mttModal').classList.add('open'); }
    function closeMttModal() { document.getElementById('mttModal').classList.remove('open'); }

    function switchMttTab(tab) {
      _mttActive = tab;
      document.getElementById('mttTabCu').classList.toggle('active', tab === 'cu');
      document.getElementById('mttTabMoi').classList.toggle('active', tab === 'moi');
      document.getElementById('mttTabHist').classList.toggle('active', tab === 'hist');
      document.getElementById('mttResults').style.display = tab === 'hist' ? 'none' : 'block';
      document.getElementById('mttSummary').style.display = tab === 'hist' ? 'none' : 'flex';
      document.getElementById('mttHistPanel').style.display = tab === 'hist' ? 'block' : 'none';
      if (tab === 'hist') renderMttHistory();
      else renderMttTable();
    }

    function parseMttSheet(data, isCu) {
      // Tìm dòng header (có 'Số HĐ')
      let headerIdx = -1;
      for (let i = 0; i < data.length; i++) {
        if (data[i].some(c => String(c||'').trim() === 'Số HĐ')) { headerIdx = i; break; }
      }
      if (headerIdx < 0) return [];
      const header = data[headerIdx];
      const fc = name => header.findIndex(c => String(c||'').trim() === name);
      const colNgay  = fc('Ngày HĐ');
      const colSoHD  = fc('Số HĐ');
      const colTong  = fc('Tổng TT HĐ htoan Misa');
      const colDV    = isCu ? fc('Nội dung xuất hóa đơn') : fc('Nội dung hóa đơn');
      const colMaDiem = isCu ? fc('Mã điểm trên misa thuế') : fc('Mã điểm ghi chú HT Misa');
      const colMaNCC  = isCu ? fc('Mã KH HT Misa') : fc('Mã NCC HT Misa');
      const colGhiChu    = fc('ghi chú');
      const colSoHopDong = fc('Số hợp đồng');
      const colThuHo  = isCu ? header.findIndex(c => String(c||'').includes('Dịch vụ thu hộ'))
                              : fc('Dịch vụ thu hộ');
      const rows = [];
      for (let i = headerIdx + 1; i < data.length; i++) {
        const r = data[i];
        const soHD = r[colSoHD];
        const tong = r[colTong];
        if (!soHD && !tong) continue;
        // Format ngày
        let ngay = '';
        const rawD = r[colNgay];
        if (typeof rawD === 'number') {
          // Excel serial → JS Date via XLSX
          const d = XLSX.SSF.parse_date_code(rawD);
          ngay = `${String(d.d).padStart(2,'0')}/${String(d.m).padStart(2,'0')}/${d.y}`;
        } else if (rawD instanceof Date) {
          ngay = `${String(rawD.getDate()).padStart(2,'0')}/${String(rawD.getMonth()+1).padStart(2,'0')}/${rawD.getFullYear()}`;
        } else if (rawD) { ngay = String(rawD); }
        rows.push({
          ngay,
          soHD: soHD || '',
          tongTien: typeof tong === 'number' ? tong : (parseFloat(String(tong).replace(/[^0-9.-]/g,''))||0),
          dichVu:   String(r[colDV]    ||''),
          maDiem:   String(r[colMaDiem]||''),
          maNCC:    String(r[colMaNCC] ||''),
          ghiChu:      String(r[colGhiChu]   ||''),
          soHopDong:   String(r[colSoHopDong]||'').toLowerCase().trim(),
          dichVuThuHo: String(r[colThuHo]    ||''),
        });
      }
      rows.sort((a,b) => (Number(a.soHD)||0) - (Number(b.soHD)||0));
      return rows;
    }

    function handleMttFile(file) {
      if (!file) return;
      const st = document.getElementById('mttUploadStatus');
      st.className = 'upload-status loading';
      st.textContent = '⏳ Đang đọc file...';
      const reader = new FileReader();
      reader.onload = function(e) {
        try {
          const wb = XLSX.read(e.target.result, { type: 'array', cellDates: false });
          // Tìm sheet KH Cũ (989)
          const shCuName  = wb.SheetNames.find(n => n.includes('989') && n.toLowerCase().includes('kê'));
          // Tìm sheet KH Mới (705 hoặc "kê ds xuất HĐ MTT" không có 989)
          const shMoiName = wb.SheetNames.find(n => !n.includes('989') && n.toLowerCase().includes('kê'));
          const cuData  = shCuName  ? XLSX.utils.sheet_to_json(wb.Sheets[shCuName],  { header:1, defval:'' }) : [];
          const moiData = shMoiName ? XLSX.utils.sheet_to_json(wb.Sheets[shMoiName], { header:1, defval:'' }) : [];
          // Merge (không ghi đè) — bỏ qua dòng đã có cùng Số HĐ
          const newCu  = parseMttSheet(cuData,  true);
          const newMoi = parseMttSheet(moiData, false);
          const exCuHD  = new Set(_mttCu.map(r => r.soHD));
          const exMoiHD = new Set(_mttMoi.map(r => r.soHD));
          const addCu   = newCu.filter(r => !exCuHD.has(r.soHD));
          const addMoi  = newMoi.filter(r => !exMoiHD.has(r.soHD));
          _mttCu  = [..._mttCu,  ...addCu];
          _mttMoi = [..._mttMoi, ...addMoi];
          // Sắp xếp lại theo soHD
          _mttCu.sort((a,b) => String(a.soHD).localeCompare(String(b.soHD), undefined, { numeric: true }));
          _mttMoi.sort((a,b) => String(a.soHD).localeCompare(String(b.soHD), undefined, { numeric: true }));
          try { lsSet(LS_MTT_CU,  JSON.stringify(_mttCu));  } catch(e) {}
          try { lsSet(LS_MTT_MOI, JSON.stringify(_mttMoi)); } catch(e) {}
          // Ghi lịch sử
          const hist = { fileName: file.name, uploadedAt: new Date().toLocaleString('vi'),
            cuAdded: addCu.length, moiAdded: addMoi.length,
            cuSkip: newCu.length - addCu.length, moiSkip: newMoi.length - addMoi.length };
          _mttHist.unshift(hist);
          if (_mttHist.length > 30) _mttHist.length = 30;
          try { lsSet(LS_MTT_HIST, JSON.stringify(_mttHist)); } catch(e) {}
          const skipMsg = (hist.cuSkip + hist.moiSkip) > 0 ? ` (bỏ qua ${hist.cuSkip + hist.moiSkip} trùng)` : '';
          st.className = 'upload-status ok';
          st.textContent = `✅ Thêm ${addCu.length} KH Cũ · ${addMoi.length} KH Mới${skipMsg} · Tổng: ${_mttCu.length}+${_mttMoi.length}`;
          closeMttModal();
          renderMttTable();
        } catch(err) {
          st.className = 'upload-status err';
          st.textContent = '❌ Lỗi: ' + err.message;
        }
      };
      reader.readAsArrayBuffer(file);
    }

    function populateMttMonthFilter(rows) {
      const sel = document.getElementById('mttMonthFilter');
      if (!sel) return;
      const cur = sel.value;
      const months = [...new Set(rows.map(r => {
        const p = r.ngay.split('/');
        return p.length === 3 ? `${p[1]}/${p[2]}` : '';
      }).filter(Boolean))].sort((a,b) => {
        const [ma,ya] = a.split('/'); const [mb,yb] = b.split('/');
        return (ya+ma).localeCompare(yb+mb);
      });
      sel.innerHTML = `<option value="">Tất cả</option>` + months.map(m => `<option value="${m}">${m}</option>`).join('');
      if (months.includes(cur)) sel.value = cur;
    }

    function renderMttTable() {
      const allRows = _mttActive === 'cu' ? _mttCu : _mttMoi;
      const label   = _mttActive === 'cu' ? 'KH Cũ (989)' : 'KH Mới (705)';
      const hasCu   = _mttCu.length > 0;
      const hasMoi  = _mttMoi.length > 0;
      if (!hasCu && !hasMoi) {
        document.getElementById('mttEmpty').style.display = 'block';
        document.getElementById('mttResults').style.display = 'none';
        document.getElementById('mttSubTabs').style.display = 'none';
        document.getElementById('mttSummary').style.display = 'none';
        return;
      }
      document.getElementById('mttEmpty').style.display = 'none';
      document.getElementById('mttResults').style.display = 'block';
      document.getElementById('mttSubTabs').style.display = 'flex';

      // Month filter
      populateMttMonthFilter(allRows);
      const selMonth = (document.getElementById('mttMonthFilter')||{}).value || '';
      const rows = selMonth ? allRows.filter(r => {
        const p = r.ngay.split('/'); return p.length === 3 && `${p[1]}/${p[2]}` === selMonth;
      }) : allRows;

      const fmt = n => Math.round(n).toLocaleString('vi');
      const tongAll  = rows.reduce((s,r) => s + r.tongTien, 0);
      const tongCuAll = _mttCu.filter(r => !selMonth || (() => { const p=r.ngay.split('/'); return p.length===3&&`${p[1]}/${p[2]}`===selMonth; })()).reduce((s,r)=>s+r.tongTien,0);
      const tongMoiAll = _mttMoi.filter(r => !selMonth || (() => { const p=r.ngay.split('/'); return p.length===3&&`${p[1]}/${p[2]}`===selMonth; })()).reduce((s,r)=>s+r.tongTien,0);

      // Summary
      const sumEl = document.getElementById('mttSummary');
      sumEl.style.display = 'flex';

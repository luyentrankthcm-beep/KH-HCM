    async function fetchBankVnpay() {
      if(!_vnpayFee.length) return;
      const dates = _vnpayFee.map(r => r.date);
      if(!dates.length) return;
      const iso = d => { const p=d.split('-'); return p[2]+'-'+p[1]+'-'+p[0]; };
      const sorted = [...dates].sort((a,b) => iso(a).localeCompare(iso(b)));
      const st = document.getElementById('bankVnpayStatus');
      if(st) st.textContent = '⏳ Đang tải...';
      try {
        const res  = await fetch('/api/dau-ra/bank-vnpay?from='+iso(sorted[0])+'&to='+iso(sorted[sorted.length-1]));
        const json = await res.json();
        if(json.ok){
          _bankVnpayPayments = json.payments||[];
          if(st) st.textContent = '✓ '+_bankVnpayPayments.length+' đợt NH · '+iso(sorted[0])+' → '+iso(sorted[sorted.length-1]);
          renderBankVnpayRaw();
          renderVnpayDoiSoat();
        } else {
          if(st) st.textContent = '❌ '+json.error;
        }
      } catch(e){ if(st) st.textContent = '❌ Lỗi kết nối'; }
    }
    async function fetchBankVnpayRefresh() {
      await fetchBankVnpay();
      const p = document.getElementById('bankVnpayDetailPanel');
      if(p) p.style.display = '';
    }

    // ══════════════════════════════════════════
    // PAYOO — mỗi (Cửa hàng, Hình thức thanh toán) là 1 gian riêng. Khung
    // đối soát giống hệt VNPay, khác biệt DUY NHẤT: NH trả về ACB1268 mỗi
    // ngày có 2 giao dịch (QR + Thẻ) nên phải so khớp Net theo ĐÚNG loại,
    // không gộp chung 2 loại lại khi tính Chênh.
    // ══════════════════════════════════════════
    function renderPayooSummary() {
      const el = document.getElementById('payoo_summary');
      if(!el) return;
      const n = _payooFee.length;
      if(!n) { el.textContent = ''; return; }
      const gians = new Set(_payooFee.map(r=>r.gian)).size;
      el.innerHTML = `${n} GD · ${gians} gian`;
    }

    function getPayooMaCT(gian) {
      const m = (_payooSpMap[gian]||'').trim();
      return m || gian;
    }

    function populatePayooMonthFilter() {
      const sel = document.getElementById('payooFilterMonth');
      if(!sel) return;
      const months = [...new Set(_payooFee.map(r => {
        const p = r.date ? r.date.split('-') : [];
        return p.length===3 ? p[1]+'/'+p[2] : '';
      }).filter(Boolean))].sort().reverse();
      const cur = sel.value;
      sel.innerHTML = '<option value="">-- Tất cả --</option>'
        + months.map(m=>`<option value="${m}"${m===cur?' selected':''}>${m}</option>`).join('');
    }

    function getPayooGianDisp(date, maCT, d) {
      const hd = _payooHD[date+'|'+maCT] || {};
      const dt  = (hd.dtOvr  != null && hd.dtOvr  !== '') ? (parseFloat(String(hd.dtOvr).replace(/[^0-9.-]/g,''))||0)  : d.gross;
      const net = (hd.netOvr != null && hd.netOvr !== '') ? (parseFloat(String(hd.netOvr).replace(/[^0-9.-]/g,''))||0) : d.net;
      return { dt, net, phi: dt - net, hasDtOvr: hd.dtOvr!=null && hd.dtOvr!=='', hasNetOvr: hd.netOvr!=null && hd.netOvr!=='' };
    }
    function computePayooDayNet(date, byDateRef) {
      const ctData = byDateRef[date]; if(!ctData) return 0;
      return Object.entries(ctData).reduce((s,[maCT,d]) => s + getPayooGianDisp(date,maCT,d).net, 0);
    }
    // So Net theo ĐÚNG loại QR/Thẻ (mỗi maCT gán loại = loại của các dòng gộp
    // vào nó -- bình thường 1 maCT chỉ chứa 1 loại vì Luyen map tách riêng).
    function computePayooDayNetByType(date, type, byDateRef) {
      const ctData = byDateRef[date]; if(!ctData) return 0;
      return Object.entries(ctData).filter(([maCT,d])=>d.loai===type)
        .reduce((s,[maCT,d]) => s + getPayooGianDisp(date,maCT,d).net, 0);
    }

    function renderPayooDoiSoat() {
      const el = document.getElementById('payooDoiSoatBody');
      if(!el) return;
      if(!_payooFee.length) {
        el.innerHTML='<div class="empty-state"><div class="big-icon">🟪</div><p>Tải file "Giao dịch bán hàng" từ Payoo để bắt đầu đối soát</p></div>';
        return;
      }
      const fmtN = n => Math.round(n).toLocaleString('vi');
      const iso  = d => { const p=d.split('-'); return p[2]+'-'+p[1]+'-'+p[0]; };
      const sortDate = (a,b) => iso(a).localeCompare(iso(b));
      const inRange = (d,f,t) => !f||!t ? false : iso(d)>=iso(f) && iso(d)<=iso(t);

      populatePayooMonthFilter();
      const selMonth = (document.getElementById('payooFilterMonth')||{}).value || '';

      const byDate = {}; // date -> maCT -> {gross,phi,net,soDon,loai}
      _payooFee.forEach(r => {
        const maCT = getPayooMaCT(r.gian);
        if(!byDate[r.date]) byDate[r.date]={};
        if(!byDate[r.date][maCT]) byDate[r.date][maCT]={gross:0,phi:0,net:0,soDon:0,loai:r.loai};
        byDate[r.date][maCT].gross += r.gross;
        byDate[r.date][maCT].phi   += r.phi;
        byDate[r.date][maCT].net   += r.net;
        byDate[r.date][maCT].soDon += 1;
      });
      const allDates = Object.keys(byDate).sort(sortDate);
      const filteredDates = selMonth
        ? allDates.filter(d => { const p=d.split('-'); return p[1]+'/'+p[2]===selMonth; })
        : allDates;

      let totGross=0,totPhi=0,totNet=0,totN=0;
      filteredDates.forEach(dt=>Object.entries(byDate[dt]).forEach(([maCT,d])=>{const gDisp=getPayooGianDisp(dt,maCT,d);totGross+=gDisp.dt;totPhi+=gDisp.phi;totNet+=gDisp.net;totN+=d.soDon;}));

      let html = '<div style="margin-bottom:.5rem;font-size:.82em;color:#64748b">';
      html += '\u{1F4CA} Payoo: <strong>'+_payooFee.length+'</strong> GD · '+filteredDates.length+' ngày';
      html += '</div>';

      const unmappedSp = Object.entries(_payooSpMap).filter(([k,v]) => !v);
      if (unmappedSp.length) {
        html += '<div style="background:#fef3c7;border:1px solid #f59e0b;border-radius:8px;padding:.6rem 1rem;margin-bottom:.6rem;font-size:.87em;color:#92400e;display:flex;justify-content:space-between;align-items:center;gap:.6rem;flex-wrap:wrap">'
          +'<span>⚠️ Có <strong>'+unmappedSp.length+'</strong> Cửa hàng/Hình thức <strong>MỚI</strong> chưa map mã CT (vd: '+unmappedSp.slice(0,3).map(([k])=>k).join(', ')+(unmappedSp.length>3?'...':'')+') — sẽ hiện tên gốc thay vì đúng gian cho tới khi map.</span>'
          +'<button onclick="switchPayooSub(\'map\')" style="background:#f59e0b;color:#fff;border:none;border-radius:6px;padding:.3rem .8rem;font-weight:700;cursor:pointer;white-space:nowrap">🗺️ Map ngay</button>'
          +'</div>';
      }

      const invoiceGroups = {};
      allDates.forEach(dt => {
        const ctData0 = byDate[dt]; if(!ctData0) return;
        Object.keys(ctData0).forEach(maCT => {
          const hd = _payooHD[dt+'|'+maCT] || {};
          const soHD = (hd.soHD||'').trim();
          if(!soHD) return;
          const gDisp0 = getPayooGianDisp(dt, maCT, ctData0[maCT]);
          const tienHD0 = parseFloat((hd.tienHD||'0').toString().replace(/[^0-9.-]/g,''))||0;
          const key = maCT+'|'+soHD;
          if(!invoiceGroups[key]) invoiceGroups[key] = {dt:0, tienHDs:[], dates:[]};
          invoiceGroups[key].dt += gDisp0.dt;
          invoiceGroups[key].tienHDs.push(tienHD0);
          invoiceGroups[key].dates.push(dt);
        });
      });
      // Xem ghi chú tương ứng ở renderZaloDoiSoat: nếu mọi ngày trong nhóm
      // ghi CÙNG 1 số tiền hóa đơn (không tự chia) thì không cộng dồn nhân đôi.
      Object.values(invoiceGroups).forEach(g => {
        const uniq = [...new Set(g.tienHDs.filter(v=>v>0))];
        g.tienHD = uniq.length <= 1 ? (uniq[0]||0) : g.tienHDs.reduce((s,v)=>s+v,0);
      });

      const renderDateBlock = date => {
        const ctData = byDate[date];
        if(!ctData) return '';
        const ctKeys = Object.keys(ctData).sort((a,b)=>a.localeCompare(b));
        const disps = {};
        ctKeys.forEach(maCT => { disps[maCT] = getPayooGianDisp(date, maCT, ctData[maCT]); });
        const dayGross=ctKeys.reduce((s,g)=>s+disps[g].dt,0);
        const dayNet=ctKeys.reduce((s,g)=>s+disps[g].net,0);
        const dayN=Object.values(ctData).reduce((s,d)=>s+d.soDon,0);
        const [dd,mm,yyyy]=date.split('-');
        const dateId = date.replace(/-/g,'_');
        let out = '<div style="margin-bottom:.8rem">'
          +'<div style="background:#4c1d95;color:#fff;padding:.4rem .75rem;font-weight:700;font-size:.87em;display:flex;justify-content:space-between;cursor:pointer" onclick="togglePayooEditPanel(\''+dateId+'\')">'
          +'<span>\u{1F4C5} '+dd+'/'+mm+'/'+yyyy+'</span>'
          +'<span style="font-size:.81em;font-weight:400;color:#e9d5ff">'+dayN+' GD · DT: '+fmtN(dayGross)+'đ · Net: '+fmtN(dayNet)+'đ &nbsp;<span style="opacity:.8">✏️ Sửa</span></span>'
          +'</div>'
          +'<table style="width:100%;border-collapse:collapse;font-size:.84em">'
          +'<thead><tr style="background:#5b21b6;color:#f5f3ff">'
          +'<th style="padding:.3rem .6rem;text-align:left">Mã CT (Gian)</th>'
          +'<th style="text-align:right;padding:.3rem .4rem">Số GD</th>'
          +'<th style="text-align:right;padding:.3rem .4rem">DT trước KM</th>'
          +'<th style="text-align:right;padding:.3rem .4rem">Phí GW</th>'
          +'<th style="text-align:right;padding:.3rem .4rem">Net GW</th>'
          +'<th style="text-align:center;padding:.3rem .4rem">Số HĐ</th>'
          +'<th style="text-align:right;padding:.3rem .4rem">Tiền HĐ</th>'
          +'<th style="text-align:right;padding:.3rem .4rem">Chênh</th>'
          +'</tr></thead><tbody>';
        ctKeys.forEach((maCT,i) => {
          const d = ctData[maCT];
          const gDisp = disps[maCT];
          const loaiTag = ' <span style="font-size:.72em;font-weight:700;padding:.05rem .35rem;border-radius:4px;vertical-align:middle;background:'+(d.loai==='THE'?'#dbeafe;color:#1d4ed8':'#dcfce7;color:#15803d')+'">'+(d.loai==='THE'?'Thẻ':'QR')+'</span>';
          const ctLabel = '<span class="ct-badge">'+maCT+'</span>'+loaiTag;
          const hdKey = date+'|'+maCT;
          const hd = _payooHD[hdKey] || {};
          const tienHD = parseFloat((hd.tienHD||'0').toString().replace(/[^0-9.-]/g,''))||0;
          const soHDNow = (hd.soHD||'').trim();
          const grp = soHDNow ? invoiceGroups[maCT+'|'+soHDNow] : null;
          const chenh = (grp && grp.dates.length > 1 && grp.tienHD)
            ? (gDisp.dt - grp.tienHD * (grp.dt > 0 ? (gDisp.dt / grp.dt) : (1 / grp.dates.length)))
            : (tienHD ? (gDisp.dt - tienHD) : null);
          const chenhColor = chenh===null?'#94a3b8':(Math.abs(chenh)<1000?'#16a34a':(chenh<0?'#ef4444':'#d97706'));
          const chenhTxt = chenh===null?'—':((chenh>0?'+':'')+fmtN(chenh));
          const bg = i%2===0?'#f8fafc':'#fff';
          const escKey = hdKey.replace(/'/g,"\\'");
          const soHDDisplay = hd.soHD
            ? '<span style="font-size:.8em;cursor:pointer" onclick="pHDEdit(this,\''+escKey+'\',\'soHD\')">'+hd.soHD+' ✏️</span>'
            : '<span style="color:#94a3b8;font-size:.75em;cursor:pointer" onclick="pHDEdit(this,\''+escKey+'\',\'soHD\')">…</span>';
          const tienHDDisplay = hd.tienHD
            ? '<span style="font-size:.8em;cursor:pointer;color:#15803d" onclick="pHDEdit(this,\''+escKey+'\',\'tienHD\')">'+hd.tienHD+' ✏️</span>'
            : '<span style="color:#94a3b8;font-size:.75em;cursor:pointer" onclick="pHDEdit(this,\''+escKey+'\',\'tienHD\')">…</span>';
          out += '<tr style="background:'+bg+'">'
            +'<td style="padding:.3rem .6rem">'+ctLabel+'</td>'
            +'<td style="text-align:right;padding:.3rem .4rem;color:#64748b">'+d.soDon+'</td>'
            +'<td style="text-align:right;padding:.3rem .4rem;color:#15803d;font-weight:600">'+fmtN(gDisp.dt)+(gDisp.hasDtOvr?'<sup style="color:#f59e0b;font-size:.7em">✏</sup>':'')+'</td>'
            +'<td style="text-align:right;padding:.3rem .4rem;color:#ef4444">'+fmtN(gDisp.phi)+'</td>'
            +'<td style="text-align:right;padding:.3rem .4rem;color:#2563eb;font-weight:700">'+fmtN(gDisp.net)+(gDisp.hasNetOvr?'<sup style="color:#f59e0b;font-size:.7em">✏</sup>':'')+'</td>'
            +'<td style="padding:.3rem .3rem;text-align:center">'+soHDDisplay+'</td>'
            +'<td style="padding:.3rem .3rem;text-align:right">'+tienHDDisplay+'</td>'
            +'<td style="text-align:right;padding:.3rem .4rem;font-weight:700;color:'+chenhColor+'">'+chenhTxt+'</td>'
            +'</tr>';
        });
        out += '</tbody></table>';
        out += '<div id="edit_payoo_'+dateId+'" style="display:none;padding:.6rem .75rem;background:#f8fafc;border:1px dashed #7c3aed;border-top:none">'
          +'<div style="font-size:.8em;font-weight:700;color:#4c1d95;margin-bottom:.4rem">✏️ Chỉnh sửa – '+dd+'/'+mm+'/'+yyyy+'</div>'
          +'<div style="overflow-x:auto"><table style="min-width:640px;border-collapse:collapse;font-size:.8em">'
          +'<thead><tr style="background:#ede9fe;color:#4c1d95">'
          +'<th style="padding:.25rem .5rem;text-align:left;border:1px solid #ddd6fe">Mã CT / Gian</th>'
          +'<th style="padding:.25rem .5rem;text-align:right;border:1px solid #ddd6fe">DT (sửa được)</th>'
          +'<th style="padding:.25rem .5rem;text-align:right;border:1px solid #ddd6fe">Net (sửa được)</th>'
          +'<th style="padding:.25rem .5rem;border:1px solid #ddd6fe">Số HĐ</th>'
          +'<th style="padding:.25rem .5rem;text-align:right;border:1px solid #ddd6fe">Tiền HĐ</th>'
          +'</tr></thead><tbody>'
          +ctKeys.map(maCT => {
            const d = ctData[maCT];
            const gDisp = disps[maCT];
            const hd = _payooHD[date+'|'+maCT] || {};
            const gKey = maCT.replace(/[^a-zA-Z0-9]/g,'_');
            return '<tr>'
              +'<td style="padding:.25rem .5rem;border:1px solid #e2e8f0;font-size:.9em">'+maCT+'</td>'
              +'<td style="padding:.25rem .5rem;border:1px solid #e2e8f0;text-align:right">'
                +'<input id="pedit_dt_'+dateId+'_'+gKey+'" type="text" value="'+gDisp.dt+'" style="width:105px;border:1px solid #bbf7d0;border-radius:4px;padding:.15rem .3rem;text-align:right;background:#f0fdf4;color:#15803d;font-weight:600"></td>'
              +'<td style="padding:.25rem .5rem;border:1px solid #e2e8f0;text-align:right">'
                +'<input id="pedit_net_'+dateId+'_'+gKey+'" type="text" value="'+gDisp.net+'" style="width:105px;border:1px solid #bfdbfe;border-radius:4px;padding:.15rem .3rem;text-align:right;background:#eff6ff;color:#0d47a1;font-weight:700"></td>'
              +'<td style="padding:.25rem .5rem;border:1px solid #e2e8f0">'
                +'<input id="pedit_soHD_'+dateId+'_'+gKey+'" type="text" value="'+(hd.soHD||'')+'" placeholder="0000123" style="width:100px;border:1px solid #cbd5e1;border-radius:4px;padding:.15rem .3rem"></td>'
              +'<td style="padding:.25rem .5rem;border:1px solid #e2e8f0;text-align:right">'
                +'<input id="pedit_tienHD_'+dateId+'_'+gKey+'" type="text" value="'+(hd.tienHD||'')+'" placeholder="0" style="width:100px;border:1px solid #cbd5e1;border-radius:4px;padding:.15rem .3rem;text-align:right"></td>'
              +'</tr>';
          }).join('')
          +'</tbody></table></div>'
          +'<div style="margin-top:.5rem;display:flex;gap:.5rem">'
          +'<button onclick="savePayooEditPanel(\''+dateId+'\',\''+date+'\',this)" data-gians=\''+JSON.stringify(ctKeys).replace(/'/g,'&#39;')+'\' style="background:#16a34a;color:#fff;border:none;border-radius:6px;padding:.3rem .8rem;font-weight:700;font-size:.8em;cursor:pointer">💾 Lưu</button>'
          +'<button onclick="togglePayooEditPanel(\''+dateId+'\')" style="background:#6b7280;color:#fff;border:none;border-radius:6px;padding:.3rem .8rem;font-weight:600;font-size:.8em;cursor:pointer">✕ Đóng</button>'
          +'</div></div></div>';
        return out;
      };

      // Luyen, 2026-09-10: "đối soát chung ngày á rồi sổ ra thôi đừng phân ra
      // thẻ với lại qr riêng" -- gộp CHUNG 2 giao dịch NH (QR+Thẻ) của cùng 1
      // khoảng ngày thành 1 tổng DUY NHẤT, so với tổng Net CHUNG (mọi gian,
      // không phân loại) -- đơn giản, giống hệt cách Zalo/VNPay đang làm.
      // (Bảng chi tiết từng gian vẫn tách QR/Thẻ riêng như cũ, chỉ có dòng
      // "NH trả về" tổng là gộp lại.)
      const paymentGroups = {};
      _bankPayooPayments.forEach(pay => {
        const key = (pay.fromDate||'')+'|'+(pay.toDate||'');
        if(!paymentGroups[key]) paymentGroups[key] = [];
        paymentGroups[key].push(pay);
      });
      const coveredDates = new Set();
      Object.values(paymentGroups).forEach(group => {
        const pay0 = group[0];
        const payAllDates = allDates.filter(d => inRange(d, pay0.fromDate, pay0.toDate));
        const payRenderDates = filteredDates.filter(d => inRange(d, pay0.fromDate, pay0.toDate));
        if(selMonth && payRenderDates.length===0){ payAllDates.forEach(d=>coveredDates.add(d)); return; }
        const totalAmount = group.reduce((s,p)=>s+p.amount,0);
        const payooNet = payAllDates.reduce((s,d)=>s+computePayooDayNet(d,byDate),0);
        const chenh = totalAmount - payooNet;
        const chCol = Math.abs(chenh)<1000?'#86efac':(chenh<0?'#fca5a5':'#fcd34d');
        const chTxt = (chenh>=0?'+':'')+fmtN(chenh);
        html += '<div style="background:#4c1d95;color:#e9d5ff;padding:.5rem .8rem;font-weight:700;font-size:.87em;border-top:2px solid #7c3aed;border-radius:4px;margin-top:.5rem;display:flex;flex-wrap:wrap;gap:.6rem;align-items:center">'
          +'<span>💜 NH trả về <strong>'+pay0.payDate+'</strong>:'
          +'<span style="background:#5b21b6;padding:.05rem .45rem;border-radius:5px;margin-left:.4rem">'+fmtN(totalAmount)+'đ</span></span>'
          +(pay0.fromDate?'<span style="font-weight:400;color:#d8b4fe;font-size:.84em">Payoo '
            +pay0.fromDate+(pay0.toDate&&pay0.toDate!==pay0.fromDate?' → '+pay0.toDate:'')+'</span>':'')
          +(payAllDates.length?'<span style="font-weight:400;color:#d8b4fe;font-size:.84em">Net: '+fmtN(payooNet)+'đ</span>':'')
          +(payAllDates.length?'<span style="color:'+chCol+';font-weight:900">'+(Math.abs(chenh)<1000?'✅':'⚠️')+' Chênh: '+chTxt+'đ</span>':'')
          +'</div>';
        payAllDates.forEach(d=>coveredDates.add(d));
        payRenderDates.forEach(d=>{ html += renderDateBlock(d); });
      });

      const unpaidDates = filteredDates.filter(d=>!coveredDates.has(d));
      if(unpaidDates.length) {
        if(_bankPayooPayments.length) {
          const unpaidNet = unpaidDates.reduce((s,d)=>s+computePayooDayNet(d,byDate),0);
          html += '<div style="background:#78350f;color:#fef3c7;padding:.5rem .8rem;font-weight:700;font-size:.86em;border-top:2px solid #d97706;border-radius:4px;margin-top:.5rem">'
            +'⏳ Chưa có NH trả về &nbsp;·&nbsp; Tổng Net: '+fmtN(unpaidNet)+'đ</div>';
        }
        unpaidDates.forEach(d=>{ html += renderDateBlock(d); });
      }

      const byGian = {};
      filteredDates.forEach(dt => {
        Object.entries(byDate[dt]).forEach(([maCT,d]) => {
          const gDisp = getPayooGianDisp(dt, maCT, d);
          if(!byGian[maCT]) byGian[maCT]={soDon:0,gross:0,phi:0,net:0};
          byGian[maCT].soDon+=d.soDon; byGian[maCT].gross+=gDisp.dt; byGian[maCT].phi+=gDisp.phi; byGian[maCT].net+=gDisp.net;
        });
      });
      const gianKeys = Object.keys(byGian).sort();
      html += '<table style="width:100%;border-collapse:collapse;font-size:.85em;margin-top:.6rem"><tbody>'
        +'<tr style="background:#4c1d95;color:#fff;font-weight:700">'
        +'<td style="padding:.5rem .75rem">TỔNG CỘNG ('+filteredDates.length+' ngày)</td>'
        +'<td style="text-align:right;padding:.5rem .5rem">'+totN+' GD</td>'
        +'<td style="text-align:right;padding:.5rem .5rem">'+fmtN(totGross)+'</td>'
        +'<td style="text-align:right;padding:.5rem .5rem">'+fmtN(totPhi)+'</td>'
        +'<td style="text-align:right;padding:.5rem .5rem">'+fmtN(totNet)+'</td>'
        +'<td colspan="3"></td></tr>';
      gianKeys.forEach((maCT,i) => {
        const g = byGian[maCT];
        html += '<tr style="background:'+(i%2===0?'#f5f3ff':'#ede9fe')+'">'
          +'<td style="padding:.3rem .75rem;padding-left:1.5rem"><span class="ct-badge">'+maCT+'</span></td>'
          +'<td style="text-align:right;padding:.3rem .5rem;color:#64748b">'+g.soDon+'</td>'
          +'<td style="text-align:right;padding:.3rem .5rem;color:#15803d;font-weight:600">'+fmtN(g.gross)+'</td>'
          +'<td style="text-align:right;padding:.3rem .5rem;color:#ef4444">'+fmtN(g.phi)+'</td>'
          +'<td style="text-align:right;padding:.3rem .5rem;color:#2563eb;font-weight:700">'+fmtN(g.net)+'</td>'
          +'<td colspan="3"></td></tr>';
      });
      html += '</tbody></table>';
      el.innerHTML = html;
    }

    function savePayooSpMap(inp) {
      const sp = inp.dataset.sp;
      const maCT = inp.value.trim();
      _payooSpMap[sp] = maCT;
      lsSet(LS_PAYOO_SP_MAP, JSON.stringify(_payooSpMap));
      renderPayooCtMap();
      renderPayooDoiSoat();
    }

    function renderPayooCtMap() {
      const el = document.getElementById('payooCtMapContent');
      if(!el) return;
      const gians = Object.keys(_payooSpMap).sort();
      if(!gians.length) {
        el.innerHTML='<div class="empty-state"><div class="big-icon">🗺️</div><p>Tải file Payoo để thấy danh sách Cửa hàng</p></div>';
        return;
      }
      const unmappedCount = gians.filter(k=>!_payooSpMap[k]).length;
      let html = `<div style="display:flex;align-items:center;gap:.5rem;margin-bottom:.6rem;flex-wrap:wrap">
        <span style="font-size:.83em;color:#64748b">${gians.length} gian (cửa hàng × hình thức) · <span style="color:${unmappedCount?'#d97706':'#16a34a'}">${unmappedCount} chưa map</span></span>
      </div>`;
      html += '<table style="width:100%;border-collapse:collapse;font-size:.84em"><thead><tr style="background:#ede9fe;color:#4c1d95"><th style="padding:.3rem .6rem;text-align:left">Cửa hàng - Hình thức</th><th style="padding:.3rem .4rem;width:180px">Mã CT</th><th style="padding:.3rem .4rem;width:56px"></th></tr></thead><tbody>';
      gians.forEach((gian, i) => {
        const isMapped = !!_payooSpMap[gian];
        const bg = isMapped ? (i%2?'#f0fdf4':'#dcfce7') : (i%2?'#fff':'#fffbeb');
        const borderCol = isMapped ? '#86efac' : '#cbd5e1';
        const esc = gian.replace(/'/g,"&#39;").replace(/"/g,'&quot;');
        html += `<tr style="background:${bg}">
          <td style="padding:.3rem .6rem;font-size:.85em">${isMapped?'':' ⏳ '}${gian}</td>
          <td style="padding:.3rem .4rem">
            <input id="psp_${i}" data-sp="${esc}" value="${(_payooSpMap[gian]||'').replace(/"/g,'&quot;')}" placeholder="Mã CT"
              style="width:100%;border:1px solid ${borderCol};border-radius:4px;padding:.2rem .35rem;background:${isMapped?'#f0fdf4':'#fff'}"
              onkeydown="if(event.key==='Enter')savePayooSpMap(this)">
          </td>
          <td style="padding:.3rem .4rem">
            <button onclick="savePayooSpMap(document.getElementById('psp_${i}'))"
              style="background:${isMapped?'#16a34a':'#2563eb'};color:#fff;border:none;border-radius:4px;padding:.2rem .5rem;cursor:pointer;font-size:.78em">Lưu</button>
          </td>
        </tr>`;
      });
      html += '</tbody></table>';
      el.innerHTML = html;
    }

    function renderPayooHist() {
      const el = document.getElementById('payooHistBody');
      if(!el) return;
      if(!_payooHist.length) {
        el.innerHTML='<div class="empty-state"><div class="big-icon">⏱️</div><p>Chưa có lịch sử tải</p></div>';
        return;
      }

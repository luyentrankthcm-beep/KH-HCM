    async function fetchBankZalo() {
      if(!_zaloFee.length) return;
      const fzdates = _zaloFee
        .filter(r => r.maDiem==='FUNZONE1' || (r.dienThu||'').toUpperCase().includes('FUNZONE'))
        .map(r => r.date);
      if(!fzdates.length) return;
      const iso = d => { const p=d.split('-'); return p[2]+'-'+p[1]+'-'+p[0]; };
      const sorted = [...fzdates].sort((a,b) => iso(a).localeCompare(iso(b)));
      const st = document.getElementById('bankZaloStatus');
      if(st) st.textContent = '⏳ Đang tải...';
      try {
        const res  = await fetch('/api/dau-ra/bank-zalo?from='+iso(sorted[0])+'&to='+iso(sorted[sorted.length-1]));
        const json = await res.json();
        if(json.ok){
          _bankZaloPayments = json.payments||[];
          if(st) st.textContent = '✓ '+_bankZaloPayments.length+' đợt NH · '+iso(sorted[0])+' → '+iso(sorted[sorted.length-1]);
          renderBankZaloRaw();
          renderZaloDoiSoat();
        } else {
          if(st) st.textContent = '❌ '+json.error;
        }
      } catch(e){ if(st) st.textContent = '❌ Lỗi kết nối'; }
    }

    async function fetchBankZaloRefresh() {
      await fetchBankZalo();
      const p = document.getElementById('bankZaloDetailPanel');
      if(p) p.style.display = '';
    }

    function saveZaloHD(maCT, field, val) {
      if(!_zaloHD[maCT]) _zaloHD[maCT] = {};

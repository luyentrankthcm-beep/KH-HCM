        mkCard('KH Mới (705)', moiCount, tongMoiAll, '#7c3aed') +
        mkCard('Tổng cộng', cuCount+moiCount, tongCuAll+tongMoiAll, '#15803d');

      document.getElementById('mttMeta').textContent = `${label}${selMonth?' · '+selMonth:''} · ${rows.length} hóa đơn · Tổng: ${fmt(tongAll)}đ`;

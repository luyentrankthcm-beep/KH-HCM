    const LS_ZALO_HIST    = `zalo_hist_${COMPANY}`;
    const LS_ZALO_HD      = `zalo_hd_${COMPANY}`;   // { [maCT]: { soHD, tienHD } }

    let _zaloOrders = {}; // {maOrder: "tenSP" hoặc "tenSPsku"} compact map (~4x smaller than array)
    let _zaloFee    = []; // [{date, maFunzone, maDonZalo, gross, phi, net}]
    let _zaloSpMap  = {}; // tenSP hoặc Sku → maCT (2 loại key dùng chung 1 bảng)
    let _zaloHist   = [];
    let _zaloHD     = {}; // maCT → { soHD, tienHD }

    // Luyen, 2026-09-10: file OrderDetails ZaloPay có cột "Sku" (mã sản phẩm)
    // ổn định hơn "Tên sản phẩm" (tên đổi theo khuyến mãi). Đóng gói chung
    // vào 1 string "tenSPsku" trong _zaloOrders để KHÔNG phải thêm 1
    // object song song (tránh tăng gấp đôi dung lượng localStorage như
    // comment cũ đã né). Vd Luyen xác nhận: Sku "AMTP" = gian "AM TP KVCM".
    const SKU_CT_DEFAULTS = { 'AMTP': 'AM TP KVCM' };
    function packZaloOrder(tenSP, sku) { return sku ? (tenSP + '' + sku) : tenSP; }
    function unpackZaloOrder(val) {
      if (val == null) return { tenSP: '', sku: '' };
      const i = val.indexOf('');
      return i === -1 ? { tenSP: val, sku: '' } : { tenSP: val.slice(0,i), sku: val.slice(i+1) };
    }

    // Dọn key cũ (array format) để giải phóng quota
    try { lsRemove('zalo_orders_kh_cu'); lsRemove('zalo_orders_kh_moi'); } catch(e){}
    try { const s=localStorage.getItem(LS_ZALO_ORDERS); if(s) _zaloOrders=JSON.parse(s); } catch(e){ _zaloOrders={}; }
    try { const s=localStorage.getItem(LS_ZALO_FEE);    if(s) _zaloFee=JSON.parse(s);    } catch(e){ _zaloFee=[]; }
    try { const s=localStorage.getItem(LS_ZALO_HD);     if(s) _zaloHD=JSON.parse(s);     } catch(e){}
    try { const s=localStorage.getItem(LS_ZALO_SP_MAP); if(s) _zaloSpMap=JSON.parse(s);  } catch(e){}

    async function fetchBankPayoo() {
      if(!_payooFee.length) return;
      const dates = _payooFee.map(r => r.date);
      if(!dates.length) return;
      const iso = d => { const p=d.split('-'); return p[2]+'-'+p[1]+'-'+p[0]; };
      const sorted = [...dates].sort((a,b) => iso(a).localeCompare(iso(b)));
      const st = document.getElementById('bankPayooStatus');
      if(st) st.textContent = '⏳ Đang tải...';
      try {
        const res  = await fetch('/api/dau-ra/bank-payoo?from='+iso(sorted[0])+'&to='+iso(sorted[sorted.length-1]));
        const json = await res.json();
        if(json.ok){
          _bankPayooPayments = json.payments||[];
          if(st) st.textContent = '✓ '+_bankPayooPayments.length+' đợt NH · '+iso(sorted[0])+' → '+iso(sorted[sorted.length-1]);
          renderBankPayooRaw();
          renderPayooDoiSoat();
        } else {
          if(st) st.textContent = '❌ '+json.error;
        }
      } catch(e){ if(st) st.textContent = '❌ Lỗi kết nối'; }
    }

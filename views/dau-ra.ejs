        </tr>`;
        return out;
      };

      let html = '';
      const coveredDates = new Set();

      // Nhóm theo đợt NH trả về
      const hasBankPayments = _bankMomoPayments.length > 0;
      if (hasBankPayments) {
        _bankMomoPayments.forEach(pay => {
          // Tất cả ngày Momo trong khoảng trả (dùng cho tính chênh — không lọc tháng)
          const payDates = _dates.filter(d => inRange(d, pay.fromDate, pay.toDate));
          // Chỉ render ngày thuộc tháng đang chọn
          const renderDates = selMonth ? payDates.filter(d => filteredDates.includes(d)) : payDates;
          // Ẩn hoàn toàn đợt này nếu không có ngày nào trong tháng đang chọn
          if (selMonth && renderDates.length === 0) { payDates.forEach(d => coveredDates.add(d)); return; }
          const momoNet = payDates.reduce((s, d) => s + computeDayFinalNet(d), 0);
          const chenhNH = payDates.length > 0 ? (pay.amount - momoNet) : null;
          // Nếu chênh ≤ 700đ: tự điều chỉnh vào gian có amount cao nhất trong payDates
          if (chenhNH !== null && chenhNH !== 0 && Math.abs(chenhNH) <= 700) {
            let maxAmt = -1, adjDate = null, adjGian = null;
            payDates.forEach(d => {
              Object.entries(byDate[d] || {}).forEach(([g, dg]) => {
                if (dg.amount > maxAmt) { maxAmt = dg.amount; adjDate = d; adjGian = g; }
              });
            });
            if (adjDate && adjGian) _batchAdjMap[`${adjDate}|${adjGian}`] = chenhNH;
          }
          const displayChenh = (chenhNH !== null && Math.abs(chenhNH) <= 700) ? 0 : chenhNH;
          const momoNetText = payDates.length > 0
            ? ` · Momo Net: <strong>${fmtN(momoNet)}đ</strong>`
            : '';
          const chenhText = displayChenh !== null
            ? ` &nbsp;·&nbsp; ${displayChenh !== 0 ? '⚠️' : '✅'} <span style="color:${displayChenh===0?'#4ade80':'#fca5a5'}">Chênh: <strong>${displayChenh>0?'+':''}${fmtN(displayChenh)}đ</strong></span>`
            : '';

          html += `<tr>
            <td colspan="6" style="background:#1e4a6f;color:#e0f2fe;padding:.6rem .75rem;font-weight:700;font-size:.9em;border-top:2px solid #0ea5e9">
              📦 NH trả về <strong>${pay.payDate}</strong>:
              <span style="font-size:1.12em;font-weight:900;color:#fff;background:#0369a1;padding:.05rem .55rem;border-radius:6px;margin:0 2px">${fmtN(pay.amount)}đ</span>
              &nbsp;·&nbsp; Momo ngày <span style="color:#bae6fd">${pay.fromDate}</span> → <span style="color:#bae6fd">${pay.toDate}</span>${momoNetText}${chenhText}
            </td>
          </tr>`;

          payDates.forEach(d => coveredDates.add(d));
          renderDates.forEach(d => { html += renderDateRows(d); });
        });
      }

      // Ngày Momo chưa có đợt NH trả về
      const unpaidDates = filteredDates.filter(d => !coveredDates.has(d));
      if (unpaidDates.length) {
        if (hasBankPayments) {
          // Chỉ hiện header "Chưa có NH" khi đã có ít nhất 1 đợt NH (để phân biệt với ngày bình thường)
          const unpaidNet = unpaidDates.reduce((s, d) =>
            s + Object.values(byDate[d] || {}).reduce((s2, v) => s2 + v.amount - Math.round(v.fee), 0), 0);
          html += `<tr>
            <td colspan="6" style="background:#78350f;color:#fef3c7;padding:.6rem .75rem;font-weight:700;font-size:.9em;border-top:2px solid #d97706">
              ⏳ Chưa có NH trả về &nbsp;·&nbsp; Tổng Net: ${fmtN(unpaidNet)}đ
            </td>
          </tr>`;
        }
        unpaidDates.forEach(d => { html += renderDateRows(d); });
      }

      el.innerHTML = html || '<tr><td colspan="6" style="text-align:center;color:#94a3b8;padding:1.5rem">Chưa có dữ liệu</td></tr>';
    }

    // ── Export pivot ──
    function exportPivot() {
      if (!_rows.length) return;
      const wb = XLSX.utils.book_new();
      const aoa = [['Gian', ..._dates, 'Tổng']];
      const pivot = {};
      _rows.forEach(r => {
        if (!pivot[r.gian]) pivot[r.gian] = {};
        pivot[r.gian][r.date] = (pivot[r.gian][r.date] || 0) + r.amount;
      });
      let grandTotal = 0;
      _gians.forEach(g => {
        let rowT = 0;
        const vals = _dates.map(d => { const v = (pivot[g]||{})[d]||0; rowT+=v; return v; });
        grandTotal += rowT;
        aoa.push([g, ...vals, rowT]);
      });
      aoa.push(['Tổng cộng', ..._dates.map(d => _rows.filter(r=>r.date===d).reduce((s,r)=>s+r.amount,0)), grandTotal]);
      const ws = XLSX.utils.aoa_to_sheet(aoa);
      XLSX.utils.book_append_sheet(wb, ws, 'Momo pivot');
      XLSX.writeFile(wb, 'Momo_pivot.xlsx');
    }

    // ── MTT / Hóa đơn ──
    const LS_MTT_CU     = `mtt_cu_${COMPANY}`;
    const LS_MTT_MOI    = `mtt_moi_${COMPANY}`;
    const LS_MTT_CT_MAP = `mtt_ct_map_${COMPANY}`;
    const LS_MTT_HIST   = `mtt_hist_${COMPANY}`;
    let _mttCu     = [];
    let _mttMoi    = [];
    let _mttActive = COMPANY === 'kh_cu' ? 'cu' : 'moi';
    let _mttCtMap  = { cu: {}, moi: {} }; // tách riêng KH Cũ / KH Mới
    let _mttHist   = []; // [{ fileName, uploadedAt, cuCount, moiCount }]

    try { const s = localStorage.getItem(LS_MTT_CU);     if (s) _mttCu     = JSON.parse(s); } catch(e) {}
    try { const s = localStorage.getItem(LS_MTT_MOI);    if (s) _mttMoi    = JSON.parse(s); } catch(e) {}
    try {
      const s = localStorage.getItem(LS_MTT_CT_MAP);
      if (s) {
        const parsed = JSON.parse(s);
        // Migration: nếu data cũ là flat object → bỏ qua, dùng cấu trúc mới
        if (parsed && typeof parsed.cu === 'object') _mttCtMap = parsed;
      }
    } catch(e) {}
    try { const s = localStorage.getItem(LS_MTT_HIST);   if (s) _mttHist   = JSON.parse(s); } catch(e) {}
    if (_mttCu.length || _mttMoi.length) { renderMttTable(); }

    function openMttModal()  { document.getElementById('mttModal').classList.add('open'); }
    function closeMttModal() { document.getElementById('mttModal').classList.remove('open'); }

    function switchMttTab(tab) {
      _mttActive = tab;
      document.getElementById('mttTabCu').classList.toggle('active', tab === 'cu');
      document.getElementById('mttTabMoi').classList.toggle('active', tab === 'moi');
      document.getElementById('mttTabHist').classList.toggle('active', tab === 'hist');
      document.getElementById('mttResults').style.display = tab === 'hist' ? 'none' : 'block';
      document.getElementById('mttSummary').style.display = tab === 'hist' ? 'none' : 'flex';
      document.getElementById('mttHistPanel').style.display = tab === 'hist' ? 'block' : 'none';
      if (tab === 'hist') renderMttHistory();
      else renderMttTable();

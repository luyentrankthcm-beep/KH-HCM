    function excelSerialToDateStr(serial) {
      // Excel date serial → DD-MM-YYYY
      const d = new Date(Math.round((serial - 25569) * 86400 * 1000));
      return `${String(d.getUTCDate()).padStart(2,'0')}-${String(d.getUTCMonth()+1).padStart(2,'0')}-${d.getUTCFullYear()}`;
    }

    function handleZaloOrderFile(inp) {
      if (!inp.files[0]) return;
      const fname = inp.files[0].name;
      const reader = new FileReader();
      reader.onload = e => {
        try {
          const wb = XLSX.read(new Uint8Array(e.target.result), {type:'array'});
          const ws = wb.Sheets[wb.SheetNames[0]];
          const rows = XLSX.utils.sheet_to_json(ws, {header:1, defval:''});
          const hdr = rows[0];
          const fc = k => hdr.indexOf(k);
          const iDate=fc('Ngày đặt hàng'), iStatus=fc('Trạng thái đơn hàng');
          const iPay=fc('Trạng thái thanh toán'), iTotal=fc('Tổng tiền hàng');
          const iSP=fc('Tên sản phẩm'), iOrder=fc('Mã đơn hàng');

          const newRows = rows.slice(1)
            .filter(r => r[iPay]==='Đã thanh toán' && r[iStatus]!=='Đã hủy' && r[iDate])
            .map(r => ({
              maOrder: String(r[iOrder]||'').trim().replace(/^#/,''),
              date: typeof r[iDate]==='number' ? excelSerialToDateStr(r[iDate])
                    : String(r[iDate]).split(' ')[0].replace(/\//g,'-'), // fallback string
              tenSP: String(r[iSP]||'').trim(),
              tongTien: parseFloat(r[iTotal])||0,
            }));

          // Merge by maOrder dedup
          const exKeys = new Set(_zaloOrders.map(r=>r.maOrder));
          const added = newRows.filter(r=>!exKeys.has(r.maOrder));
          _zaloOrders = [..._zaloOrders, ...added];
          localStorage.setItem(LS_ZALO_ORDERS, JSON.stringify(_zaloOrders));

          // Auto-add new tenSP to map (unmapped)
          newRows.forEach(r => { if(r.tenSP && !(_zaloSpMap[r.tenSP])) _zaloSpMap[r.tenSP]=''; });
          localStorage.setItem(LS_ZALO_SP_MAP, JSON.stringify(_zaloSpMap));

          _zaloHist.unshift({type:'order', file:fname, at:new Date().toLocaleString('vi'), added:added.length, skip:newRows.length-added.length});
          localStorage.setItem(LS_ZALO_HIST, JSON.stringify(_zaloHist));

          renderZaloSummary(); renderZaloDoiSoat(); renderZaloCtMap(); renderZaloHist();
          alert(`✅ OrderDetails: +${added.length} đơn mới · Bỏ qua ${newRows.length-added.length} trùng`);
        } catch(err) { alert('Lỗi đọc file OrderDetails: ' + err.message); }
      };
      reader.readAsArrayBuffer(inp.files[0]);
      inp.value='';
    }

    function handleZaloFeeFile(inp) {
      if (!inp.files[0]) return;
      const fname = inp.files[0].name;
      const reader = new FileReader();
      reader.onload = e => {
        try {
          const wb = XLSX.read(new Uint8Array(e.target.result), {type:'array'});
          // Tìm đúng sheet có data (không phải sheet CONFIG) — scan sheet nào có 'STT' ở cột đầu
          let ws = null;
          for(const sn of wb.SheetNames){
            const s = wb.Sheets[sn];
            const test = XLSX.utils.sheet_to_json(s,{header:1,defval:'',sheetRows:5,raw:true});
            if(test.some(r=>String(r[0]||'').trim()==='STT')){ws=s;break;}
          }
          if(!ws) ws = wb.Sheets[wb.SheetNames[0]]; // fallback
          const rows = XLSX.utils.sheet_to_json(ws, {header:1, defval:'', raw:true});
          const toNum = v => { if(typeof v==='number') return v; return parseFloat(String(v||'').replace(/[^0-9.-]/g,'')) || 0; };
          // HARDCODE: cấu trúc file BaoCaoPhi cố định (đã xác minh):
          //   Row index 2 = header, data từ row index 3
          //   Col B(1)=Thời gian GD, I(8)=Mã đơn hàng ZaloPay, V(21)=Số tiền trước KM
          //   AA(26)=Số tiền phí thu hộ, AS(44)=Ghi chú
          const HDR=2, iTime=1, iMaDiem=4, iDienThu=5, iMaDonZalo=8, iGross=21, iPhi=26, iGhiChu=44;
          // Validate: nếu cột 21 của row đầu tiên không phải số → báo lỗi debug
          const sample = rows[HDR+1];
          console.log('[BaoCaoPhi] row0=',rows[0]?.[0],'hdr2=',rows[HDR]?.[0],rows[HDR]?.[1],'sampleGross=',sample?.[iGross],'sampleTime=',sample?.[iTime]);
          if(sample && typeof sample[iGross] !== 'number')
            console.warn('[BaoCaoPhi] WARN: gross col',iGross,'=',sample[iGross],'(not number!) — hdr:',rows[HDR]?.slice(20,28));

          const newRows = rows.slice(HDR+1)
            .filter(r => typeof r[iGross]==='number' && r[iGross]>0)
            .map(r => {
              const tg = String(r[iTime]||'').split(' ')[0]; // "07/09/2026"
              const parts = tg.split('/');
              const date = parts.length===3 ? `${parts[0]}-${parts[1]}-${parts[2]}` : tg;
              const gc = String(r[iGhiChu]||'');
              const mFunzone = gc.match(/don hang\s+(\d+)/i);
              const gross = r[iGross];
              const phi   = toNum(r[iPhi]);
              return {
                date,
                maFunzone: mFunzone ? mFunzone[1] : '',
                maDonZalo: String(r[iMaDonZalo]||'').trim(),
                maDiem: String(r[iMaDiem]||'').trim(),
                dienThu: String(r[iDienThu]||'').trim(),
                gross,
                phi,
                net: gross - phi,
              };
            });

          // REPLACE (mỗi lần tải là replace để luôn có dữ liệu mới nhất)
          _zaloFee = newRows;
          localStorage.setItem(LS_ZALO_FEE, JSON.stringify(_zaloFee));

          // Auto-add Điểm thu vào SpMap để user có thể map mã CT
          newRows.forEach(r => {
            if(r.dienThu && !(_zaloSpMap[r.dienThu])) _zaloSpMap[r.dienThu]='';
          });
          localStorage.setItem(LS_ZALO_SP_MAP, JSON.stringify(_zaloSpMap));

          _zaloHist.unshift({type:'fee', file:fname, at:new Date().toLocaleString('vi'), added:newRows.length, skip:0});
          localStorage.setItem(LS_ZALO_HIST, JSON.stringify(_zaloHist));

          renderZaloSummary(); renderZaloDoiSoat(); renderZaloHist();
          const s0 = newRows[0];
          alert(`✅ BaoCaoPhi: ${newRows.length} giao dịch\nMẫu GD đầu: ngày=${s0?.date} | gross=${s0?.gross} | maFunzone=${s0?.maFunzone}`);
        } catch(err) { alert('Lỗi đọc file BaoCaoPhi: ' + err.message); }
      };
      reader.readAsArrayBuffer(inp.files[0]);
      inp.value='';
    }

    function renderZaloSummary() {
      const el = document.getElementById('zalo_summary');
      if(!el) return;
      const dates = [...new Set(_zaloOrders.map(r=>r.date))];
      el.textContent = _zaloOrders.length ? `${_zaloOrders.length} đơn · ${dates.length} ngày` : '';
    }

    function getZaloMaCT(tenSP) {
      // 1. Exact map (user-configured)
      const exact = (_zaloSpMap[tenSP]||'').trim();
      if(exact) return exact;
      // 2. Partial match in user map (key is substring of tenSP)
      for(const [k,v] of Object.entries(_zaloSpMap)){
        if(k && v && tenSP.toUpperCase().includes(k.toUpperCase())) return v.trim();
      }
      // 3. Keyword fallback for Điểm thu values from BaoCaoPhi
      const up = tenSP.toUpperCase();
      const KW = [
        ['GHOST','GHOST'],['SNOW','SNOW'],['TUTU','TUTU'],
        ['FARM AEON','FARM AEON HUE'],['FARM MEGA','FARM MEGA DN'],
        ['FARM','FARM'],['FUNZONE','FUNZONE'],
        ['LOTTE','LOTTE'],['AEON','AEON'],['GO!','GO'],
        ['BIG C','BIGC'],['COOPMART','COOP'],['MM MEGA','MM'],
        ['VINCOM','VINCOM'],['SENSE','SENSE'],
      ];
      for(const [kw,ct] of KW){ if(up.includes(kw)) return ct; }
      return null;
    }

    function renderZaloDoiSoat() {
      const el = document.getElementById('zaloDoiSoatBody');
      if(!el) return;
      if(!_zaloOrders.length && !_zaloFee.length) {
        el.innerHTML='<div class="empty-state"><div class="big-icon">🔵</div><p>Tải OrderDetails + BaoCaoPhi để bắt đầu đối soát</p></div>';
        return;
      }
      const fmtN = n => Math.round(n).toLocaleString('vi');
      const sortDate = (a,b) => {
        const p=d=>{const[dd,mm,yy]=d.split('-');return`${yy}-${mm}-${dd}`;};
        return p(a).localeCompare(p(b));
      };

      // Lookup: maOrder (Funzone ID) → order info
      const orderLookup = {};
      _zaloOrders.forEach(o => { if(o.maOrder) orderLookup[String(o.maOrder)] = o; });

      if (_zaloFee.length) {
        // ── PRIMARY: BaoCaoPhi → group by DATE → GIAN ──
        const byDate = {};  // date → { maCT → {gross,phi,net,soDon} }
        const byGianTot = {}; // maCT → {gross,phi,net,soDon}  (for summary footer)
        let nUnmatched = 0;
        _zaloFee.forEach(r => {
          const order = r.maFunzone ? orderLookup[String(r.maFunzone)] : null;
          if (!order) nUnmatched++;
          const maCT = order
            ? (getZaloMaCT(order.tenSP) || order.tenSP)
            : (r.dienThu ? (getZaloMaCT(r.dienThu) || r.dienThu) : '_unknown_');
          if(!byDate[r.date]) byDate[r.date] = {};
          if(!byDate[r.date][maCT]) byDate[r.date][maCT] = {gross:0,phi:0,net:0,soDon:0};
          byDate[r.date][maCT].gross  += r.gross;
          byDate[r.date][maCT].phi    += r.phi;
          byDate[r.date][maCT].net    += r.net;
          byDate[r.date][maCT].soDon  += 1;
          if(!byGianTot[maCT]) byGianTot[maCT]={gross:0,phi:0,net:0,soDon:0};
          byGianTot[maCT].gross += r.gross;
          byGianTot[maCT].phi   += r.phi;
          byGianTot[maCT].net   += r.net;
          byGianTot[maCT].soDon += 1;
        });

        const totGross = _zaloFee.reduce((s,r)=>s+r.gross,0);
        const totPhi   = _zaloFee.reduce((s,r)=>s+r.phi,0);
        const totNet   = _zaloFee.reduce((s,r)=>s+r.net,0);
        const nMatched = _zaloFee.length - nUnmatched;

        const dates = Object.keys(byDate).sort(sortDate);
        const gianAll = [...new Set(Object.values(byDate).flatMap(d=>Object.keys(d)))].sort((a,b)=>{
          if(a==='_unknown_') return 1; if(b==='_unknown_') return -1;
          return a.localeCompare(b);
        });

        let html = `<div style="margin-bottom:.75rem;font-size:.82em;color:#64748b">`;
        html += `📊 <strong>${_zaloFee.length}</strong> giao dịch · ${dates.length} ngày`;
        if(_zaloOrders.length) html += ` · Khớp OrderDetails: <strong style="color:#16a34a">${nMatched}</strong> / Chưa khớp: <span style="color:#f59e0b">${nUnmatched}</span>`;
        else html += ` · <span style="color:#f59e0b">Chưa tải OrderDetails → gian lấy từ Điểm thu</span>`;
        html += `</div>`;

        html += '<table style="width:100%;border-collapse:collapse;font-size:.84em">';
        html += '<thead><tr style="background:#1e3a5f;color:#fff">'
          + '<th style="padding:.45rem .75rem;text-align:left">Ngày / Gian</th>'
          + '<th style="text-align:right;padding:.45rem .6rem">Số GD</th>'
          + '<th style="text-align:right;padding:.45rem .6rem">DT trước KM</th>'
          + '<th style="text-align:right;padding:.45rem .6rem">Phí GW</th>'
          + '<th style="text-align:right;padding:.45rem .6rem">Net GW</th>'
          + '</tr></thead><tbody>';

        dates.forEach(date => {
          const ctData = byDate[date];
          const dayGross = Object.values(ctData).reduce((s,v)=>s+v.gross,0);
          const dayPhi   = Object.values(ctData).reduce((s,v)=>s+v.phi,0);
          const dayNet   = Object.values(ctData).reduce((s,v)=>s+v.net,0);
          const dayN     = Object.values(ctData).reduce((s,v)=>s+v.soDon,0);
          // Date header row (click to collapse)
          html += `<tr style="background:#2d4a6e;color:#e2e8f0;cursor:pointer" onclick="
            var tb=this.nextElementSibling;
            tb.style.display=tb.style.display==='none'?'':'none';
            this.querySelector('.tog').textContent=tb.style.display===''?'▾':'▸';
          ">
            <td style="padding:.4rem .75rem;font-weight:600">
              <span class="tog">▾</span> 📅 ${date}
            </td>
            <td style="text-align:right;padding:.4rem .6rem">${dayN}</td>
            <td style="text-align:right;padding:.4rem .6rem;font-weight:700">${fmtN(dayGross)}</td>
            <td style="text-align:right;padding:.4rem .6rem;color:#fca5a5">${fmtN(dayPhi)}</td>
            <td style="text-align:right;padding:.4rem .6rem;font-weight:700;color:#93c5fd">${fmtN(dayNet)}</td>
          </tr>`;
          // Gian sub-rows (visible by default)
          html += `<tbody>`;
          const ctKeys = Object.keys(ctData).sort((a,b)=>{
            if(a==='_unknown_') return 1; if(b==='_unknown_') return -1;
            return a.localeCompare(b);
          });
          ctKeys.forEach((maCT,i) => {
            const d = ctData[maCT];
            const isUnknown = maCT==='_unknown_';
            const ctLabel = isUnknown
              ? `<span style="color:#94a3b8;font-style:italic">Chưa xác định</span>`
              : `<span class="ct-badge">${maCT}</span>`;
            const bg = i%2===0 ? '#f8fafc' : '#fff';
            html += `<tr style="background:${bg}">
              <td style="padding:.35rem .75rem .35rem 2rem">${ctLabel}</td>
              <td style="text-align:right;padding:.35rem .6rem;color:#64748b">${d.soDon}</td>
              <td style="text-align:right;padding:.35rem .6rem;color:#15803d;font-weight:600">${fmtN(d.gross)}</td>
              <td style="text-align:right;padding:.35rem .6rem;color:#ef4444">${fmtN(d.phi)}</td>
              <td style="text-align:right;padding:.35rem .6rem;color:#2563eb;font-weight:600">${fmtN(d.net)}</td>
            </tr>`;
          });
          html += `</tbody>`;
        });

        // Tổng cộng theo gian
        html += `<tr style="background:#1e3a5f;color:#fff;font-weight:700">
          <td style="padding:.5rem .75rem">TỔNG CỘNG</td>
          <td style="text-align:right;padding:.5rem .6rem">${_zaloFee.length}</td>
          <td style="text-align:right;padding:.5rem .6rem">${fmtN(totGross)}</td>
          <td style="text-align:right;padding:.5rem .6rem">${fmtN(totPhi)}</td>
          <td style="text-align:right;padding:.5rem .6rem">${fmtN(totNet)}</td>
        </tr>`;
        // Per-gian total sub-rows
        gianAll.forEach(maCT => {
          const d = byGianTot[maCT];
          if(!d) return;
          const isUnknown = maCT==='_unknown_';
          const ctLabel = isUnknown ? 'Chưa xác định' : maCT;
          html += `<tr style="background:#273549;color:#cbd5e1;font-size:.82em">
            <td style="padding:.3rem .75rem .3rem 2rem">↳ ${ctLabel}</td>
            <td style="text-align:right;padding:.3rem .6rem">${d.soDon}</td>
            <td style="text-align:right;padding:.3rem .6rem;color:#86efac">${fmtN(d.gross)}</td>
            <td style="text-align:right;padding:.3rem .6rem;color:#fca5a5">${fmtN(d.phi)}</td>
            <td style="text-align:right;padding:.3rem .6rem;color:#93c5fd">${fmtN(d.net)}</td>
          </tr>`;
        });
        html += '</tbody></table>';
        el.innerHTML = html;
      } else {
        // ── FALLBACK: chỉ có OrderDetails, chưa có BaoCaoPhi ──
        const byDate = {};
        _zaloOrders.forEach(r => {
          const maCT = getZaloMaCT(r.tenSP) || r.tenSP;
          if(!byDate[r.date]) byDate[r.date] = {};
          if(!byDate[r.date][maCT]) byDate[r.date][maCT] = {amount:0, tenSPs:new Set()};
          byDate[r.date][maCT].amount += r.tongTien;
          byDate[r.date][maCT].tenSPs.add(r.tenSP);
        });
        const dates = Object.keys(byDate).sort(sortDate);
        let html = '<table style="width:100%;border-collapse:collapse;font-size:.85em">';
        html += '<thead><tr style="background:#1e3a5f;color:#fff"><th style="padding:.4rem .6rem;text-align:left">Ngày / CT</th><th style="text-align:right;padding:.4rem .6rem">Doanh thu</th><th style="text-align:right;padding:.4rem .6rem">Phí GW</th><th style="text-align:right;padding:.4rem .6rem">Net GW</th></tr></thead><tbody>';
        dates.forEach(date => {
          const ctData = byDate[date];
          const dayTotal = Object.values(ctData).reduce((s,v)=>s+v.amount,0);
          html += `<tr style="background:#374151;color:#e5e7eb"><td colspan="4" style="padding:.35rem .75rem .35rem 1rem;font-size:.87em">📅 <strong>${date}</strong> &nbsp;·&nbsp; DT: ${fmtN(dayTotal)}đ &nbsp;<span style="color:#fbbf24;font-size:.82em">(chưa có BaoCaoPhi)</span></td></tr>`;
          Object.entries(ctData).forEach(([maCT, d]) => {
            const isMapped = !!getZaloMaCT([...d.tenSPs][0]);
            const ctBadge = isMapped ? `<span class="ct-badge">${maCT}</span>` : `<span style="color:#94a3b8;font-size:.75em;font-style:italic">chưa map</span>`;
            html += `<tr class="gian-row"><td style="padding-left:2rem"><div>${ctBadge}</div><div style="font-size:.78em;color:#64748b">${[...d.tenSPs].join(' · ')}</div></td>
              <td style="text-align:right;color:#15803d;font-weight:600">${fmtN(d.amount)}</td>
              <td style="text-align:right;color:#94a3b8">–</td>
              <td style="text-align:right;color:#94a3b8">–</td></tr>`;
          });
        });
        html += '</tbody></table>';
        el.innerHTML = html;
      }
    }

    function autoMapZaloSP() {
      // Dùng keyword overlap từ các SP đã map để tự điền SP chưa map
      const mapped = Object.entries(_zaloSpMap).filter(([,ct]) => ct);
      if(!mapped.length) { alert('Chưa có SP nào được map — hãy map ít nhất vài SP trước.'); return; }
      // Chuẩn hóa: loại emoji, ký tự đặc biệt, lowercase
      const normalize = s => s.toLowerCase()
        .replace(/[\u{1F300}-\u{1FFFF}]/gu,'')
        .replace(/[^a-zA-ZÀ-ỹ0-9\s]/g,' ')
        .split(/\s+/).filter(w=>w.length>1);
      let filled = 0;
      Object.keys(_zaloSpMap).forEach(sp => {
        if(_zaloSpMap[sp]) return;
        const spW = normalize(sp);
        let bestCT='', bestScore=0;
        mapped.forEach(([mSP, mCT]) => {
          const mW = normalize(mSP);
          const common = spW.filter(w => mW.includes(w)).length;
          const score = common / Math.max(spW.length, mW.length);
          if(score > bestScore && score >= 0.35) { bestScore=score; bestCT=mCT; }
        });
        if(bestCT) { _zaloSpMap[sp]=bestCT; filled++; }
      });
      localStorage.setItem(LS_ZALO_SP_MAP, JSON.stringify(_zaloSpMap));
      renderZaloCtMap(); renderZaloDoiSoat();
      alert(`⚡ Auto map: điền được ${filled} SP · Còn ${Object.values(_zaloSpMap).filter(v=>!v).length} chưa map`);
    }

    function exportZaloSpMap() {
      const rows = [['Tên sản phẩm','Mã CT']];
      Object.entries(_zaloSpMap).sort((a,b)=>a[0].localeCompare(b[0])).forEach(([sp,ct])=>rows.push([sp,ct]));
      const ws = XLSX.utils.aoa_to_sheet(rows);
      const wb = XLSX.utils.book_new(); XLSX.utils.book_append_sheet(wb,ws,'Map SP-CT');
      XLSX.writeFile(wb,'ZaloPay_MapSP_CT.xlsx');
    }

    function renderZaloCtMap() {
      const el = document.getElementById('zaloCtMapContent');
      if(!el) return;
      const tenSPs = Object.keys(_zaloSpMap).sort();
      if(!tenSPs.length) {
        el.innerHTML='<div class="empty-state"><div class="big-icon">🗺️</div><p>Tải OrderDetails để thấy danh sách Tên SP</p></div>';
        return;
      }
      const unmappedCount = tenSPs.filter(k=>!_zaloSpMap[k]).length;
      // Toolbar
      let html = `<div style="display:flex;align-items:center;gap:.5rem;margin-bottom:.6rem;flex-wrap:wrap">
        <span style="font-size:.83em;color:#64748b">${tenSPs.length} sản phẩm · <span style="color:${unmappedCount?'#d97706':'#16a34a'}">${unmappedCount} chưa map</span></span>
        <button onclick="autoMapZaloSP()" style="background:#7c3aed;color:#fff;border:none;border-radius:5px;padding:.25rem .7rem;cursor:pointer;font-size:.8em;font-weight:700">⚡ Auto Map</button>
        <button onclick="exportZaloSpMap()" style="background:#0891b2;color:#fff;border:none;border-radius:5px;padding:.25rem .7rem;cursor:pointer;font-size:.8em">⬇️ Xuất Excel</button>
      </div>`;
      // 1 bảng duy nhất — unmapped trước (nền vàng nhạt), mapped sau (nền xanh nhạt)
      html += '<table style="width:100%;border-collapse:collapse;font-size:.84em"><thead><tr style="background:#e0e7ff;color:#1e3a5f"><th style="padding:.3rem .6rem;text-align:left">Tên sản phẩm</th><th style="padding:.3rem .4rem;width:180px">Mã CT</th><th style="padding:.3rem .4rem;width:56px"></th></tr></thead><tbody>';
      tenSPs.forEach((sp, i) => {
        const isMapped = !!_zaloSpMap[sp];
        const bg = isMapped ? (i%2?'#f0fdf4':'#dcfce7') : (i%2?'#fff':'#fffbeb');
        const borderCol = isMapped ? '#86efac' : '#cbd5e1';
        const esc = sp.replace(/'/g,"&#39;").replace(/"/g,'&quot;');
        html += `<tr style="background:${bg}">
          <td style="padding:.3rem .6rem;font-size:.79em">${isMapped?'':' ⏳ '}${sp}</td>
          <td style="padding:.3rem .4rem">
            <input id="zsp_${i}" data-sp="${esc}" value="${(_zaloSpMap[sp]||'').replace(/"/g,'&quot;')}" placeholder="Mã CT"
              style="width:100%;border:1px solid ${borderCol};border-radius:4px;padding:.2rem .35rem;background:${isMapped?'#f0fdf4':'#fff'}"
              onkeydown="if(event.key==='Enter')saveZaloSpMap(this)">
          </td>
          <td style="padding:.3rem .4rem">
            <button onclick="saveZaloSpMap(document.getElementById('zsp_${i}'))"
              style="background:${isMapped?'#16a34a':'#2563eb'};color:#fff;border:none;border-radius:4px;padding:.2rem .5rem;cursor:pointer;font-size:.78em">Lưu</button>
          </td>
        </tr>`;
      });
      html += '</tbody></table>';
      el.innerHTML = html;
    }

    function saveZaloSpMap(inp) {
      const sp = inp.dataset.sp;
      const maCT = inp.value.trim();
      _zaloSpMap[sp] = maCT;
      localStorage.setItem(LS_ZALO_SP_MAP, JSON.stringify(_zaloSpMap));
      renderZaloCtMap();
      renderZaloDoiSoat();
    }

    function renderZaloHist() {
      const el = document.getElementById('zaloHistBody');
      if(!el) return;
      if(!_zaloHist.length) {
        el.innerHTML='<div class="empty-state"><div class="big-icon">⏱️</div><p>Chưa có lịch sử tải</p></div>';
        return;
      }
      let html='<table style="width:100%;border-collapse:collapse;font-size:.84em"><thead><tr style="background:#e0e7ff;color:#1e3a5f"><th style="padding:.3rem .5rem;text-align:left">Loại</th><th style="padding:.3rem .5rem;text-align:left">File</th><th style="padding:.3rem .5rem">Thêm</th><th style="padding:.3rem .5rem">Bỏ qua</th><th style="padding:.3rem .5rem;text-align:left">Thời gian</th></tr></thead><tbody>';
      _zaloHist.slice(0,20).forEach((h,i) => {
        html+=`<tr style="background:${i%2?'#f8fafc':'#fff'}">
          <td style="padding:.3rem .5rem">${h.type==='order'?'📥 Order':'💰 Fee'}</td>
          <td style="padding:.3rem .5rem;font-size:.8em;color:#475569">${h.file}</td>
          <td style="padding:.3rem .5rem;text-align:center;color:#16a34a;font-weight:700">+${h.added}</td>
          <td style="padding:.3rem .5rem;text-align:center;color:#94a3b8">${h.skip}</td>
          <td style="padding:.3rem .5rem;font-size:.8em;color:#64748b">${h.at}</td>
        </tr>`;
      });
      html+='</tbody></table>';
      el.innerHTML=html;
    }

    // Init Zalo Pay
    renderZaloSummary(); renderZaloDoiSoat(); renderZaloCtMap(); renderZaloHist();

  </script>
</body>
</html>

    // Lưu Doanh thu/Net (override) + Số HĐ/Tiền HĐ sửa tay cho từng gian trong ngày
    function saveZaloEditPanel(dateId, date, btnEl) {
      const gianList = btnEl && btnEl.dataset && btnEl.dataset.gians ? JSON.parse(btnEl.dataset.gians) : [];
      gianList.forEach(maCT => {
        const gKey = maCT.replace(/[^a-zA-Z0-9]/g,'_');
        const hdKey = `${date}|${maCT}`;
        if (!_zaloHD[hdKey]) _zaloHD[hdKey] = {};
        const dtOvr    = (document.getElementById(`zedit_dt_${dateId}_${gKey}`)    || {}).value;
        const netOvr   = (document.getElementById(`zedit_net_${dateId}_${gKey}`)   || {}).value;
        const soHD     = (document.getElementById(`zedit_soHD_${dateId}_${gKey}`)   || {}).value || '';
        const tienHD   = (document.getElementById(`zedit_tienHD_${dateId}_${gKey}`) || {}).value || '';
        _zaloHD[hdKey].dtOvr  = dtOvr  != null ? dtOvr  : '';
        _zaloHD[hdKey].netOvr = netOvr != null ? netOvr : '';
        _zaloHD[hdKey].soHD   = soHD.trim();
        _zaloHD[hdKey].tienHD = tienHD.trim();
        // Chỉ đánh dấu "tự tay sửa" khi Luyen thực sự nhập Số HĐ/Tiền HĐ --
        // để trống thì vẫn để nút "Map MTT → Zalo" tự điền sau này.
        if (soHD.trim() || tienHD.trim()) _zaloHD[hdKey]._manual = true;
      });
      try { lsSet(LS_ZALO_HD, JSON.stringify(_zaloHD)); } catch(e){}
      renderZaloDoiSoat();
    }

    // Map "Chưa xác định gian" cho 1 ngày → maCT cụ thể
    const LS_ZALO_UNK = `zalo_unk_${COMPANY}`; // {date: maCT}
    let _zaloUnk = {};
    try { const s=localStorage.getItem(LS_ZALO_UNK); if(s) _zaloUnk=JSON.parse(s); } catch(e){}
    function saveZaloUnkCT(date, maCT) {
      if(!maCT.trim()) return;
      _zaloUnk[date] = maCT.trim().toUpperCase();
      try { lsSet(LS_ZALO_UNK, JSON.stringify(_zaloUnk)); } catch(e){}
      renderZaloDoiSoat();
    }

    // Xóa hẳn các GD FUNZONE "chưa xác định gian" của 1 ngày (không map được
    // vào gian nào, vd giao dịch rác/lỗi thay vì phải Map ép vào 1 mã CT).
    function deleteZaloUnkGroup(date) {
      const isFunzone = r => r.maDiem==='FUNZONE1' || (r.dienThu||'').toUpperCase().includes('FUNZONE');
      const isUnmatched = r => !r.maFunzone || _zaloOrders[String(r.maFunzone)] === undefined;
      const toRemove = _zaloFee.filter(r => r.date===date && isFunzone(r) && isUnmatched(r));
      if (!toRemove.length) { alert('Không có giao dịch "chưa xác định gian" nào ở ngày ' + date + '.'); return; }
      const total = toRemove.reduce((s,r)=>s+r.gross,0);
      if (!confirm(`Xóa ${toRemove.length} GD "chưa xác định gian" ngày ${date} (tổng ${total.toLocaleString('vi')}đ)?\nKhông hoàn tác được.`)) return;
      _zaloFee = _zaloFee.filter(r => !(r.date===date && isFunzone(r) && isUnmatched(r)));
      lsSet(LS_ZALO_FEE, JSON.stringify(_zaloFee));
      renderZaloDoiSoat();
      alert(`✅ Đã xóa ${toRemove.length} GD (tổng ${total.toLocaleString('vi')}đ).`);
    }

    // Luyen, 2026-09-10: khung xem chi tiết từng GD "chưa xác định gian" của
    // 1 ngày -- liệt kê mã đơn Zalo, mã đơn Funzone, điểm thu, DT/phí và LÝ DO
    // cụ thể (không đọc được mã đơn từ ghi chú, hay có mã đơn nhưng không có
    // trong file OrderDetails đã tải / đơn đó chưa "Đã thanh toán"/bị hủy nên
    // bị lọc khi tải OrderDetails).
    function renderZaloUnkDetail(date) {
      const fmtN = n => Math.round(n).toLocaleString('vi');
      const isFunzone = r => r.maDiem==='FUNZONE1' || (r.dienThu||'').toUpperCase().includes('FUNZONE');
      const isUnmatched = r => !r.maFunzone || _zaloOrders[String(r.maFunzone)] === undefined;
      const rows = _zaloFee.filter(r => r.date===date && isFunzone(r) && isUnmatched(r));
      if(!rows.length) return '<div style="padding:.3rem .5rem;color:#94a3b8;font-size:.78em">Không có giao dịch nào.</div>';
      let html = '<div style="overflow-x:auto"><table style="width:100%;border-collapse:collapse;font-size:.74em;margin-top:.25rem;background:#fffbeb">'
        +'<thead><tr style="background:#fde68a;color:#78350f">'
        +'<th style="padding:.2rem .4rem;text-align:left">Mã đơn Zalo</th>'
        +'<th style="padding:.2rem .4rem;text-align:left">Mã đơn (Funzone)</th>'
        +'<th style="padding:.2rem .4rem;text-align:left">Điểm thu</th>'
        +'<th style="padding:.2rem .4rem;text-align:right">DT trước KM</th>'
        +'<th style="padding:.2rem .4rem;text-align:right">Phí</th>'
        +'<th style="padding:.2rem .4rem;text-align:left">Lý do chưa xác định</th>'
        +'</tr></thead><tbody>';
      rows.forEach(r => {
        const reason = !r.maFunzone
          ? 'Không đọc được mã đơn hàng từ ghi chú BaoCaoPhi'
          : 'Mã đơn <b>'+r.maFunzone+'</b> không có trong file OrderDetails đã tải — do chưa tải file chứa đơn này, hoặc đơn đó không ở trạng thái "Đã thanh toán" nên khi tải OrderDetails đã bị lọc bỏ';
        html += '<tr style="border-bottom:1px solid #fde68a">'
          +'<td style="padding:.2rem .4rem">'+(r.maDonZalo||'—')+'</td>'
          +'<td style="padding:.2rem .4rem">'+(r.maFunzone||'—')+'</td>'
          +'<td style="padding:.2rem .4rem">'+(r.dienThu||'—')+'</td>'
          +'<td style="padding:.2rem .4rem;text-align:right;color:#15803d">'+fmtN(r.gross)+'</td>'
          +'<td style="padding:.2rem .4rem;text-align:right;color:#ef4444">'+fmtN(r.phi)+'</td>'
          +'<td style="padding:.2rem .4rem;color:#92400e">'+reason+'</td>'
          +'</tr>';
      });
      html += '</tbody></table></div>';
      return html;
    }

    function toggleZaloUnkDetail(date) {
      const el = document.getElementById('unkDetail_'+date.replace(/-/g,''));
      if(!el) return;
      if(el.style.display==='none'){ el.innerHTML = renderZaloUnkDetail(date); el.style.display=''; }
      else { el.style.display='none'; el.innerHTML=''; }
    }

    function saveZaloSpMap(inp) {
      const sp = inp.dataset.sp;
      const maCT = inp.value.trim();
      _zaloSpMap[sp] = maCT;
      lsSet(LS_ZALO_SP_MAP, JSON.stringify(_zaloSpMap));
      renderZaloCtMap();
      renderZaloDoiSoat();
    }

    function renderZaloHist() {
      const el = document.getElementById('zaloHistBody');
      if(!el) return;
      if(!_zaloHist.length) {
        el.innerHTML='<div class="empty-state"><div class="big-icon">⏱️</div><p>Chưa có lịch sử tải</p></div>';
        return;
      }
      let html='<table style="width:100%;border-collapse:collapse;font-size:.84em"><thead><tr style="background:#e0e7ff;color:#1e3a5f"><th style="padding:.3rem .5rem;text-align:left">Loại</th><th style="padding:.3rem .5rem;text-align:left">File</th><th style="padding:.3rem .5rem">Thêm</th><th style="padding:.3rem .5rem">Bỏ qua</th><th style="padding:.3rem .5rem;text-align:left">Thời gian</th></tr></thead><tbody>';
      _zaloHist.slice(0,20).forEach((h,i) => {
        html+=`<tr style="background:${i%2?'#f8fafc':'#fff'}">
          <td style="padding:.3rem .5rem">${h.type==='order'?'📥 Order':'💰 Fee'}</td>
          <td style="padding:.3rem .5rem;font-size:.8em;color:#475569">${h.file}</td>
          <td style="padding:.3rem .5rem;text-align:center;color:#16a34a;font-weight:700">+${h.added}</td>
          <td style="padding:.3rem .5rem;text-align:center;color:#94a3b8">${h.skip}</td>
          <td style="padding:.3rem .5rem;font-size:.8em;color:#64748b">${h.at}</td>
        </tr>`;
      });
      html+='</tbody></table>';
      el.innerHTML=html;
    }

    // ══════════════════════════════════════════
    // VNPAY (QR Offline) — tách từ CÙNG file BaoCaoPhi với Zalo Pay (mọi
    // Điểm thu KHÁC "FUNZONE MINI APP"). Đơn giản hơn Zalo Pay: 1 Điểm thu =
    // 1 gian trực tiếp (không qua OrderDetails/Sku), nên các hàm dưới đây là
    // bản RÚT GỌN của renderZaloDoiSoat/renderZaloCtMap/fetchBankZalo — giữ
    // nguyên khung đối soát (DT/Phí/Net/Số HĐ/Tiền HĐ/Chênh, cấn trừ hóa đơn
    // nhiều ngày, nhóm theo NH trả về) nhưng độc lập hoàn toàn về dữ liệu.
    // ══════════════════════════════════════════
    function renderVnpaySummary() {
      const el = document.getElementById('vnpay_summary');
      if(!el) return;
      const n = _vnpayFee.length;
      if(!n) { el.textContent = ''; return; }
      const gians = new Set(_vnpayFee.map(r=>r.dienThu)).size;
      el.innerHTML = `${n} GD · ${gians} gian`;
    }

    function getVnpayMaCT(dienThu) {
      const m = (_vnpaySpMap[dienThu]||'').trim();
      return m || dienThu;
    }

    function populateVnpayMonthFilter() {
      const sel = document.getElementById('vnpayFilterMonth');
      if(!sel) return;
      const months = [...new Set(_vnpayFee.map(r => {
        const p = r.date ? r.date.split('-') : [];
        return p.length===3 ? p[1]+'/'+p[2] : '';
      }).filter(Boolean))].sort().reverse();
      const cur = sel.value;
      sel.innerHTML = '<option value="">-- Tất cả --</option>'
        + months.map(m=>`<option value="${m}"${m===cur?' selected':''}>${m}</option>`).join('');
    }

    function getVnpayGianDisp(date, maCT, d) {
      const hd = _vnpayHD[date+'|'+maCT] || {};
      const dt  = (hd.dtOvr  != null && hd.dtOvr  !== '') ? (parseFloat(String(hd.dtOvr).replace(/[^0-9.-]/g,''))||0)  : d.gross;
      const net = (hd.netOvr != null && hd.netOvr !== '') ? (parseFloat(String(hd.netOvr).replace(/[^0-9.-]/g,''))||0) : d.net;
      return { dt, net, phi: dt - net, hasDtOvr: hd.dtOvr!=null && hd.dtOvr!=='', hasNetOvr: hd.netOvr!=null && hd.netOvr!=='' };
    }
    function computeVnpayDayNet(date, byDateRef) {
      const ctData = byDateRef[date]; if(!ctData) return 0;
      return Object.entries(ctData).reduce((s,[maCT,d]) => s + getVnpayGianDisp(date,maCT,d).net, 0);
    }

    function renderVnpayDoiSoat() {
      const el = document.getElementById('vnpayDoiSoatBody');
      if(!el) return;
      if(!_vnpayFee.length) {
        el.innerHTML='<div class="empty-state"><div class="big-icon">🟦</div><p>Tải BaoCaoPhi (bên tab Zalo Pay) để bắt đầu đối soát VNPay</p></div>';
        return;
      }
      const fmtN = n => Math.round(n).toLocaleString('vi');
      const iso  = d => { const p=d.split('-'); return p[2]+'-'+p[1]+'-'+p[0]; };
      const sortDate = (a,b) => iso(a).localeCompare(iso(b));
      const inRange = (d,f,t) => !f||!t ? false : iso(d)>=iso(f) && iso(d)<=iso(t);

      populateVnpayMonthFilter();
      const selMonth = (document.getElementById('vnpayFilterMonth')||{}).value || '';

      const byDate = {};
      _vnpayFee.forEach(r => {
        const maCT = getVnpayMaCT(r.dienThu);
        if(!byDate[r.date]) byDate[r.date]={};
        if(!byDate[r.date][maCT]) byDate[r.date][maCT]={gross:0,phi:0,net:0,soDon:0};
        byDate[r.date][maCT].gross += r.gross;
        byDate[r.date][maCT].phi   += r.phi;
        byDate[r.date][maCT].net   += r.net;
        byDate[r.date][maCT].soDon += 1;
      });
      const allDates = Object.keys(byDate).sort(sortDate);
      const filteredDates = selMonth
        ? allDates.filter(d => { const p=d.split('-'); return p[1]+'/'+p[2]===selMonth; })
        : allDates;

      let totGross=0,totPhi=0,totNet=0,totN=0;
      filteredDates.forEach(dt=>Object.entries(byDate[dt]).forEach(([maCT,d])=>{const gDisp=getVnpayGianDisp(dt,maCT,d);totGross+=gDisp.dt;totPhi+=gDisp.phi;totNet+=gDisp.net;totN+=d.soDon;}));

      let html = '<div style="margin-bottom:.5rem;font-size:.82em;color:#64748b">';
      html += '\u{1F4CA} VNPay: <strong>'+_vnpayFee.length+'</strong> GD · '+filteredDates.length+' ngày';
      html += '</div>';

      const unmappedSp = Object.entries(_vnpaySpMap).filter(([k,v]) => !v);
      if (unmappedSp.length) {
        html += '<div style="background:#fef3c7;border:1px solid #f59e0b;border-radius:8px;padding:.6rem 1rem;margin-bottom:.6rem;font-size:.87em;color:#92400e;display:flex;justify-content:space-between;align-items:center;gap:.6rem;flex-wrap:wrap">'
          +'<span>⚠️ Có <strong>'+unmappedSp.length+'</strong> Điểm thu <strong>MỚI</strong> chưa map mã CT (vd: '+unmappedSp.slice(0,3).map(([k])=>k).join(', ')+(unmappedSp.length>3?'...':'')+') — sẽ hiện tên gốc thay vì đúng gian cho tới khi map.</span>'
          +'<button onclick="switchVnpaySub(\'map\')" style="background:#f59e0b;color:#fff;border:none;border-radius:6px;padding:.3rem .8rem;font-weight:700;cursor:pointer;white-space:nowrap">🗺️ Map ngay</button>'
          +'</div>';
      }

      // Cấn trừ hóa đơn xuất chung nhiều ngày (giống Zalo Pay)
      const invoiceGroups = {};
      allDates.forEach(dt => {
        const ctData0 = byDate[dt]; if(!ctData0) return;
        Object.keys(ctData0).forEach(maCT => {
          const hd = _vnpayHD[dt+'|'+maCT] || {};
          const soHD = (hd.soHD||'').trim();
          if(!soHD) return;
          const gDisp0 = getVnpayGianDisp(dt, maCT, ctData0[maCT]);
          const tienHD0 = parseFloat((hd.tienHD||'0').toString().replace(/[^0-9.-]/g,''))||0;
          const key = maCT+'|'+soHD;
          if(!invoiceGroups[key]) invoiceGroups[key] = {dt:0, tienHDs:[], dates:[]};
          invoiceGroups[key].dt += gDisp0.dt;
          invoiceGroups[key].tienHDs.push(tienHD0);
          invoiceGroups[key].dates.push(dt);
        });
      });
      // Xem ghi chú tương ứng ở renderZaloDoiSoat: nếu mọi ngày trong nhóm
      // ghi CÙNG 1 số tiền hóa đơn (không tự chia) thì không cộng dồn nhân đôi.
      Object.values(invoiceGroups).forEach(g => {
        const uniq = [...new Set(g.tienHDs.filter(v=>v>0))];
        g.tienHD = uniq.length <= 1 ? (uniq[0]||0) : g.tienHDs.reduce((s,v)=>s+v,0);
      });

      const renderDateBlock = date => {
        const ctData = byDate[date];
        if(!ctData) return '';
        const ctKeys = Object.keys(ctData).sort((a,b)=>a.localeCompare(b));
        const disps = {};
        ctKeys.forEach(maCT => { disps[maCT] = getVnpayGianDisp(date, maCT, ctData[maCT]); });
        const dayGross=ctKeys.reduce((s,g)=>s+disps[g].dt,0);
        const dayNet=ctKeys.reduce((s,g)=>s+disps[g].net,0);
        const dayN=Object.values(ctData).reduce((s,d)=>s+d.soDon,0);
        const [dd,mm,yyyy]=date.split('-');
        const dateId = date.replace(/-/g,'_');
        let out = '<div style="margin-bottom:.8rem">'
          +'<div style="background:#7c2d12;color:#fff;padding:.4rem .75rem;font-weight:700;font-size:.87em;display:flex;justify-content:space-between;cursor:pointer" onclick="toggleVnpayEditPanel(\''+dateId+'\')">'
          +'<span>\u{1F4C5} '+dd+'/'+mm+'/'+yyyy+'</span>'
          +'<span style="font-size:.81em;font-weight:400;color:#fdba74">'+dayN+' GD · DT: '+fmtN(dayGross)+'đ · Net: '+fmtN(dayNet)+'đ &nbsp;<span style="opacity:.8">✏️ Sửa</span></span>'
          +'</div>'
          +'<table style="width:100%;border-collapse:collapse;font-size:.84em">'
          +'<thead><tr style="background:#9a3412;color:#fff7ed">'
          +'<th style="padding:.3rem .6rem;text-align:left">Mã CT (Gian)</th>'
          +'<th style="text-align:right;padding:.3rem .4rem">Số GD</th>'
          +'<th style="text-align:right;padding:.3rem .4rem">DT trước KM</th>'
          +'<th style="text-align:right;padding:.3rem .4rem">Phí GW</th>'
          +'<th style="text-align:right;padding:.3rem .4rem">Net GW</th>'
          +'<th style="text-align:center;padding:.3rem .4rem">Số HĐ</th>'
          +'<th style="text-align:right;padding:.3rem .4rem">Tiền HĐ</th>'
          +'<th style="text-align:right;padding:.3rem .4rem">Chênh</th>'
          +'</tr></thead><tbody>';
        ctKeys.forEach((maCT,i) => {
          const d = ctData[maCT];
          const gDisp = disps[maCT];
          const ctLabel = '<span class="ct-badge">'+maCT+'</span>';
          const hdKey = date+'|'+maCT;
          const hd = _vnpayHD[hdKey] || {};
          const tienHD = parseFloat((hd.tienHD||'0').toString().replace(/[^0-9.-]/g,''))||0;
          const soHDNow = (hd.soHD||'').trim();
          const grp = soHDNow ? invoiceGroups[maCT+'|'+soHDNow] : null;
          const chenh = (grp && grp.dates.length > 1 && grp.tienHD)
            ? (gDisp.dt - grp.tienHD * (grp.dt > 0 ? (gDisp.dt / grp.dt) : (1 / grp.dates.length)))
            : (tienHD ? (gDisp.dt - tienHD) : null);
          const chenhColor = chenh===null?'#94a3b8':(Math.abs(chenh)<1000?'#16a34a':(chenh<0?'#ef4444':'#d97706'));
          const chenhTxt = chenh===null?'—':((chenh>0?'+':'')+fmtN(chenh));
          const bg = i%2===0?'#f8fafc':'#fff';
          const escKey = hdKey.replace(/'/g,"\\'");
          const soHDDisplay = hd.soHD
            ? '<span style="font-size:.8em;cursor:pointer" onclick="vHDEdit(this,\''+escKey+'\',\'soHD\')">'+hd.soHD+' ✏️</span>'
            : '<span style="color:#94a3b8;font-size:.75em;cursor:pointer" onclick="vHDEdit(this,\''+escKey+'\',\'soHD\')">…</span>';
          const tienHDDisplay = hd.tienHD
            ? '<span style="font-size:.8em;cursor:pointer;color:#15803d" onclick="vHDEdit(this,\''+escKey+'\',\'tienHD\')">'+hd.tienHD+' ✏️</span>'
            : '<span style="color:#94a3b8;font-size:.75em;cursor:pointer" onclick="vHDEdit(this,\''+escKey+'\',\'tienHD\')">…</span>';
          out += '<tr style="background:'+bg+'">'
            +'<td style="padding:.3rem .6rem">'+ctLabel+'</td>'
            +'<td style="text-align:right;padding:.3rem .4rem;color:#64748b">'+d.soDon+'</td>'
            +'<td style="text-align:right;padding:.3rem .4rem;color:#15803d;font-weight:600">'+fmtN(gDisp.dt)+(gDisp.hasDtOvr?'<sup style="color:#f59e0b;font-size:.7em">✏</sup>':'')+'</td>'
            +'<td style="text-align:right;padding:.3rem .4rem;color:#ef4444">'+fmtN(gDisp.phi)+'</td>'
            +'<td style="text-align:right;padding:.3rem .4rem;color:#2563eb;font-weight:700">'+fmtN(gDisp.net)+(gDisp.hasNetOvr?'<sup style="color:#f59e0b;font-size:.7em">✏</sup>':'')+'</td>'
            +'<td style="padding:.3rem .3rem;text-align:center">'+soHDDisplay+'</td>'
            +'<td style="padding:.3rem .3rem;text-align:right">'+tienHDDisplay+'</td>'
            +'<td style="text-align:right;padding:.3rem .4rem;font-weight:700;color:'+chenhColor+'">'+chenhTxt+'</td>'
            +'</tr>';
        });
        out += '</tbody></table>';
        out += '<div id="edit_vnpay_'+dateId+'" style="display:none;padding:.6rem .75rem;background:#f8fafc;border:1px dashed #ea580c;border-top:none">'
          +'<div style="font-size:.8em;font-weight:700;color:#7c2d12;margin-bottom:.4rem">✏️ Chỉnh sửa – '+dd+'/'+mm+'/'+yyyy+'</div>'
          +'<div style="overflow-x:auto"><table style="min-width:640px;border-collapse:collapse;font-size:.8em">'
          +'<thead><tr style="background:#ffedd5;color:#7c2d12">'
          +'<th style="padding:.25rem .5rem;text-align:left;border:1px solid #fed7aa">Mã CT / Gian</th>'
          +'<th style="padding:.25rem .5rem;text-align:right;border:1px solid #fed7aa">DT (sửa được)</th>'
          +'<th style="padding:.25rem .5rem;text-align:right;border:1px solid #fed7aa">Net (sửa được)</th>'
          +'<th style="padding:.25rem .5rem;border:1px solid #fed7aa">Số HĐ</th>'
          +'<th style="padding:.25rem .5rem;text-align:right;border:1px solid #fed7aa">Tiền HĐ</th>'
          +'</tr></thead><tbody>'
          +ctKeys.map(maCT => {
            const d = ctData[maCT];
            const gDisp = disps[maCT];
            const hd = _vnpayHD[date+'|'+maCT] || {};
            const gKey = maCT.replace(/[^a-zA-Z0-9]/g,'_');
            return '<tr>'
              +'<td style="padding:.25rem .5rem;border:1px solid #e2e8f0;font-size:.9em">'+maCT+'</td>'
              +'<td style="padding:.25rem .5rem;border:1px solid #e2e8f0;text-align:right">'
                +'<input id="vedit_dt_'+dateId+'_'+gKey+'" type="text" value="'+gDisp.dt+'" style="width:105px;border:1px solid #bbf7d0;border-radius:4px;padding:.15rem .3rem;text-align:right;background:#f0fdf4;color:#15803d;font-weight:600"></td>'
              +'<td style="padding:.25rem .5rem;border:1px solid #e2e8f0;text-align:right">'
                +'<input id="vedit_net_'+dateId+'_'+gKey+'" type="text" value="'+gDisp.net+'" style="width:105px;border:1px solid #bfdbfe;border-radius:4px;padding:.15rem .3rem;text-align:right;background:#eff6ff;color:#0d47a1;font-weight:700"></td>'
              +'<td style="padding:.25rem .5rem;border:1px solid #e2e8f0">'
                +'<input id="vedit_soHD_'+dateId+'_'+gKey+'" type="text" value="'+(hd.soHD||'')+'" placeholder="0000123" style="width:100px;border:1px solid #cbd5e1;border-radius:4px;padding:.15rem .3rem"></td>'
              +'<td style="padding:.25rem .5rem;border:1px solid #e2e8f0;text-align:right">'
                +'<input id="vedit_tienHD_'+dateId+'_'+gKey+'" type="text" value="'+(hd.tienHD||'')+'" placeholder="0" style="width:100px;border:1px solid #cbd5e1;border-radius:4px;padding:.15rem .3rem;text-align:right"></td>'
              +'</tr>';
          }).join('')
          +'</tbody></table></div>'
          +'<div style="margin-top:.5rem;display:flex;gap:.5rem">'
          +'<button onclick="saveVnpayEditPanel(\''+dateId+'\',\''+date+'\',this)" data-gians=\''+JSON.stringify(ctKeys).replace(/'/g,'&#39;')+'\' style="background:#16a34a;color:#fff;border:none;border-radius:6px;padding:.3rem .8rem;font-weight:700;font-size:.8em;cursor:pointer">💾 Lưu</button>'
          +'<button onclick="toggleVnpayEditPanel(\''+dateId+'\')" style="background:#6b7280;color:#fff;border:none;border-radius:6px;padding:.3rem .8rem;font-weight:600;font-size:.8em;cursor:pointer">✕ Đóng</button>'
          +'</div></div></div>';
        return out;
      };

      const coveredDates = new Set();
      if(_bankVnpayPayments.length) {
        _bankVnpayPayments.forEach(pay => {
          const payAllDates = allDates.filter(d => inRange(d, pay.fromDate, pay.toDate));
          const payRenderDates = filteredDates.filter(d => inRange(d, pay.fromDate, pay.toDate));
          if(selMonth && payRenderDates.length===0){ payAllDates.forEach(d=>coveredDates.add(d)); return; }
          const vnpayNet = payAllDates.reduce((s,d)=>s+computeVnpayDayNet(d,byDate),0);
          const chenh = pay.amount - vnpayNet;
          const chCol = Math.abs(chenh)<1000?'#86efac':(chenh<0?'#fca5a5':'#fcd34d');
          const chTxt = (chenh>=0?'+':'')+fmtN(chenh);
          html += '<div style="background:#7c2d12;color:#fed7aa;padding:.5rem .8rem;font-weight:700;font-size:.87em;border-top:2px solid #ea580c;border-radius:4px;margin-top:.5rem;display:flex;flex-wrap:wrap;gap:.6rem;align-items:center">'
            +'<span>💳 NH trả về <strong>'+pay.payDate+'</strong>:'
            +'<span style="background:#9a3412;padding:.05rem .45rem;border-radius:5px;margin-left:.4rem">'+fmtN(pay.amount)+'đ</span></span>'
            +(pay.fromDate?'<span style="font-weight:400;color:#fdba74;font-size:.84em">VNPay '
              +pay.fromDate+(pay.toDate&&pay.toDate!==pay.fromDate?' → '+pay.toDate:'')+'</span>':'')
            +(payAllDates.length?'<span style="font-weight:400;color:#fdba74;font-size:.84em">Net: '+fmtN(vnpayNet)+'đ</span>':'')
            +(payAllDates.length?'<span style="color:'+chCol+';font-weight:900">'+(Math.abs(chenh)<1000?'✅':'⚠️')+' Chênh: '+chTxt+'đ</span>':'')
            +'</div>';
          payAllDates.forEach(d=>coveredDates.add(d));
          payRenderDates.forEach(d=>{ html += renderDateBlock(d); });
        });
      }

      const unpaidDates = filteredDates.filter(d=>!coveredDates.has(d));
      if(unpaidDates.length) {
        if(_bankVnpayPayments.length) {
          const unpaidNet = unpaidDates.reduce((s,d)=>s+computeVnpayDayNet(d,byDate),0);
          html += '<div style="background:#78350f;color:#fef3c7;padding:.5rem .8rem;font-weight:700;font-size:.86em;border-top:2px solid #d97706;border-radius:4px;margin-top:.5rem">'
            +'⏳ Chưa có NH trả về &nbsp;·&nbsp; Tổng Net: '+fmtN(unpaidNet)+'đ</div>';
        }
        unpaidDates.forEach(d=>{ html += renderDateBlock(d); });
      }

      const byGian = {};
      filteredDates.forEach(dt => {
        Object.entries(byDate[dt]).forEach(([maCT,d]) => {
          const gDisp = getVnpayGianDisp(dt, maCT, d);
          if(!byGian[maCT]) byGian[maCT]={soDon:0,gross:0,phi:0,net:0};
          byGian[maCT].soDon+=d.soDon; byGian[maCT].gross+=gDisp.dt; byGian[maCT].phi+=gDisp.phi; byGian[maCT].net+=gDisp.net;
        });
      });
      const gianKeys = Object.keys(byGian).sort();
      html += '<table style="width:100%;border-collapse:collapse;font-size:.85em;margin-top:.6rem"><tbody>'
        +'<tr style="background:#7c2d12;color:#fff;font-weight:700">'
        +'<td style="padding:.5rem .75rem">TỔNG CỘNG ('+filteredDates.length+' ngày)</td>'
        +'<td style="text-align:right;padding:.5rem .5rem">'+totN+' GD</td>'
        +'<td style="text-align:right;padding:.5rem .5rem">'+fmtN(totGross)+'</td>'
        +'<td style="text-align:right;padding:.5rem .5rem">'+fmtN(totPhi)+'</td>'
        +'<td style="text-align:right;padding:.5rem .5rem">'+fmtN(totNet)+'</td>'
        +'<td colspan="3"></td></tr>';
      gianKeys.forEach((maCT,i) => {
        const g = byGian[maCT];
        html += '<tr style="background:'+(i%2===0?'#fff7ed':'#ffedd5')+'">'
          +'<td style="padding:.3rem .75rem;padding-left:1.5rem"><span class="ct-badge">'+maCT+'</span></td>'
          +'<td style="text-align:right;padding:.3rem .5rem;color:#64748b">'+g.soDon+'</td>'
          +'<td style="text-align:right;padding:.3rem .5rem;color:#15803d;font-weight:600">'+fmtN(g.gross)+'</td>'
          +'<td style="text-align:right;padding:.3rem .5rem;color:#ef4444">'+fmtN(g.phi)+'</td>'
          +'<td style="text-align:right;padding:.3rem .5rem;color:#2563eb;font-weight:700">'+fmtN(g.net)+'</td>'
          +'<td colspan="3"></td></tr>';
      });
      html += '</tbody></table>';
      el.innerHTML = html;
    }


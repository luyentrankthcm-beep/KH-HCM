    // Click-to-edit số HĐ / tiền HĐ (show inline input, save on blur/Enter)
    function zHDEdit(spanEl, hdKey, field) {
      const cur = _zaloHD[hdKey] ? (_zaloHD[hdKey][field]||'') : '';
      const inp = document.createElement('input');
      inp.value = cur;
      inp.style.cssText = 'width:' + (field==='soHD'?'90px':'110px') + ';border:1px solid #2563eb;border-radius:4px;padding:.15rem .3rem;font-size:.8em;' + (field==='tienHD'?'text-align:right':'text-align:center');
      inp.onblur = () => { saveZaloHD(hdKey, field, inp.value); renderZaloDoiSoat(); };

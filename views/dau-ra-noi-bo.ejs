<!DOCTYPE html>
<html lang="vi">
<head>
  <%- include('partials/head') %>
  <title>Đầu Ra – Nội Bộ – K&H</title>
  <style>
    .tab-bar { display:flex; gap:0; border-bottom:2px solid #1e3a5f; margin-bottom:1.25rem; }
    .tab-btn { padding:.5rem 1.25rem; font-weight:600; font-size:.88em; cursor:pointer; border:none; background:#e8f0fe; color:#1e3a5f; border-radius:6px 6px 0 0; margin-right:3px; text-decoration:none; display:inline-block; }
    .tab-btn.active { background:#1e3a5f; color:#fff; }
    .tab-btn:hover:not(.active) { background:#c7d7f8; }
    .tab-panel { display:none; }
    .tab-panel.active { display:block; }

    .kvc-toolbar { display:flex; align-items:center; gap:.6rem; flex-wrap:wrap; margin-bottom:1rem; }
    .kvc-toolbar select, .kvc-toolbar input { padding:.35rem .6rem; border:1px solid #cbd5e1; border-radius:6px; font-size:.85em; }
    .btn-update-all { background:#1e3a5f; color:#fff; border:none; border-radius:6px; padding:.4rem 1rem; font-size:.85em; font-weight:600; cursor:pointer; white-space:nowrap; }
    .btn-update-all:hover { background:#2563eb; }
    .btn-update-all:disabled { background:#94a3b8; cursor:not-allowed; }
    .btn-add-gian { background:#16a34a; color:#fff; border:none; border-radius:6px; padding:.4rem .9rem; font-size:.85em; font-weight:600; cursor:pointer; white-space:nowrap; }
    .btn-add-gian:hover { background:#15803d; }

    /* ===== ADD GIAN MODAL ===== */
    .add-gian-overlay { display:none; position:fixed; inset:0; background:rgba(0,0,0,.48); z-index:300; align-items:center; justify-content:center; }
    .add-gian-overlay.open { display:flex; }
    .add-gian-box { background:#fff; border-radius:14px; width:96%; max-width:560px; box-shadow:0 12px 48px rgba(0,0,0,.22); overflow:hidden; }
    .add-gian-head { display:flex; align-items:center; justify-content:space-between; padding:.85rem 1.25rem; background:#16a34a; }
    .add-gian-head h3 { margin:0; font-size:.95rem; font-weight:700; color:#fff; }
    .add-gian-body { padding:1.1rem 1.25rem; display:grid; gap:.75rem; }
    .add-gian-row { display:grid; grid-template-columns:1fr 1fr; gap:.6rem; }
    .add-gian-row.full { grid-template-columns:1fr; }
    .add-gian-label { font-size:.78em; color:#475569; font-weight:600; margin-bottom:.2rem; display:block; }
    .add-gian-input { width:100%; padding:.38rem .6rem; border:1px solid #cbd5e1; border-radius:6px; font-size:.85em; font-family:inherit; box-sizing:border-box; }
    .add-gian-input:focus { outline:none; border-color:#16a34a; background:#f0fdf4; }
    .add-gian-hint { font-size:.72em; color:#94a3b8; margin-top:.15rem; }
    .add-gian-foot { display:flex; justify-content:flex-end; gap:.6rem; padding:.85rem 1.25rem; border-top:1px solid #e2e8f0; background:#f8fafc; }
    .btn-link { display:inline-flex; align-items:center; gap:3px; background:#eff6ff; color:#2563eb; border:1px solid #bfdbfe; border-radius:4px; padding:.2rem .5rem; font-size:.78em; font-weight:600; text-decoration:none; white-space:nowrap; }
    .btn-link:hover { background:#dbeafe; }
    .btn-row-update { background:#1e3a5f; border:none; border-radius:4px; color:#fff; cursor:pointer; font-size:.78em; padding:.28rem .6rem; white-space:nowrap; }
    .btn-row-update:hover { background:#2563eb; }

    .kvc-table { width:100%; border-collapse:collapse; font-size:.86em; }
    .kvc-table th { background:#1e3a5f; color:#fff; padding:.5rem .6rem; text-align:left; white-space:nowrap; position:sticky; top:0; z-index:5; }
    .kvc-table th.right { text-align:right; }
    .kvc-table td { padding:.45rem .6rem; border-bottom:1px solid #e2e8f0; vertical-align:middle; }
    .kvc-table tbody tr:hover td { background:#f0f7ff; }
    .kvc-table tfoot td { background:#f1f5f9; font-weight:700; border-top:2px solid #1e3a5f; }
    .kvc-table .num { text-align:right; font-variant-numeric:tabular-nums; }
    .kvc-table .num.money { color:#15803d; font-weight:600; }
    .kvc-table .num.empty { color:#cbd5e1; font-style:italic; }
    .kvc-table tbody tr { cursor:pointer; }

    .badge-kh { display:inline-block; border-radius:10px; padding:.1rem .45rem; font-size:.75em; font-weight:700; }
    .badge-moi { background:#dcfce7; color:#166534; }
    .badge-cu { background:#dbeafe; color:#1e40af; }

    .last-updated { font-size:.72em; color:#94a3b8; }
    .status-dot { display:inline-block; width:7px; height:7px; border-radius:50%; margin-right:4px; }
    .dot-ok { background:#22c55e; }
    .dot-empty { background:#e2e8f0; }
    @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:.3} }

    /* ===== DETAIL MODAL ===== */
    .modal-overlay { display:none; position:fixed; inset:0; background:rgba(0,0,0,.45); z-index:200; align-items:flex-start; justify-content:center; padding-top:2rem; overflow-y:auto; }
    .modal-overlay.open { display:flex; }
    .modal-box { background:#fff; border-radius:14px; padding:0; width:98%; max-width:820px; box-shadow:0 12px 48px rgba(0,0,0,.22); margin-bottom:2rem; }
    .modal-header { display:flex; align-items:center; justify-content:space-between; padding:1rem 1.25rem; border-bottom:2px solid #e2e8f0; background:#1e3a5f; border-radius:14px 14px 0 0; }
    .modal-title { font-size:.96rem; font-weight:700; color:#fff; }
    .modal-header-right { display:flex; align-items:center; gap:.5rem; }
    .btn-close-modal { background:rgba(255,255,255,.15); border:none; color:#fff; font-size:1.1rem; cursor:pointer; width:30px; height:30px; border-radius:50%; display:flex; align-items:center; justify-content:center; }
    .btn-close-modal:hover { background:rgba(255,255,255,.3); }
    .btn-fetch { background:#16a34a; color:#fff; border:none; border-radius:6px; padding:.3rem .8rem; font-size:.8em; font-weight:700; cursor:pointer; white-space:nowrap; }
    .btn-fetch:hover { background:#15803d; }
    .btn-fetch:disabled { background:#6b7280; cursor:not-allowed; }
    .modal-body { padding:1rem 1.25rem; }
    .modal-link { font-size:.78em; color:#93c5fd; text-decoration:none; }
    .modal-link:hover { color:#fff; text-decoration:underline; }

    .day-table { width:100%; border-collapse:collapse; font-size:.83em; }
    .day-table th { background:#e8f0fe; color:#1e3a5f; padding:.4rem .5rem; text-align:right; font-weight:700; border:1px solid #dbeafe; white-space:nowrap; }
    .day-table th:first-child { text-align:left; width:90px; }
    .day-table td { padding:.3rem .5rem; border:1px solid #f1f5f9; vertical-align:middle; }
    .day-table td:first-child { font-weight:600; color:#374151; background:#fafafa; white-space:nowrap; }
    .day-table tfoot td { background:#f1f5f9; font-weight:700; border-top:2px solid #1e3a5f; text-align:right; color:#1e3a5f; }
    .day-table tfoot td:first-child { text-align:left; }
    .day-table tbody tr:hover td { background:#f0f9ff; }
    .day-table tbody tr:hover td:first-child { background:#e0f2fe; }

    .day-input { width:100%; min-width:95px; padding:.25rem .4rem; border:1px solid #e2e8f0; border-radius:4px; font-size:.85em; text-align:right; font-family:inherit; }
    .day-input:focus { outline:none; border-color:#2563eb; background:#eff6ff; }
    .day-input::-webkit-inner-spin-button { opacity:.5; }
    .tong-cell { text-align:right; font-weight:700; color:#15803d; padding:.3rem .5rem; }
    .tong-zero { color:#d1d5db; font-weight:400; }

    .modal-footer { display:flex; justify-content:space-between; align-items:center; padding:.85rem 1.25rem; border-top:1px solid #e2e8f0; background:#f8fafc; border-radius:0 0 14px 14px; }
    .btn-save { background:#16a34a; color:#fff; border:none; border-radius:7px; padding:.45rem 1.2rem; font-size:.88em; font-weight:700; cursor:pointer; }
    .btn-save:hover { background:#15803d; }
    .btn-cancel { background:#f1f5f9; color:#64748b; border:1px solid #e2e8f0; border-radius:7px; padding:.45rem 1rem; font-size:.88em; cursor:pointer; }
    .btn-cancel:hover { background:#e2e8f0; }
    .modal-total-preview { font-size:.82em; color:#475569; }
    .modal-total-preview strong { color:#1e3a5f; }
  </style>
</head>
<body>
  <%- include('partials/nav') %>
  <main class="container" style="padding-top:1.5rem; max-width:1300px;">

    <h1 style="font-size:1.4rem;font-weight:700;margin-bottom:.75rem">Đầu Ra – Nội Bộ</h1>

    <div class="tab-bar">
      <button class="tab-btn active" id="tab_btn_nb1" onclick="switchTabNB('nb1')">🏪 KVC MN</button>
      <button class="tab-btn" id="tab_btn_nb2" onclick="switchTabNB('nb2')">📋 Tab 2</button>
    </div>

    <!-- ===== TAB 1: KVC MN ===== -->
    <div id="tab_nb1" class="tab-panel active">

      <div class="kvc-toolbar">
        <label style="font-size:.85em;font-weight:600;color:#475569;">Tháng:</label>
        <select id="kvc_month" onchange="renderKvcTable()">
          <option value="1">Tháng 1</option><option value="2">Tháng 2</option>
          <option value="3">Tháng 3</option><option value="4">Tháng 4</option>
          <option value="5">Tháng 5</option><option value="6">Tháng 6</option>
          <option value="7">Tháng 7</option><option value="8">Tháng 8</option>
          <option value="9" selected>Tháng 9</option><option value="10">Tháng 10</option>
          <option value="11">Tháng 11</option><option value="12">Tháng 12</option>
        </select>
        <select id="kvc_year" onchange="renderKvcTable()">
          <option value="2025">2025</option>
          <option value="2026" selected>2026</option>
        </select>
        <span style="font-size:.8em;color:#94a3b8;">💡 Nhấn vào gian để nhập số liệu từng ngày</span>
        <button class="btn-update-all" id="btn_update_all" onclick="updateAllFromSheets()" title="Tự động lấy TM & CK từ Google Sheets cho tất cả gian và lưu lên server">
          🔄 Cập nhật tất cả từ GG Sheets
        </button>
        <button class="btn-add-gian" onclick="openAddGianModal()" title="Thêm gian mới và map Google Sheets">
          ➕ Thêm gian mới
        </button>
        <span id="kvc_status" style="font-size:.8em;color:#64748b;"></span>
      </div>

      <div style="overflow-x:auto;border-radius:10px;box-shadow:0 2px 12px rgba(0,0,0,.07);">
        <table class="kvc-table" id="kvc_main_table">
          <thead>
            <tr>
              <th style="width:30px;">#</th>
              <th style="width:45px;">KH</th>
              <th>Mã công trình</th>
              <th style="width:60px;text-align:center;">Báo cáo</th>
              <th class="right" style="min-width:130px;">Tiền mặt (đ)</th>
              <th class="right" style="min-width:130px;">Chuyển khoản (đ)</th>
              <th class="right" style="min-width:130px;">DT khác (đ)</th>
              <th class="right" style="min-width:130px;">Tổng DT (đ)</th>
              <th style="width:60px;text-align:center;">Báo cáo</th>
            </tr>
          </thead>
          <tbody id="kvc_tbody"></tbody>
          <tfoot id="kvc_tfoot"></tfoot>
        </table>
      </div>

      <p style="font-size:.76em;color:#94a3b8;margin-top:.6rem;">
        💾 Dữ liệu lưu trên server. Nhấn "Cập nhật tất cả từ GG Sheets" để tự động lấy TM/CK cho tất cả gian.
      </p>
    </div>

    <!-- ===== TAB 2 ===== -->
    <div id="tab_nb2" class="tab-panel">
      <div style="padding:3rem;text-align:center;color:#94a3b8">
        <div style="font-size:3rem;margin-bottom:1rem">📂</div>
        <p style="font-size:.88em">Chưa có nội dung</p>
      </div>
    </div>

  </main>

  <!-- ===== ADD GIAN MODAL ===== -->
  <div class="add-gian-overlay" id="add_gian_modal">
    <div class="add-gian-box">
      <div class="add-gian-head">
        <h3>➕ Thêm gian mới</h3>
        <button style="background:rgba(255,255,255,.2);border:none;color:#fff;font-size:1.1rem;cursor:pointer;width:28px;height:28px;border-radius:50%;display:flex;align-items:center;justify-content:center;" onclick="closeAddGianModal()">✕</button>
      </div>
      <div class="add-gian-body">
        <div class="add-gian-row full">
          <label class="add-gian-label">Tên mã công trình <span style="color:red">*</span></label>
          <input class="add-gian-input" id="ag_maCT" placeholder="VD: TUTU MN AEON MALL TÂN BÌNH" />
        </div>
        <div class="add-gian-row">
          <div>
            <label class="add-gian-label">Tên đầy đủ (tên khách hàng)</label>
            <input class="add-gian-input" id="ag_khFull" placeholder="VD: AEON VIỆT NAM - AEON TÂN BÌNH" />
          </div>
          <div>
            <label class="add-gian-label">Loại KH</label>
            <select class="add-gian-input" id="ag_kh" style="cursor:pointer;">
              <option value="mới">Mới</option>
              <option value="cũ">Cũ</option>
            </select>
          </div>
        </div>
        <div class="add-gian-row full">
          <label class="add-gian-label">Link Google Sheets <span style="color:red">*</span></label>
          <input class="add-gian-input" id="ag_link" placeholder="https://docs.google.com/spreadsheets/d/..." oninput="onAgLinkInput(this)" />
          <div class="add-gian-hint" id="ag_sheet_id_hint">Nhập link → tự động trích xuất Sheet ID</div>
        </div>
        <div class="add-gian-row">
          <div>
            <label class="add-gian-label">Tên tab <span style="color:red">*</span></label>
            <input class="add-gian-input" id="ag_tab" placeholder="VÉ" value="VÉ" />
            <div class="add-gian-hint">Ví dụ: VÉ, TỔNG, BÁO CÁO</div>
          </div>
          <div>
            <label class="add-gian-label">ID gian (tự tạo)</label>
            <input class="add-gian-input" id="ag_id" placeholder="tự tạo từ tên" style="color:#64748b;" />
            <div class="add-gian-hint">Tự động điền, có thể sửa</div>
          </div>
        </div>
        <div class="add-gian-row">
          <div>
            <label class="add-gian-label">Cột Tiền Mặt <span style="color:red">*</span></label>
            <input class="add-gian-input" id="ag_tmCol" placeholder="AI" value="AI" style="text-transform:uppercase;" />
            <div class="add-gian-hint">Ký tự cột trong Sheet (VD: AI = cột 35)</div>
          </div>
          <div>
            <label class="add-gian-label">Cột CK/Momo <span style="color:red">*</span></label>
            <input class="add-gian-input" id="ag_ckCol" placeholder="AJ" value="AJ" style="text-transform:uppercase;" />
            <div class="add-gian-hint">Ký tự cột trong Sheet (VD: AJ = cột 36)</div>
          </div>
        </div>
        <div id="ag_error" style="display:none;color:#dc2626;font-size:.82em;padding:.4rem .6rem;background:#fef2f2;border-radius:6px;"></div>
      </div>
      <div class="add-gian-foot">
        <button style="padding:.45rem 1rem;border:1px solid #e2e8f0;border-radius:7px;background:#f1f5f9;color:#64748b;cursor:pointer;font-size:.88em;" onclick="closeAddGianModal()">Hủy</button>
        <button style="padding:.45rem 1.2rem;border:none;border-radius:7px;background:#16a34a;color:#fff;font-weight:700;cursor:pointer;font-size:.88em;" id="ag_submit_btn" onclick="submitAddGian()">✅ Thêm gian</button>
      </div>
    </div>
  </div>

  <!-- ===== DETAIL MODAL ===== -->
  <div class="modal-overlay" id="detail_modal">
    <div class="modal-box">
      <div class="modal-header">
        <div>
          <div class="modal-title" id="modal_title">Chi tiết</div>
          <a id="modal_sheet_link" href="#" target="_blank" class="modal-link">📊 Mở báo cáo Google Sheets ↗</a>
        </div>
        <div class="modal-header-right">
          <button id="btn_fetch_sheets" class="btn-fetch" onclick="fetchFromSheets()" title="Tự động lấy TM & CK từ Google Sheets báo cáo">
            🔄 Lấy từ GG Sheets
          </button>
          <button class="btn-close-modal" onclick="closeDetailModal()">✕</button>
        </div>
      </div>
      <div class="modal-body" id="modal_body"></div>
      <div class="modal-footer">
        <div class="modal-total-preview" id="modal_total_preview"></div>
        <div style="display:flex;gap:.5rem;align-items:center;">
          <span id="modal_save_ok" style="display:none;font-size:.82em;color:#16a34a;font-weight:600;">✓ Đã lưu lên server</span>
          <button class="btn-cancel" onclick="closeDetailModal()">Đóng</button>
          <button class="btn-save" onclick="saveDetail()">💾 Lưu</button>
        </div>
      </div>
    </div>
  </div>

  <script>
  // ============================================================
  // DATA: 14 gian KVC MN
  // ============================================================
  const KVC_GIAN = [
    { id:'farm_lottebt', kh:'mới', maCT:'FARM MN LOTTE MART PHAN THIẾT',       khFull:'LOTTE VIỆT NAM - CHI NHÁNH BÌNH THUẬN',        link:'https://docs.google.com/spreadsheets/d/1fiFGmerqMGjKW8oxJBfN_KXVn7c7rbIOszzuZIavHLc/edit?usp=sharing' },
    { id:'tutu_lottegv', kh:'cũ',  maCT:'TUTU MN LOTTE MART GÒ VẤP',           khFull:'LOTTE VIỆT NAM - CHI NHÁNH GÒ VẤP',            link:'https://docs.google.com/spreadsheets/d/1F3ATisma35uHIdhlKAckd16GlmTGMvRE_QwH4N16H0M/edit?usp=sharing' },
    { id:'tutu_aeontp',  kh:'cũ',  maCT:'TUTU MN AEON MALL TÂN PHÚ',           khFull:'AEON VIỆT NAM - AEON TÂN PHÚ',                 link:'https://docs.google.com/spreadsheets/d/1jGG9Po3WnsntEeXC53uHUUxi-5bcKx-jPuPWhN68Qps/edit?usp=sharing' },
    { id:'tutu_aeonbt',  kh:'cũ',  maCT:'TUTU MN AEON MALL BÌNH TÂN',          khFull:'AEON HỒ CHÍ MINH - CSE',                       link:'https://docs.google.com/spreadsheets/d/1Lts3GeoeozWrPlprGzANK_ksmd6h4XMnl5xMUMM_OL4/edit?usp=sharing' },
    { id:'tutu_aeonbd',  kh:'cũ',  maCT:'TUTU MN AEON MALL BÌNH DƯƠNG',        khFull:'AEON BÌNH DƯƠNG',                               link:'https://docs.google.com/spreadsheets/d/15brZmUqEYuuEkbp7AgQSAEKmbgMiNqey6CIScGO97cs/edit?usp=sharing' },
    { id:'tutu_estella', kh:'mới', maCT:'TUTU MN ESTELLA',                     khFull:'LIÊN DOANH ESTELLA - CSE',                     link:'https://docs.google.com/spreadsheets/d/1cegFodLAXbtYdITdfGGd8m0weoOUVP6RgwGPScb9JMo/edit?usp=sharing' },
    { id:'tutu_aeontan', kh:'mới', maCT:'TUTU MN AEON MALL TÂN AN',            khFull:'AEON TÂN AN',                                  link:'https://docs.google.com/spreadsheets/d/1SGtQ0Kvnvidr4ipxSP-AY5uwGwFEEoOrwFhawJP2scI/edit?usp=sharing' },
    { id:'fz_lottebt',   kh:'cũ',  maCT:'FZ MN NHÀ BÓNG LOTTE MART VŨNG TÀU', khFull:'LOTTE VIỆT NAM - CHI NHÁNH BÀ RỊA VŨNG TÀU',  link:'https://docs.google.com/spreadsheets/d/1Be1E0pBJlYATKpogjqMTyHbhMcOg3Rbca7qoUlvHBWk/edit?usp=sharing' },
    { id:'fz_scvivo',    kh:'cũ',  maCT:'FZ MN ADV SC VIVO',                   khFull:'SC VIVO (PHỨC HỢP THƯƠNG MẠI VIETSIN)',        link:'https://docs.google.com/spreadsheets/d/1lQMEpf1OhVOEROY5kzM_cWp77fZgUl92cVn0A78SGvw/edit?usp=sharing' },
    { id:'fz_aeontan',   kh:'mới', maCT:'FZ MN VR AEON MALL TÂN AN',           khFull:'AEON TÂN AN',                                  link:'https://docs.google.com/spreadsheets/d/1Ej4iwtbLGu-WgHkjTjdIDZPz02lL4KLRE9ANYzpMP9c/edit?usp=sharing' },
    { id:'ev_ghostbr',   kh:'cũ',  maCT:'EVMN GHOST MN GO BÀ RỊA',            khFull:'GO BÀ RỊA (VIỆT- NHẬT TẠI BÀ RỊA)',           link:'https://docs.google.com/spreadsheets/d/1JwtV9Mg-LS_3xIuuzSuc0aE4x23riepFiomt7q0HAPU/edit?usp=sharing' },
    { id:'ev_fzgoan',    kh:'cũ',  maCT:'EVMN FZ ADV GO AN LẠC',              khFull:'GO AN LẠC (SIÊU THỊ AN LẠC)',                  link:'https://docs.google.com/spreadsheets/d/1bdU9XExnBp8aMLTj9rAAXS1G3_Xi6m2jI3y0SqQN80s/edit?usp=sharing' },
    { id:'fz_scvivo2',   kh:'cũ',  maCT:'FZ MN VR SC VIVO',                   khFull:'SC VIVO (PHỨC HỢP THƯƠNG MẠI VIETSIN) - CSE', link:'https://docs.google.com/spreadsheets/d/1ZaNpXiOrtpnHHZXdMZEFmBKw1eooAPmXqqls0N0Uap0/edit?usp=sharing' },
    { id:'pinball_amtp', kh:'cũ',  maCT:'PINBALL MN AMTP',                    khFull:'AEON VIỆT NAM - AEON TÂN PHÚ',                 link:'https://docs.google.com/spreadsheets/d/1r-huBGhhy_K_nOyHr0iz4Rd3Bkfw0vyTDQEZbT_PrOo/edit?usp=sharing' },
  ];

  const THU_MAP = ['CN','T2','T3','T4','T5','T6','T7'];

  // ============================================================
  // HELPERS
  // ============================================================
  function storageKey(id, month, year) { return 'kvc_' + id + '_' + year + '_' + month; }

  // Cache server KV vào memory (dùng khi localStorage bị đầy)
  let _serverKvcCache = {};

  function loadData(id, month, year) {
    const k = storageKey(id, month, year);
    // 1. Thử localStorage trước
    try { const r = localStorage.getItem(k); if (r) return JSON.parse(r); } catch(e) {}
    // 2. Fallback về server cache trong memory
    return _serverKvcCache[k] || null;
  }

  function saveData(id, month, year, data) {
    const k = storageKey(id, month, year);
    // Lưu vào memory cache ngay lập tức
    _serverKvcCache[k] = data;
    try { localStorage.setItem(k, JSON.stringify(data)); } catch(e) {}
    // Sync lên server để dùng nhiều máy
    serverSave(k, data);
  }

  function fmtMoney(val) {
    if (val===null||val===undefined||val===''||isNaN(Number(val))) return '<span class="empty">—</span>';
    const n = Number(val);
    if (n===0) return '<span style="color:#94a3b8">0</span>';
    return n.toLocaleString('vi-VN');
  }

  function cleanNum(s) {
    if (s===null||s===undefined||s==='') return 0;
    return Number(String(s).replace(/[.,\s]/g,'')) || 0;
  }

  // Lấy danh sách ngày trong tháng
  function getDaysInMonth(year, month) {
    const daysInMonth = new Date(year, month, 0).getDate();
    const days = [];
    for (let d = 1; d <= daysInMonth; d++) {
      const dt = new Date(year, month-1, d);
      const thu = THU_MAP[dt.getDay()];
      const dayStr = String(d).padStart(2,'0');
      const monStr = String(month).padStart(2,'0');
      days.push({ day: d, label: dayStr + '/' + monStr, thu });
    }
    return days;
  }

  function getMonthYear() {
    return {
      month: parseInt(document.getElementById('kvc_month').value),
      year: parseInt(document.getElementById('kvc_year').value)
    };
  }

  // Tính tổng từ daily array
  function calcTotalsFromDaily(daily) {
    let tm = 0, ck = 0, khac = 0;
    let hasTM = false, hasCK = false;
    (daily||[]).forEach(r => {
      if (r.tienMat !== null && r.tienMat !== undefined && r.tienMat !== '') { tm += Number(r.tienMat)||0; hasTM = true; }
      if (r.chuyenKhoan !== null && r.chuyenKhoan !== undefined && r.chuyenKhoan !== '') { ck += Number(r.chuyenKhoan)||0; hasCK = true; }
      if (r.dtKhac) khac += Number(r.dtKhac)||0;
    });
    return { tm: hasTM ? tm : null, ck: hasCK ? ck : null, khac };
  }

  // ============================================================
  // RENDER MAIN TABLE
  // ============================================================
  function renderKvcTable() {
    const {month, year} = getMonthYear();
    const tbody = document.getElementById('kvc_tbody');
    const tfoot = document.getElementById('kvc_tfoot');
    let totalTM = 0, totalCK = 0, totalKhac = 0;
    let hasAnyData = false;

    tbody.innerHTML = KVC_GIAN.map((g, i) => {
      const d = loadData(g.id, month, year);
      const tots = d && d.daily ? calcTotalsFromDaily(d.daily) : { tm: null, ck: null, khac: 0 };
      const { tm, ck, khac } = tots;
      const tong = (tm !== null || ck !== null) ? (tm||0) + (ck||0) + (khac||0) : null;

      if (tm !== null) { totalTM += tm; hasAnyData = true; }
      if (ck !== null) { totalCK += ck; hasAnyData = true; }
      totalKhac += khac;

      const hasDot = (tm !== null || ck !== null) ? 'dot-ok' : 'dot-empty';
      const updatedTxt = d && d.updatedAt ? '<br><span class="last-updated">' + d.updatedAt + '</span>' : '';

      return `<tr onclick="showDetail('${g.id}','${month}','${year}')" title="Nhấn để nhập số liệu từng ngày">
        <td style="color:#94a3b8;font-size:.8em;">${i+1}</td>
        <td><span class="badge-kh badge-${g.kh==='mới'?'moi':'cu'}">${g.kh}</span></td>
        <td>
          <span class="status-dot ${hasDot}"></span>
          <strong>${g.maCT}</strong>
          <br><span style="font-size:.75em;color:#94a3b8;">${g.khFull}</span>
          ${updatedTxt}
        </td>
        <td style="text-align:center;" onclick="event.stopPropagation()">
          <a href="${g.link}" target="_blank" class="btn-link" title="Mở báo cáo">📊</a>
        </td>
        <td class="num ${tm!==null?'money':'empty'}">${fmtMoney(tm)}</td>
        <td class="num ${ck!==null?'money':'empty'}">${fmtMoney(ck)}</td>
        <td class="num ${khac?'money':'empty'}">${fmtMoney(khac||null)}</td>
        <td class="num ${tong!==null?'money':'empty'}">${fmtMoney(tong)}</td>
        <td style="text-align:center;" onclick="event.stopPropagation()">
          <a href="${g.link}" target="_blank" class="btn-link" title="Mở báo cáo">📊</a>
        </td>
      </tr>`;
    }).join('');

    const totalTong = totalTM + totalCK + totalKhac;
    tfoot.innerHTML = `<tr>
      <td colspan="4" style="font-weight:700;color:#1e3a5f;font-size:.88em;">TỔNG CỘNG</td>
      <td class="num money">${hasAnyData ? totalTM.toLocaleString('vi-VN') : '—'}</td>
      <td class="num money">${hasAnyData ? totalCK.toLocaleString('vi-VN') : '—'}</td>
      <td class="num money">${totalKhac ? totalKhac.toLocaleString('vi-VN') : '—'}</td>
      <td class="num money">${hasAnyData ? totalTong.toLocaleString('vi-VN') : '—'}</td>
      <td></td>
    </tr>`;
  }

  // ============================================================
  // DETAIL MODAL
  // ============================================================
  let _currentModalId   = null;
  let _currentModalMonth = null;
  let _currentModalYear  = null;

  function showDetail(id, month, year) {
    const g = KVC_GIAN.find(x => x.id === id);
    if (!g) return;

    _currentModalId    = id;
    _currentModalMonth = parseInt(month);
    _currentModalYear  = parseInt(year);

    document.getElementById('modal_title').textContent = g.maCT + ' — Tháng ' + month + '/' + year;
    document.getElementById('modal_sheet_link').href = g.link;

    const d = loadData(id, month, year) || {};
    const existing = {};
    (d.daily || []).forEach(r => { existing[r.ngay] = r; });

    const days = getDaysInMonth(parseInt(year), parseInt(month));

    let html = `<div style="overflow-x:auto;">
    <table class="day-table" id="day_tbl">
      <thead>
        <tr>
          <th>Ngày</th>
          <th>Tiền mặt (đ)<br><span style="font-weight:400;font-size:.78em;color:#64748b;">cột AI</span></th>
          <th>CK – Momo (đ)<br><span style="font-weight:400;font-size:.78em;color:#64748b;">cột AJ</span></th>
          <th>DT khác (đ)</th>
          <th>Tổng (đ)</th>
        </tr>
      </thead>
      <tbody>`;

    days.forEach(({ day, label, thu }) => {
      const r = existing[label] || {};
      const tmVal  = r.tienMat      !== undefined ? r.tienMat      : '';
      const ckVal  = r.chuyenKhoan  !== undefined ? r.chuyenKhoan  : '';
      const khVal  = r.dtKhac       !== undefined ? r.dtKhac       : '';
      const tong   = (Number(tmVal)||0) + (Number(ckVal)||0) + (Number(khVal)||0);
      const tongHtml = tong ? tong.toLocaleString('vi-VN') : '<span class="tong-zero">—</span>';

      html += `<tr>
        <td>${label} <span style="color:#94a3b8;font-size:.82em;">${thu}</span></td>
        <td><input class="day-input" type="number" min="0" step="1000"
            data-ngay="${label}" data-col="tm"
            value="${tmVal}" placeholder="0"
            oninput="onDayInput(this)"></td>
        <td><input class="day-input" type="number" min="0" step="1000"
            data-ngay="${label}" data-col="ck"
            value="${ckVal}" placeholder="0"
            oninput="onDayInput(this)"></td>
        <td><input class="day-input" type="number" min="0" step="1000"
            data-ngay="${label}" data-col="khac"
            value="${khVal}" placeholder="0"
            oninput="onDayInput(this)"></td>
        <td class="tong-cell" id="tong_${label.replace('/','_')}">${tongHtml}</td>
      </tr>`;
    });

    // Footer tổng
    const tots = calcTotalsFromDaily(d.daily || []);
    html += `</tbody>
      <tfoot>
        <tr id="day_tbl_foot">
          <td>TỔNG</td>
          <td id="foot_tm">${tots.tm!==null ? tots.tm.toLocaleString('vi-VN') : '—'}</td>
          <td id="foot_ck">${tots.ck!==null ? tots.ck.toLocaleString('vi-VN') : '—'}</td>
          <td id="foot_khac">${tots.khac ? tots.khac.toLocaleString('vi-VN') : '—'}</td>
          <td id="foot_tong">${(tots.tm!==null||tots.ck!==null) ? ((tots.tm||0)+(tots.ck||0)+(tots.khac||0)).toLocaleString('vi-VN') : '—'}</td>
        </tr>
      </tfoot>
    </table></div>`;

    document.getElementById('modal_body').innerHTML = html;
    updateModalPreview();
    document.getElementById('detail_modal').classList.add('open');
  }

  function onDayInput(input) {
    // Cập nhật tổng hàng
    const ngay = input.dataset.ngay;
    const key  = ngay.replace('/','_');
    const row  = input.closest('tr');
    const vals = row.querySelectorAll('input.day-input');
    let sum = 0;
    vals.forEach(v => { sum += Number(v.value) || 0; });
    const cell = document.getElementById('tong_' + key);
    if (cell) cell.innerHTML = sum ? sum.toLocaleString('vi-VN') : '<span class="tong-zero">—</span>';

    // Cập nhật footer
    updateFooterTotals();
    updateModalPreview();
  }

  function updateFooterTotals() {
    const tbl = document.getElementById('day_tbl');
    if (!tbl) return;
    let sumTM = 0, sumCK = 0, sumKhac = 0;
    let hasTM = false, hasCK = false;

    tbl.querySelectorAll('tbody tr').forEach(row => {
      const inputs = row.querySelectorAll('input.day-input');
      if (inputs.length < 3) return;
      const tm   = inputs[0].value !== '' ? Number(inputs[0].value)||0 : null;
      const ck   = inputs[1].value !== '' ? Number(inputs[1].value)||0 : null;
      const khac = Number(inputs[2].value)||0;
      if (tm !== null) { sumTM += tm; hasTM = true; }
      if (ck !== null) { sumCK += ck; hasCK = true; }
      sumKhac += khac;
    });

    document.getElementById('foot_tm').textContent   = hasTM  ? sumTM.toLocaleString('vi-VN')   : '—';
    document.getElementById('foot_ck').textContent   = hasCK  ? sumCK.toLocaleString('vi-VN')   : '—';
    document.getElementById('foot_khac').textContent = sumKhac ? sumKhac.toLocaleString('vi-VN') : '—';
    const tong = (hasTM || hasCK) ? sumTM + sumCK + sumKhac : 0;
    document.getElementById('foot_tong').textContent = tong ? tong.toLocaleString('vi-VN') : '—';
  }

  function updateModalPreview() {
    const tbl = document.getElementById('day_tbl');
    if (!tbl) return;
    let sumTM = 0, sumCK = 0, sumKhac = 0, hasTM=false, hasCK=false;
    tbl.querySelectorAll('tbody tr').forEach(row => {
      const inputs = row.querySelectorAll('input.day-input');
      if (inputs.length < 3) return;
      const tm   = inputs[0].value !== '' ? Number(inputs[0].value)||0 : null;
      const ck   = inputs[1].value !== '' ? Number(inputs[1].value)||0 : null;
      const khac = Number(inputs[2].value)||0;
      if (tm!==null){sumTM+=tm;hasTM=true;} if(ck!==null){sumCK+=ck;hasCK=true;} sumKhac+=khac;
    });
    const tong = sumTM + sumCK + sumKhac;
    const prev = document.getElementById('modal_total_preview');
    if (prev) prev.innerHTML =
      `TM: <strong>${hasTM?sumTM.toLocaleString('vi-VN'):'—'}</strong> &nbsp;|&nbsp; ` +
      `CK: <strong>${hasCK?sumCK.toLocaleString('vi-VN'):'—'}</strong> &nbsp;|&nbsp; ` +
      `Khác: <strong>${sumKhac?sumKhac.toLocaleString('vi-VN'):'—'}</strong> &nbsp;|&nbsp; ` +
      `Tổng: <strong style="color:#15803d">${tong?tong.toLocaleString('vi-VN'):'—'}</strong>`;
  }

  function readDailyFromModal() {
    const tbl = document.getElementById('day_tbl');
    if (!tbl) return [];
    const daily = [];
    tbl.querySelectorAll('tbody tr').forEach(row => {
      const inputs = row.querySelectorAll('input.day-input');
      if (inputs.length < 3) return;
      const ngay = inputs[0].dataset.ngay;
      const tm   = inputs[0].value !== '' ? Number(inputs[0].value)||0 : null;
      const ck   = inputs[1].value !== '' ? Number(inputs[1].value)||0 : null;
      const khac = inputs[2].value !== '' ? Number(inputs[2].value)||0 : 0;
      if (tm !== null || ck !== null || khac) {
        daily.push({ ngay, tienMat: tm, chuyenKhoan: ck, dtKhac: khac });
      }
    });
    return daily;
  }

  async function saveDetail() {
    if (!_currentModalId) return;
    const daily = readDailyFromModal();
    const now = new Date().toLocaleDateString('vi-VN', {day:'2-digit',month:'2-digit',year:'numeric',hour:'2-digit',minute:'2-digit'});
    saveData(_currentModalId, _currentModalMonth, _currentModalYear, { daily, updatedAt: now });
    renderKvcTable();
    // Hiện thông báo "Đã lưu" trong modal (không đóng modal)
    const okSpan = document.getElementById('modal_save_ok');
    if (okSpan) { okSpan.style.display = 'inline'; setTimeout(() => { okSpan.style.display = 'none'; }, 3000); }
  }

  function closeDetailModal() {
    document.getElementById('detail_modal').classList.remove('open');
  }

  // Đóng khi click overlay
  document.getElementById('detail_modal').addEventListener('click', function(e) {
    if (e.target === this) closeDetailModal();
  });

  // ============================================================
  // TAB SWITCH
  // ============================================================
  function switchTabNB(id) {
    document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
    document.getElementById('tab_' + id).classList.add('active');
    document.getElementById('tab_btn_' + id).classList.add('active');
  }

  // ============================================================
  // FETCH FROM GOOGLE SHEETS
  // ============================================================
  async function fetchFromSheets() {
    if (!_currentModalId) return;
    const btn = document.getElementById('btn_fetch_sheets');
    btn.disabled = true;
    btn.textContent = '⏳ Đang lấy...';

    try {
      const url = `/api/dau-ra/sheets-daily?gianId=${_currentModalId}&month=${_currentModalMonth}&year=${_currentModalYear}`;
      const resp = await fetch(url);
      const result = await resp.json();

      if (!result.ok) {
        if (result.needAuth) {
          alert('⚠️ Chưa kết nối Google.\n\nVào trang Chi Phí → bấm "Kết nối Gmail" để xác thực, sau đó thử lại.');
        } else {
          alert('Lỗi: ' + result.error);
        }
        return;
      }

      const { daily, tab, tmCol, ckCol } = result;
      if (!daily || daily.length === 0) {
        alert(`Không tìm thấy dữ liệu tháng ${_currentModalMonth}/${_currentModalYear} trong sheet "${tab}".\n(TM cột ${tmCol}, CK cột ${ckCol})`);
        return;
      }

      // Điền vào các input trong modal
      const tbl = document.getElementById('day_tbl');
      if (!tbl) return;

      // Map ngay → data
      const dataMap = {};
      daily.forEach(r => { dataMap[r.ngay] = r; });

      let filled = 0;
      tbl.querySelectorAll('tbody tr').forEach(row => {
        const inputs = row.querySelectorAll('input.day-input');
        if (inputs.length < 3) return;
        const ngay = inputs[0].dataset.ngay;
        const r = dataMap[ngay];
        if (!r) return;

        if (r.tienMat !== null && r.tienMat !== undefined) {
          inputs[0].value = r.tienMat;
          // Trigger update
          const ev = new Event('input');
          inputs[0].dispatchEvent(ev);
          filled++;
        }
        if (r.chuyenKhoan !== null && r.chuyenKhoan !== undefined) {
          inputs[1].value = r.chuyenKhoan;
          const ev = new Event('input');
          inputs[1].dispatchEvent(ev);
        }
      });

      updateFooterTotals();
      updateModalPreview();
      // Tự động lưu ngay sau khi lấy từ Sheets
      await saveDetail();
      btn.textContent = `✅ Đã lấy & lưu ${filled} ngày`;
      setTimeout(() => { btn.textContent = '🔄 Lấy từ GG Sheets'; btn.disabled = false; }, 2500);
    } catch(e) {
      alert('Lỗi kết nối: ' + e.message);
      btn.textContent = '🔄 Lấy từ GG Sheets';
      btn.disabled = false;
    }
  }

  // ============================================================
  // FETCH & SAVE 1 GIAN (không cần mở modal)
  // ============================================================
  async function fetchAndSaveGian(gianId, month, year) {
    const url = `/api/dau-ra/sheets-daily?gianId=${gianId}&month=${month}&year=${year}`;
    const resp = await fetch(url);
    const result = await resp.json();
    if (!result.ok || !result.daily || result.daily.length === 0) return { ok: false, filled: 0 };
    const now = new Date().toLocaleDateString('vi-VN', {day:'2-digit',month:'2-digit',year:'numeric',hour:'2-digit',minute:'2-digit'});
    saveData(gianId, month, year, { daily: result.daily, updatedAt: now, fromSheets: true });
    return { ok: true, filled: result.daily.length };
  }

  // ============================================================
  // CẬP NHẬT TẤT CẢ GIAN TỪ GG SHEETS
  // ============================================================
  async function updateAllFromSheets() {
    const btn = document.getElementById('btn_update_all');
    const status = document.getElementById('kvc_status');
    btn.disabled = true;
    const month = parseInt(document.getElementById('kvc_month').value);
    const year  = parseInt(document.getElementById('kvc_year').value);

    let ok = 0, fail = 0;
    for (let i = 0; i < KVC_GIAN.length; i++) {
      const g = KVC_GIAN[i];
      status.textContent = `⏳ Đang lấy ${i+1}/${KVC_GIAN.length}: ${g.maCT}…`;
      try {
        const res = await fetchAndSaveGian(g.id, month, year);
        if (res.ok) ok++; else fail++;
      } catch(e) { fail++; }
    }

    renderKvcTable();
    btn.disabled = false;
    status.textContent = `✅ Hoàn tất: ${ok} gian lấy được, ${fail} gian không có dữ liệu`;
    setTimeout(() => { status.textContent = ''; }, 8000);
  }

  // ============================================================
  // SERVER KV SYNC — đồng bộ dữ liệu lên server để dùng nhiều máy
  // ============================================================
  async function serverSave(key, value) {
    try {
      await fetch('/api/dau-ra/kv', {
        method:'POST', headers:{'Content-Type':'application/json'},
        body: JSON.stringify({ key, value })
      });
    } catch(e) { /* silent */ }
  }

  async function serverLoadAll() {
    try {
      const resp = await fetch('/api/dau-ra/kv-all');
      const result = await resp.json();
      if (result.ok && result.data) {
        // Load vào memory cache TRƯỚC (không bị giới hạn localStorage)
        Object.keys(result.data).forEach(k => {
          if (k.startsWith('kvc_')) {
            _serverKvcCache[k] = result.data[k];
            // Cố gắng ghi vào localStorage nếu còn chỗ
            try { localStorage.setItem(k, JSON.stringify(result.data[k])); } catch(e) {}
          }
        });
      }
    } catch(e) { /* silent */ }
  }

  // ============================================================
  // THÊM GIAN MỚI
  // ============================================================
  function slugifyGianId(str) {
    const vi = {'à':'a','á':'a','ả':'a','ã':'a','ạ':'a','dđ':'d'};
    const viMap = {'\xe0':'a','\xe1':'a','ả':'a','\xe3':'a','ạ':'a','ă':'a','ắ':'a','ằ':'a','ẳ':'a','ẵ':'a','ặ':'a','\xe2':'a','ấ':'a','ầ':'a','ẩ':'a','ẫ':'a','ậ':'a','đ':'d','\xe8':'e','\xe9':'e','ẻ':'e','ẽ':'e','ẹ':'e','\xea':'e','ế':'e','ề':'e','ể':'e','ễ':'e','ệ':'e','\xec':'i','\xed':'i','ỉ':'i','ĩ':'i','ị':'i','\xf2':'o','\xf3':'o','ỏ':'o','\xf5':'o','ọ':'o','\xf4':'o','ố':'o','ồ':'o','ổ':'o','ỗ':'o','ộ':'o','ơ':'o','ớ':'o','ờ':'o','ở':'o','ỡ':'o','ợ':'o','\xf9':'u','\xfa':'u','ủ':'u','ũ':'u','ụ':'u','ư':'u','ứ':'u','ừ':'u','ử':'u','ữ':'u','ự':'u','ỳ':'y','\xfd':'y','ỷ':'y','ỹ':'y','ỵ':'y'};
    let s = '';
    for (const c of str.toLowerCase()) {
      s += viMap[c] !== undefined ? viMap[c] : (c.charCodeAt(0) < 128 ? c : '');
    }
    return s.replace(/[^a-z0-9]+/g,'_').replace(/^_+|_+$/g,'').substring(0,40);
  }

  function colLetterToIdx(s) {
    s = (s||'').toUpperCase().replace(/\s/g,'');
    if (!s) return 0;
    let n = 0;
    for (let i = 0; i < s.length; i++) n = n * 26 + (s.charCodeAt(i) - 64);
    return n - 1; // 0-based
  }

  function extractSheetId(url) {
    const m = url.match(/\/spreadsheets\/d\/([a-zA-Z0-9_-]+)/);
    return m ? m[1] : '';
  }

  function onAgLinkInput(inp) {
    const sheetId = extractSheetId(inp.value || '');
    const hint = document.getElementById('ag_sheet_id_hint');
    if (sheetId) {
      hint.textContent = '✓ Sheet ID: ' + sheetId;
      hint.style.color = '#16a34a';
    } else {
      hint.textContent = 'Nhập link → tự động trích xuất Sheet ID';
      hint.style.color = '#94a3b8';
    }
  }

  document.getElementById('ag_maCT').addEventListener('input', function() {
    const idEl = document.getElementById('ag_id');
    idEl.value = slugifyGianId(this.value);
  });


  async function submitAddGian() {
    const maCT   = document.getElementById('ag_maCT').value.trim().toUpperCase();
    const khFull = document.getElementById('ag_khFull').value.trim().toUpperCase();
    const kh     = document.getElementById('ag_kh').value;
    const link   = document.getElementById('ag_link').value.trim();
    const tab    = document.getElementById('ag_tab').value.trim();
    const id     = document.getElementById('ag_id').value.trim() || slugifyGianId(maCT);
    const tmLetters = document.getElementById('ag_tmCol').value.trim().toUpperCase();
    const ckLetters = document.getElementById('ag_ckCol').value.trim().toUpperCase();
    const sheetId = extractSheetId(link);

    const errEl = document.getElementById('ag_error');
    const showErr = (msg) => { errEl.textContent = msg; errEl.style.display = 'block'; };

    if (!maCT) return showErr('Vui lòng nhập tên mã công trình.');
    if (!sheetId) return showErr('Link Google Sheets không hợp lệ hoặc không chứa Sheet ID.');
    if (!tab) return showErr('Vui lòng nhập tên tab.');
    if (!tmLetters || !ckLetters) return showErr('Vui lòng nhập ký tự cột TM và CK.');
    errEl.style.display = 'none';

    const tmCol = colLetterToIdx(tmLetters);
    const ckCol = colLetterToIdx(ckLetters);

    const btn = document.getElementById('ag_submit_btn');
    btn.disabled = true;
    btn.textContent = '⏳ Đang lưu...';

    try {
      const resp = await fetch('/api/dau-ra/gian-custom', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id, kh, maCT, khFull, link, sheetId, tab, tmCol, ckCol })
      });
      const result = await resp.json();
      if (!result.ok) { showErr('Lỗi: ' + result.error); btn.disabled = false; btn.textContent = '✅ Thêm gian'; return; }

      // Thêm vào KVC_GIAN và re-render
      KVC_GIAN.push({ id, kh, maCT, khFull, link });
      closeAddGianModal();
      renderKvcTable();
      document.getElementById('kvc_status').textContent = `✅ Đã thêm gian: ${maCT}`;
      setTimeout(() => { document.getElementById('kvc_status').textContent = ''; }, 5000);
    } catch(e) {
      showErr('Lỗi kết nối: ' + e.message);
    } finally {
      btn.disabled = false;
      btn.textContent = '✅ Thêm gian';
    }
  }

  // ============================================================
  // LOAD CUSTOM GIANS FROM SERVER
  // ============================================================
  async function loadCustomGians() {
    try {
      const resp = await fetch('/api/dau-ra/gian-custom');
      const result = await resp.json();
      if (result.ok && result.gians && result.gians.length > 0) {
        const existingIds = new Set(KVC_GIAN.map(g => g.id));
        result.gians.forEach(g => {
          if (!existingIds.has(g.id)) {
            KVC_GIAN.push({ id: g.id, kh: g.kh, maCT: g.maCT, khFull: g.khFull || '', link: g.link || '' });
          }
        });
      }
    } catch(e) { /* silent */ }
  }

  // Init: load custom gians + server KV data vào memory, rồi render
  // Không render trước vì cần server data để hiển thị đúng khi localStorage đầy
  Promise.all([loadCustomGians(), serverLoadAll()]).then(() => renderKvcTable());
  </script>
  <%- include('partials/scroll-restore') %>
</body>
</html>

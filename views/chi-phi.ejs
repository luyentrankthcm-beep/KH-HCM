<!DOCTYPE html>
<html lang="vi">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/nav') %>
  <main class="container">
    <h1>Chi Phí</h1>
    <p class="muted" style="margin-top:-10px;margin-bottom:20px;">
      Sổ ghi chi phí — lấy từ Google Sheet "ĐI ỦY NHIỆM CHI KVC + MTĐ MN" (tab THÁNG 7.2026 + TT TIỀN MẶT), tách theo
      công ty đang chọn (nút Cũ/Mới góc trên trái). Tổng công ty: <%= totalForCompany %> khoản chi (<%= chuaHachToanCount %> chưa hạch toán, <%= chuaSoHoaDonCount %> chưa có số hóa đơn).
      Đang hiển thị: <%= rows.length %> khoản, <%= tongTien.toLocaleString('vi-VN') %> đ.
    </p>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>

    <style>
      .icon-upload-btn {
        display: inline-flex; flex-direction: column; align-items: center; justify-content: center;
        gap: 4px; cursor: pointer; border: 1px solid var(--color-hairline); border-radius: var(--radius-md);
        padding: 12px 20px; background: #fff; transition: box-shadow .15s, transform .15s;
      }
      .icon-upload-btn:hover { box-shadow: 0 2px 8px rgba(0,0,0,.1); transform: translateY(-1px); }
      .icon-upload-btn .icon-upload-btn-icon { font-size: 26px; line-height: 1; }
      .icon-upload-btn .icon-upload-btn-label { font-size: 12px; font-weight: 600; white-space: nowrap; }
    </style>
    <div style="margin-bottom:16px; display:flex; gap:12px;">
      <form method="POST" action="/chi-phi/cap-nhat-tu-sheet" style="display:inline-block;">
        <button type="submit" class="icon-upload-btn" style="border:none;" title='Đọc thẳng từ Google Sheet "ĐI ỦY NHIỆM CHI KVC + MTĐ MN" để nạp thêm khoản chi mới (không cần tải file lên nữa, không mất dữ liệu đã có)'>
          <span class="icon-upload-btn-icon">📥</span>
          <span class="icon-upload-btn-label">Cập nhật chi phí</span>
        </button>
      </form>
      <form method="POST" action="/chi-phi/quet-ngan-hang" style="display:inline-block;">
        <button type="submit" class="icon-upload-btn" style="border:1px solid var(--color-hairline);" title="Tự động quét các giao dịch Chi (tiền thuê gian) trong tháng hiện tại trên tất cả tài khoản ngân hàng, khớp gian hàng và tạo khoản chi phí mới (không tạo trùng). Chạy hàng ngày để tự cập nhật.">
          <span class="icon-upload-btn-icon">🏦</span>
          <span class="icon-upload-btn-label">Quét ngân hàng</span>
        </button>
      </form>
      <a
        href="/chi-phi/export.xlsx?hachToan=<%= encodeURIComponent(hachToanFilter) %>&thang=<%= encodeURIComponent(thangFilter) %>&hoaDon=<%= encodeURIComponent(hoaDonFilter) %>"
        class="icon-upload-btn"
        style="border:1px solid var(--color-hairline); text-decoration:none; color:inherit;"
        title="Xuất ra file Excel danh sách chi phí đang hiển thị (theo đúng bộ lọc hạch toán/tháng/số hóa đơn đang chọn)"
      >
        <span class="icon-upload-btn-icon">📊</span>
        <span class="icon-upload-btn-label">Xuất Excel</span>
      </a>
      <% if (gmailConnected) { %>
        <form method="POST" action="/chi-phi/tim-hoa-don-gmail" style="display:inline-block;">
          <input type="hidden" name="hachToan" value="<%= hachToanFilter %>" />
          <input type="hidden" name="thang" value="<%= thangFilter %>" />
          <input type="hidden" name="hoaDon" value="<%= hoaDonFilter %>" />
          <button type="submit" class="icon-upload-btn" style="border:1px solid var(--color-hairline);" title='Tự động tìm hóa đơn qua Gmail cho các dòng của tháng mới nhất còn thiếu Link hóa đơn (bỏ qua dòng đã có link). Bấm nhiều lần để quét tiếp phần còn lại.'>
            <span class="icon-upload-btn-icon">✉️</span>
            <span class="icon-upload-btn-label">Cập nhật tìm hóa đơn</span>
          </button>
        </form>
      <% } else { %>
        <a
          href="/gmail/connect"
          class="icon-upload-btn"
          style="border:1px solid var(--color-hairline); text-decoration:none; color:inherit;"
          title='<%= gmailConfigured ? "Kết nối tài khoản Gmail để dùng nút Cập nhật tìm hóa đơn (tự động tìm hóa đơn qua email)" : "Chưa cấu hình Google OAuth trên Railway (GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET/GOOGLE_REDIRECT_URI) -- báo Claude thiết lập trước" %>'
        >
          <span class="icon-upload-btn-icon">🔗</span>
          <span class="icon-upload-btn-label">Kết nối Gmail</span>
        </a>
      <% } %>
    </div>

    <section class="panel">
      <h2>Thêm khoản chi mới (nhập tay)</h2>
      <form method="POST" action="/chi-phi" class="form-grid">
        <label>Ngày chi <input type="date" name="ngay" required /></label>
        <label>Gian/Cơ sở <input type="text" name="gian" /></label>
        <label>NCC <input type="text" name="ncc" /></label>
        <label>Số hóa đơn <input type="text" name="soHoaDon" /></label>
        <label>Số UNC <input type="text" name="soUNC" placeholder="vd UNC 01/7" /></label>
        <label>Số chứng từ liên quan <input type="text" name="soChungTuLienQuan" placeholder="vd số hợp đồng thuê" /></label>
        <label>Loại chi phí <input type="text" name="loaiChiPhi" placeholder="vd tiền điện, văn phòng phẩm..." required /></label>
        <label>Số tiền <input type="text" name="soTien" placeholder="vd 500000" /></label>
        <label style="grid-column: 1 / -1;">Diễn giải <input type="text" name="dienGiai" /></label>
        <label style="grid-column: 1 / -1;">Link hóa đơn <input type="text" name="linkHoaDon" /></label>
        <label style="grid-column: 1 / -1;">Ghi chú <input type="text" name="ghiChu" /></label>
        <button type="submit" class="btn btn-primary">Lưu</button>
      </form>
    </section>

    <section class="panel">
      <h2>Danh sách (<%= rows.length %> khoản chi)</h2>
      <div class="form-grid" style="margin-bottom:10px;">
        <label style="grid-column: 1 / -1;">
          Tìm nhanh (gian, NCC, số hóa đơn, số UNC, chứng từ, diễn giải...)
          <input type="text" id="cpSearchBox" placeholder="Gõ để tìm..." oninput="filterCpRows()" />
        </label>
        <label>
          Lọc hạch toán
          <select id="cpHachToanFilter" onchange="cpApplyFilters()">
            <option value="" <%= hachToanFilter === "" ? "selected" : "" %>>Tất cả</option>
            <option value="0" <%= hachToanFilter === "0" ? "selected" : "" %>>Chưa hạch toán</option>
            <option value="1" <%= hachToanFilter === "1" ? "selected" : "" %>>Đã hạch toán</option>
          </select>
        </label>
        <label>
          Lọc theo tháng
          <select id="cpThangFilter" onchange="cpApplyFilters()">
            <option value="" <%= thangFilter === "" ? "selected" : "" %>>Tất cả các tháng</option>
            <% availableMonths.forEach(function(m) { %>
            <option value="<%= m %>" <%= thangFilter === m ? "selected" : "" %>>Tháng <%= Number(m.slice(5,7)) %>/<%= m.slice(0,4) %></option>
            <% }) %>
          </select>
        </label>
        <label>
          Lọc số hóa đơn
          <select id="cpHoaDonFilter" onchange="cpApplyFilters()">
            <option value="" <%= hoaDonFilter === "" ? "selected" : "" %>>Tất cả</option>
            <option value="0" <%= hoaDonFilter === "0" ? "selected" : "" %>>Chưa có số hóa đơn</option>
            <option value="1" <%= hoaDonFilter === "1" ? "selected" : "" %>>Đã có số hóa đơn</option>
          </select>
        </label>
      </div>
      <div class="table-scroll">
        <table class="table">
          <thead>
            <tr>
              <th>Ngày</th><th>Gian</th><th>NCC</th><th>Số hóa đơn</th><th>Số UNC</th><th>Chứng từ liên quan</th><th>Diễn giải</th>
              <th>Số tiền</th><th>Link hóa đơn</th><th>Đã hạch toán</th>
            </tr>
          </thead>
          <tbody id="cpTableBody">
            <% rows.forEach(function(r) { %>
            <tr class="cp-row" id="cp-<%= r.id %>" data-search="<%= (r.gian + ' ' + r.ncc + ' ' + r.soHoaDon + ' ' + r.soUNC + ' ' + r.soChungTuLienQuan + ' ' + r.dienGiai + ' ' + r.loaiChiPhi).toLowerCase().replace(/\"/g,'&quot;') %>">
              <td><%= r.ngay %></td>
              <td><%= r.gian %></td>
              <td><%= r.ncc %></td>
              <td>
                <!-- Chi Nhan (2026-07-22): "có số hóa đơn rồi thì khóa lun không cần
                     cho phép chỉnh sửa đâu" -- dong da co soHoaDon mac dinh KHOA (chi
                     hien text + nut "Sửa" nho de mo lai neu that su can sua), tranh
                     bam nham/ghi de mat du lieu da luu. -->
                <span class="cp-so-hd-locked" id="soHdLocked-<%= r.id %>" style="font-size:12px; <%= r.soHoaDon ? '' : 'display:none;' %>">
                  <%= r.soHoaDon %>
                  <button type="button" class="link-btn" style="font-size:10px;" onclick="cpUnlock('<%= r.id %>','so-hoa-don')">Sửa</button>
                </span>
                <form method="POST" action="/chi-phi/<%= r.id %>/so-hoa-don" class="form-inline cp-ajax-form" data-kind="so-hoa-don" id="soHdForm-<%= r.id %>" style="gap:4px; <%= r.soHoaDon ? 'display:none;' : '' %>">
                  <input type="hidden" name="hachToan" value="<%= hachToanFilter %>" />
                  <input type="hidden" name="thang" value="<%= thangFilter %>" />
                  <input type="hidden" name="hoaDon" value="<%= hoaDonFilter %>" />
                  <input type="text" name="soHoaDon" value="<%= r.soHoaDon %>" placeholder="Nhập số HĐ" style="width:80px; font-size:12px; padding:2px 4px;" />
                  <button type="submit" class="link-btn" style="font-size:11px;" title="Lưu số hóa đơn">Lưu</button>
                  <span class="cp-save-flash" style="font-size:11px; color:#1a7f37; display:none;">✓</span>
                </form>
              </td>
              <td><%= r.soUNC %></td>
              <td>
                <% if (r.chungTuLienQuanLink) { %><a href="<%= r.chungTuLienQuanLink %>" target="_blank" rel="noopener"><%= r.soChungTuLienQuan %></a>
                <% } else { %><%= r.soChungTuLienQuan %><% } %>
              </td>
              <td style="max-width:320px;">
                <%= r.dienGiai || r.loaiChiPhi %>
                <span class="cp-trang-thai-hoa-don" id="trangThai-<%= r.id %>"><% if (r.trangThaiHoaDon) { %><br/><span class="muted" style="font-size:11px;"><%= r.trangThaiHoaDon %></span><% } %></span>
                <% if (r.soTienHoaDonGoc && r.soTienHoaDonGoc !== r.soTien) { %>
                  <br/><span class="text-neg" style="font-size:11px;">⚠ Số tiền trên hóa đơn gốc: <%= r.soTienHoaDonGoc.toLocaleString('vi-VN') %> đ (khác số trong sheet)</span>
                <% } %>
              </td>
              <td>
                <!-- Chi Nhan (2026-07-23): "số tiền có 8tr mấy mà bạn lấy lên mất tỷ
                     dữ vậy" -- them kha nang sua so tien 1 dong (truoc gio khong sua
                     duoc), mac dinh hien text (khoa) + nut "Sửa" nho de mo form. -->
                <span class="cp-so-tien-locked" id="soTienLocked-<%= r.id %>">
                  <%= (r.soTien || 0).toLocaleString('vi-VN') %> đ
                  <button type="button" class="link-btn" style="font-size:10px;" onclick="cpUnlock('<%= r.id %>','so-tien')">Sửa</button>
                </span>
                <form method="POST" action="/chi-phi/<%= r.id %>/so-tien" class="form-inline cp-ajax-form" data-kind="so-tien" id="soTienForm-<%= r.id %>" style="gap:4px; display:none;">
                  <input type="hidden" name="hachToan" value="<%= hachToanFilter %>" />
                  <input type="hidden" name="thang" value="<%= thangFilter %>" />
                  <input type="hidden" name="hoaDon" value="<%= hoaDonFilter %>" />
                  <input type="text" name="soTien" value="<%= r.soTien %>" placeholder="Số tiền" style="width:100px; font-size:12px; padding:2px 4px;" />
                  <button type="submit" class="link-btn" style="font-size:11px;" title="Lưu số tiền">Lưu</button>
                  <span class="cp-save-flash" style="font-size:11px; color:#1a7f37; display:none;">✓</span>
                </form>
              </td>
              <td>
                <span class="cp-link-hoa-don-display" id="linkDisplay-<%= r.id %>">
                <% if (r.linkHoaDon) { %><a href="<%= r.linkHoaDon %>" target="_blank" rel="noopener">Xem hóa đơn</a>
                  <button type="button" class="link-btn" style="font-size:10px;" onclick="cpUnlock('<%= r.id %>','link-hoa-don')">Sửa</button><br/>
                <% } else { %><span class="muted">Không có</span><br/>
                <% } %>
                </span>
                <form method="POST" action="/chi-phi/<%= r.id %>/link-hoa-don" class="form-inline cp-ajax-form" data-kind="link-hoa-don" id="linkHdForm-<%= r.id %>" style="gap:4px; <%= r.linkHoaDon ? 'display:none;' : '' %>">
                  <input type="hidden" name="hachToan" value="<%= hachToanFilter %>" />
                  <input type="hidden" name="thang" value="<%= thangFilter %>" />
                  <input type="hidden" name="hoaDon" value="<%= hoaDonFilter %>" />
                  <input type="text" name="linkHoaDon" value="<%= r.linkHoaDon %>" placeholder="Dán link Drive" style="width:90px; font-size:11px; padding:2px 4px;" />
                  <button type="submit" class="link-btn" style="font-size:11px;" title="Lưu link hóa đơn">Lưu</button>
                  <span class="cp-save-flash" style="font-size:11px; color:#1a7f37; display:none;">✓</span>
                </form>
              </td>
              <td>
                <form method="POST" action="/chi-phi/<%= r.id %>/hach-toan" class="cp-ajax-form" data-kind="hach-toan" style="display:inline;">
                  <input type="hidden" name="daHachToan" value="<%= r.daHachToan ? '0' : '1' %>" />
                  <input type="hidden" name="hachToan" value="<%= hachToanFilter %>" />
                  <input type="hidden" name="thang" value="<%= thangFilter %>" />
                  <input type="hidden" name="hoaDon" value="<%= hoaDonFilter %>" />
                  <button type="submit" class="link-btn" title="Bấm để đổi trạng thái" style="font-size:16px;">
                    <%= r.daHachToan ? '☑' : '☐' %>
                  </button>
                </form>
              </td>
            </tr>
            <% }) %>
            <% if (rows.length === 0) { %>
            <tr><td colspan="10" class="muted">Chưa có khoản chi nào.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
      <div id="cpPagination" style="display:flex; align-items:center; gap:10px; justify-content:center; margin-top:12px;">
        <button type="button" class="link-btn" id="cpPrevBtn" onclick="cpChangePage(-1)">&larr; Trang trước</button>
        <span id="cpPageInfo" class="muted"></span>
        <button type="button" class="link-btn" id="cpNextBtn" onclick="cpChangePage(1)">Trang sau &rarr;</button>
      </div>
    </section>
  </main>
  <script>
    (function () {
      var PAGE_SIZE = 20;
      var page = 1;
      window.filterCpRows = function () {
        page = 1;
        render();
      };
      window.cpApplyFilters = function () {
        var hachToan = document.getElementById('cpHachToanFilter').value;
        var thang = document.getElementById('cpThangFilter').value;
        var hoaDon = document.getElementById('cpHoaDonFilter').value;
        var url = new URL(window.location.href);
        if (hachToan) url.searchParams.set('hachToan', hachToan);
        else url.searchParams.delete('hachToan');
        // thang: luon set (ke ca rong) de override gia tri mac dinh (thang 7) tren server.
        url.searchParams.set('thang', thang);
        if (hoaDon) url.searchParams.set('hoaDon', hoaDon);
        else url.searchParams.delete('hoaDon');
        window.location.href = url.toString();
      };
      window.cpChangePage = function (delta) {
        page += delta;
        render();
      };
      // Chi Nhan (2026-07-22): "có số hóa đơn rồi thì khóa lun không cần cho
      // phép chỉnh sửa đâu" -- mo lai form khi bam nut "Sửa" (chu dong, tranh
      // sua nham); kind: 'so-hoa-don' hoac 'link-hoa-don'.
      window.cpUnlock = function (rowId, kind) {
        if (kind === 'so-hoa-don') {
          var lockedEl = document.getElementById('soHdLocked-' + rowId);
          var formEl = document.getElementById('soHdForm-' + rowId);
          if (lockedEl) lockedEl.style.display = 'none';
          if (formEl) {
            formEl.style.display = '';
            var input = formEl.querySelector('input[name="soHoaDon"]');
            if (input) input.focus();
          }
        } else if (kind === 'link-hoa-don') {
          var formEl2 = document.getElementById('linkHdForm-' + rowId);
          if (formEl2) {
            formEl2.style.display = '';
            var input2 = formEl2.querySelector('input[name="linkHoaDon"]');
            if (input2) input2.focus();
          }
        } else if (kind === 'so-tien') {
          var soTienLockedEl = document.getElementById('soTienLocked-' + rowId);
          var soTienFormEl = document.getElementById('soTienForm-' + rowId);
          if (soTienLockedEl) soTienLockedEl.style.display = 'none';
          if (soTienFormEl) {
            soTienFormEl.style.display = '';
            var input3 = soTienFormEl.querySelector('input[name="soTien"]');
            if (input3) { input3.focus(); input3.select(); }
          }
        }
      };
      function render() {
        var q = (document.getElementById('cpSearchBox').value || '').toLowerCase().trim();
        var allRows = Array.prototype.slice.call(document.querySelectorAll('#cpTableBody tr.cp-row'));
        var matched = allRows.filter(function (tr) {
          return !q || tr.getAttribute('data-search').indexOf(q) !== -1;
        });
        var totalPages = Math.max(1, Math.ceil(matched.length / PAGE_SIZE));
        if (page > totalPages) page = totalPages;
        if (page < 1) page = 1;
        var start = (page - 1) * PAGE_SIZE;
        var end = start + PAGE_SIZE;
        allRows.forEach(function (tr) { tr.style.display = 'none'; });
        matched.slice(start, end).forEach(function (tr) { tr.style.display = ''; });
        var info = document.getElementById('cpPageInfo');
        info.textContent = matched.length === 0
          ? 'Không có khoản chi phù hợp'
          : 'Trang ' + page + '/' + totalPages + ' (' + matched.length + ' khoản chi)';
        document.getElementById('cpPrevBtn').disabled = page <= 1;
        document.getElementById('cpNextBtn').disabled = page >= totalPages;
      }
      render();

      // Luyen, 2026-07-22: "cập nhật thì giữ nguyên trang, đừng đưa lên đầu
      // trang rồi kéo xuống" + "khi nào tôi bỏ lọc mới thay đổi, còn lại vẫn
      // phải có" -- cac form Luu (so hoa don / link hoa don / hach toan) gui
      // AJAX (X-Requested-With) thay vi submit thuong, de trang KHONG reload:
      // khong mat vi tri cuon, va dong khong bi bien mat theo bo loc dang
      // chon cho toi khi chi tu tay doi bo loc.
      function showFlash(form) {
        var flash = form.querySelector('.cp-save-flash');
        if (!flash) return;
        flash.style.display = 'inline';
        setTimeout(function () { flash.style.display = 'none'; }, 1500);
      }
      document.querySelectorAll('form.cp-ajax-form').forEach(function (form) {
        form.addEventListener('submit', function (e) {
          e.preventDefault();
          var kind = form.getAttribute('data-kind');
          var tr = form.closest('tr.cp-row');
          var rowId = tr ? tr.id.replace('cp-', '') : null;
          var body = new URLSearchParams(new FormData(form));
          fetch(form.action, {
            method: 'POST',
            headers: { 'X-Requested-With': 'XMLHttpRequest' },
            body: body,
          })
            .then(function (resp) { return resp.json().then(function (data) { return { ok: resp.ok, data: data }; }); })
            .then(function (result) {
              if (!result.ok) { alert((result.data && result.data.error) || 'Có lỗi khi lưu, thử lại giúp tôi.'); return; }
              var data = result.data;
              if (kind === 'hach-toan') {
                var btn = form.querySelector('button[type="submit"]');
                btn.textContent = data.daHachToan ? '☑' : '☐';
                form.querySelector('input[name="daHachToan"]').value = data.daHachToan ? '0' : '1';
              } else if (kind === 'so-hoa-don') {
                var trangThaiEl = document.getElementById('trangThai-' + rowId);
                if (trangThaiEl) {
                  trangThaiEl.innerHTML = data.trangThaiHoaDon
                    ? '<br/><span class="muted" style="font-size:11px;">' + data.trangThaiHoaDon + '</span>'
                    : '';
                }
                if (tr) tr.setAttribute('data-search', tr.getAttribute('data-search'));
                // Chi Nhan (2026-07-22): luu xong ma co gia tri thi khoa lai ngay
                // (an form, hien text + nut Sua) -- khong doi ban ghi phai bam F5.
                var soHdLockedEl = document.getElementById('soHdLocked-' + rowId);
                if (data.soHoaDon && soHdLockedEl) {
                  soHdLockedEl.innerHTML = data.soHoaDon +
                    ' <button type="button" class="link-btn" style="font-size:10px;" onclick="cpUnlock(\'' + rowId + '\',\'so-hoa-don\')">Sửa</button>';
                  soHdLockedEl.style.display = '';
                  form.style.display = 'none';
                }
              } else if (kind === 'link-hoa-don') {
                var trangThaiEl2 = document.getElementById('trangThai-' + rowId);
                if (trangThaiEl2 && data.trangThaiHoaDon !== undefined) {
                  trangThaiEl2.innerHTML = data.trangThaiHoaDon
                    ? '<br/><span class="muted" style="font-size:11px;">' + data.trangThaiHoaDon + '</span>'
                    : '';
                }
                var linkEl = document.getElementById('linkDisplay-' + rowId);
                if (linkEl) {
                  linkEl.innerHTML = data.linkHoaDon
                    ? '<a href="' + data.linkHoaDon + '" target="_blank" rel="noopener">Xem hóa đơn</a> <button type="button" class="link-btn" style="font-size:10px;" onclick="cpUnlock(\'' + rowId + '\',\'link-hoa-don\')">Sửa</button><br/>'
                    : '<span class="muted">Không có</span><br/>';
                }
                if (data.linkHoaDon) form.style.display = 'none';
              } else if (kind === 'so-tien') {
                var trangThaiEl3 = document.getElementById('trangThai-' + rowId);
                if (trangThaiEl3 && data.trangThaiHoaDon !== undefined) {
                  trangThaiEl3.innerHTML = data.trangThaiHoaDon
                    ? '<br/><span class="muted" style="font-size:11px;">' + data.trangThaiHoaDon + '</span>'
                    : '';
                }
                var soTienLockedEl2 = document.getElementById('soTienLocked-' + rowId);
                if (soTienLockedEl2 && data.soTien !== undefined) {
                  soTienLockedEl2.innerHTML = Number(data.soTien).toLocaleString('vi-VN') + ' đ ' +
                    '<button type="button" class="link-btn" style="font-size:10px;" onclick="cpUnlock(\'' + rowId + '\',\'so-tien\')">Sửa</button>';
                  soTienLockedEl2.style.display = '';
                  form.style.display = 'none';
                }
              }
              showFlash(form);
            })
            .catch(function () { alert('Không kết nối được, thử lại giúp tôi.'); });
        });
      });
    })();
  </script>
</body>
</html>

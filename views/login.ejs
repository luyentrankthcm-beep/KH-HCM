<!DOCTYPE html>
<html lang="vi">
<head>
  <%- include('partials/head') %>
</head>
<body class="login-body">
  <div class="aqua-bg" aria-hidden="true">
    <span class="bubble" style="left:8%; width:16px; height:16px; animation-duration:11s; animation-delay:0s;"></span>
    <span class="bubble" style="left:20%; width:24px; height:24px; animation-duration:14s; animation-delay:2s;"></span>
    <span class="bubble" style="left:35%; width:12px; height:12px; animation-duration:9s; animation-delay:5s;"></span>
    <span class="bubble" style="left:50%; width:20px; height:20px; animation-duration:13s; animation-delay:1s;"></span>
    <span class="bubble" style="left:65%; width:14px; height:14px; animation-duration:10s; animation-delay:6s;"></span>
    <span class="bubble" style="left:80%; width:28px; height:28px; animation-duration:16s; animation-delay:3s;"></span>
    <span class="bubble" style="left:92%; width:16px; height:16px; animation-duration:12s; animation-delay:7s;"></span>
  </div>
  <div class="login-card">
    <h1>K&amp;H Bank Tracker</h1>
    <p class="muted">CÔNG TY TNHH DỊCH VỤ VÀ GIẢI TRÍ K&amp;H</p>
    <% if (error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>
    <form method="POST" action="/login">
      <label>Tên đăng nhập</label>
      <input type="text" name="username" required autofocus />
      <label>Mật khẩu</label>
      <input type="password" name="password" required />
      <button type="submit" class="btn btn-primary btn-full">Đăng nhập</button>
    </form>
  </div>
</body>
</html>

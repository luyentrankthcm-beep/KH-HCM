                <form method="POST" action="/doi-soat/zvp/upload-payoo/<%= u.id %>/delete" onsubmit="return confirm('Xoá bảng doanh thu Payoo này?');">
                  <button type="submit" class="link-btn link-danger">Xoá</button>
                </form>
              </td>
            </tr>
            <% }) %>
            <% if (payooUploads.length === 0) { %>
            <tr><td colspan="6" class="muted">Chưa tải file Payoo nào.</td></tr>
            <% } %>
          </tbody>
        </table>
      </details>
        </div>
      </details>
    </section>

    <section class="panel">
